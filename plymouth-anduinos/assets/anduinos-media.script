# Installed only as the active theme in the dedicated Live initrd.
# Ordinary startup progress never pretends to be a checksum percentage.
Window.SetBackgroundTopColor(0.035, 0.045, 0.07);
Window.SetBackgroundBottomColor(0.035, 0.045, 0.07);

logo_image = Image("logo.png");
logo = Sprite(logo_image);
logo.SetX(Window.GetWidth() / 2 - logo_image.GetWidth() / 2);
logo.SetY(Window.GetHeight() / 2 - 180);

bar_width = Math.Min(480, Window.GetWidth() - 80);
fun solid_pixel(red, green, blue) {
    image = Image.Text("█", red, green, blue, 1.0, "Sans 20", "center");
    return image.Crop(image.GetWidth() / 2, image.GetHeight() / 2, 1, 1);
}
bar_background_image = solid_pixel(0.22, 0.25, 0.3).Scale(bar_width, 8);
bar_background = Sprite(bar_background_image);
bar_background.SetX(Window.GetWidth() / 2 - bar_width / 2);
bar_background.SetY(Window.GetHeight() / 2 - 25);
bar = Sprite();
bar.SetX(Window.GetWidth() / 2 - bar_width / 2);
bar.SetY(Window.GetHeight() / 2 - 25);
bar.SetZ(1);
percentage = Sprite();
message = Sprite();
message_text = "";

fun string_to_integer(text) {
    # Plymouth's script language does not coerce strings to numbers. Status
    # callbacks always receive strings, so parse the bounded percentage
    # explicitly instead of silently drawing a one-pixel progress bar.
    for (number = 0; number <= 100; number++) {
        if (number + "" == text) return number;
    }
    return 0;
}

fun update_status(status) {
    if (status.SubString(0, 6) != "media:") return;
    value = status.SubString(6, 20);
    if (value == "done") {
        bar.SetOpacity(0);
        bar_background.SetOpacity(0);
        percentage.SetOpacity(0);
        return;
    }
    fraction = string_to_integer(value);
    bar_background.SetOpacity(1);
    bar.SetOpacity(1);
    percentage.SetOpacity(1);
    bar.SetImage(solid_pixel(0.2, 0.52, 0.94).Scale(Math.Max(1, bar_width * fraction / 100), 8));
    percentage_image = Image.Text(value + "%", 0.9, 0.93, 1, 1.0,
        "Sans 14", "center");
    percentage.SetImage(percentage_image);
    percentage.SetX(Window.GetWidth() / 2 - percentage_image.GetWidth() / 2);
    percentage.SetY(Window.GetHeight() / 2 - 60);
}

fun display_message(text) {
    if (text.SubString(0, 15) == "anduinos-clear:")
        message_text = text.SubString(15, 4096);
    else if (text.SubString(0, 16) == "anduinos-append:")
        message_text = message_text + "\n" + text.SubString(16, 4096);
    else
        message_text = text;
    message_image = Image.Text(message_text, 0.9, 0.93, 1, 1.0, "Sans 12", "center");
    # Long translations must remain on screen at safe-graphics resolutions.
    if (message_image.GetWidth() > Window.GetWidth() - 40)
        message_image = message_image.Scale(Window.GetWidth() - 40,
            message_image.GetHeight() * (Window.GetWidth() - 40) / message_image.GetWidth());
    message.SetImage(message_image);
    message.SetX(Window.GetWidth() / 2 - message_image.GetWidth() / 2);
    message.SetY(Window.GetHeight() / 2 + 15);
}

Plymouth.SetUpdateStatusFunction(update_status);
Plymouth.SetDisplayMessageFunction(display_message);
