<Project Sdk="Aiursoft.Apkg.Sdk">
  <PropertyGroup>
    <PackageName>anduinos-kernel-parameters</PackageName>
    <PackageVersion>2.1.0-1+$(SuiteShortName)</PackageVersion>
    <Maintainer>AnduinOS Team &lt;anduin@aiursoft.com&gt;</Maintainer>
    <PackageDescription>AnduinOS desktop kernel parameters — full dynamic preemption and graphical boot splash</PackageDescription>
    <Section>admin</Section>
    <PackageHomepage>https://www.anduinos.com</PackageHomepage>
    <RepositoryUrl>https://github.com/AiursoftWeb/AnduinOS-Packages</RepositoryUrl>
    <LicenseType>GPL-3.0</LicenseType>
    <Conflicts>lowlatency-kernel</Conflicts>
    <TargetDistro>anduinos</TargetDistro>
    <TargetSuites>resolute-addon stonking-addon</TargetSuites>
    <TargetArchitectures>all</TargetArchitectures>
    <Component>main</Component>
    <SuiteShortNameMap>resolute-addon=resolute stonking-addon=stonking</SuiteShortNameMap>
  </PropertyGroup>

  <ItemGroup>
    <DependencyCheckSource
        Url="https://mirror.aiursoft.com/ubuntu"
        SuiteMap="resolute-addon=resolute stonking-addon=stonking" />
  </ItemGroup>

  <ItemGroup>
    <Dependency Include="linux-generic-hwe-26.04" Condition="'$(Suite)' == 'resolute-addon'" />
    <Dependency Include="linux-generic" Condition="'$(Suite)' == 'stonking-addon'" />
    <Dependency Include="grub2-common" />
  </ItemGroup>

  <ItemGroup>
    <IncludeFile Include="assets/99-anduinos-desktop.cfg"
                 Target="/etc/default/grub.d/99-anduinos-desktop.cfg" />
    <PostInstallScript Include="scripts/postinst.sh" />
    <PostRemoveScript Include="scripts/postrm.sh" />
  </ItemGroup>
  <ItemGroup>
    <TestCommand Name="source" Profile="anduinos-package-release-test" Run="PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=src LANGUAGE=C python3 -m unittest discover -s tests -v" TimeoutSeconds="300" />
  </ItemGroup>
</Project>
