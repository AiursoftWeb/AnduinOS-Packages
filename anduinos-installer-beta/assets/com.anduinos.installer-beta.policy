<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>AnduinOS</vendor>
  <vendor_url>https://www.anduinos.com</vendor_url>

  <action id="com.anduinos.installer-beta.probe-storage">
    <description>Read exact disk partition geometry for the AnduinOS installer</description>
    <description xml:lang="ar_SA">قراءة المواضع والأحجام الدقيقة لتقسيمات القرص لبرنامج تثبيت AnduinOS</description>
    <description xml:lang="da_DK">Læs diskpartitionernes nøjagtige placeringer og størrelser til AnduinOS-installationsprogrammet</description>
    <description xml:lang="de_DE">Die genauen Positionen und Größen der Festplattenpartitionen für den AnduinOS-Installer auslesen</description>
    <description xml:lang="el_GR">Ανάγνωση των ακριβών θέσεων και μεγεθών των διαμερισμάτων του δίσκου για τον εγκαταστάτη AnduinOS</description>
    <description xml:lang="en_GB">Read exact disk partition geometry for the AnduinOS installer</description>
    <description xml:lang="es_ES">Leer las posiciones y los tamaños exactos de las particiones del disco para el instalador de AnduinOS</description>
    <description xml:lang="fi_FI">Lue AnduinOS-asentajaa varten levyosioiden tarkat sijainnit ja koot</description>
    <description xml:lang="fr_FR">Lire les positions et tailles exactes des partitions du disque pour l’installateur AnduinOS</description>
    <description xml:lang="hi_IN">AnduinOS इंस्टॉलर के लिए डिस्क पार्टिशनों की सटीक स्थिति और आकार पढ़ें</description>
    <description xml:lang="id_ID">Baca posisi dan ukuran pasti partisi disk untuk penginstal AnduinOS</description>
    <description xml:lang="it_IT">Leggere le posizioni e le dimensioni esatte delle partizioni del disco per il programma di installazione di AnduinOS</description>
    <description xml:lang="ja_JP">AnduinOS インストーラー用に、ディスクパーティションの正確な位置とサイズを読み取る</description>
    <description xml:lang="ko_KR">AnduinOS 설치 프로그램용 디스크 파티션의 정확한 위치 및 크기 정보 읽기</description>
    <description xml:lang="nl_NL">De exacte locaties en groottes van schijfpartities lezen voor het AnduinOS-installatieprogramma</description>
    <description xml:lang="pl_PL">Odczyt dokładnego położenia i rozmiarów partycji dysku dla instalatora AnduinOS</description>
    <description xml:lang="pt_BR">Ler as posições e os tamanhos exatos das partições do disco para o instalador do AnduinOS</description>
    <description xml:lang="pt_PT">Ler as posições e os tamanhos exatos das partições do disco para o instalador do AnduinOS</description>
    <description xml:lang="ro_RO">Citirea geometriei exacte a partițiilor discului pentru instalatorul AnduinOS</description>
    <description xml:lang="ru_RU">Чтение точной геометрии разделов диска для установщика AnduinOS</description>
    <description xml:lang="sv_SE">Läs diskpartitionernas exakta positioner och storlekar för AnduinOS-installatören</description>
    <description xml:lang="th_TH">อ่านข้อมูลตำแหน่งและขนาดที่แน่นอนของพาร์ทิชันบนดิสก์สำหรับโปรแกรมติดตั้ง AnduinOS</description>
    <description xml:lang="tr_TR">AnduinOS kurulumu için disk bölümlerinin kesin konumlarını ve boyutlarını oku</description>
    <description xml:lang="uk_UA">Зчитувати точні розташування та розміри розділів диска для встановлювача AnduinOS</description>
    <description xml:lang="vi_VN">Đọc vị trí và kích thước chính xác của các phân vùng ổ đĩa cho trình cài đặt AnduinOS</description>
    <description xml:lang="zh_CN">读取 AnduinOS 安装程序所需的精确磁盘分区几何信息</description>
    <description xml:lang="zh_HK">讀取 AnduinOS 安裝程式所需的精確磁碟分割區幾何資訊</description>
    <description xml:lang="zh_TW">讀取 AnduinOS 安裝程式所需的精確磁碟分割區幾何資訊</description>
    <message>Authorization is required to inspect disk partition geometry</message>
    <message xml:lang="ar_SA">يلزم الحصول على التفويض لفحص المواضع والأحجام الدقيقة لتقسيمات القرص</message>
    <message xml:lang="da_DK">Godkendelse kræves for at kontrollere diskpartitionernes nøjagtige placeringer og størrelser</message>
    <message xml:lang="de_DE">Zum Prüfen der genauen Positionen und Größen der Festplattenpartitionen ist eine Autorisierung erforderlich.</message>
    <message xml:lang="el_GR">Απαιτείται έλεγχος ταυτότητας για την εξέταση των ακριβών θέσεων και μεγεθών των διαμερισμάτων του δίσκου</message>
    <message xml:lang="en_GB">Authorization is required to inspect disk partition geometry</message>
    <message xml:lang="es_ES">Se requiere autorización para inspeccionar las posiciones y los tamaños exactos de las particiones del disco</message>
    <message xml:lang="fi_FI">Levyosioiden tarkkojen sijaintien ja kokojen tarkasteluun vaaditaan valtuutus</message>
    <message xml:lang="fr_FR">L’authentification est requise pour inspecter les positions et tailles exactes des partitions du disque</message>
    <message xml:lang="hi_IN">डिस्क पार्टिशनों की सटीक स्थिति और आकार की जाँच के लिए प्रमाणीकरण आवश्यक है</message>
    <message xml:lang="id_ID">Otorisasi diperlukan untuk memeriksa posisi dan ukuran pasti partisi disk</message>
    <message xml:lang="it_IT">L'autenticazione è richiesta per ispezionare le posizioni e le dimensioni esatte delle partizioni del disco</message>
    <message xml:lang="ja_JP">ディスクパーティションの正確な位置とサイズを確認するには、認証が必要です。</message>
    <message xml:lang="ko_KR">디스크 파티션의 정확한 위치 및 크기 정보를 확인하려면 인증이 필요합니다</message>
    <message xml:lang="nl_NL">Autorisatie is vereist om de exacte locaties en groottes van schijfpartities te inspecteren</message>
    <message xml:lang="pl_PL">Wymagane jest uwierzytelnienie, aby sprawdzić dokładne położenie i rozmiary partycji dysku</message>
    <message xml:lang="pt_BR">É necessária autorização para inspecionar as posições e os tamanhos exatos das partições do disco</message>
    <message xml:lang="pt_PT">É necessária autenticação para inspecionar as posições e os tamanhos exatos das partições do disco</message>
    <message xml:lang="ro_RO">Autentificarea este necesară pentru a inspecta pozițiile și dimensiunile exacte ale partițiilor discului.</message>
    <message xml:lang="ru_RU">Для проверки геометрии разделов диска требуется авторизация</message>
    <message xml:lang="sv_SE">Behörighet krävs för att kontrollera diskpartitionernas exakta positioner och storlekar.</message>
    <message xml:lang="th_TH">จำเป็นต้องมีการยืนยันสิทธิ์เพื่อดูข้อมูลตำแหน่งและขนาดที่แน่นอนของพาร์ทิชันบนดิสก์</message>
    <message xml:lang="tr_TR">Disk bölümlerinin kesin konumlarını ve boyutlarını incelemek için yetkilendirme gerekir</message>
    <message xml:lang="uk_UA">Для перевірки точних розташувань і розмірів розділів диска потрібна автентифікація</message>
    <message xml:lang="vi_VN">Yêu cầu ủy quyền để kiểm tra vị trí và kích thước chính xác của các phân vùng ổ đĩa</message>
    <message xml:lang="zh_CN">检查磁盘分区几何信息需要授权</message>
    <message xml:lang="zh_HK">檢查磁碟分割區幾何資訊需要授權</message>
    <message xml:lang="zh_TW">檢查磁碟分割區幾何資訊需要授權</message>
    <icon_name>drive-harddisk-symbolic</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/anduinos-installer-storage-probe</annotate>
  </action>
</policyconfig>
