msgstr "{path} sebagai {filesystem}"

msgid "{size} at {offset}"
msgstr "{size} pada {offset}"

msgid "{size} unallocated at {offset}"
msgstr "{size} tidak dialokasikan pada {offset}"

msgid "{step} failed"
msgstr "{step} gagal"

msgid ""
"⚠ Only the selected unallocated space will be partitioned and formatted. "
"Existing partitions are preserved, but EFI/AnduinOS files and the AnduinOS "
"firmware boot entry may change. This installer will not shrink Windows for "
"you."
msgstr ""
"⚠ Hanya ruang tidak dialokasikan yang dipilih akan dipartisi dan diformat. "
"Partisi yang ada tetap dipertahankan, tetapi file EFI/AnduinOS dan entri "
"boot firmware AnduinOS mungkin berubah. Pemasang ini tidak akan mengecilkan "
"Windows untuk Anda."

msgid ""
"⚠ This will erase ALL data on the selected disk. This action cannot be "
"undone."
msgstr ""
"⚠ Ini akan menghapus SEMUA data pada disk yang dipilih. Tindakan ini tidak "
"dapat dibatalkan."

