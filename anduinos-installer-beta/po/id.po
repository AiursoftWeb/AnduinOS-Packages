msgstr "Belanda"

msgid "EFI System Partition"
msgstr "Partisi Sistem EFI"

msgid "EFI policy"
msgstr "Kebijakan EFI"

msgid "Empty disk — no partitions"
msgstr "Disk kosong — tidak ada partisi"

msgid "Enables shared-space subvolumes, snapshots and Disk Snapshots Manager."
msgstr ""
"Mengaktifkan subvolume ruang bersama, snapshot, dan Disk Snapshots Manager."

msgid "English (UK)"
msgstr "Bahasa Inggris (UK)"

msgid "English (US)"
msgstr "Bahasa Inggris (AS)"

msgid "Ensure Disk Snapshots Manager is available"
msgstr "Pastikan Disk Snapshots Manager tersedia"

