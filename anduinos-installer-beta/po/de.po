msgstr "Konto, Region, Zeitzone und Maschinenidentität konfigurieren"

msgid "Configure storage and swap"
msgstr "Speicher und Swap konfigurieren"

msgid "Confirm Password"
msgstr "Passwort bestätigen"

msgid "Confirm your keyboard layout"
msgstr "Bestätigen Sie Ihre Tastaturlayout-Einstellung"

