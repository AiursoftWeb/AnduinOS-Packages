#: src/pages.py:2244
msgid "Installing an input method requires an Internet connection."
msgstr "Installation af en inputmetode kræver en internetforbindelse."

#: src/pages.py:2255
msgid "No Internet connection. Input methods cannot be installed. You can install them later when connected."
msgstr "Ingen internetforbindelse. Inputmetoder kan ikke installeres. Du kan installere dem senere, når du er online."

#: src/pages.py:7174
msgid ""
"\n"
"\n"
"A real installation will create a machine-local MOK. After reboot, choose Enroll MOK → Continue → Yes in MOKManager and enter password 123456."
msgstr ""
"\n"
"\n"
"En rigtig installation vil oprette en maskinelokal MOK. Efter genstart skal du vælge Tilmeld MOK → Fortsæt → Ja i MOKManager og indtaste adgangskoden 123456."

#: src/pages.py:7185
msgid ""
"\n"
"On the blue MOKManager screen choose Enroll MOK → Continue → Yes, password: 123456"
msgstr ""
"\n"
"På den blå MOKManager-skærm vælger du Enroll MOK → Continue → Ja, adgangskode: 123456"

#: src/pages.py:6191
msgid "; sudo does not require a password"
msgstr "; sudo kræver ikke en adgangskode"

#: src/pages.py:6193
msgid "; sudo requires the account password"
msgstr "; sudo kræver kontoens adgangskode"

#: src/pages.py:160
msgid "A partition on this disk is mounted. Unmount it and rescan storage before continuing."
msgstr "En partition på denne disk er monteret. Afmonter den og genundersøg lageret, før du fortsætter."

#: src/pages.py:3241
msgid "ALL DATA on {disk} will be permanently erased."
msgstr "ALLE DATA på {disk} vil blive permanent slettet."

#: src/pages.py:6188
msgid "Account security"
msgstr "Kontosikkerhed"

#: src/pages.py:4066
msgid "Advanced Storage"
msgstr "Avanceret lager"

#: src/pages.py:195
msgid "After changing partitions or unmounting a volume, rescan storage and select the target again."
msgstr "Efter ændring af partitioner eller afmontering af et volumen, skal du genundersøge lageret og vælge målet igen."

#: src/pages.py:7042
msgid "After restart, MOKManager will open. Choose Enroll MOK → Continue → Yes, then enter password 123456."
msgstr "Efter genstart åbnes MOKManager. Vælg Enroll MOK → Continue → Yes, og indtast derefter adgangskoden 123456."

#: src/pages.py:6636
msgid ""
"All partitions and data on {disk} will be destroyed.\n"
"\n"
msgstr ""
"Alle partitioner og data på {disk} vil blive slettet.\n"
"\n"

#: src/pages.py:186
msgid "Alternatively, you may explicitly select one entire partition to erase. Everything in that selected partition will be destroyed; it is never selected automatically."
msgstr "Alternativt kan du udtrykkeligt vælge en hel partition til sletning. Alt i den valgte partition vil blive ødelagt; den vælges aldrig automatisk."

#: src/pages.py:991 src/pages.py:1053
msgid "Battery power is too low for a safe installation."
msgstr "Batteriniveauet er for lavt til en sikker installation."

#: src/pages.py:962
msgid "Charge to at least 80% before starting the installation."
msgstr "Oplad til mindst 80 %, før installationen startes."

