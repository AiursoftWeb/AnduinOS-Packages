msgstr "Detekter internetforbindelse"

msgid "Detect firmware and Secure Boot"
msgstr "Opdag firmware og Secure Boot"

msgid ""
"Development mode will simulate installation to {disk}. No disk data will be "
"changed.\n"
"\n"
msgstr ""
"Udviklingstilstand vil simulere installation til {disk}. Ingenti diskdata "
"vil blive ændret.\n"
"\n"

msgid "Development simulation completed"
msgstr "Udviklingssimulation fuldført"

msgid "Discover AnduinOS"
msgstr "Udforsk AnduinOS"

msgid "Do not require a password for sudo commands"
msgstr "Krav ikke en adgangskode til sudo-kommandoer"

