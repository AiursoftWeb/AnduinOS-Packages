#: src/main.py:88
msgid "AnduinOS Installer (Development)"
msgstr "AnduinOS-installationsprogram (Udvikling)"

#: src/main.py:90
msgid "AnduinOS Installer (Beta)"
msgstr "AnduinOS-installationsprogram (Beta)"

#: src/main.py:125
msgid "Installation in progress"
msgstr "Installation i gang"

#: src/main.py:127
msgid "The installer cannot be closed while it is modifying the target disk."
msgstr "Installationsprogrammet kan ikke lukkes, mens det modificerer måldisken."

#: src/main.py:133
msgid "Continue Installation"
msgstr "Fortsæt installation"

#: src/pages.py:69
msgid "Guided coexistence requires a system booted in UEFI mode and a GPT target disk. This disk cannot continue in guided mode."
msgstr "Styret samexistens kræver et system bootet i UEFI-tilstand og en GPT-måldisk. Denne disk kan ikke fortsætte i styret tilstand."

#: src/pages.py:73
msgid "The complete partition map and free-space geometry could not be read consistently. No space on this disk is authorized for installation."
msgstr "Hele partitionskortet og fri-plads geometrien kunne ikke læses konsistent. Ingen plads på denne disk er autoriseret til installation."

#: src/pages.py:78
msgid "The GPT disk or one of its partitions has no unique stable identifier. Guided coexistence cannot safely authorize preservation or writes on this disk."
msgstr "GPT-disken eller en af dens partitioner har ingen unik stabil identifikator. Styret samexistens kan ikke sikkert autorisere bevarelse eller skrivning på denne disk."

#: src/pages.py:83
msgid "This disk contains an active mapper, array or other nested block-device topology that guided coexistence does not support."
msgstr "Denne disk indeholder en aktiv mapper, array eller anden nested block-device topologi, som styret samexistens ikke understøtter."

#: src/pages.py:87
msgid "A partition on this disk is mounted. Unmount it and rescan storage before continuing."
msgstr "En partition på denne disk er monteret. Afmonter den og genundersøg lageret, før du fortsætter."

#: src/pages.py:91
msgid "AnduinOS will use only the selected unallocated space. The installer will not shrink or move an existing filesystem."
msgstr "AnduinOS vil kun bruge det valgte ubenævnte plads. Installatøren vil ikke reducere eller flytte et eksisterende filsystem."

#: src/pages.py:95
msgid "Existing Windows, recovery and data partitions remain outside the write set and will be preserved."
msgstr "Eksisterende Windows-, genoprettelses- og datapartitioner forbliver uden for skrive-sættet og vil blive bevaret."

#: src/pages.py:99
msgid "The existing EFI System Partition is only a candidate. Health and free-space checks must pass before it can be reused, and it will never be formatted."
msgstr "Den eksisterende EFI System Partition er kun en kandidat. Sundheds- og fri-plads tjek skal bestå, før den kan genbruges, og den vil aldrig blive formateret."

#: src/pages.py:104
msgid "BitLocker storage will be preserved. The installer will not unlock, resize, repair or otherwise modify it."
msgstr "BitLocker-lager vil blive bevaret. Installatøren vil ikke låse op, ændre størrelse, reparere eller på anden måde modificere det."

#: src/pages.py:108
msgid "The installer will not mount, repair or infer the safety of Windows volumes from hibernation or Fast Startup state. Any required Windows maintenance must be completed in Windows."
msgstr "Installatøren vil ikke montere, reparere eller udlede sikkerheden af Windows-volumener fra dvaletilstand eller Hurtig opstart-tilstand. Eventuel nødvendig Windows vedligeholdelse skal udføres i Windows."

#: src/pages.py:113
msgid "Alternatively, you may explicitly select one entire partition to erase. Everything in that selected partition will be destroyed; it is never selected automatically."
msgstr "Alternativt kan du udtrykkeligt vælge en hel partition til sletning. Alt i den valgte partition vil blive ødelagt; den vælges aldrig automatisk."

#: src/pages.py:118
msgid "Installation cannot continue with this selection. There is no force-continue option around storage safety checks."
msgstr "Installationen kan ikke fortsætte med dette valg. Der er ingen tving-fortsat mulighed omgående sikkerhedstjek for lager."

#: src/pages.py:122
msgid "After changing partitions or unmounting a volume, rescan storage and select the target again."
msgstr "Efter ændring af partitioner eller afmontering af et volumen, skal du genundersøge lageret og vælge målet igen."

#: src/pages.py:128
msgid "No suitable unallocated space was found. To protect your data, create unallocated space with Windows Disk Management, then boot the installer again and rescan the disk."
msgstr "Ingen egnet ubenævnt plads blev fundet. For at beskytte dine data, opret ubenævnt plads med Windows Diskhåndtering, boot derefter installatøren igen og genundersøg disken."

#: src/pages.py:133
msgid "No suitable unallocated space was found. To protect your data, create unallocated space with a partitioning tool, then boot the installer again and rescan the disk."
msgstr "Ingen egnet ubenævnt plads blev fundet. For at beskytte dine data, opret ubenævnt plads med et partitioneringsværktøj, boot derefter installatøren igen og genundersøg disken."

