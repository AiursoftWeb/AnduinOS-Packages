msgstr "Konfigurer konto, region, tidszone og maskinidentitet"

msgid "Configure storage and swap"
msgstr "Konfigurer lager og swap"

msgid "Confirm Password"
msgstr "Bekræft adgangskode"

msgid "Confirm your keyboard layout"
msgstr "Bekræft dit tastaturlayout"

