msgstr "تم اكتشاف ويندوز"

#: src/pages.py:730
msgid "BitLocker detected"
msgstr "تم اكتشاف BitLocker"

#: src/pages.py:732
msgid "Live USB — excluded"
msgstr "USB حي — مستبعد"

#: src/pages.py:734
msgid "Too small"
msgstr "صغير جداً"

#: src/pages.py:751 src/pages.py:757
msgid "Select Installation Disk"
msgstr "اختيار قرص التثبيت"

#: src/pages.py:793
msgid "Rescan Storage"
msgstr "إعادة مسح التخزين"

#: src/pages.py:863
msgid "No suitable disks found."
msgstr "لم يتم العثور على أقراص مناسبة."

#: src/pages.py:917
msgid "Choose Installation Method"
msgstr "اختر طريقة التثبيت"

#: src/pages.py:922
msgid "How should AnduinOS use this disk?"
msgstr "كيف يجب أن تستخدم AnduinOS هذا القرص؟"

#: src/pages.py:937 src/pages.py:1191 src/pages.py:1425
#, python-brace-format
msgid "Target: {disk} ({size} — {model})"
msgstr "الهدف: {disk} ({size} — {model})"

#: src/pages.py:1014
msgid "Erase every partition and all data on the selected disk."
msgstr "محوا كل الأقسام وجميع البيانات على القرص المحدد."

#: src/pages.py:1018
msgid "Btrfs — recommended"
msgstr "Btrfs — موصى به"

#: src/pages.py:1022
msgid "Enables shared-space subvolumes, snapshots and Timeback Machine."
msgstr "تفعيل مجلدات فرعية مشتركة في مساحة واحدة، ولقطات فورية، وآلة Timeback."

#: src/pages.py:1030
msgid "ext4 — classic"
msgstr "ext4 — كلاسيكي"

#: src/pages.py:1033
msgid "Uses a traditional single root filesystem."
msgstr "يستخدم نظام ملفات جذر واحد تقليدي."

#: src/pages.py:1039
msgid "Advanced — keep existing systems"
msgstr "متقدم — الاحتفاظ بالنظم الموجودة"

#: src/pages.py:1041
msgid "Use already-unallocated space and preserve existing partitions. This is the only Windows coexistence path."
msgstr "استخدم المساحة غير المخصصة بالفعل واحفظ التقسيمات الموجودة. هذا هو المسار الوحيد للتعايش مع نظام ويندوز."

#: src/pages.py:1089
msgid "Advanced coexistence can affect EFI firmware state and may trigger BitLocker recovery. It never shrinks or repairs Windows volumes."
msgstr "يمكن للتعايش المتقدم أن يؤثر على حالة برنامج التمهيد الثابت EFI وقد يؤدي إلى تفعيل استرداد BitLocker. إنه لا يقوم أبدًا بتصغير أو إصلاح وحدات تخزين Windows."

#: src/pages.py:1099
#, python-brace-format
msgid "ALL DATA on {disk} will be permanently erased."
msgstr "سيتم مسح جميع البيانات على {disk} بشكل دائم."

#: src/pages.py:1135
msgid "This disk is too small for whole-disk installation. Advanced may continue only if suitable unallocated space exists."
msgstr "هذا القرص صغير جداً لتركيب النظام بالكامل. يمكن للمطورين المتقدمين المتابعة فقط إذا كان هناك مساحة غير مخصصة مناسبة."

#: src/pages.py:1145
msgid "Existing partitions were detected. The first two choices delete them; Advanced is the preservation path."
msgstr "تم اكتشاف أقسام موجودة. الخياريان الأولان يحذفانها؛ بينما الخيار المتقدم هو المسار الذي يحافظ عليها."

#: src/pages.py:1178
msgid "Advanced Storage"
msgstr "التخزين المتقدم"

#: src/pages.py:1183
msgid "Advanced: Install Alongside"
msgstr "متقدم: التثبيت بالتوازي"

#: src/pages.py:1212
msgid "Before continuing: finish Windows updates, disable Fast Startup and hibernation, and back up the BitLocker recovery key. EFI, Secure Boot, TPM measurements and boot order can change."
msgstr "قبل المتابعة: أكمل تحديثات Windows، وعطل بدء التشغيل السريع والوضع المعلق، وقم بنسخ مفتاح استرداد BitLocker احتياطيًا. قد تتغير إعدادات EFI، والتمهيد الآمن، وقياسات TPM، وترتيب التمهيد."

#: src/pages.py:1219
msgid "This advanced path preserves existing partitions but changes the selected disk's partition table and the machine's EFI boot state."
msgstr "يحافظ هذا المسار المتقدم على التقسيمات الحالية لكنه يغير جدول تقسيمات القرص المحدد وحالة تشغيل EFI للجهاز."

#: src/pages.py:1250 src/pages.py:2113
msgid "Filesystem"
msgstr "نظام الملفات"

#: src/pages.py:1253
msgid "Btrfs (recommended)"
msgstr "Btrfs (موصى به)"

#: src/pages.py:1253
msgid "ext4 (classic)"
msgstr "ext4 (كلاسيكي)"

#: src/pages.py:1263
msgid "Unallocated space"
msgstr "مساحة غير مخصصة"

#: src/pages.py:1271
msgid "EFI System Partition"
msgstr "قسم نظام EFI"

#: src/pages.py:1285
msgid "Rescan and Reselect Disk"
msgstr "إعادة المسح وإعادة اختيار القرص"

#: src/pages.py:1326
msgid "Create a new 1 GiB AnduinOS EFI System Partition"
msgstr "إنشاء قسم نظام EFI جديد بحجم 1 GiB لنظام AnduinOS"

#: src/pages.py:1330
#, python-brace-format
msgid "Reuse {path} ({size})"
msgstr "إعادة استخدام {path} ({size})"

#: src/pages.py:1394
#, python-brace-format
msgid "The selected disk changed or disappeared. Return to the disk page and select it again. {error}"
msgstr "تغير القرص المحدد أو اختفى. عد إلى صفحة الأقراص وحدده مرة أخرى. {error}"

#: src/pages.py:1407
msgid "The selected disk size changed. Return and select it again."
msgstr "تغير حجم القرص المحدد. عد واختره مرة أخرى."

#: src/pages.py:1417
msgid "The selected disk topology changed. Review the disk and installation method again."
msgstr "تغير هيكلية القرص المحددة. راجع القرص وطريقة التثبيت مرة أخرى."

#: src/pages.py:1453
#, python-brace-format
msgid "{size} unallocated at {offset}"
msgstr "{size} غير مخصص عند الإزاحة {offset}"

#: src/pages.py:1579 src/pages.py:1585
msgid "User Account"
msgstr "حساب المستخدم"

#: src/pages.py:1605 src/pages.py:1606
msgid "Full Name"
msgstr "الاسم الكامل"

#: src/pages.py:1609 src/pages.py:1612
msgid "Username"
msgstr "اسم المستخدم"

#: src/pages.py:1616 src/pages.py:1627
msgid "Password"
msgstr "كلمة المرور"

#: src/pages.py:1620 src/pages.py:1628
msgid "Confirm Password"
msgstr "تأكيد كلمة المرور"

#: src/pages.py:1632
msgid "Do not require a password for sudo commands"
msgstr "لا تتطلب كلمة مرور لأوامر sudo"

#: src/pages.py:1638 src/pages.py:1643 src/pages.py:2157
msgid "Computer Name"
msgstr "اسم الحاسوب"

#: src/pages.py:1669
msgid "Username must start with a lowercase ASCII letter and contain only lowercase ASCII letters or digits (maximum 16 characters)."
msgstr "Username must start with a lowercase ASCII letter and contain only lowercase ASCII letters or digits (maximum 16 characters)."

#: src/pages.py:1680
msgid "Install alongside requires a password-protected account."
msgstr "يتطلب التثبيت بجانب نظام تشغيل آخر حسابًا محميًا بكلمة مرور."

#: src/pages.py:1691
msgid "The two passwords do not match."
msgstr "كلمتا المرور غير متطابقتين."

#: src/pages.py:1695
msgid "Password must be at least 6 characters."
msgstr "يجب أن تتكون كلمة المرور من 6 أحرف على الأقل."

#: src/pages.py:1703
msgid "Computer name contains invalid characters."
msgstr "يحتوي اسم الحاسوب على أحرف غير صالحة."

#: src/pages.py:1756
msgid "Return to Make Changes"
msgstr "العودة لإجراء تغييرات"

#: src/pages.py:1763
msgid "This configuration is very unsafe"
msgstr "هذه الإعدادات غير آمنة للغاية"

#: src/pages.py:1765
msgid "Passwordless sudo is unsafe"
msgstr "استخدام sudo بدون كلمة مرور غير آمن"

#: src/pages.py:1769
msgid "The system will sign in to this account automatically and allow it to obtain full administrator privileges without a password. Anyone with physical access, and any program running as this user, can completely control the system. Use this only for a kiosk, temporary virtual machine, or another controlled environment."
msgstr "سيتصل النظام تلقائيًا بهذه الحساب ويسمح له بالحصول على امتيازات مسؤول كاملة دون كلمة مرور. يمكن لأي شخص لديه وصول مادي، وأي برنامج يعمل باسم هذا المستخدم، التحكم الكامل في النظام. استخدم هذا فقط لـ kiosk أو آلة افتراضية مؤقتة أو بيئة أخرى خاضعة للرقابة."

#: src/pages.py:1778
msgid "Any program running as your user can obtain full administrator privileges without authentication. Your login password still protects sign-in, but it will not protect sudo. Are you sure you want to continue?"
msgstr "يمكن لأي برنامج يعمل باسم مستخدمك الحصول على امتيازات مسؤول كاملة دون مصادقة. لا تزال كلمة مرور تسجيل الدخول تحمي عملية تسجيل الدخول، لكنها لن تحمي sudo. هل أنت متأكد من أنك تريد المتابعة؟"

#: src/pages.py:1792
msgid "Return and Set a Password"
msgstr "العودة وإعداد كلمة مرور"

#: src/pages.py:1798
msgid "I Understand the Risk, Continue"
msgstr "أفهم المخاطر، المتابعة"

#: src/pages.py:1822
msgid "Administrator access would be locked"
msgstr "سيتم قفل وصول المسؤول"

#: src/pages.py:1824
msgid "This account has no login password, but sudo would still require one. Because the root account is locked by default, you would be unable to perform administrator tasks. Set an account password or enable passwordless sudo."
msgstr "لا يحتوي هذا الحساب على كلمة مرور تسجيل الدخول، لكن الأمر sudo سيظل يتطلب واحدة. نظرًا لأن حساب root مقفول افتراضيًا، لن تتمكن من تنفيذ مهام المسؤول. قم بتعيين كلمة مرور للحساب أو فعّل sudo بدون كلمة مرور."

#: src/pages.py:1895 src/pages.py:1901
msgid "Select Timezone"
msgstr "اختيار المنطقة الزمنية"

#: src/pages.py:1914
msgid "Search timezones…"
msgstr "البحث عن المناطق الزمنية…"

#: src/pages.py:1967
msgid "Selected timezone"
msgstr "المنطقة الزمنية المحددة"

#: src/pages.py:2035 src/pages.py:2041
msgid "Ready to Install"
msgstr "جاهز للتثبيت"

#: src/pages.py:2056
msgid "DEVELOPMENT MODE — the plan will be validated and simulated. No privileged executor or disk command can run."
msgstr "وضع التطوير — سيتم التحقق من صحة الخطة ومحاكاتها. لا يمكن تشغيل أي منفذ ذي امتياز أو أمر القرص."

#: src/pages.py:2081
