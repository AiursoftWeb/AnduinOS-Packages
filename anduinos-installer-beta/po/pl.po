msgid ""
"Installation cannot continue with this selection. There is no force-continue "
"option around storage safety checks."
msgstr ""
"Instalacji nie można kontynuować z tym wyborem. Nie ma opcji wymuszenia "
"kontynuacji omijającej kontrole bezpieczeństwa pamięci masowej."

msgid "Installation complete"
msgstr "Instalacja zakończona"

msgid "Installation failed"
msgstr "Nieudana instalacja"

