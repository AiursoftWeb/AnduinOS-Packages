msgstr "Planuj rejestrację MOK"

msgid "Search timezones…"
msgstr "Szukaj stref czasowych…"

msgid "Secure Boot enrollment"
msgstr "Rejestracja Secure Boot"

msgid "Select Installation Disk"
msgstr "Wybierz dysk instalacyjny"

msgid "Select Timezone"
msgstr "Wybierz strefę czasową"

msgid "Select fastest package mirror"
msgstr "Wybierz najszybszy lustrzany serwer pakietów"

