#: src/pages.py:1271
msgid "EFI System Partition"
msgstr "Partycja systemu EFI"

#: src/pages.py:1285
msgid "Rescan and Reselect Disk"
msgstr "Przeskanuj i wybierz dysk ponownie"

#: src/pages.py:1326
msgid "Create a new 1 GiB AnduinOS EFI System Partition"
msgstr "Utwórz nową partycję EFI systemu AnduinOS o rozmiarze 1 GiB"

#: src/pages.py:1330
#, python-brace-format
msgid "Reuse {path} ({size})"
msgstr "Ponownie użyj {path} ({size})"

#: src/pages.py:1394
#, python-brace-format
msgid "The selected disk changed or disappeared. Return to the disk page and select it again. {error}"
msgstr "Wybrany dysk uległ zmianie lub zniknął. Wróć do strony dysku i wybierz go ponownie. {error}"

#: src/pages.py:1407
msgid "The selected disk size changed. Return and select it again."
msgstr "Rozmiar wybranego dysku uległ zmianie. Wróć i wybierz go ponownie."

#: src/pages.py:1417
msgid "The selected disk topology changed. Review the disk and installation method again."
msgstr "Topologia wybranego dysku uległa zmianie. Przeglądaj dysk i metodę instalacji ponownie."

#: src/pages.py:1453
#, python-brace-format
msgid "{size} unallocated at {offset}"
msgstr "{size} nieprzydzielone przy {offset}"

#: src/pages.py:1579 src/pages.py:1585
msgid "User Account"
msgstr "Konto użytkownika"

#: src/pages.py:1605 src/pages.py:1606
msgid "Full Name"
msgstr "Pełne imię i nazwisko"

#: src/pages.py:1609 src/pages.py:1612
msgid "Username"
msgstr "Nazwa użytkownika"

#: src/pages.py:1616 src/pages.py:1627
msgid "Password"
msgstr "Hasło"

#: src/pages.py:1620 src/pages.py:1628
msgid "Confirm Password"
msgstr "Potwierdź hasło"

#: src/pages.py:1632
msgid "Do not require a password for sudo commands"
msgstr "Nie wymagaj hasła dla poleceń sudo"

#: src/pages.py:1638 src/pages.py:1643 src/pages.py:2157
msgid "Computer Name"
msgstr "Nazwa komputera"

#: src/pages.py:1669
msgid "Username may only contain lowercase letters, digits, underscores and hyphens."
msgstr "Nazwa użytkownika może zawierać tylko małe litery, cyfry, znaki podkreślenia i myślniki."

#: src/pages.py:1680
msgid "Install alongside requires a password-protected account."
msgstr "Instalacja obok istniejącego systemu wymaga konta chronionego hasłem."

#: src/pages.py:1691
msgid "The two passwords do not match."
msgstr "Oba hasła nie są zgodne."

#: src/pages.py:1695
msgid "Password must be at least 6 characters."
msgstr "Hasło musi mieć co najmniej 6 znaków."

#: src/pages.py:1703
msgid "Computer name contains invalid characters."
msgstr "Nazwa komputera zawiera niedozwolone znaki."

#: src/pages.py:1756
msgid "Return to Make Changes"
msgstr "Wróć, aby wprowadzić zmiany"

#: src/pages.py:1763
msgid "This configuration is very unsafe"
msgstr "Ta konfiguracja jest bardzo niebezpieczna"

#: src/pages.py:1765
msgid "Passwordless sudo is unsafe"
msgstr "Sudo bez hasła jest niebezpieczne"

#: src/pages.py:1769
msgid "The system will sign in to this account automatically and allow it to obtain full administrator privileges without a password. Anyone with physical access, and any program running as this user, can completely control the system. Use this only for a kiosk, temporary virtual machine, or another controlled environment."
msgstr "System automatycznie zaloguje się na to konto i pozwoli mu uzyskać pełne uprawnienia administratora bez hasła. Każdy posiadający fizyczny dostęp do komputera, a także każda aplikacja uruchomiona jako ten użytkownik, może w pełni kontrolować system. Używaj tego tylko dla kiosku, tymczasowej maszyny wirtualnej lub innego kontrolowanego środowiska."

#: src/pages.py:1778
msgid "Any program running as your user can obtain full administrator privileges without authentication. Your login password still protects sign-in, but it will not protect sudo. Are you sure you want to continue?"
msgstr "Każda aplikacja uruchomiona jako Twój użytkownik może uzyskać pełne uprawnienia administratora bez uwierzytelniania. Twoje hasło logowania nadal chroni proces logowania, ale nie będzie chronić poleceń sudo. Czy na pewno chcesz kontynuować?"

#: src/pages.py:1792
msgid "Return and Set a Password"
msgstr "Wróć i ustaw hasło"

#: src/pages.py:1798
msgid "I Understand the Risk, Continue"
msgstr "Rozumiem ryzyko, kontynuuj"

#: src/pages.py:1822
msgid "Administrator access would be locked"
msgstr "Dostęp administratora zostałby zablokowany"

#: src/pages.py:1824
msgid "This account has no login password, but sudo would still require one. Because the root account is locked by default, you would be unable to perform administrator tasks. Set an account password or enable passwordless sudo."
msgstr "To konto nie ma hasła logowania, ale sudo nadal będzie go wymagać. Ponieważ konto root jest domyślnie zablokowane, nie będziesz mógł wykonywać zadań administratora. Ustaw hasło konta lub włącz sudo bez hasła."

#: src/pages.py:1895 src/pages.py:1901
msgid "Select Timezone"
msgstr "Wybierz strefę czasową"

#: src/pages.py:1914
msgid "Search timezones…"
msgstr "Szukaj stref czasowych…"

#: src/pages.py:1967
