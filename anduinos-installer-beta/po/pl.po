#: src/pages.py:917
msgid "Choose Installation Method"
msgstr "Wybierz metodę instalacji"

#: src/pages.py:922
msgid "How should AnduinOS use this disk?"
msgstr "Jak AnduinOS powinien korzystać z tego dysku?"

#: src/pages.py:937 src/pages.py:1191 src/pages.py:1425
#, python-brace-format
msgid "Target: {disk} ({size} — {model})"
msgstr "Cel: {disk} ({size} — {model})"

#: src/pages.py:1014
msgid "Erase every partition and all data on the selected disk."
msgstr "Kasuje każdą partycję i wszystkie dane na wybranym dysku."

#: src/pages.py:1018
msgid "Btrfs — recommended"
msgstr "Btrfs — polecane"

#: src/pages.py:1022
msgid "Enables shared-space subvolumes, snapshots and Timeback Machine."
msgstr "Włącza podwoluminy w przestrzeni współdzielonej, migawki oraz Timeback Machine."

#: src/pages.py:1030
msgid "ext4 — classic"
msgstr "ext4 — klasyczny"

#: src/pages.py:1033
msgid "Uses a traditional single root filesystem."
msgstr "Korzysta z tradycyjnego pojedynczego systemu plików korzeniowych."

#: src/pages.py:1039
msgid "Advanced — keep existing systems"
msgstr "Zaawansowane — zachowanie istniejących systemów"

#: src/pages.py:1041
msgid "Use already-unallocated space and preserve existing partitions. This is the only Windows coexistence path."
msgstr "Użyj już niezarezerwowanej przestrzeni i zachowaj istniejące partycje. Jest to jedyna ścieżka współistnienia z systemem Windows."

#: src/pages.py:1089
msgid "Advanced coexistence can affect EFI firmware state and may trigger BitLocker recovery. It never shrinks or repairs Windows volumes."
msgstr "Zaawansowana współistnienie może wpłynąć na stan firmwaru EFI i spowodować uruchomienie odzyskiwania BitLocker. Nigdy nie zmniejsza ani nie naprawia woluminów Windows."

#: src/pages.py:1099
#, python-brace-format
msgid "ALL DATA on {disk} will be permanently erased."
msgstr "WSZYSTKIE DANE na dysku {disk} zostaną trwale usunięte."

#: src/pages.py:1135
msgid "This disk is too small for whole-disk installation. Advanced may continue only if suitable unallocated space exists."
msgstr "Ten dysk jest zbyt mały do instalacji na całym dysku. Zaawansowani mogą kontynuować tylko wtedy, gdy istnieje odpowiednia niezarezerwowana przestrzeń."

#: src/pages.py:1145
msgid "Existing partitions were detected. The first two choices delete them; Advanced is the preservation path."
msgstr "Wykryto istniejące partycje. Dwie pierwsze opcje je usuwają; zaawansowana to ścieżka zachowania."

#: src/pages.py:1178
msgid "Advanced Storage"
msgstr "Zaawansowane ustawienia pamięci masowej"

#: src/pages.py:1183
msgid "Advanced: Install Alongside"
msgstr "Zaawansowane: Instalacja obok innego systemu"

#: src/pages.py:1212
msgid "Before continuing: finish Windows updates, disable Fast Startup and hibernation, and back up the BitLocker recovery key. EFI, Secure Boot, TPM measurements and boot order can change."
msgstr "Zanim kontynuujesz: ukończ aktualizacje systemu Windows, wyłącz szybki start i hibernację oraz wykonaj kopię zapasową klucza odzyskiwania BitLocker. Ustawienia EFI, Secure Boot, pomiary TPM i kolejność rozruchu mogą się zmienić."

#: src/pages.py:1219
msgid "This advanced path preserves existing partitions but changes the selected disk's partition table and the machine's EFI boot state."
msgstr "Ta zaawansowana ścieżka zachowuje istniejące partycje, ale zmienia tabelę partycji wybranego dysku i stan rozruchu EFI komputera."

#: src/pages.py:1250 src/pages.py:2113
msgid "Filesystem"
msgstr "System plików"

#: src/pages.py:1253
msgid "Btrfs (recommended)"
msgstr "Btrfs (zalecane)"

#: src/pages.py:1253
msgid "ext4 (classic)"
msgstr "ext4 (klasyczny)"

#: src/pages.py:1263
msgid "Unallocated space"
