msgid "Install Alongside"
msgstr "ติดตั้งพร้อมกัน"

#: src/pages.py:4169
msgid "Install alongside"
msgstr "ติดตั้งพร้อมกัน"

#: src/pages.py:4608
msgid "Install bootloader"
msgstr "ติดตั้ง bootloader"

#: src/pages.py:4611
msgid "Check systems on other disks"
msgstr "ตรวจสอบระบบในดิสก์อื่น"

