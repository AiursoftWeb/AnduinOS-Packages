msgstr "Detetar firmware e Secure Boot"

msgid ""
"Development mode will simulate installation to {disk}. No disk data will be "
"changed.\n"
"\n"
msgstr ""
"O modo de desenvolvimento simulará a instalação em {disk}. Nenhum dado do "
"disco será alterado.\n"
"\n"

msgid "Development simulation completed"
msgstr "Simulação de desenvolvimento concluída"

msgid "Discover AnduinOS"
msgstr "Descubra o AnduinOS"

msgid "Do not require a password for sudo commands"
msgstr "Não exigir palavra-passe para comandos sudo"

msgid "Download and install system updates during installation"
msgstr ""
"Efetuar download e instalar atualizações do sistema durante a instalação"

