msgid "External power is connected."
msgstr "A alimentação externa está ligada."

#: src/pages.py:1008
msgid "External power is not connected."
msgstr "A alimentação externa não está ligada."

#: src/pages.py:954
msgid "I understand the risks and insist on installing with low battery."
msgstr "Compreendo os riscos e insisto em instalar com a bateria fraca."

