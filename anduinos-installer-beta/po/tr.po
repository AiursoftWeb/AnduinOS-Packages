#, python-brace-format
msgid "Target: {disk} ({size} — {model})"
msgstr "Hedef: {disk} ({size} — {model})"

#: src/pages.py:1014
msgid "Erase every partition and all data on the selected disk."
msgstr "Seçili diskteki her bölümü ve tüm verileri siler."

#: src/pages.py:1018
msgid "Btrfs — recommended"
msgstr "Btrfs — önerilen"

#: src/pages.py:1022
msgid "Enables shared-space subvolumes, snapshots and Timeback Machine."
msgstr "Ortak alan alt hacimlerini, anlık görüntüleri ve Timeback Machine'i etkinleştirir."

#: src/pages.py:1030
msgid "ext4 — classic"
msgstr "ext4 — klasik"

#: src/pages.py:1033
msgid "Uses a traditional single root filesystem."
msgstr "Geleneksel tek kök dosya sistemini kullanır."

#: src/pages.py:1039
msgid "Advanced — keep existing systems"
msgstr "Gelişmiş — mevcut sistemleri koru"

#: src/pages.py:1041
msgid "Use already-unallocated space and preserve existing partitions. This is the only Windows coexistence path."
msgstr "Zaten ayrılmamış alanı kullanın ve mevcut bölümleri koruyun. Bu, Windows ile birlikte çalışmanın tek yoludur."

#: src/pages.py:1089
msgid "Advanced coexistence can affect EFI firmware state and may trigger BitLocker recovery. It never shrinks or repairs Windows volumes."
msgstr "Gelişmiş birlikte yaşam, EFI firmware durumunu etkileyebilir ve BitLocker kurtarmasını tetikleyebilir. Asla Windows birimlerini küçültmez veya onarmaz."

#: src/pages.py:1099
#, python-brace-format
msgid "ALL DATA on {disk} will be permanently erased."
msgstr "{disk} üzerindeki TÜM VERİLER kalıcı olarak silinecektir."

#: src/pages.py:1135
msgid "This disk is too small for whole-disk installation. Advanced may continue only if suitable unallocated space exists."
msgstr "Bu disk, tüm disk kurulumu için çok küçük. Gelişmiş seçenek yalnızca uygun ayrılmamış alan varsa devam edebilir."

#: src/pages.py:1145
msgid "Existing partitions were detected. The first two choices delete them; Advanced is the preservation path."
msgstr "Mevcut bölümler algılandı. İlk iki seçenek bunları siler; Gelişmiş koruma yoludur."

#: src/pages.py:1178
msgid "Advanced Storage"
msgstr "Gelişmiş Depolama"

#: src/pages.py:1183
msgid "Advanced: Install Alongside"
msgstr "Gelişmiş: Yan Yana Kurulum"

#: src/pages.py:1212
msgid "Before continuing: finish Windows updates, disable Fast Startup and hibernation, and back up the BitLocker recovery key. EFI, Secure Boot, TPM measurements and boot order can change."
msgstr "Devam etmeden önce: Windows güncellemelerini tamamlayın, Hızlı Başlatmayı ve uyku modunu devre dışı bırakın ve BitLocker kurtarma anahtarını yedekleyin. EFI, Güvenli Önyükleme, TPM ölçümleri ve önyükleme sırası değişebilir."

#: src/pages.py:1219
msgid "This advanced path preserves existing partitions but changes the selected disk's partition table and the machine's EFI boot state."
msgstr "Bu gelişmiş yol, mevcut bölümleri korur ancak seçili diskin bölüm tablosunu ve makinenin EFI önyüklenme durumunu değiştirir."

