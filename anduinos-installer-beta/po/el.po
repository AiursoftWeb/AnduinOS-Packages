#: src/pages.py:581
msgid "Some drivers are proprietary or otherwise non-free software."
msgstr "Ορισμένοι οδηγοί είναι ιδιόκτητο ή αλλιώς μη ελεύθερο λογισμικό."

#: src/pages.py:641
msgid "Storage Device"
msgstr "Συσκευή αποθήκευσης"

#: src/pages.py:650
msgid "No partition table"
