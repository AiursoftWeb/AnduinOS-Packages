msgstr "Νέο"

#: src/pages.py:5156
msgid "No new partitions yet. Add an ESP if needed, one Root partition, and optionally Swap."
msgstr "Δεν υπάρχουν ακόμη νέα διαμερίσματα. Προσθέστε ESP αν χρειάζεται, ένα διαμέρισμα Root και προαιρετικά Swap."

#: src/pages.py:5170
#, python-brace-format
msgid "{size} at {start} MiB"
msgstr "{size} στο {start} MiB"

#: src/pages.py:5205
msgid "an ESP of at least 512 MiB"
msgstr "ένα ESP τουλάχιστον 512 MiB"

#: src/pages.py:5207
msgid "a Root partition of at least 20 GiB"
msgstr "ένα διαμέρισμα Root τουλάχιστον 20 GiB"

#: src/pages.py:5209
#, python-brace-format
msgid "Complete the plan: {requirements}."
msgstr "Ολοκληρώστε το σχέδιο: {requirements}."

#: src/pages.py:5222
msgid "Layout is valid. Only the listed resizes, deletes, creates and formats will be sent to the privileged executor."
msgstr "Η διάταξη είναι έγκυρη. Μόνο οι αναφερόμενες αλλαγές μεγέθους, διαγραφές, δημιουργίες και μορφοποιήσεις θα σταλούν στη διεργασία υπηρεσίας με αυξημένα δικαιώματα."

#: src/pages.py:5262
msgid "That partition role already exists."
msgstr "Ο ρόλος αυτού του τμήματος υπάρχει ήδη."

#: src/pages.py:5302
msgid "Initialize a new GPT?"
msgstr "Επανεκκίνηση ενός νέου GPT;"

#: src/pages.py:5304
msgid "Every existing partition and all data on this disk will be deleted. You must then create a new ESP and Root partition."
msgstr "Κάθε υπάρχον διαμέρισμα και όλα τα δεδομένα σε αυτόν τον δίσκο θα διαγραφούν. Πρέπει στη συνέχεια να δημιουργήσετε ένα νέο διαμέρισμα ESP και ένα διαμέρισμα Root."

#: src/pages.py:5310
msgid "Initialize GPT"
msgstr "Επανεκκίνηση GPT"

#: src/pages.py:5346
msgid "The selected disk changed or disappeared."
msgstr "Ο επιλεγμένος δίσκος άλλαξε ή χάθηκε."

#: src/pages.py:5351
msgid "The selected disk topology changed. Select it again."
msgstr "Η τοπολογία του επιλεγμένου δίσκου άλλαξε. Επιλέξτε τον ξανά."

#: src/pages.py:6292 src/pages.py:6293 src/pages.py:6302
msgid "none"
msgstr "κανένα"

#: src/pages.py:6295
#, python-brace-format
msgid "{path}: {before} → {after} (free {reclaimed})"
msgstr "{path}: {before} → {after} (χώρος που θα ελευθερωθεί: {reclaimed})"

#: src/pages.py:6304
#, python-brace-format
msgid "{name}: {size} MiB ({start}–{end})"
msgstr "{name}: {size} MiB ({start}–{end})"

#: src/pages.py:6320
msgid "Initialize a new empty GPT"
msgstr "Επανεκκίνηση νέου κενού GPT"

#: src/pages.py:6322
msgid "Keep the current GPT"
msgstr "Κράτα το τρέχον GPT"

#: src/pages.py:6326
#, python-brace-format
msgid "Reuse {path}; inspect it and never format it."
msgstr "Επαναχρησιμοποίηση {path}; ελέγξτε το και μην το μορφοποιείτε ποτέ."

#: src/pages.py:6330
msgid "Create and format a new EFI System Partition."
msgstr "Δημιουργία και μορφοποίηση νέου Διαμερίσματος Συστήματος EFI."

#: src/pages.py:6334
msgid "Advanced manual GPT"
msgstr "Για προχωρημένους: χειροκίνητη GPT"

#: src/pages.py:6335
msgid "Partition table"
msgstr "Πίνακας διαμερισμάτων"

#: src/pages.py:6337
msgid "Deleted partitions"
msgstr "Διαγραμμένοι διαμερίσματα"

#: src/pages.py:6338
msgid "Resized partitions"
msgstr "Διαμερίσματα με αλλαγή μεγέθους"

#: src/pages.py:6344
msgid "Write only EFI/AnduinOS, preserve EFI/BOOT, and create a verified AnduinOS NVRAM entry."
msgstr "Γράψτε μόνο EFI/AnduinOS, διατηρήστε το EFI/BOOT και δημιουργήστε μια επαληθευμένη εγγραφή NVRAM για το AnduinOS."

#: src/pages.py:6402
msgid "Manual storage selection is missing. Return and review it."
msgstr "Λείπει η χειροκίνητη επιλογή αποθήκευσης. Επιστρέψτε και αναθεωρήστε την."

#: src/pages.py:6496
msgid "⚠ Listed NTFS resizes will move filesystem data and partition boundaries. Listed partitions will be deleted and every listed new partition will be formatted. Back up important data first; these partitioning operations cannot be undone."
msgstr "⚠ Οι αναφερόμενες αλλαγές μεγέθους NTFS θα μετακινήσουν δεδομένα του συστήματος αρχείων και τα όρια των διαμερισμάτων. Τα αναφερόμενα διαμερίσματα θα διαγραφούν και κάθε αναφερόμενο νέο διαμέρισμα θα μορφοποιηθεί. Δημιουργήστε πρώτα αντίγραφα ασφαλείας των σημαντικών δεδομένων· αυτές οι εργασίες διαμέρισης δεν μπορούν να αναιρεθούν."

#: src/pages.py:6606
msgid "Apply this manual disk layout?"
msgstr "Εφαρμογή αυτής της χειροκίνητης διάταξης δίσκου;"

#: src/pages.py:6607 src/pages.py:6735
msgid "Apply Layout and Install"
msgstr "Εφαρμογή διάταξης και εγκατάσταση"

#: src/pages.py:6630
#, python-brace-format
msgid ""
"AnduinOS will apply only the reviewed manual changes to {disk}.\n"
"\n"
msgstr ""
"Το AnduinOS θα εφαρμόσει μόνο τις ελεγμένες χειροκίνητες αλλαγές στον {disk}.\n"
"\n"

#: src/pages.py:6658
msgid "Only the explicitly listed partitions will be deleted or formatted. Uninvolved partitions remain unchanged; EFI/BOOT is not overwritten."
msgstr "Μόνο τα ρητά καταγεγραμμένα διαμερίσματα θα διαγραφούν ή θα μορφοποιηθούν. Τα διαμερίσματα που δεν εμπλέκονται παραμένουν αμετάβλητα· το EFI/BOOT δεν επαναγράφεται."

#: src/pages.py:4072
msgid "Edit one GPT disk. Partition starts are never moved; plain NTFS may be shrunk after safety checks."
msgstr "Επεξεργασία ενός δίσκου GPT. Οι αρχές των διαμερισμάτων δεν μετακινούνται ποτέ· ένας απλός τόμος NTFS μπορεί να συρρικνωθεί μετά από ελέγχους ασφαλείας."

#: src/pages.py:5119
msgid "XFS (classic, scalable)"
msgstr "XFS (κλασικό, κλιμακούμενο)"

#: src/pages.py:5120
msgid "F2FS (flash-optimized)"
msgstr "F2FS (βελτιστοποιημένο για flash)"

#: src/pages.py:3004
msgid "0 GiB · ZRAM only"
msgstr "0 GiB · Μόνο ZRAM"

#: src/pages.py:2900
msgid "Disk Swap will not be created. ZRAM remains enabled, but sustained memory pressure can terminate applications and hibernation is unavailable. This is strongly discouraged."
msgstr "Δεν θα δημιουργηθεί χώρος Swap στον δίσκο. Το ZRAM παραμένει ενεργοποιημένο, αλλά η παρατεταμένη πίεση μνήμης μπορεί να οδηγήσει σε αναγκαστικό τερματισμό εφαρμογών και η αδρανοποίηση δεν θα είναι διαθέσιμη. Αυτή η ρύθμιση δεν συνιστάται σε καμία περίπτωση."

#: src/pages.py:6702
msgid "Review your custom Swap size"
msgstr "Ελέγξτε το προσαρμοσμένο μέγεθος Swap"

#: src/pages.py:2927
msgid "This exceeds the AnduinOS recommendation. It consumes more disk space and normally does not improve runtime performance."
msgstr "Αυτό το μέγεθος υπερβαίνει τη συνιστώμενη τιμή του AnduinOS. Καταλαμβάνει περισσότερο χώρο στον δίσκο και συνήθως δεν βελτιώνει την απόδοση κατά τη συνήθη χρήση."

#: src/pages.py:2913
msgid "This is below AnduinOS's runtime safety target. ZRAM still works, but heavy browser or application workloads can run out of backing memory sooner; hibernation is also unavailable."
msgstr "Αυτό το μέγεθος είναι κάτω από το ασφαλές ελάχιστο που συνιστά το AnduinOS για κανονική χρήση. Το ZRAM εξακολουθεί να λειτουργεί, αλλά η έντονη χρήση του προγράμματος περιήγησης ή των εφαρμογών μπορεί να εξαντλήσει νωρίτερα τον διαθέσιμο χώρο Swap· επίσης, η αδρανοποίηση δεν είναι διαθέσιμη."

#: src/pages.py:2920
msgid "This size protects ordinary memory pressure, but is smaller than the hibernation target. Hibernation may fail or be unavailable."
msgstr "Αυτό το μέγεθος επαρκεί για την αντιμετώπιση της συνήθους πίεσης μνήμης, αλλά είναι μικρότερο από το μέγεθος που απαιτείται για την αδρανοποίηση. Η αδρανοποίηση ενδέχεται να αποτύχει ή να μην είναι διαθέσιμη."

#: src/pages.py:3028
msgid "ZRAM always remains enabled: 50% of RAM · LZ4 · priority 100. Disk Swap uses priority 10."
msgstr "Το ZRAM παραμένει πάντα ενεργοποιημένο: 50% της RAM · LZ4 · προτεραιότητα 100. Ο χώρος εναλλαγής στον δίσκο χρησιμοποιεί προτεραιότητα 10."

#: src/pages.py:6705
msgid "ZRAM will remain enabled regardless of this choice."
msgstr "Το ZRAM παραμένει ενεργοποιημένο ανεξάρτητα από αυτήν την επιλογή."

#: src/pages.py:3008
msgid "{size} GiB · Max"
msgstr "{size} GiB · Μέγιστο"

#: src/pages.py:2895
msgid "✓ Best performance — AnduinOS recommended Swap size."
msgstr "✓ Καλύτερη απόδοση — Συνιστώμενο μέγεθος Swap από το AnduinOS."

