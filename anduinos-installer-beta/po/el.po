msgstr "Τρέχουσα διάταξη δίσκου"

#: src/pages.py:693
msgid "Unknown filesystem"
msgstr "Άγνωστο σύστημα αρχείων"

#: src/pages.py:706
#, python-brace-format
msgid "Unallocated · {size}"
msgstr "Μη κατανεμημένο · {size}"

#: src/pages.py:713
msgid "Partition details unavailable"
msgstr "Μη διαθέσιμες λεπτομέρειες διαμερίσματος"

#: src/pages.py:728
msgid "Windows detected"
msgstr "Ανιχνεύθηκαν τα Windows"

#: src/pages.py:730
msgid "BitLocker detected"
msgstr "Ανιχνεύθηκε BitLocker"

#: src/pages.py:732
msgid "Live USB — excluded"
msgstr "Ζωντανός USB — αποκλείεται"

#: src/pages.py:734
msgid "Too small"
msgstr "Πολύ μικρό"

#: src/pages.py:751 src/pages.py:757
msgid "Select Installation Disk"
msgstr "Επιλέξτε δίσκο εγκατάστασης"

#: src/pages.py:793
msgid "Rescan Storage"
msgstr "Επανασάρωση Αποθήκευσης"

#: src/pages.py:863
msgid "No suitable disks found."
msgstr "Δεν βρέθηκαν κατάλληλοι δίσκοι."

#: src/pages.py:917
msgid "Choose Installation Method"
msgstr "Επιλογή μεθόδου εγκατάστασης"

#: src/pages.py:922
msgid "How should AnduinOS use this disk?"
msgstr "Πώς θα χρησιμοποιήσει ο AnduinOS αυτόν τον δίσκο;"

#: src/pages.py:937 src/pages.py:1191 src/pages.py:1425
#, python-brace-format
msgid "Target: {disk} ({size} — {model})"
msgstr "Στόχος: {disk} ({size} — {model})"

#: src/pages.py:1014
msgid "Erase every partition and all data on the selected disk."
msgstr "Διαγραφή όλων των τομέων και όλων των δεδομένων στον επιλεγμένο δίσκο."

#: src/pages.py:1018
msgid "Btrfs — recommended"
msgstr "Btrfs — συνιστάται"

#: src/pages.py:1022
msgid "Enables shared-space subvolumes, snapshots and Timeback Machine."
msgstr "Ενεργοποιεί υποτόμους κοινόχρηστου χώρου, στιγμιότυπα και τη μηχανή Timeback."

#: src/pages.py:1030
msgid "ext4 — classic"
msgstr "ext4 — κλασικό"

#: src/pages.py:1033
msgid "Uses a traditional single root filesystem."
msgstr "Χρησιμοποιεί ένα παραδοσιακό μονό σύστημα αρχείων ρίζας."

#: src/pages.py:1039
msgid "Advanced — keep existing systems"
msgstr "Για προχωρημένους — διατήρηση των υπάρχοντων συστημάτων"

#: src/pages.py:1041
msgid "Use already-unallocated space and preserve existing partitions. This is the only Windows coexistence path."
msgstr "Χρήση ήδη μη κατανεμημένου χώρου και διατήρηση των υφιστάμενων τμημάτων. Αυτή είναι η μοναδική διαδρομή συμβίωσης με Windows."

#: src/pages.py:1089
msgid "Advanced coexistence can affect EFI firmware state and may trigger BitLocker recovery. It never shrinks or repairs Windows volumes."
msgstr "Η προηγμένη συνύπαρξη μπορεί να επηρεάσει την κατάσταση της firmware EFI και ενδέχεται να ενεργοποιήσει την ανάκτηση BitLocker. Ποτέ δεν συρρικνώνει ή επισκευάζει τόμους Windows."

#: src/pages.py:1099
#, python-brace-format
msgid "ALL DATA on {disk} will be permanently erased."
msgstr "Όλα τα ΔΕΔΟΜΕΝΑ στο {disk} θα διαγραφούν οριστικά."

#: src/pages.py:1135
msgid "This disk is too small for whole-disk installation. Advanced may continue only if suitable unallocated space exists."
msgstr "Αυτός ο δίσκος είναι πολύ μικρός για εγκατάσταση σε ολόκληρο τον δίσκο. Η προηγμένη μπορεί να συνεχιστεί μόνο αν υπάρχει κατάλληλος μη εκχωρημένος χώρος."

#: src/pages.py:1145
msgid "Existing partitions were detected. The first two choices delete them; Advanced is the preservation path."
msgstr "Ανιχνεύτηκαν υπάρχοντες τομείς. Οι δύο πρώτες επιλογές τους διαγράφουν· η Προχωρημένη είναι η διαδρομή διατήρησης."

#: src/pages.py:1178
msgid "Advanced Storage"
msgstr "Για προχωρημένους χρήστες — Αποθήκευση"

#: src/pages.py:1183
msgid "Advanced: Install Alongside"
msgstr "Για προχωρημένους: Εγκατάσταση δίπλα σε άλλο σύστημα"

#: src/pages.py:1212
msgid "Before continuing: finish Windows updates, disable Fast Startup and hibernation, and back up the BitLocker recovery key. EFI, Secure Boot, TPM measurements and boot order can change."
msgstr "Πριν συνεχίσετε: ολοκληρώστε τις ενημερώσεις του Windows, απενεργοποιήστε την Εγρήγορση Ταχείας Εκκίνησης και την υπνωση (hibernation), και δημιουργήστε αντίγραφο ασφαλείας του κλειδιού ανάκτησης BitLocker. Οι ρυθμίσεις EFI, Secure Boot, οι μετρήσεις TPM και η σειρά εκκίνησης ενδέχεται να αλλάξουν."

#: src/pages.py:1219
msgid "This advanced path preserves existing partitions but changes the selected disk's partition table and the machine's EFI boot state."
msgstr "Αυτή η προηγμένη διαδρομή διατηρεί τις υπάρχουσες παρτίτες αλλά αλλάζει τον πίνακα παρτίτων του επιλεγμένου δίσκου και την κατάσταση εκκίνησης EFI της μηχανής."

#: src/pages.py:1250 src/pages.py:2113
msgid "Filesystem"
msgstr "Σύστημα αρχείων"

#: src/pages.py:1253
msgid "Btrfs (recommended)"
msgstr "Btrfs (προτεινόμενο)"

#: src/pages.py:1253
msgid "ext4 (classic)"
msgstr "ext4 (κλασικό)"

#: src/pages.py:1263
msgid "Unallocated space"
msgstr "Μη κατανεμημένος χώρος"

#: src/pages.py:1271
msgid "EFI System Partition"
msgstr "Τομέας Συστήματος EFI"

#: src/pages.py:1285
msgid "Rescan and Reselect Disk"
msgstr "Επανασάρωση και επαναεπιλογή δίσκου"

#: src/pages.py:1326
msgid "Create a new 1 GiB AnduinOS EFI System Partition"
msgstr "Δημιουργία νέου τμήματος EFI συστήματος AnduinOS 1 GiB"

#: src/pages.py:1330
#, python-brace-format
msgid "Reuse {path} ({size})"
msgstr "Επαναχρήση {path} ({size})"

#: src/pages.py:1394
#, python-brace-format
msgid "The selected disk changed or disappeared. Return to the disk page and select it again. {error}"
msgstr "Ο επιλεγμένος δίσκος άλλαξε ή εξαφανίστηκε. Επιστρέψτε στη σελίδα του δίσκου και επιλέξτε τον ξανά. {error}"

#: src/pages.py:1407
msgid "The selected disk size changed. Return and select it again."
msgstr "Το μέγεθος του επιλεγμένου δίσκου άλλαξε. Επιστρέψτε και επιλέξτε τον ξανά."

#: src/pages.py:1417
msgid "The selected disk topology changed. Review the disk and installation method again."
msgstr "Η τοπολογία του επιλεγμένου δίσκου άλλαξε. Εξετάστε ξανά τον δίσκο και τη μέθοδο εγκατάστασης."

#: src/pages.py:1453
#, python-brace-format
msgid "{size} unallocated at {offset}"
msgstr "{size} μη 할당ημένος χώρος στη θέση {offset}"

#: src/pages.py:1579 src/pages.py:1585
msgid "User Account"
msgstr "Λογαριασμός Χρήστη"

#: src/pages.py:1605 src/pages.py:1606
msgid "Full Name"
msgstr "Πλήρες Όνομα"

#: src/pages.py:1609 src/pages.py:1612
msgid "Username"
msgstr "Όνομα χρήστη"

#: src/pages.py:1616 src/pages.py:1627
msgid "Password"
msgstr "Κωδικός"

#: src/pages.py:1620 src/pages.py:1628
msgid "Confirm Password"
msgstr "Επιβεβαίωση Κωδικού"

#: src/pages.py:1632
msgid "Do not require a password for sudo commands"
msgstr "Μην απαιτείτε κωδικό για εντολές sudo"

#: src/pages.py:1638 src/pages.py:1643 src/pages.py:2157
msgid "Computer Name"
msgstr "Όνομα Υπολογιστή"

#: src/pages.py:1669
msgid "Username must start with a lowercase ASCII letter and contain only lowercase ASCII letters or digits (maximum 16 characters)."
msgstr "Username must start with a lowercase ASCII letter and contain only lowercase ASCII letters or digits (maximum 16 characters)."

#: src/pages.py:1680
msgid "Install alongside requires a password-protected account."
msgstr "Η εγκατάσταση παράλληλα απαιτεί λογαριασμό με προστασία κωδικού πρόσβασης."

#: src/pages.py:1691
msgid "The two passwords do not match."
msgstr "Τα δύο κωδικά πρόσβασης δεν ταιριάζουν."

#: src/pages.py:1695
msgid "Password must be at least 6 characters."
msgstr "Ο κωδικός πρέπει να αποτελείται από τουλάχιστον 6 χαρακτήρες."

#: src/pages.py:1703
msgid "Computer name contains invalid characters."
msgstr "Το όνομα του υπολογιστή περιέχει μη έγκυρους χαρακτήρες."

#: src/pages.py:1756
msgid "Return to Make Changes"
msgstr "Επιστροφή για Αλλαγές"

#: src/pages.py:1763
msgid "This configuration is very unsafe"
msgstr "Αυτή η διαμόρφωση είναι πολύ μη ασφαλής"

#: src/pages.py:1765
msgid "Passwordless sudo is unsafe"
msgstr "Το sudo χωρίς κωδικό είναι ασφαλές"

#: src/pages.py:1769
msgid "The system will sign in to this account automatically and allow it to obtain full administrator privileges without a password. Anyone with physical access, and any program running as this user, can completely control the system. Use this only for a kiosk, temporary virtual machine, or another controlled environment."
msgstr "Το σύστημα θα συνδεθεί αυτόματα σε αυτόν τον λογαριασμό και θα του επιτρέψει να αποκτήσει πλήρη δικαιώματα διαχειριστή χωρίς κωδικό. Οποιοσδήποτε με φυσική πρόσβαση, και οποιοδήποτε πρόγραμμα που εκτελείται ως αυτός ο χρήστης, μπορεί να ελέγξει πλήρως το σύστημα. Χρησιμοποιήστε το μόνο για ένα kiosk, προσωρινή εικονική μηχανή ή άλλο ελεγχόμενο περιβάλλον."

#: src/pages.py:1778
msgid "Any program running as your user can obtain full administrator privileges without authentication. Your login password still protects sign-in, but it will not protect sudo. Are you sure you want to continue?"
msgstr "Οποιοδήποτε πρόγραμμα που εκτελείται ως ο χρήστης σας μπορεί να αποκτήσει πλήρη δικαιώματα διαχειριστή χωρίς εγγραφή. Ο κωδικός σύνδεσής σας εξακολουθεί να προστατεύει την είσοδο, αλλά δεν θα προστατεύσει το sudo. Είστε σίγουρος ότι θέλετε να συνεχίσετε;"

#: src/pages.py:1792
msgid "Return and Set a Password"
msgstr "Επιστροφή και Ορισμός Κωδικού"

#: src/pages.py:1798
