#: src/pages.py:937 src/pages.py:1191 src/pages.py:1425
#, python-brace-format
msgid "Target: {disk} ({size} — {model})"
msgstr "Kohde: {disk} ({size} — {model})"

#: src/pages.py:1014
msgid "Erase every partition and all data on the selected disk."
msgstr "Poista kaikki valitun levyn osiot ja data."

#: src/pages.py:1018
msgid "Btrfs — recommended"
msgstr "Btrfs — suositeltu"

#: src/pages.py:1022
msgid "Enables shared-space subvolumes, snapshots and Timeback Machine."
msgstr "Ota käyttöön jaetun tilan alinvoluutit, hetkikuvat ja Timeback Machine."

#: src/pages.py:1030
msgid "ext4 — classic"
msgstr "ext4 — klassinen"

#: src/pages.py:1033
msgid "Uses a traditional single root filesystem."
msgstr "Käyttää perinteistä yksittäistä juuritasojen tiedostojärjestelmää."

#: src/pages.py:1039
msgid "Advanced — keep existing systems"
msgstr "Edistynyt – säilytä olemassa olevat järjestelmät"

#: src/pages.py:1041
msgid "Use already-unallocated space and preserve existing partitions. This is the only Windows coexistence path."
msgstr "Käytä jo olevaa varaamatonta tilaa ja säilytä nykyiset osiot. Tämä on ainoa Windowsin rinnakkaiskäytön tuki."

#: src/pages.py:1089
msgid "Advanced coexistence can affect EFI firmware state and may trigger BitLocker recovery. It never shrinks or repairs Windows volumes."
msgstr "Edistynyt rinnakkaiskäyttö voi vaikuttaa EFI-laitteiston tilaan ja aktivoida BitLocker-palautuksen. Se ei koskaan pienennä tai korjaa Windows-osioita."

#: src/pages.py:1099
#, python-brace-format
msgid "ALL DATA on {disk} will be permanently erased."
msgstr "{disk}-levyn KAIKKI TIEDOT poistetaan pysyvästi."

#: src/pages.py:1135
msgid "This disk is too small for whole-disk installation. Advanced may continue only if suitable unallocated space exists."
msgstr "Tämä levy on liian pieni koko levyn asennusta varten. Asennus voi jatkua vain, jos sopivaa varaamatonta tilaa on saatavilla."

#: src/pages.py:1145
msgid "Existing partitions were detected. The first two choices delete them; Advanced is the preservation path."
msgstr "Olemassa olevia osioita havaittiin. Kaksi ensimmäistä vaihtoehtoa poistaa ne; Advanced on säilytyspolku."

#: src/pages.py:1178
msgid "Advanced Storage"
msgstr "Edistynyt tallennustila"

#: src/pages.py:1183
msgid "Advanced: Install Alongside"
msgstr "Edistynyt: Asenna rinnakkain"

#: src/pages.py:1212
msgid "Before continuing: finish Windows updates, disable Fast Startup and hibernation, and back up the BitLocker recovery key. EFI, Secure Boot, TPM measurements and boot order can change."
msgstr "Jatkaaksesi: suorita Windows-päivitykset loppuun, poista nopea käynnistys ja valmiustila käytöstä sekä varuskopioida BitLockerin palautusavain. EFI, Secure Boot, TPM-mittaukset ja käynnistysjärjestys voivat muuttua."

#: src/pages.py:1219
msgid "This advanced path preserves existing partitions but changes the selected disk's partition table and the machine's EFI boot state."
msgstr "Tämä edistynyt vaihtoehto säilyttää olemassa olevat osiot, mutta muuttaa valitun levyn osiotaulukon ja tietokoneen EFI-käynnistystilan."

