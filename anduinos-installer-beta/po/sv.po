#: src/pages.py:1691
msgid "The two passwords do not match."
msgstr "De två lösenorden matchar inte."

#: src/pages.py:1695
msgid "Password must be at least 6 characters."
msgstr "Lösenordet måste vara minst 6 tecken långt."

#: src/pages.py:1703
