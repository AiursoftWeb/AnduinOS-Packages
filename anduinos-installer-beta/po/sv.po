#: src/main.py:88
msgid "AnduinOS Installer (Development)"
msgstr "AnduinOS-installatören (Utveckling)"

#: src/main.py:90
msgid "AnduinOS Installer (Beta)"
msgstr "AnduinOS-installatören (Beta)"

#: src/main.py:125
msgid "Installation in progress"
msgstr "Installation pågår"

#: src/main.py:127
msgid "The installer cannot be closed while it is modifying the target disk."
msgstr "Installatören kan inte stängas medan den modifierar målskivan."

#: src/main.py:133
msgid "Continue Installation"
msgstr "Fortsätt installationen"

#: src/pages.py:69
msgid "Guided coexistence requires a system booted in UEFI mode and a GPT target disk. This disk cannot continue in guided mode."
msgstr "Guidad samexistens kräver ett system som startats i UEFI-läge och en GPT-målskiva. Denna skiva kan inte fortsätta i guidad läge."

#: src/pages.py:73
msgid "The complete partition map and free-space geometry could not be read consistently. No space on this disk is authorized for installation."
msgstr "Den fullständiga partionskartan och ledig utrymmesgeometri kunde inte läsas konsekvent. Inget utrymme på denna disk är godkänt för installation."

#: src/pages.py:78
msgid "The GPT disk or one of its partitions has no unique stable identifier. Guided coexistence cannot safely authorize preservation or writes on this disk."
msgstr "GPT-disken eller en av dess partitioner har ingen unik stabil identifierare. Guidad samexistens kan inte säkert godkänna bevarande eller skrivningar på denna disk."

#: src/pages.py:83
msgid "This disk contains an active mapper, array or other nested block-device topology that guided coexistence does not support."
msgstr "Den här disken innehåller en aktiv mapper, array eller annan nästlad blockenhets-topologi som inte stöds av guidad samexistens."

#: src/pages.py:87
msgid "A partition on this disk is mounted. Unmount it and rescan storage before continuing."
msgstr "En partition på denna disk är monterad. Avmontera den och skanna om lagringsutrymmet innan du fortsätter."

#: src/pages.py:91
msgid "AnduinOS will use only the selected unallocated space. The installer will not shrink or move an existing filesystem."
msgstr "AnduinOS kommer endast att använda det valda oanvända utrymmet. Installationsprogrammet krymper eller flyttar inte ett befintligt filsystem."

#: src/pages.py:95
msgid "Existing Windows, recovery and data partitions remain outside the write set and will be preserved."
msgstr "Befintliga Windows-, återställnings- och datapartitioner förblir utanför skrivuppsättningen och kommer att bevaras."

#: src/pages.py:99
msgid "The existing EFI System Partition is only a candidate. Health and free-space checks must pass before it can be reused, and it will never be formatted."
msgstr "Den befintliga EFI-systempartitionen är endast en kandidat. Hälsokontroller och kontroller av ledigt utrymme måste klaras innan den kan återanvändas, och den kommer aldrig att formateras."

#: src/pages.py:104
msgid "BitLocker storage will be preserved. The installer will not unlock, resize, repair or otherwise modify it."
msgstr "BitLocker-lagring bevaras. Installationsprogrammet låser inte upp, ändrar storlek på, reparerar eller modifierar det på annat sätt."

#: src/pages.py:108
msgid "The installer will not mount, repair or infer the safety of Windows volumes from hibernation or Fast Startup state. Any required Windows maintenance must be completed in Windows."
msgstr "Installationsprogrammet monterar inte, reparerar eller utvärderar säkerheten för Windows-volymer från viloläge eller snabbstart. All nödvändig underhåll av Windows måste slutföras i Windows."

#: src/pages.py:113
msgid "Alternatively, you may explicitly select one entire partition to erase. Everything in that selected partition will be destroyed; it is never selected automatically."
msgstr "Alternativt kan du explicit välja en hel partition att radera. Allt i den valda partitionen kommer att förstöras; den väljs aldrig automatiskt."

#: src/pages.py:118
msgid "Installation cannot continue with this selection. There is no force-continue option around storage safety checks."
msgstr "Installationen kan inte fortsätta med detta val. Det finns inget alternativ för att tvinga fram fortgång kring säkerhetskontroller för lagring."

#: src/pages.py:122
msgid "After changing partitions or unmounting a volume, rescan storage and select the target again."
msgstr "Efter att du har ändrat partitioner eller avmonterat en volym, skanna om lagringsutrymmet och välj målet igen."

#: src/pages.py:128
msgid "No suitable unallocated space was found. To protect your data, create unallocated space with Windows Disk Management, then boot the installer again and rescan the disk."
msgstr "Inget lämpligt outnyttjat utrymme hittades. För att skydda dina data, skapa outnyttjat utrymme med Windows diskhantering, starta sedan installationsprogrammet igen och skanna disken på nytt."

#: src/pages.py:133
msgid "No suitable unallocated space was found. To protect your data, create unallocated space with a partitioning tool, then boot the installer again and rescan the disk."
msgstr "Inget lämpligt outnyttjat utrymme hittades. För att skydda dina data, skapa outnyttjat utrymme med ett partitioneringsverktyg, starta sedan installationsprogrammet igen och skanna disken på nytt."

