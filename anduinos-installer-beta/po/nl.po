#: src/pages.py:1018
msgid "Btrfs — recommended"
msgstr "Btrfs — aanbevolen"

#: src/pages.py:1022
msgid "Enables shared-space subvolumes, snapshots and Timeback Machine."
msgstr "Schakelt gedeelde subvolumes, momentopnamen en Timeback Machine in."

#: src/pages.py:1030
