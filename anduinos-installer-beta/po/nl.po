msgstr "Partitie toevoegen"

#: src/pages.py:4321 src/pages.py:5146
msgid "Edit"
msgstr "Bewerken"

#: src/pages.py:4548
msgid "That partition can no longer be edited safely."
msgstr "Die partitie kan niet langer veilig worden bewerkt."

#: src/pages.py:4587
msgid "Use All Available Space"
msgstr "Alle beschikbare ruimte gebruiken"

#: src/pages.py:4616
#, python-brace-format
