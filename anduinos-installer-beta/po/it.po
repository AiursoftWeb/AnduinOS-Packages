msgstr "{architecture} / {firmware} / Secure Boot: {secure_boot}"

msgid "{count}: {paths}"
msgstr "{count}: {paths}"

msgid "{name}: {start}–{end} MiB"
msgstr "{name}: {start}–{end} MiB"

msgid "{path} as {filesystem}"
msgstr "{path} come {filesystem}"

msgid "{size} at {offset}"
msgstr "{size} a {offset}"

msgid "{size} unallocated at {offset}"
msgstr "{size} non allocati a {offset}"

msgid "{step} failed"
msgstr "{step} non riuscito"

msgid ""
"⚠ Only the selected unallocated space will be partitioned and formatted. "
"Existing partitions are preserved, but EFI/AnduinOS files and the AnduinOS "
"firmware boot entry may change. This installer will not shrink Windows for "
"you."
msgstr ""
"⚠ Solo lo spazio non allocato selezionato verrà partizionato e formattato. "
"Le partizioni esistenti vengono preservate, ma i file EFI/AnduinOS e la voce "
"di avvio del firmware AnduinOS potrebbero cambiare. Questo installatore non "
"ridimensionerà Windows per te."

msgid ""
"⚠ This will erase ALL data on the selected disk. This action cannot be "
"undone."
msgstr ""
"⚠ Questo cancellerà TUTTI i dati sul disco selezionato. Questa azione non "
"può essere annullata."

