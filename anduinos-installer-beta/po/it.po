msgstr "Danese"

msgid "Detect Internet connectivity"
msgstr "Rileva la connettività Internet"

msgid "Detect firmware and Secure Boot"
msgstr "Rileva firmware e Secure Boot"

msgid ""
"Development mode will simulate installation to {disk}. No disk data will be "
"changed.\n"
"\n"
msgstr ""
"La modalità di sviluppo simulerà l'installazione su {disk}. Nessun dato del "
"disco verrà modificato.\n"
"\n"

msgid "Development simulation completed"
msgstr "Simulazione di sviluppo completata"

msgid "Discover AnduinOS"
msgstr "Scopri AnduinOS"

msgid "Do not require a password for sudo commands"
msgstr "Non richiedere una password per i comandi sudo"

msgid "Download and install system updates during installation"
msgstr ""
"Scarica e installa gli aggiornamenti di sistema durante l'installazione"

