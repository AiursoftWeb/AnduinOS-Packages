msgstr "विभाजन विवरण उपलब्ध नहीं हैं"

#: src/pages.py:728
msgid "Windows detected"
msgstr "विंडोज़ का पता लगाया गया"

#: src/pages.py:730
msgid "BitLocker detected"
msgstr "BitLocker का पता चला"

#: src/pages.py:732
msgid "Live USB — excluded"
msgstr "लाइव यूएसबी — बाहर रखा गया"

#: src/pages.py:734
msgid "Too small"
msgstr "बहुत छोटा"

#: src/pages.py:751 src/pages.py:757
msgid "Select Installation Disk"
msgstr "इंस्टालेशन डिस्क चुनें"

#: src/pages.py:793
msgid "Rescan Storage"
msgstr "स्टोरेज पुनः स्कैन करें"

#: src/pages.py:863
msgid "No suitable disks found."
msgstr "कोई उपयुक्त डिस्क नहीं मिली।"

#: src/pages.py:917
msgid "Choose Installation Method"
msgstr "इंस्टॉलेशन विधि चुनें"

#: src/pages.py:922
msgid "How should AnduinOS use this disk?"
msgstr "AnduinOS को इस डिस्क का उपयोग कैसे करना चाहिए?"

#: src/pages.py:937 src/pages.py:1191 src/pages.py:1425
#, python-brace-format
msgid "Target: {disk} ({size} — {model})"
msgstr "लक्ष्य: {disk} ({size} — {model})"

#: src/pages.py:1014
msgid "Erase every partition and all data on the selected disk."
msgstr "चयनित डिस्क पर हर विभाजन और सभी डेटा मिटाएँ।"

#: src/pages.py:1018
msgid "Btrfs — recommended"
msgstr "Btrfs — अनुशंसित"

#: src/pages.py:1022
msgid "Enables shared-space subvolumes, snapshots and Timeback Machine."
msgstr "शेयरड-स्पेस सबवॉल्यूम्स, स्नैपशॉट्स और टाइमबैक मशीन को सक्षम करता है।"

#: src/pages.py:1030
msgid "ext4 — classic"
msgstr "ext4 — क्लासिक"

#: src/pages.py:1033
msgid "Uses a traditional single root filesystem."
msgstr "परंपरागत एकल रूट फ़ाइल सिस्टम का उपयोग करता है।"

#: src/pages.py:1039
msgid "Advanced — keep existing systems"
msgstr "उन्नत — मौजूदा सिस्टम को बनाए रखें"

#: src/pages.py:1041
msgid "Use already-unallocated space and preserve existing partitions. This is the only Windows coexistence path."
msgstr "पहले से ही अविभाजित स्थान का उपयोग करें और मौजूदा विभाजनों को बनाए रखें। यह विंडोज़ सहअस्तित्व का एकमात्र मार्ग है।"

#: src/pages.py:1089
msgid "Advanced coexistence can affect EFI firmware state and may trigger BitLocker recovery. It never shrinks or repairs Windows volumes."
msgstr "उन्नत सहअस्तित्व EFI फर्मवेयर की स्थिति को प्रभावित कर सकता है और BitLocker रिकवरी को ट्रिगर कर सकता है। यह कभी भी Windows वॉल्यूम को छोटा नहीं करता या उसकी मरम्मत नहीं करता।"

#: src/pages.py:1099
#, python-brace-format
msgid "ALL DATA on {disk} will be permanently erased."
msgstr "{disk} पर मौजूद सभी डेटा स्थायी रूप से मिटा दिया जाएगा।"

#: src/pages.py:1135
msgid "This disk is too small for whole-disk installation. Advanced may continue only if suitable unallocated space exists."
msgstr "यह डिस्क पूरे-डिस्क इंस्टालेशन के लिए बहुत छोटी है। उन्नत तभी जारी रख सकता है यदि उपयुक्त अनासंजत स्थिति उपलब्ध हो।"

#: src/pages.py:1145
msgid "Existing partitions were detected. The first two choices delete them; Advanced is the preservation path."
msgstr "विद्यमान विभाजनों का पता चला है। पहले दो विकल्प उन्हें मिटाते हैं; उन्नत (Advanced) विकल्प संरक्षण मार्ग है।"

#: src/pages.py:1178
msgid "Advanced Storage"
msgstr "उन्नत स्टोरेज"

#: src/pages.py:1183
msgid "Advanced: Install Alongside"
msgstr "उन्नत: साथ में इंस्टॉल करें"

#: src/pages.py:1212
msgid "Before continuing: finish Windows updates, disable Fast Startup and hibernation, and back up the BitLocker recovery key. EFI, Secure Boot, TPM measurements and boot order can change."
msgstr "आगे बढ़ने से पहले: Windows अपडेट पूरे करें, Fast Startup और हibernation अक्षम करें, और BitLocker रिकवरी की का बैकअप लें। EFI, Secure Boot, TPM माप और बूट क्रम बदल सकता है।"

#: src/pages.py:1219
msgid "This advanced path preserves existing partitions but changes the selected disk's partition table and the machine's EFI boot state."
msgstr "यह उन्नत पथ मौजूदा पार्टिशनों को बनाए रखता है लेकिन चयनित डिस्क की पार्टिशन टेबल और मशीन की EFI बूट स्थिति को बदल देता है।"

#: src/pages.py:1250 src/pages.py:2113
msgid "Filesystem"
msgstr "फ़ाइल सिस्टम"

#: src/pages.py:1253
msgid "Btrfs (recommended)"
msgstr "Btrfs (अनुशंसित)"

#: src/pages.py:1253
msgid "ext4 (classic)"
msgstr "ext4 (क्लासिक)"

#: src/pages.py:1263
msgid "Unallocated space"
msgstr "अविभाजित स्थान"

#: src/pages.py:1271
msgid "EFI System Partition"
msgstr "EFI सिस्टम विभाजन"

#: src/pages.py:1285
msgid "Rescan and Reselect Disk"
msgstr "डिस्क को पुनः स्कैन करें और पुनः चुनें"

#: src/pages.py:1326
msgid "Create a new 1 GiB AnduinOS EFI System Partition"
msgstr "एक नई 1 GiB AnduinOS EFI सिस्टम पार्तिशन बनाएं"

#: src/pages.py:1330
#, python-brace-format
msgid "Reuse {path} ({size})"
msgstr "{path} ({size}) का पुन: उपयोग करें"

#: src/pages.py:1394
#, python-brace-format
msgid "The selected disk changed or disappeared. Return to the disk page and select it again. {error}"
msgstr "चयनित डिस्क बदल गई या गायब हो गई। डिस्क पेज पर लौटें और इसे फिर से चयन करें। {error}"

#: src/pages.py:1407
msgid "The selected disk size changed. Return and select it again."
msgstr "चयनित डिस्क का आकार बदल गया। लौटें और इसे फिर से चयन करें।"

#: src/pages.py:1417
msgid "The selected disk topology changed. Review the disk and installation method again."
