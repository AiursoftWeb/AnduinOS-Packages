msgid "Battery power is too low for a safe installation."
msgstr "Baterija je preslaba za sigurnu instalaciju."

#: src/pages.py:962
msgid "Charge to at least 80% before starting the installation."
msgstr "Prije početka instalacije napunite bateriju na najmanje 80 %."

