msgstr "{architecture} / {firmware} / Безопасная загрузка: {secure_boot}"

#: src/pages.py:2090
#, python-brace-format
msgid "Unavailable: {error}"
msgstr "Недоступно: {error}"

#: src/pages.py:2100
msgid "single ext4 root filesystem"
msgstr "одна файловая система ext4 корня"

#: src/pages.py:2103
msgid "Language"
msgstr "Язык"

#: src/pages.py:2104
msgid "Keyboard"
msgstr "Клавиатура"

#: src/pages.py:2106
msgid "Target Disk"
msgstr "Целевой диск"

#: src/pages.py:2110
msgid "Stable disk identity"
msgstr "Стабильный идентификатор диска"

#: src/pages.py:2112
msgid "Platform"
msgstr "Платформа"

