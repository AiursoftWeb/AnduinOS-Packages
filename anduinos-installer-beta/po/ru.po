msgstr "Отключение установленной системы"

msgid "Updates and Drivers"
msgstr "Обновления и драйверы"

msgid ""
"Use already-unallocated space and preserve existing partitions. This is the "
"only Windows coexistence path."
msgstr ""
"Использовать уже неразмеченное пространство и сохранить существующие "
"разделы. Это единственный вариант сосуществования с Windows."

msgid "Use only existing unallocated space on the selected disk."
msgstr ""
"Использовать только существующее неразмеченное пространство на выбранном "
"диске."

msgid "User"
msgstr "Пользователь"

msgid "User Account"
msgstr "Учетная запись пользователя"

msgid "Username"
msgstr "Имя пользователя"

msgid ""
"Username must start with a lowercase ASCII letter and contain only lowercase "
"ASCII letters or digits (maximum 16 characters)."
msgstr ""
"Username must start with a lowercase ASCII letter and contain only lowercase "
"ASCII letters or digits (maximum 16 characters)."

msgid "Uses a traditional single root filesystem."
msgstr ""
"Использует традиционную файловую систему с единственным корневым каталогом."

msgid "Validate Plan (No Installation)"
msgstr "Проверить план (без установки)"

msgid "Validate this installation plan?"
msgstr "Проверить этот план установки?"

msgid "Verify kernel module signatures"
msgstr "Проверка подписей модулей ядра"

msgid "Verify target disk isolation"
msgstr "Проверка изоляции целевого диска"

msgid "Vietnamese"
msgstr "Вьетнамский"

msgid "Welcome to AnduinOS"
msgstr "Добро пожаловать в AnduinOS"

msgid "Windows detected"
msgstr "Обнаружена Windows"

msgid ""
"Write only EFI/AnduinOS, do not overwrite EFI/BOOT, and require a verified "
"AnduinOS NVRAM entry."
msgstr ""
"Записать только EFI/AnduinOS, не перезаписывать EFI/BOOT и требовать "
"проверенный загрузочный раздел AnduinOS в NVRAM."

msgid "automatic login"
msgstr "автоматический вход"

msgid "create a machine-local MOK; enroll after reboot with password 123456"
msgstr ""
"создать локальный для машины MOK; зарегистрировать после перезагрузки с "
"паролем 123456"

msgid "detect and install (may include non-free software)"
msgstr "обнаружить и установить (может включать нелицензионное ПО)"

msgid "do not install"
msgstr "не устанавливать"

msgid "download and install"
msgstr "скачать и установить"

msgid "ext4 (classic)"
msgstr "ext4 (классическая)"

