msgstr ""
"Установка не может продолжиться с этим выбором. Не существует опции "
"принудительного продолжения обхода проверок безопасности хранилища."

msgid "Installation complete"
msgstr "Установка завершена"

msgid "Installation failed"
msgstr "Ошибка установки"

msgid "Installation in progress"
msgstr "Идет установка"

msgid "Installing AnduinOS"
msgstr "Установка AnduinOS"

