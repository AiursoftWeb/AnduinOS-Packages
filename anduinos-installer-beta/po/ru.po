msgstr ""
"Использовать повторно {path}; не форматировать; перед записью проверить "
"состояние FAT, идентификатор и наличие 64 МБ свободного места."

msgid "Romanian"
msgstr "Румынский"

msgid "Russian"
msgstr "Русский"

