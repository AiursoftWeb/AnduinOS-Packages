msgstr "Сохранить журнал"

msgid "Schedule MOK enrollment"
msgstr "Планирование регистрации MOK"

msgid "Search timezones…"
msgstr "Поиск часовых поясов…"

msgid "Secure Boot enrollment"
msgstr "Регистрация Secure Boot"

msgid "Select Installation Disk"
msgstr "Выбор диска для установки"

msgid "Select Timezone"
msgstr "Выбор часового пояса"

msgid "Select fastest package mirror"
msgstr "Выбор самого быстрого зеркала пакетов"

