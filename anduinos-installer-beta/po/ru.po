msgid "Ready to Install"
msgstr "Готово к установке"

#: src/pages.py:2056
msgid "DEVELOPMENT MODE — the plan will be validated and simulated. No privileged executor or disk command can run."
msgstr "РЕЖИМ РАЗРАБОТКИ — план будет проверен и смоделирован. Ни один привилегированный исполнитель или команда диска не может быть выполнена."

#: src/pages.py:2081
#, python-brace-format
