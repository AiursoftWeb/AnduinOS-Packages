msgid "After restart, MOKManager will open. Choose Enroll MOK → Continue → Yes, then enter password 123456."
msgstr "Após a reinicialização, o MOKManager será aberto. Escolha Enroll MOK → Continuar → Sim e depois digite a senha 123456."

#: src/pages.py:6636
msgid ""
"All partitions and data on {disk} will be destroyed.\n"
"\n"
msgstr ""
"Todas as partições e dados em {disk} serão destruídos.\n"
"\n"

