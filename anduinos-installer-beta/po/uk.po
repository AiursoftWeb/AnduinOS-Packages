msgstr "Недоступно: {error}"

msgid "Unknown filesystem"
msgstr "Невідома файлова система"

msgid "Unmount installed system"
msgstr "Відключення встановленої системи"

msgid "Updates and Drivers"
msgstr "Оновлення та драйвери"

msgid ""
"Use already-unallocated space and preserve existing partitions. This is the "
"only Windows coexistence path."
msgstr ""
"Використовувати вже невиділений простір і зберігати існуючі розділи. Це "
"єдиний шлях співіснування з Windows."

msgid "Use only existing unallocated space on the selected disk."
msgstr "Використовувати лише наявний невиділений простір на вибраному диску."

msgid "User"
msgstr "Користувач"

msgid "User Account"
msgstr "Обліковий запис користувача"

msgid "Username"
msgstr "Ім'я користувача"

msgid ""
"Username must start with a lowercase ASCII letter and contain only lowercase "
"ASCII letters or digits (maximum 16 characters)."
msgstr ""
"Username must start with a lowercase ASCII letter and contain only lowercase "
"ASCII letters or digits (maximum 16 characters)."

msgid "Uses a traditional single root filesystem."
msgstr "Використовує традиційну файлову систему з одним коренем."

msgid "Validate Plan (No Installation)"
msgstr "Перевірити план (без встановлення)"

msgid "Validate this installation plan?"
msgstr "Перевірити цей план встановлення?"

msgid "Verify kernel module signatures"
msgstr "Перевірка підписів модулів ядра"

msgid "Verify target disk isolation"
msgstr "Перевірка ізоляції цільового диска"

msgid "Vietnamese"
msgstr "В'єтнамська"

msgid "Welcome to AnduinOS"
msgstr "Ласкаво просимо до AnduinOS"

msgid "Windows detected"
msgstr "Windows виявлено"

msgid ""
"Write only EFI/AnduinOS, do not overwrite EFI/BOOT, and require a verified "
"AnduinOS NVRAM entry."
msgstr ""
"Записувати лише EFI/AnduinOS, не перезаписувати EFI/BOOT та вимагати "
"перевіреного запису AnduinOS у NVRAM."

msgid "automatic login"
msgstr "автоматичний вхід"

msgid "create a machine-local MOK; enroll after reboot with password 123456"
msgstr ""
"створити локальний для машини MOK; зареєструвати після перезавантаження з "
"паролем 123456"

msgid "detect and install (may include non-free software)"
msgstr "виявити та встановити (може включати не вільне програмне забезпечення)"

msgid "do not install"
msgstr "не встановлювати"

msgid "download and install"
msgstr "завантажити та встановити"

msgid "ext4 (classic)"
msgstr "ext4 (класична)"

msgid "ext4 — classic"
msgstr "ext4 — класичний"

msgid "not required"
msgstr "не обов'язково"

msgid "password required for login"
msgstr "потрібен пароль для входу"

msgid "single ext4 root filesystem"
msgstr "єдина файлова система ext4 кореневого каталогу"

msgid "{architecture} / {firmware} / Secure Boot: {secure_boot}"
msgstr "{architecture} / {firmware} / Secure Boot: {secure_boot}"

msgid "{count}: {paths}"
msgstr "{count}: {paths}"

msgid "{name}: {start}–{end} MiB"
msgstr "{name}: {start}–{end} MiB"

