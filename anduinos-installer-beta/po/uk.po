msgstr "Виявлено BitLocker"

#: src/pages.py:732
msgid "Live USB — excluded"
msgstr "Живий USB — виключено"

#: src/pages.py:734
msgid "Too small"
msgstr "Занадто мало"

#: src/pages.py:751 src/pages.py:757
msgid "Select Installation Disk"
msgstr "Вибір диска встановлення"

#: src/pages.py:793
msgid "Rescan Storage"
msgstr "Повторне сканування сховища"

#: src/pages.py:863
msgid "No suitable disks found."
msgstr "Не знайдено придатних дисків."

#: src/pages.py:917
msgid "Choose Installation Method"
msgstr "Оберіть метод встановлення"

#: src/pages.py:922
msgid "How should AnduinOS use this disk?"
msgstr "Як AnduinOS має використовувати цей диск?"

#: src/pages.py:937 src/pages.py:1191 src/pages.py:1425
#, python-brace-format
msgid "Target: {disk} ({size} — {model})"
msgstr "Мета: {disk} ({size} — {model})"

#: src/pages.py:1014
msgid "Erase every partition and all data on the selected disk."
msgstr "Видалити кожну розділ і всі дані на вибраному диску."

#: src/pages.py:1018
msgid "Btrfs — recommended"
msgstr "Btrfs — рекомендовано"

#: src/pages.py:1022
msgid "Enables shared-space subvolumes, snapshots and Timeback Machine."
msgstr "Увімкнути підтомови спільного простору, миттєві знімки та Timeback Machine."

#: src/pages.py:1030
msgid "ext4 — classic"
msgstr "ext4 — класичний"

#: src/pages.py:1033
msgid "Uses a traditional single root filesystem."
msgstr "Використовує традиційну файлову систему з одним коренем."

#: src/pages.py:1039
msgid "Advanced — keep existing systems"
msgstr "Розширені — залишити існуючі системи"

#: src/pages.py:1041
msgid "Use already-unallocated space and preserve existing partitions. This is the only Windows coexistence path."
msgstr "Використовувати вже невиділений простір і зберігати існуючі розділи. Це єдиний шлях співіснування з Windows."

#: src/pages.py:1089
msgid "Advanced coexistence can affect EFI firmware state and may trigger BitLocker recovery. It never shrinks or repairs Windows volumes."
msgstr "Розширене співіснування може вплинути на стан прошивки EFI та запустити відновлення BitLocker. Воно ніколи не зменшує і не ремонтує томи Windows."

#: src/pages.py:1099
#, python-brace-format
msgid "ALL DATA on {disk} will be permanently erased."
msgstr "ВСІ ДАНІ на {disk} буде остаточно видалено."

#: src/pages.py:1135
msgid "This disk is too small for whole-disk installation. Advanced may continue only if suitable unallocated space exists."
msgstr "\\\tЦей диск занадто малий для повного встановлення на диск. Розширений режим може продовжити лише за наявності відповідного невизначеного місця."

#: src/pages.py:1145
msgid "Existing partitions were detected. The first two choices delete them; Advanced is the preservation path."
msgstr "Був виявлено існуючі розділи. Перші два варіанти видаляють їх; Розширений є шляхом збереження."

#: src/pages.py:1178
msgid "Advanced Storage"
msgstr "Розширені налаштування сховища"

#: src/pages.py:1183
msgid "Advanced: Install Alongside"
msgstr "Розширені: встановити поряд із"

#: src/pages.py:1212
msgid "Before continuing: finish Windows updates, disable Fast Startup and hibernation, and back up the BitLocker recovery key. EFI, Secure Boot, TPM measurements and boot order can change."
msgstr "Перш ніж продовжити: завершіть оновлення Windows, вимкніть швидкий запуск та режим сну, а також створіть резервну копію ключа відновлення BitLocker. Налаштування EFI, Secure Boot, вимірювання TPM та порядок завантаження можуть змінитися."

#: src/pages.py:1219
msgid "This advanced path preserves existing partitions but changes the selected disk's partition table and the machine's EFI boot state."
msgstr "\\\tЦей розширений шлях зберігає існуючі розділи, але змінює таблицю розділів вибраного диска та стан завантаження EFI машини."

#: src/pages.py:1250 src/pages.py:2113
msgid "Filesystem"
msgstr "Файлова система"

#: src/pages.py:1253
msgid "Btrfs (recommended)"
msgstr "Btrfs (рекомендовано)"

#: src/pages.py:1253
msgid "ext4 (classic)"
msgstr "ext4 (класична)"

#: src/pages.py:1263
msgid "Unallocated space"
msgstr "Невиділений простір"

#: src/pages.py:1271
msgid "EFI System Partition"
msgstr "EFI System Partition"

#: src/pages.py:1285
msgid "Rescan and Reselect Disk"
msgstr "Пересканувати та вибрати диск знову"

#: src/pages.py:1326
msgid "Create a new 1 GiB AnduinOS EFI System Partition"
msgstr "Створіть новий розділ системи EFI AnduinOS розміром 1 ГіБ"

#: src/pages.py:1330
#, python-brace-format
msgid "Reuse {path} ({size})"
msgstr "Використати повторно {path} ({size})"

#: src/pages.py:1394
#, python-brace-format
msgid "The selected disk changed or disappeared. Return to the disk page and select it again. {error}"
msgstr "\\\tВибраний диск змінився або зник. Поверніться на сторінку диска та виберіть його знову. {error}"

#: src/pages.py:1407
msgid "The selected disk size changed. Return and select it again."
msgstr "\\\tРозмір вибраного диска змінився. Поверніться та виберіть його знову."

#: src/pages.py:1417
msgid "The selected disk topology changed. Review the disk and installation method again."
msgstr "\\\tТопологія вибраного диска змінилася. Перевірте диск та метод встановлення ще раз."

#: src/pages.py:1453
#, python-brace-format
msgid "{size} unallocated at {offset}"
msgstr "{size} невиділено на {offset}"

#: src/pages.py:1579 src/pages.py:1585
msgid "User Account"
msgstr "Обліковий запис користувача"

#: src/pages.py:1605 src/pages.py:1606
msgid "Full Name"
msgstr "Повне ім'я"

#: src/pages.py:1609 src/pages.py:1612
msgid "Username"
msgstr "Ім'я користувача"

#: src/pages.py:1616 src/pages.py:1627
msgid "Password"
msgstr "Пароль"

#: src/pages.py:1620 src/pages.py:1628
msgid "Confirm Password"
msgstr "Підтвердження пароля"

#: src/pages.py:1632
msgid "Do not require a password for sudo commands"
msgstr "Не вимагати пароль для команд sudo"

#: src/pages.py:1638 src/pages.py:1643 src/pages.py:2157
msgid "Computer Name"
msgstr "Ім'я комп'ютера"

#: src/pages.py:1669
msgid "Username may only contain lowercase letters, digits, underscores and hyphens."
msgstr "Ім'я користувача може містити лише малі літери, цифри, підкреслення та дефіси."

#: src/pages.py:1680
msgid "Install alongside requires a password-protected account."
msgstr "Для встановлення поруч потрібен обліковий запис із захистом паролем."

#: src/pages.py:1691
msgid "The two passwords do not match."
msgstr "Два паролі не збігаються."

#: src/pages.py:1695
msgid "Password must be at least 6 characters."
msgstr "Пароль має містити щонайменше 6 символів."

#: src/pages.py:1703
msgid "Computer name contains invalid characters."
msgstr "Ім'я комп'ютера містить недопустимі символи."

#: src/pages.py:1756
msgid "Return to Make Changes"
msgstr "Повернутися для внесення змін"

#: src/pages.py:1763
msgid "This configuration is very unsafe"
msgstr "Ця конфігурація є дуже небезпечною"

#: src/pages.py:1765
msgid "Passwordless sudo is unsafe"
msgstr "Судо без пароля є небезпечним"

#: src/pages.py:1769
msgid "The system will sign in to this account automatically and allow it to obtain full administrator privileges without a password. Anyone with physical access, and any program running as this user, can completely control the system. Use this only for a kiosk, temporary virtual machine, or another controlled environment."
msgstr "Система автоматично увійде в цей обліковий запис і дозволить отримувати повні права адміністратора без пароля. Будь-хто з фізичним доступом, а також будь-яка програма, запущена від цього користувача, може повністю керувати системою. Використовуйте це лише для кіоску, тимчасової віртуальної машини або іншого контрольованого середовища."

#: src/pages.py:1778
msgid "Any program running as your user can obtain full administrator privileges without authentication. Your login password still protects sign-in, but it will not protect sudo. Are you sure you want to continue?"
msgstr "Будь-яка програма, запущена від вашого імені, може отримати повні права адміністратора без автентифікації. Ваш пароль входу захищає вхід у систему, але не захистить sudo. Ви впевнені, що хочете продовжити?"

#: src/pages.py:1792
msgid "Return and Set a Password"
msgstr "Повернутися та встановити пароль"

#: src/pages.py:1798
msgid "I Understand the Risk, Continue"
msgstr "Я розумію ризики, продовжити"

#: src/pages.py:1822
msgid "Administrator access would be locked"
msgstr "Доступ адміністратора буде заблоковано"

#: src/pages.py:1824
msgid "This account has no login password, but sudo would still require one. Because the root account is locked by default, you would be unable to perform administrator tasks. Set an account password or enable passwordless sudo."
msgstr "Цей обліковий запис не має пароля для входу, але sudo все одно вимагатиме пароль. Оскільки обліковий запис root за замовчуванням заблоковано, ви не зможете виконувати завдання адміністратора. Встановіть пароль облікового запису або увімкніть sudo без пароля."

#: src/pages.py:1895 src/pages.py:1901
msgid "Select Timezone"
msgstr "Вибір часового поясу"

#: src/pages.py:1914
msgid "Search timezones…"
msgstr "Пошук часових поясів…"

#: src/pages.py:1967
msgid "Selected timezone"
msgstr "Обраний часовий пояс"

#: src/pages.py:2035 src/pages.py:2041
msgid "Ready to Install"
msgstr "Готовий до встановлення"

