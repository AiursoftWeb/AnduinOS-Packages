#: src/main.py:88
msgid "AnduinOS Installer (Development)"
msgstr "Cài đặt AnduinOS (Phát triển)"

#: src/main.py:90
msgid "AnduinOS Installer (Beta)"
msgstr "Cài đặt AnduinOS (Beta)"

#: src/main.py:125
msgid "Installation in progress"
msgstr "Đang cài đặt"

#: src/main.py:127
msgid "The installer cannot be closed while it is modifying the target disk."
msgstr "Trình cài đặt không thể đóng trong khi nó đang sửa đổi đĩa đích."

#: src/main.py:133
msgid "Continue Installation"
msgstr "Tiếp tục cài đặt"

#: src/pages.py:69
msgid "Guided coexistence requires a system booted in UEFI mode and a GPT target disk. This disk cannot continue in guided mode."
msgstr "Sự cùng tồn tại có hướng dẫn yêu cầu hệ thống khởi động ở chế độ UEFI và đĩa đích GPT. Đĩa này không thể tiếp tục ở chế độ hướng dẫn."

#: src/pages.py:73
msgid "The complete partition map and free-space geometry could not be read consistently. No space on this disk is authorized for installation."
msgstr "Bản đồ phân vùng hoàn chỉnh và hình học không gian trống không thể đọc được một cách nhất quán. Không có không gian nào trên đĩa này được ủy quyền để cài đặt."

#: src/pages.py:78
msgid "The GPT disk or one of its partitions has no unique stable identifier. Guided coexistence cannot safely authorize preservation or writes on this disk."
msgstr "Đĩa GPT hoặc một trong các phân vùng của nó không có định danh ổn định duy nhất. Chế độ cùng tồn tại có hướng dẫn không thể an toàn ủy quyền bảo lưu hoặc ghi vào đĩa này."

#: src/pages.py:83
msgid "This disk contains an active mapper, array or other nested block-device topology that guided coexistence does not support."
msgstr "Oss đĩa này chứa một trình ánh xạ, mảng hoặc cấu trúc thiết bị khối lồng nhau khác mà chế độ cùng tồn tại có hướng dẫn không hỗ trợ."

#: src/pages.py:87
msgid "A partition on this disk is mounted. Unmount it and rescan storage before continuing."
msgstr "Một phân vùng trên ổ đĩa này đang được gắn kết. Hãy ngắt kết nối nó và quét lại bộ nhớ trước khi tiếp tục."

#: src/pages.py:91
msgid "AnduinOS will use only the selected unallocated space. The installer will not shrink or move an existing filesystem."
msgstr "AnduinOS sẽ chỉ sử dụng phần dung lượng chưa được phân bổ đã chọn. Trình cài đặt sẽ không thu nhỏ hoặc di chuyển hệ thống tệp hiện có."

#: src/pages.py:95
msgid "Existing Windows, recovery and data partitions remain outside the write set and will be preserved."
msgstr "Các phân vùng Windows, khôi phục và dữ liệu hiện có sẽ nằm ngoài tập hợp ghi và được bảo tồn."

#: src/pages.py:99
msgid "The existing EFI System Partition is only a candidate. Health and free-space checks must pass before it can be reused, and it will never be formatted."
msgstr "Phân vùng Hệ thống EFI hiện có chỉ là ứng viên. Các kiểm tra tình trạng và không gian trống phải đạt yêu cầu trước khi nó có thể được tái sử dụng, và nó sẽ không bao giờ được định dạng lại."

#: src/pages.py:104
msgid "BitLocker storage will be preserved. The installer will not unlock, resize, repair or otherwise modify it."
msgstr "Lưu trữ BitLocker sẽ được giữ nguyên. Trình cài đặt sẽ không mở khóa, thay đổi kích thước, sửa chữa hoặc sửa đổi nó theo bất kỳ cách nào khác."

#: src/pages.py:108
msgid "The installer will not mount, repair or infer the safety of Windows volumes from hibernation or Fast Startup state. Any required Windows maintenance must be completed in Windows."
msgstr "Cài đặt sẽ không gắn kết, sửa chữa hoặc suy luận tính an toàn của các ổ Windows từ trạng thái ngủ đông hoặc Khởi động nhanh. Mọi bảo trì Windows cần thiết phải được hoàn tất trong Windows."

#: src/pages.py:113
msgid "Alternatively, you may explicitly select one entire partition to erase. Everything in that selected partition will be destroyed; it is never selected automatically."
msgstr "Ngoài ra, bạn có thể chọn rõ ràng toàn bộ một phân vùng để xóa. Mọi thứ trong phân vùng được chọn đó sẽ bị phá hủy; nó không bao giờ được chọn tự động."

#: src/pages.py:118
msgid "Installation cannot continue with this selection. There is no force-continue option around storage safety checks."
msgstr "Quá trình cài đặt không thể tiếp tục với lựa chọn này. Không có tùy chọn buộc tiếp tục xung quanh các kiểm tra an toàn lưu trữ."

#: src/pages.py:122
msgid "After changing partitions or unmounting a volume, rescan storage and select the target again."
msgstr "Sau khi thay đổi phân vùng hoặc ngắt kết nối một vùng lưu trữ, hãy quét lại bộ nhớ và chọn đích lần nữa."

#: src/pages.py:128
msgid "No suitable unallocated space was found. To protect your data, create unallocated space with Windows Disk Management, then boot the installer again and rescan the disk."
msgstr "Không tìm thấy khoảng trống chưa phân bổ phù hợp. Để bảo vệ dữ liệu của bạn, hãy tạo không gian chưa phân bổ bằng Quản lý đĩa Windows, sau đó khởi động trình cài đặt lại và quét lại đĩa."

#: src/pages.py:133
msgid "No suitable unallocated space was found. To protect your data, create unallocated space with a partitioning tool, then boot the installer again and rescan the disk."
msgstr "Không tìm thấy khoảng trống chưa phân bổ phù hợp. Để bảo vệ dữ liệu của bạn, hãy tạo không gian chưa phân bổ bằng công cụ phân vùng, sau đó khởi động trình cài đặt lại và quét lại đĩa."

