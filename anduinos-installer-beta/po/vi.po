#: src/pages.py:2092
msgid "Installing an input method requires an Internet connection."
msgstr "Cần kết nối Internet để cài đặt bộ gõ."

#: src/pages.py:2103
msgid ""
"No Internet connection. Input methods cannot be installed. You can install "
"them later when connected."
msgstr ""
"Không có kết nối Internet. Không thể cài đặt bộ gõ. Bạn có thể cài đặt sau "
"khi kết nối."

#: src/pages.py:4933
msgid ""
"\n"
"\n"
"A real installation will create a machine-local MOK. After reboot, choose Enroll MOK → Continue → Yes in MOKManager and enter password 123456."
msgstr ""
"\n"
"\n"
"Cài đặt thực tế sẽ tạo MOK cục bộ cho máy. Sau khi khởi động lại, hãy chọn Enroll MOK → Continue → Yes trong MOKManager và nhập mật khẩu 123456."

#: src/pages.py:4944
msgid ""
"\n"
"On the blue MOKManager screen choose Enroll MOK → Continue → Yes, password: 123456"
msgstr ""
"\n"
"Trên màn hình MOKManager màu xanh lam, hãy chọn Enroll MOK → Continue → Yes, mật khẩu: 123456"

#: src/pages.py:4275
msgid "4 GiB disk swap (priority 10) + 50% RAM LZ4 zram (priority 100)"
msgstr "Swap đĩa 4 GiB (độ ưu tiên 10) + zram LZ4 50% RAM (độ ưu tiên 100)"

#: src/pages.py:4085
msgid "; sudo does not require a password"
msgstr "; sudo không yêu cầu mật khẩu"

#: src/pages.py:4087
msgid "; sudo requires the account password"
msgstr "; sudo yêu cầu mật khẩu tài khoản"

#: src/pages.py:129
msgid ""
"A partition on this disk is mounted. Unmount it and rescan storage before "
"continuing."
msgstr ""
"Một phân vùng trên ổ đĩa này đang được gắn kết. Hãy ngắt kết nối nó và quét "
"lại bộ nhớ trước khi tiếp tục."

#: src/pages.py:2899
msgid "ALL DATA on {disk} will be permanently erased."
msgstr "TẤT CẢ DỮ LIỆU trên {disk} sẽ bị xóa vĩnh viễn."

#: src/pages.py:4082
msgid "Account security"
msgstr "Bảo mật tài khoản"

#: src/pages.py:2980
msgid "Advanced Storage"
msgstr "Bộ nhớ nâng cao"

#: src/pages.py:2889
msgid ""
"Advanced coexistence can affect EFI firmware state and may trigger BitLocker"
" recovery. It never shrinks or repairs Windows volumes."
msgstr ""
"Tính năng cùng tồn tại nâng cao có thể ảnh hưởng đến trạng thái firmware EFI"
" và có thể kích hoạt khôi phục BitLocker. Nó không bao giờ thu nhỏ hoặc sửa "
"chữa các vùng lưu trữ Windows."

#: src/pages.py:2838
msgid "Advanced — keep existing systems"
msgstr "Nâng cao — giữ lại các hệ thống hiện có"

#: src/pages.py:2985
msgid "Advanced: Install Alongside"
msgstr "Nâng cao: Cài đặt song song"

#: src/pages.py:164
msgid ""
"After changing partitions or unmounting a volume, rescan storage and select "
"the target again."
msgstr ""
"Sau khi thay đổi phân vùng hoặc ngắt kết nối một vùng lưu trữ, hãy quét lại "
"bộ nhớ và chọn đích lần nữa."

#: src/pages.py:4801
msgid ""
"After restart, MOKManager will open. Choose Enroll MOK → Continue → Yes, "
"then enter password 123456."
msgstr ""
"Sau khi khởi động lại, MOKManager sẽ mở ra. Hãy chọn Enroll MOK → Continue →"
" Yes, sau đó nhập mật khẩu 123456."

#: src/pages.py:4432
msgid ""
"All partitions and data on {disk} will be destroyed.\n"
"\n"
msgstr ""
"Tất cả các phân vùng và dữ liệu trên {disk} sẽ bị phá hủy.\n"
"\n"

#: src/pages.py:155
msgid ""
"Alternatively, you may explicitly select one entire partition to erase. "
"Everything in that selected partition will be destroyed; it is never "
"selected automatically."
msgstr ""
"Ngoài ra, bạn có thể chọn rõ ràng toàn bộ một phân vùng để xóa. Mọi thứ "
"trong phân vùng được chọn đó sẽ bị phá hủy; nó không bao giờ được chọn tự "
"động."

#: src/pages.py:924 src/pages.py:986
msgid "Battery power is too low for a safe installation."
msgstr "Mức pin quá thấp để cài đặt an toàn."

#: src/pages.py:895
msgid "Charge to at least 80% before starting the installation."
msgstr "Hãy sạc pin lên ít nhất 80% trước khi bắt đầu cài đặt."

#: src/pages.py:1041 src/pages.py:1016
msgid "Continue Anyway"
msgstr "Vẫn tiếp tục"

#: src/pages.py:1000
msgid "Current battery level: {percent}%"
msgstr "Mức pin hiện tại: {percent}%"

#: src/pages.py:1006
msgid "External power is connected."
msgstr "Đã kết nối nguồn điện ngoài."

#: src/pages.py:1008
msgid "External power is not connected."
msgstr "Chưa kết nối nguồn điện ngoài."

#: src/pages.py:954
msgid "I understand the risks and insist on installing with low battery."
msgstr "Tôi hiểu các rủi ro và vẫn muốn cài đặt khi pin yếu."

#: src/pages.py:894 src/pages.py:889 src/pages.py:967 src/pages.py:969
msgid "Low battery"
msgstr "Pin yếu"

#: src/pages.py:948
msgid "Recheck"
msgstr "Kiểm tra lại"

#: src/main.py:110 src/pages.py:731 src/pages.py:815
msgid "AnduinOS Installer"
msgstr "Cài đặt AnduinOS"

#: src/main.py:108
msgid "AnduinOS Installer (Development)"
msgstr "Cài đặt AnduinOS (Phát triển)"

#: src/pages.py:4425
msgid ""
"AnduinOS will use only the selected unallocated space on {disk}. Existing partitions will be preserved.\n"
"\n"
msgstr ""
"AnduinOS sẽ chỉ sử dụng phần dung lượng chưa được phân bổ đã chọn trên {disk}. Các phân vùng hiện có sẽ được giữ nguyên.\n"
"\n"

#: src/pages.py:133
msgid ""
"AnduinOS will use only the selected unallocated space. The installer will "
"not shrink or move an existing filesystem."
msgstr ""
"AnduinOS sẽ chỉ sử dụng phần dung lượng chưa được phân bổ đã chọn. Trình cài"
" đặt sẽ không thu nhỏ hoặc di chuyển hệ thống tệp hiện có."

#: data/languages.json:keyboard_layouts
msgid "Arabic"
msgstr "Tiếng Ả Rập"

#: src/pages.py:268 src/pages.py:4461 src/pages.py:817
msgid "Back"
msgstr "Quay lại"

#: src/pages.py:3014
msgid ""
"Before continuing: finish Windows updates, disable Fast Startup and "
"hibernation, and back up the BitLocker recovery key. EFI, Secure Boot, TPM "
"measurements and boot order can change."
msgstr ""
"Trước khi tiếp tục: hoàn tất các bản cập nhật Windows, tắt Khởi động nhanh "
"và chế độ ngủ đông, sao lưu khóa khôi phục BitLocker. EFI, Khởi động an "
"toàn, đo lường TPM và thứ tự khởi động có thể thay đổi."

#: src/pages.py:2470
msgid "BitLocker detected"
msgstr "Phát hiện BitLocker"

#: src/pages.py:146
msgid ""
"BitLocker storage will be preserved. The installer will not unlock, resize, "
"repair or otherwise modify it."
msgstr ""
"Lưu trữ BitLocker sẽ được giữ nguyên. Trình cài đặt sẽ không mở khóa, thay "
"đổi kích thước, sửa chữa hoặc sửa đổi nó theo bất kỳ cách nào khác."

#: src/pages.py:4186
msgid "Boot policy"
msgstr "Chính sách khởi động"

