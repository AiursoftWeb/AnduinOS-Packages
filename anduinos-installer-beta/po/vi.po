msgstr "Tiếng Việt"

msgid "Welcome to AnduinOS"
msgstr "Chào mừng đến với AnduinOS"

msgid "Windows detected"
msgstr "Windows đã được phát hiện"

msgid ""
"Write only EFI/AnduinOS, do not overwrite EFI/BOOT, and require a verified "
"AnduinOS NVRAM entry."
msgstr ""
"Chỉ ghi EFI/AnduinOS, không ghi đè lên EFI/BOOT và yêu cầu mục NVRAM "
"AnduinOS đã được xác minh."

msgid "automatic login"
