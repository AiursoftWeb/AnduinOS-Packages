msgstr "Cấu trúc đĩa được chọn đã thay đổi. Hãy chọn lại."

#: src/pages.py:6292 src/pages.py:6293 src/pages.py:6302
msgid "none"
msgstr "không"

#: src/pages.py:6295
#, python-brace-format
msgid "{path}: {before} → {after} (free {reclaimed})"
msgstr "{path}: {before} → {after} (dung lượng thu hồi: {reclaimed})"

#: src/pages.py:6304
#, python-brace-format
msgid "{name}: {size} MiB ({start}–{end})"
msgstr "{name}: {size} MiB ({start}–{end})"

#: src/pages.py:6320
msgid "Initialize a new empty GPT"
msgstr "Khởi tạo GPT trống mới"

#: src/pages.py:6322
msgid "Keep the current GPT"
msgstr "Giữ GPT hiện tại"

#: src/pages.py:6326
#, python-brace-format
msgid "Reuse {path}; inspect it and never format it."
msgstr "Tái sử dụng {path}; kiểm tra nó và không bao giờ định dạng."

#: src/pages.py:6330
msgid "Create and format a new EFI System Partition."
msgstr "Tạo và định dạng phân vùng Hệ thống EFI mới."

#: src/pages.py:6334
msgid "Advanced manual GPT"
msgstr "GPT thủ công nâng cao"

#: src/pages.py:6335
msgid "Partition table"
msgstr "Bảng phân vùng"

#: src/pages.py:6337
msgid "Deleted partitions"
msgstr "Các phân vùng đã bị xóa"

#: src/pages.py:6338
msgid "Resized partitions"
msgstr "Các phân vùng đã thay đổi kích thước"

#: src/pages.py:6344
msgid "Write only EFI/AnduinOS, preserve EFI/BOOT, and create a verified AnduinOS NVRAM entry."
msgstr "Chỉ ghi EFI/AnduinOS, giữ EFI/BOOT và tạo một mục NVRAM AnduinOS đã xác minh."

#: src/pages.py:6402
msgid "Manual storage selection is missing. Return and review it."
msgstr "Thiếu lựa chọn lưu trữ thủ công. Quay lại và xem xét lại."

#: src/pages.py:6496
msgid "⚠ Listed NTFS resizes will move filesystem data and partition boundaries. Listed partitions will be deleted and every listed new partition will be formatted. Back up important data first; these partitioning operations cannot be undone."
msgstr "⚠ Việc thay đổi kích thước các phân vùng NTFS được liệt kê sẽ di chuyển dữ liệu hệ thống tệp và ranh giới phân vùng. Các phân vùng được liệt kê sẽ bị xóa và mọi phân vùng mới được liệt kê sẽ được định dạng. Hãy sao lưu dữ liệu quan trọng trước; các thao tác phân vùng này không thể hoàn tác."

#: src/pages.py:6606
msgid "Apply this manual disk layout?"
msgstr "Áp dụng bố cục ổ đĩa thủ công này?"

#: src/pages.py:6607 src/pages.py:6735
msgid "Apply Layout and Install"
msgstr "Áp dụng bố cục và cài đặt"

#: src/pages.py:6630
#, python-brace-format
msgid ""
"AnduinOS will apply only the reviewed manual changes to {disk}.\n"
"\n"
msgstr ""
"AnduinOS sẽ chỉ áp dụng các thay đổi thủ công đã được xem xét cho {disk}.\n"
"\n"

#: src/pages.py:6658
msgid "Only the explicitly listed partitions will be deleted or formatted. Uninvolved partitions remain unchanged; EFI/BOOT is not overwritten."
msgstr "Chỉ các phân vùng được liệt kê rõ ràng sẽ bị xóa hoặc định dạng. Các phân vùng không liên quan vẫn giữ nguyên; EFI/BOOT không bị ghi đè."

#: src/pages.py:4072
msgid "Edit one GPT disk. Partition starts are never moved; plain NTFS may be shrunk after safety checks."
msgstr "Chỉnh sửa một đĩa GPT. Vị trí bắt đầu của phân vùng sẽ không bao giờ bị dịch chuyển; phân vùng NTFS không mã hóa có thể được thu nhỏ sau khi kiểm tra an toàn."

#: src/pages.py:5119
msgid "XFS (classic, scalable)"
msgstr "XFS (cổ điển, có thể mở rộng)"

#: src/pages.py:5120
msgid "F2FS (flash-optimized)"
msgstr "F2FS (tối ưu cho flash)"

#: src/pages.py:3004
msgid "0 GiB · ZRAM only"
msgstr "0 GiB · Chỉ ZRAM"

#: src/pages.py:2900
msgid "Disk Swap will not be created. ZRAM remains enabled, but sustained memory pressure can terminate applications and hibernation is unavailable. This is strongly discouraged."
msgstr "Swap trên đĩa sẽ không được tạo. ZRAM vẫn được bật, nhưng áp lực bộ nhớ kéo dài có thể khiến ứng dụng bị buộc dừng và chế độ ngủ đông sẽ không khả dụng. Rất không nên sử dụng cấu hình này."

#: src/pages.py:6702
msgid "Review your custom Swap size"
msgstr "Xem lại kích thước Swap tùy chỉnh của bạn"

#: src/pages.py:2927
msgid "This exceeds the AnduinOS recommendation. It consumes more disk space and normally does not improve runtime performance."
msgstr "Kích thước này vượt quá khuyến nghị của AnduinOS. Nó chiếm nhiều dung lượng ổ đĩa hơn và thường không cải thiện hiệu suất khi sử dụng thông thường."

#: src/pages.py:2913
msgid "This is below AnduinOS's runtime safety target. ZRAM still works, but heavy browser or application workloads can run out of backing memory sooner; hibernation is also unavailable."
msgstr "Kích thước này thấp hơn mức tối thiểu an toàn mà AnduinOS khuyến nghị cho việc sử dụng thông thường. ZRAM vẫn hoạt động, nhưng khi trình duyệt hoặc ứng dụng chạy tác vụ nặng, dung lượng Swap khả dụng có thể cạn kiệt nhanh hơn; chế độ ngủ đông cũng không khả dụng."

#: src/pages.py:2920
msgid "This size protects ordinary memory pressure, but is smaller than the hibernation target. Hibernation may fail or be unavailable."
msgstr "Kích thước này đủ để ứng phó với tình trạng thiếu bộ nhớ thông thường, nhưng nhỏ hơn dung lượng cần thiết cho chế độ ngủ đông. Chế độ ngủ đông có thể thất bại hoặc không khả dụng."

#: src/pages.py:3028
msgid "ZRAM always remains enabled: 50% of RAM · LZ4 · priority 100. Disk Swap uses priority 10."
msgstr "ZRAM luôn được bật: 50% RAM · LZ4 · độ ưu tiên 100. Swap trên đĩa sử dụng độ ưu tiên 10."

#: src/pages.py:6705
msgid "ZRAM will remain enabled regardless of this choice."
msgstr "ZRAM sẽ vẫn được bật bất kể lựa chọn này."

#: src/pages.py:3008
msgid "{size} GiB · Max"
msgstr "{size} GiB · Tối đa"

#: src/pages.py:2895
msgid "✓ Best performance — AnduinOS recommended Swap size."
msgstr "✓ Hiệu suất tối ưu — Kích thước Swap được AnduinOS khuyến nghị."

#: anduinos-installer-beta/assets/com.anduinos.installer-beta.policy:11
msgid "Authorization is required to inspect disk partition geometry"
msgstr "Yêu cầu ủy quyền để kiểm tra vị trí và kích thước chính xác của các phân vùng ổ đĩa"

#: anduinos-installer-beta/assets/com.anduinos.installer-beta.policy:10
msgid "Read exact disk partition geometry for the AnduinOS installer"
msgstr "Đọc vị trí và kích thước chính xác của các phân vùng ổ đĩa cho trình cài đặt AnduinOS"

