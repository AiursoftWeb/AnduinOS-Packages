msgid "Advanced Options"
msgstr "Tùy chọn nâng cao"

#: src/pages.py:3747
msgid "Allow SSH login with the account password"
msgstr "Cho phép đăng nhập SSH bằng mật khẩu tài khoản"

#: src/pages.py:4089
msgid "Automatic desktop login"
msgstr "Tự động đăng nhập màn hình nền"

#: src/pages.py:3701
msgid ""
"Choose how the local administrator account signs in and authorizes system "
"changes."
msgstr ""
"Chọn cách tài khoản quản trị viên cục bộ đăng nhập và cho phép thay đổi hệ "
"thống."

#: src/pages.py:3682
msgid "Choose optional access and sign-in policies"
msgstr "Chọn chính sách truy cập và đăng nhập tùy chọn"

#: src/pages.py:3709
msgid "Choose whether this computer accepts remote Secure Shell connections."
msgstr ""
"Chọn có cho phép máy tính này chấp nhận kết nối Secure Shell từ xa hay "
"không."

#: src/pages.py:4604
msgid "Configure Secure Shell"
msgstr "Cấu hình Secure Shell"

#: src/pages.py:3699
msgid "Local Access"
msgstr "Truy cập cục bộ"

#: src/pages.py:3737
msgid "Log in to the desktop automatically"
msgstr "Tự động đăng nhập vào màn hình nền"

#: src/pages.py:3739
msgid "Open this account's desktop automatically when the computer starts."
msgstr "Tự động mở màn hình nền của tài khoản này khi máy tính khởi động."

#: src/pages.py:3707
msgid "Remote Access"
msgstr "Truy cập từ xa"

#: src/pages.py:3730
msgid "Run sudo commands without a password"
msgstr "Chạy lệnh sudo mà không cần mật khẩu"

#: src/pages.py:4095
msgid "SSH password login"
msgstr "Đăng nhập SSH bằng mật khẩu"

#: src/pages.py:3749
msgid "Start Secure Shell and accept this account password over the network."
msgstr ""
"Khởi động Secure Shell và chấp nhận mật khẩu của tài khoản này qua mạng."

#: src/pages.py:3759
msgid "This will reduce the security of the installed system."
msgstr "Điều này sẽ làm giảm tính bảo mật của hệ thống đã cài đặt."

#: src/pages.py:4093 src/pages.py:4099
msgid "disabled"
msgstr "đã tắt"

#: src/pages.py:4091 src/pages.py:4097
msgid "enabled"
msgstr "đã bật"

#: src/pages.py:349
msgid ""
"AnduinOS has comprehensive Secure Boot support. Secure Boot is not currently"
" enabled on this computer, and we recommend enabling it for additional "
"protection."
msgstr ""
"AnduinOS hỗ trợ đầy đủ tính năng Secure Boot. Secure Boot hiện chưa được bật"
" trên máy tính này, và chúng tôi khuyến nghị bật tính năng này để bảo vệ "
"thêm."

#: src/pages.py:331
msgid "AnduinOS supports Secure Boot"
msgstr "AnduinOS hỗ trợ Secure Boot"

#: src/pages.py:360
msgid ""
"Battery power is sufficient or reliable power is connected. You can continue"
" with the installation."
msgstr ""
"Nguồn điện pin đủ hoặc nguồn điện ổn định đã được kết nối. Bạn có thể tiếp "
"tục cài đặt."

#: src/pages.py:366
msgid ""
"Connect reliable external power and charge above 25%, or charge above 45% "
"while unplugged."
msgstr ""
"Cắm nguồn điện ngoài ổn định và sạc trên 25%, hoặc sạc trên 45% khi không "
"cắm sạc."

#: src/pages.py:338
msgid "Could not open UEFI firmware settings"
msgstr "Không thể mở cài đặt firmware UEFI"

#: src/pages.py:333
msgid "Get additional protection before installing AnduinOS."
msgstr "Bật các biện pháp bảo vệ bổ sung trước khi cài đặt AnduinOS."

#: src/pages.py:364
msgid "Power conditions are safe for installation."
msgstr "Điều kiện nguồn điện an toàn để cài đặt."

#: src/pages.py:363
msgid "Power ready"
msgstr "Nguồn điện sẵn sàng"

#: src/pages.py:335
msgid "Restart to UEFI Firmware Settings"
msgstr "Khởi động lại vào Cài đặt Firmware UEFI"

#: src/pages.py:345
msgid ""
"Secure Boot is a UEFI security feature that verifies trusted, digitally "
"signed software while your computer starts."
msgstr ""
"Secure Boot là tính năng bảo mật UEFI xác minh phần mềm được tin cậy, có chữ"
" ký số khi máy tính khởi động."

#: src/pages.py:336
msgid "Skip"
msgstr "Bỏ qua"

#: src/pages.py:341
msgid "The firmware settings could not be opened on this computer."
msgstr "Không thể mở cài đặt firmware trên máy tính này."

#: src/pages.py:354
msgid ""
"To enable it, open the UEFI firmware settings and look under Boot, Security,"
" or Secure Boot. Select Microsoft & 3rd-party CA or turn Secure Boot on. "
"Firmware wording varies by manufacturer."
msgstr ""
"Để bật tính năng này, hãy mở cài đặt firmware UEFI và tìm trong mục Boot, "
"Security, hoặc Secure Boot. Chọn Microsoft & 3rd-party CA hoặc bật Secure "
"Boot. Từ ngữ trong firmware có thể khác nhau tùy theo nhà sản xuất."
