#: src/pages.py:2244
msgid "Installing an input method requires an Internet connection."
msgstr "Cần kết nối Internet để cài đặt bộ gõ."

#: src/pages.py:2255
msgid "No Internet connection. Input methods cannot be installed. You can install them later when connected."
msgstr "Không có kết nối Internet. Không thể cài đặt bộ gõ. Bạn có thể cài đặt sau khi kết nối."

#: src/pages.py:7174
msgid ""
"\n"
"\n"
"A real installation will create a machine-local MOK. After reboot, choose Enroll MOK → Continue → Yes in MOKManager and enter password 123456."
msgstr ""
"\n"
"\n"
"Cài đặt thực tế sẽ tạo MOK cục bộ cho máy. Sau khi khởi động lại, hãy chọn Enroll MOK → Continue → Yes trong MOKManager và nhập mật khẩu 123456."

#: src/pages.py:7185
msgid ""
"\n"
"On the blue MOKManager screen choose Enroll MOK → Continue → Yes, password: 123456"
msgstr ""
"\n"
"Trên màn hình MOKManager màu xanh lam, hãy chọn Enroll MOK → Continue → Yes, mật khẩu: 123456"

#: src/pages.py:6191
msgid "; sudo does not require a password"
msgstr "; sudo không yêu cầu mật khẩu"

#: src/pages.py:6193
msgid "; sudo requires the account password"
msgstr "; sudo yêu cầu mật khẩu tài khoản"

#: src/pages.py:160
msgid "A partition on this disk is mounted. Unmount it and rescan storage before continuing."
msgstr "Một phân vùng trên ổ đĩa này đang được gắn kết. Hãy ngắt kết nối nó và quét lại bộ nhớ trước khi tiếp tục."

#: src/pages.py:3241
msgid "ALL DATA on {disk} will be permanently erased."
msgstr "TẤT CẢ DỮ LIỆU trên {disk} sẽ bị xóa vĩnh viễn."

#: src/pages.py:6188
msgid "Account security"
msgstr "Bảo mật tài khoản"

#: src/pages.py:4066
msgid "Advanced Storage"
msgstr "Bộ nhớ nâng cao"

#: src/pages.py:195
msgid "After changing partitions or unmounting a volume, rescan storage and select the target again."
msgstr "Sau khi thay đổi phân vùng hoặc ngắt kết nối một vùng lưu trữ, hãy quét lại bộ nhớ và chọn đích lần nữa."

#: src/pages.py:7042
msgid "After restart, MOKManager will open. Choose Enroll MOK → Continue → Yes, then enter password 123456."
msgstr "Sau khi khởi động lại, MOKManager sẽ mở ra. Hãy chọn Enroll MOK → Continue → Yes, sau đó nhập mật khẩu 123456."

#: src/pages.py:6636
msgid ""
"All partitions and data on {disk} will be destroyed.\n"
"\n"
msgstr ""
"Tất cả các phân vùng và dữ liệu trên {disk} sẽ bị phá hủy.\n"
"\n"

#: src/pages.py:186
msgid "Alternatively, you may explicitly select one entire partition to erase. Everything in that selected partition will be destroyed; it is never selected automatically."
msgstr "Ngoài ra, bạn có thể chọn rõ ràng toàn bộ một phân vùng để xóa. Mọi thứ trong phân vùng được chọn đó sẽ bị phá hủy; nó không bao giờ được chọn tự động."

#: src/pages.py:991 src/pages.py:1053
msgid "Battery power is too low for a safe installation."
msgstr "Mức pin quá thấp để cài đặt an toàn."

#: src/pages.py:962
msgid "Charge to at least 80% before starting the installation."
msgstr "Hãy sạc pin lên ít nhất 80% trước khi bắt đầu cài đặt."

#: src/pages.py:1108 src/pages.py:1083
msgid "Continue Anyway"
msgstr "Vẫn tiếp tục"

#: src/pages.py:1067
msgid "Current battery level: {percent}%"
msgstr "Mức pin hiện tại: {percent}%"

#: src/pages.py:1073
msgid "External power is connected."
msgstr "Đã kết nối nguồn điện ngoài."

#: src/pages.py:1075
msgid "External power is not connected."
msgstr "Chưa kết nối nguồn điện ngoài."

#: src/pages.py:1021
msgid "I understand the risks and insist on installing with low battery."
msgstr "Tôi hiểu các rủi ro và vẫn muốn cài đặt khi pin yếu."

