#: src/pages.py:863
msgid "No suitable disks found."
msgstr "Không tìm thấy đĩa phù hợp."

#: src/pages.py:917
msgid "Choose Installation Method"
msgstr "Chọn Phương thức Cài đặt"

#: src/pages.py:922
msgid "How should AnduinOS use this disk?"
msgstr "AnduinOS nên sử dụng đĩa này như thế nào?"

#: src/pages.py:937 src/pages.py:1191 src/pages.py:1425
#, python-brace-format
msgid "Target: {disk} ({size} — {model})"
msgstr "Mục tiêu: {disk} ({size} — {model})"

#: src/pages.py:1014
msgid "Erase every partition and all data on the selected disk."
msgstr "Xóa mọi phân vùng và tất cả dữ liệu trên đĩa đã chọn."

#: src/pages.py:1018
msgid "Btrfs — recommended"
msgstr "Btrfs — được khuyến nghị"

#: src/pages.py:1022
msgid "Enables shared-space subvolumes, snapshots and Timeback Machine."
msgstr "Kích hoạt các subvolume không gian chia sẻ, snapshot và Timeback Machine."

#: src/pages.py:1030
msgid "ext4 — classic"
msgstr "ext4 — cổ điển"

#: src/pages.py:1033
msgid "Uses a traditional single root filesystem."
msgstr "Sử dụng hệ thống tệp gốc đơn truyền thống."

#: src/pages.py:1039
msgid "Advanced — keep existing systems"
msgstr "Nâng cao — giữ lại các hệ thống hiện có"

#: src/pages.py:1041
msgid "Use already-unallocated space and preserve existing partitions. This is the only Windows coexistence path."
msgstr "Sử dụng khoảng trống chưa phân bổ sẵn và bảo toàn các phân vùng hiện có. Đây là cách duy nhất để cùng tồn tại với Windows."

#: src/pages.py:1089
msgid "Advanced coexistence can affect EFI firmware state and may trigger BitLocker recovery. It never shrinks or repairs Windows volumes."
msgstr "Tính năng cùng tồn tại nâng cao có thể ảnh hưởng đến trạng thái firmware EFI và có thể kích hoạt khôi phục BitLocker. Nó không bao giờ thu nhỏ hoặc sửa chữa các vùng lưu trữ Windows."

#: src/pages.py:1099
#, python-brace-format
msgid "ALL DATA on {disk} will be permanently erased."
msgstr "TẤT CẢ DỮ LIỆU trên {disk} sẽ bị xóa vĩnh viễn."

#: src/pages.py:1135
msgid "This disk is too small for whole-disk installation. Advanced may continue only if suitable unallocated space exists."
msgstr "Ổ đĩa này quá nhỏ để cài đặt toàn bộ ổ đĩa. Chế độ nâng cao chỉ có thể tiếp tục nếu có đủ không gian chưa phân bổ phù hợp."

#: src/pages.py:1145
msgid "Existing partitions were detected. The first two choices delete them; Advanced is the preservation path."
msgstr "Đã phát hiện các phân vùng hiện có. Hai lựa chọn đầu tiên sẽ xóa chúng; Nâng cao là đường dẫn bảo tồn."

#: src/pages.py:1178
msgid "Advanced Storage"
msgstr "Bộ nhớ nâng cao"

#: src/pages.py:1183
msgid "Advanced: Install Alongside"
msgstr "Nâng cao: Cài đặt song song"

#: src/pages.py:1212
msgid "Before continuing: finish Windows updates, disable Fast Startup and hibernation, and back up the BitLocker recovery key. EFI, Secure Boot, TPM measurements and boot order can change."
msgstr "Trước khi tiếp tục: hoàn tất các bản cập nhật Windows, tắt Khởi động nhanh và chế độ ngủ đông, sao lưu khóa khôi phục BitLocker. EFI, Khởi động an toàn, đo lường TPM và thứ tự khởi động có thể thay đổi."

#: src/pages.py:1219
msgid "This advanced path preserves existing partitions but changes the selected disk's partition table and the machine's EFI boot state."
msgstr "Path nâng cao này bảo toàn các phân vùng hiện có nhưng thay đổi bảng phân vùng của ổ đĩa đã chọn và trạng thái khởi động EFI của máy."

#: src/pages.py:1250 src/pages.py:2113
msgid "Filesystem"
msgstr "Hệ thống tập tin"

#: src/pages.py:1253
msgid "Btrfs (recommended)"
msgstr "Btrfs (được khuyến nghị)"

#: src/pages.py:1253
msgid "ext4 (classic)"
msgstr "ext4 (cổ điển)"

#: src/pages.py:1263
msgid "Unallocated space"
msgstr "Khoảng trống chưa phân bổ"

#: src/pages.py:1271
msgid "EFI System Partition"
msgstr "Phân vùng Hệ thống EFI"

#: src/pages.py:1285
msgid "Rescan and Reselect Disk"
msgstr "Tìm lại và chọn lại đĩa"

#: src/pages.py:1326
msgid "Create a new 1 GiB AnduinOS EFI System Partition"
msgstr "Tạo phân vùng EFI Hệ thống AnduinOS mới 1 GiB"

#: src/pages.py:1330
#, python-brace-format
msgid "Reuse {path} ({size})"
msgstr "Tái sử dụng {path} ({size})"

#: src/pages.py:1394
#, python-brace-format
msgid "The selected disk changed or disappeared. Return to the disk page and select it again. {error}"
msgstr "Đĩa đã chọn bị thay đổi hoặc biến mất. Quay lại trang đĩa và chọn lại. {error}"

#: src/pages.py:1407
msgid "The selected disk size changed. Return and select it again."
msgstr "Kích thước đĩa đã chọn bị thay đổi. Quay lại và chọn lại."

#: src/pages.py:1417
msgid "The selected disk topology changed. Review the disk and installation method again."
msgstr "Cấu trúc đĩa đã chọn bị thay đổi. Xem xét lại đĩa và phương pháp cài đặt."

#: src/pages.py:1453
#, python-brace-format
msgid "{size} unallocated at {offset}"
msgstr "{size} chưa phân bổ tại {offset}"

#: src/pages.py:1579 src/pages.py:1585
msgid "User Account"
msgstr "Tài khoản người dùng"

#: src/pages.py:1605 src/pages.py:1606
msgid "Full Name"
msgstr "Họ và tên đầy đủ"

#: src/pages.py:1609 src/pages.py:1612
msgid "Username"
msgstr "Tên người dùng"

#: src/pages.py:1616 src/pages.py:1627
msgid "Password"
msgstr "Mật khẩu"

#: src/pages.py:1620 src/pages.py:1628
msgid "Confirm Password"
msgstr "Xác nhận mật khẩu"

#: src/pages.py:1632
msgid "Do not require a password for sudo commands"
msgstr "Không yêu cầu mật khẩu cho các lệnh sudo"

#: src/pages.py:1638 src/pages.py:1643 src/pages.py:2157
msgid "Computer Name"
msgstr "Tên máy tính"

#: src/pages.py:1669
msgid "Username must start with a lowercase ASCII letter and contain only lowercase ASCII letters or digits (maximum 16 characters)."
msgstr "Username must start with a lowercase ASCII letter and contain only lowercase ASCII letters or digits (maximum 16 characters)."

#: src/pages.py:1680
msgid "Install alongside requires a password-protected account."
msgstr "Cài đặt song song yêu cầu tài khoản được bảo vệ bằng mật khẩu."

#: src/pages.py:1691
msgid "The two passwords do not match."
msgstr "Hai mật khẩu không khớp nhau."

#: src/pages.py:1695
msgid "Password must be at least 6 characters."
msgstr "Mật khẩu phải có ít nhất 6 ký tự."

#: src/pages.py:1703
msgid "Computer name contains invalid characters."
msgstr "Tên máy tính chứa ký tự không hợp lệ."

#: src/pages.py:1756
msgid "Return to Make Changes"
msgstr "Quay lại để thực hiện thay đổi"

#: src/pages.py:1763
msgid "This configuration is very unsafe"
msgstr "Cấu hình này rất không an toàn"

#: src/pages.py:1765
msgid "Passwordless sudo is unsafe"
msgstr "Sudo không mật khẩu là không an toàn"

#: src/pages.py:1769
msgid "The system will sign in to this account automatically and allow it to obtain full administrator privileges without a password. Anyone with physical access, and any program running as this user, can completely control the system. Use this only for a kiosk, temporary virtual machine, or another controlled environment."
msgstr "Hệ thống sẽ tự động đăng nhập vào tài khoản này và cho phép nó giành được đặc quyền quản trị viên đầy đủ mà không cần mật khẩu. Bất kỳ ai có quyền truy cập vật lý và bất kỳ chương trình nào chạy dưới quyền người dùng này đều có thể kiểm soát hoàn toàn hệ thống. Chỉ sử dụng điều này cho kiosk, máy ảo tạm thời hoặc môi trường được kiểm soát khác."

#: src/pages.py:1778
msgid "Any program running as your user can obtain full administrator privileges without authentication. Your login password still protects sign-in, but it will not protect sudo. Are you sure you want to continue?"
msgstr "Bất kỳ chương trình nào chạy dưới quyền người dùng của bạn đều có thể giành được đặc quyền quản trị viên đầy đủ mà không cần xác thực. Mật khẩu đăng nhập của bạn vẫn bảo vệ việc đăng nhập, nhưng sẽ không bảo vệ sudo. Bạn có chắc chắn muốn tiếp tục không?"

#: src/pages.py:1792
msgid "Return and Set a Password"
msgstr "Quay lại và Đặt mật khẩu"

#: src/pages.py:1798
msgid "I Understand the Risk, Continue"
msgstr "Tôi hiểu rủi ro, tiếp tục"

#: src/pages.py:1822
msgid "Administrator access would be locked"
