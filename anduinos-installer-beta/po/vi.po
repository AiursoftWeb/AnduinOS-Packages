msgstr "Khả dụng: {error}"

msgid "Unknown filesystem"
msgstr "Hệ thống tệp không xác định"

msgid "Unmount installed system"
msgstr "Gỡ cài đặt hệ thống đã cài đặt"

msgid "Updates and Drivers"
msgstr "Bản cập nhật và Trình điều khiển"

msgid ""
"Use already-unallocated space and preserve existing partitions. This is the "
"only Windows coexistence path."
msgstr ""
"Sử dụng khoảng trống chưa phân bổ sẵn và bảo toàn các phân vùng hiện có. Đây "
"là cách duy nhất để cùng tồn tại với Windows."

msgid "Use only existing unallocated space on the selected disk."
msgstr "Chỉ sử dụng khoảng trống chưa phân bổ hiện có trên ổ đĩa đã chọn."

