msgstr "{path}: {before} → {after} (free {reclaimed})"

#, python-brace-format
msgid "{name}: {size} MiB ({start}–{end})"
msgstr "{name}: {size} MiB ({start}–{end})"

msgid "Initialize a new empty GPT"
msgstr "새로운 빈 GPT 초기화"

msgid "Keep the current GPT"
msgstr "현재 GPT 유지"

#, python-brace-format
msgid "Reuse {path}; inspect it and never format it."
msgstr "{path}를 재사용합니다. 검사만 하고 절대 포맷하지 마세요."

msgid "Create and format a new EFI System Partition."
msgstr "新しいEFIシステムパーティションを作成してフォーマットします。"

msgid "Advanced manual GPT"
msgstr "詳細な手動GPT"

msgid "Partition table"
msgstr "파티션 테이블"

msgid "Deleted partitions"
msgstr "削除されたパーティション"

msgid "Resized partitions"
msgstr "Resized partitions"

msgid "Write only EFI/AnduinOS, preserve EFI/BOOT, and create a verified AnduinOS NVRAM entry."
msgstr "EFI/AnduinOS에만 기록하고 EFI/BOOT는 보존하며, 검증된 AnduinOS NVRAM 항목을 생성합니다."

msgid "Manual storage selection is missing. Return and review it."
msgstr "수동 저장소 선택이 누락되었습니다. 돌아가서 검토하십시오."

msgid "⚠ Listed NTFS resizes will move filesystem data and partition boundaries. Listed partitions will be deleted and every listed new partition will be formatted. Back up important data first; these partitioning operations cannot be undone."
msgstr "⚠ Listed NTFS resizes will move filesystem data and partition boundaries. Listed partitions will be deleted and every listed new partition will be formatted. Back up important data first; these partitioning operations cannot be undone."

msgid "Apply this manual disk layout?"
msgstr "この手動ディスクレイアウトを適用しますか?"

msgid "Apply Layout and Install"
msgstr "レイアウトを適用してインストール"

#, python-brace-format
msgid ""
"AnduinOS will apply only the reviewed manual changes to {disk}.\n"
"\n"
msgstr ""
"AnduinOSは{disk}にレビュー済みの手動変更のみを適用します。\n"
"\n"

msgid "Only the explicitly listed partitions will be deleted or formatted. Uninvolved partitions remain unchanged; EFI/BOOT is not overwritten."
msgstr "명시적으로 나열된 파티션만 삭제 또는 포맷됩니다. 관련 없는 파티션은 변경되지 않으며, EFI/BOOT는 덮어쓰지 않습니다."

msgid "Edit one GPT disk. Partition starts are never moved; plain NTFS may be shrunk after safety checks."
msgstr "Edit one GPT disk. Partition starts are never moved; plain NTFS may be shrunk after safety checks."

msgid "XFS (classic, scalable)"
msgstr "XFS (classic, scalable)"

msgid "F2FS (flash-optimized)"
msgstr "F2FS (flash-optimized)"

msgid "XFS and F2FS use one conventional root filesystem; Btrfs additionally creates AnduinOS subvolumes and enables snapshots."
msgstr "XFS and F2FS use one conventional root filesystem; Btrfs additionally creates AnduinOS subvolumes and enables snapshots."
