msgstr "Detectar la conectividad a Internet"

msgid "Detect firmware and Secure Boot"
msgstr "Detectar firmware e Inicio seguro"

msgid ""
"Development mode will simulate installation to {disk}. No disk data will be "
"changed.\n"
"\n"
msgstr ""
"El modo de desarrollo simulará la instalación en {disk}. No se modificarán "
"los datos del disco.\n"
"\n"

msgid "Development simulation completed"
msgstr "Simulación de desarrollo completada"

msgid "Discover AnduinOS"
msgstr "Explore AnduinOS"

msgid "Do not require a password for sudo commands"
msgstr "No requerir contraseña para comandos sudo"

msgid "Download and install system updates during installation"
msgstr ""
"Descargar e instalar actualizaciones del sistema durante la instalación"

