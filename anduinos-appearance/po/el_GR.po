msgstr "✓ Εφαρμόστηκε — {style} | {pos}"

msgid "✓ Desktop settings reset. Restart Shell to apply."
msgstr "✓ Οι ρυθμίσεις επιφάνειας εργασίας επαναφέρθηκαν. Επανεκκινήστε το Shell για εφαρμογή.✓ Οι ρυθμίσεις της επιφάνειας εργασίας επαναφέρθηκαν. Επανεκκίνησε το Shell για να εφαρμοστούν."

msgid "✓ GDM wallpaper applied"
msgstr "✓ Η ταπετσαρία GDM εφαρμόστηκε"

msgid "✓ {label} — {action}d"
msgstr "✓ {label} — {action}ε"

msgid "✗ Failed to apply position"
