msgid "✗ Failed to apply style"
msgstr "✗ Απέτυχε η εφαρμογή στυλ"

msgid "✗ Failed to reset"
msgstr "✗ Απέτυχε η επαναφορά"

msgid "✗ Failed to set GDM wallpaper"
msgstr "✗ Αποτυχία ορισμού ταπετσαρίας GDM"

msgid "✗ Failed to toggle activities button"
msgstr "✗ Αποτυχία εναλλαγής κουμπιού δραστηριοτήτων"

msgid "✗ Failed to {action} {label}"
msgstr "✗ Απέτυχε να {action} το {label}"

msgid "✗ Please select an image first"
msgstr "✗ Παρακαλώ επιλέξτε πρώτα μια εικόνα"

