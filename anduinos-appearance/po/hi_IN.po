msgid "About AnduinOS Appearance"
msgstr "AnduinOS की उपस्थिति के बारे में"

msgid "Advanced"
msgstr "उन्नत"

msgid "AnduinOS Appearance"
msgstr "AnduinOS की उपस्थिति"

msgid "AnduinOS Team"
msgstr "AnduinOS टीम"

msgid "Appearance"
msgstr "उपस्थिति"

msgid "Apply to Login Screen"
msgstr "लॉगिन स्क्रीन पर लागू करें"

msgid "Bottom"
msgstr "नीचे"

msgid "Cancel"
msgstr "रद्द करें"

msgid "Choose an image for the GDM login screen background."
msgstr "GDM लॉगिन स्क्रीन पृष्ठभूमि के लिए एक छवि चुनें।"

msgid "Choose the visual style of your taskbar."
msgstr "अपने टास्कबार का दृश्य शैली चुनें।"

msgid "Choose…"
msgstr "चुनें…"

msgid "Classic"
msgstr "क्लासिक"

msgid "Combine multiple windows of one app into a single icon"
msgstr "एक ही ऐप की कई विंडो को एक आइकन में संयोजित करें"

msgid "Danger Zone"
msgstr "खतरनाक क्षेत्र"

msgid "Display the Activities button on the taskbar"
msgstr "टास्कबार पर गतिविधियाँ बटन प्रदर्शित करें"

msgid "Enable grouping"
msgstr "समूहीकरण सक्षम करें"

msgid "Extension Settings"
msgstr "एक्सटेंशन सेटिंग्स"

msgid "GDM Wallpaper"
msgstr "GDM वॉलपेपर"

msgid "Group apps"
msgstr "ऐप्स को समूहित करें"

msgid "Images"
msgstr "छवियाँ"

msgid "Keep launchers separate from running apps"
msgstr "लॉन्चर को चल रहे ऐप्स से अलग करें"

msgid "Layout"
msgstr "लेआउट"

msgid "Left"
msgstr "बाएं"

msgid "Login Screen Wallpaper"
msgstr "लॉगिन स्क्रीन वॉलपेपर"

msgid "Open"
msgstr "खोलें"

msgid "Open the preference windows of the panel extensions."
msgstr "पैनल एक्सटेंशनों की प्राथमिकता विंडो खोलें।"

msgid "Panel Indicators"
msgstr "पैनल इंडिकेटर्स"

msgid "Panel Widgets"
msgstr "पैनल विजेट्स"

msgid "Preview"
msgstr "पूर्वावलोकन"

msgid "Reset"
msgstr "रीसेट करें"

msgid "Reset desktop settings"
msgstr "डेस्कटॉप सेटिंग्स रीसेट करें"

msgid "Reset desktop settings?"
msgstr "डेस्कटॉप सेटिंग्स रीसेट करें?"

msgid "Restore all GNOME Shell settings to factory defaults"
msgstr "सभी GNOME Shell सेटिंग्स को फैक्टरी डिफ़ॉल्ट पर पुनर्स्थापित करें"

msgid "Right"
msgstr "दाएं"

msgid "Select image"
msgstr "छवि चुनें"

msgid "Seperated"
msgstr "अलग"

msgid "Show Activities Button"
msgstr "गतिविधियाँ बटन दिखाएँ"

msgid "Show Desktop Icons"
msgstr "Show Desktop Icons"

msgid "Show Network"
msgstr "नेटवर्क दिखाएं"

msgid "Show Weather"
msgstr "मौसम दिखाएं"

msgid "Show or hide built-in panel elements."
msgstr "अंतर्निहित पैनल तत्वों को दिखाएं या छिपाएं।"

msgid "Taskbar Elements"
msgstr "टास्कबार तत्व"

msgid "Taskbar Style"
msgstr "टास्कबार शैली"

msgid "Toggle panel indicator widgets on or off."
msgstr "पैनल इंडिकेटर विजेट्स को चालू या बंद करें।"

msgid "Top"
msgstr "ऊपर"

msgid "Tweaks"
msgstr "ट्वीक्स"

msgid "Use Vista taskbar behavior"
msgstr "Vista टास्कबार व्यवहार"

msgid "Wallpaper"
msgstr "वॉलपेपर"

msgid "Windows 11"
msgstr "Show Desktop Icons"

msgid "✓ Activities button — {action}n"
msgstr "✓ गतिविधियाँ बटन — {action}n"

msgid "✓ Applied — {style} | {pos}"
msgstr "✓ लागू किया गया — {style} | {pos}"

msgid "✓ Desktop settings reset. Restart Shell to apply."
msgstr "✓ डेस्कटॉप सेटिंग्स रीसेट हो गईं। लागू करने के लिए Shell पुनः आरंभ करें।"

msgid "✓ GDM wallpaper applied"
msgstr "✓ GDM वॉलपेपर लागू किया गया"

msgid "✓ {label} — {action}d"
msgstr "✓ {label} — {action} किया गया"

msgid "✗ Failed to apply position"
msgstr "✗ स्थिति लागू करने में विफल"

msgid "✗ Failed to apply style"
msgstr "✗ शैली लागू करने में विफल"

msgid "✗ Failed to reset"
msgstr "✗ रीसेट करने में विफल"

msgid "✗ Failed to set GDM wallpaper"
msgstr "✗ GDM वॉलपेपर सेट करने में विफल"

msgid "✗ Failed to toggle activities button"
msgstr "✗ गतिविधियाँ बटन टॉगल करने में विफल"

msgid "✗ Failed to {action} {label}"
msgstr "✗ {action} {label} करने में विफल"

msgid "✗ Please select an image first"
msgstr "✗ कृपया पहले एक छवि चुनें"

