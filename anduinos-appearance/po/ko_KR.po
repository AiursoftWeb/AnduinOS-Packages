msgid "About AnduinOS Appearance"
msgstr "AnduinOS 외관 정보"

msgid "Advanced"
msgstr "고급"

msgid "AnduinOS Appearance"
msgstr "AnduinOS 외관"

msgid "AnduinOS Team"
msgstr "AnduinOS 팀"

msgid "Appearance"
msgstr "외관"

