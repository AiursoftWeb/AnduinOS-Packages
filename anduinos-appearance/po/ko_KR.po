msgstr "바탕 화면 설정 초기화"

msgid "Reset desktop settings?"
msgstr "바탕 화면 설정을 초기화하시겠습니까?"

msgid "Restore all GNOME Shell settings to factory defaults"
msgstr "모든 GNOME Shell 설정을 공장 기본값으로 복원합니다"

msgid "Right"
msgstr "오른쪽"

msgid "Select image"
msgstr "이미지 선택"

msgid "Seperated"
msgstr "분리"

msgid "Show Activities Button"
msgstr "활동 버튼 표시"

msgid "Show Desktop Icons"
msgstr "Show Desktop Icons"

msgid "Show Network"
msgstr "네트워크 표시"

msgid "Show Weather"
msgstr "날씨 표시"

msgid "Show or hide built-in panel elements."
msgstr "내장 패널 요소를 표시하거나 숨깁니다."

msgid "Taskbar Elements"
msgstr "작업 표시줄 요소"

msgid "Taskbar Style"
msgstr "작업 표시줄 스타일"

msgid "Toggle panel indicator widgets on or off."
msgstr "패널 표시기 위젯의 켜기/끄기를 전환합니다."

msgid "Top"
msgstr "위"

msgid "Tweaks"
msgstr "설정 튜닝"

msgid "Use Vista taskbar behavior"
msgstr "Vista 작업 표시줄 동작 사용"

msgid "Wallpaper"
msgstr "배경화면"

msgid "Windows 11"
msgstr "Show Desktop Icons"

msgid "✓ Activities button — {action}n"
msgstr "✓ 활동 버튼 — {action}n"

msgid "✓ Applied — {style} | {pos}"
msgstr "✓ 적용됨 — {style} | {pos}"

msgid "✓ Desktop settings reset. Restart Shell to apply."
msgstr "✓ 데스크톱 설정이 재설정되었습니다. Shell을 다시 시작하여 적용하십시오.✓ 바탕 화면 설정이 초기화되었습니다. 적용하려면 Shell을 다시 시작하세요."

msgid "✓ GDM wallpaper applied"
msgstr "✓ GDM 배경화면 적용 완료"

msgid "✓ {label} — {action}d"
msgstr "✓ {label} — {action}됨"

msgid "✗ Failed to apply position"
msgstr "✗ 위치 적용 실패"

msgid "✗ Failed to apply style"
msgstr "✗ 스타일 적용 실패"

msgid "✗ Failed to reset"
msgstr "✗ 초기화 실패"

msgid "✗ Failed to set GDM wallpaper"
msgstr "✗ GDM 배경화면 설정 실패"

msgid "✗ Failed to toggle activities button"
msgstr "✗ 활동 버튼 전환 실패"

msgid "✗ Failed to {action} {label}"
msgstr "✗ {label} {action} 실패"

msgid "✗ Please select an image first"
msgstr "✗ 먼저 이미지를 선택하세요"

