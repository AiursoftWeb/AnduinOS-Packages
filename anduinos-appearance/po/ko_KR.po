msgstr "로그인 화면에 적용"

msgid "Bottom"
msgstr "아래"

msgid "Cancel"
msgstr "취소"

msgid "Choose an image for the GDM login screen background."
msgstr "GDM 로그인 화면 배경 이미지를 선택하십시오."

msgid "Choose the visual style of your taskbar."
msgstr "작업 표시줄의 시각적 스타일을 선택하세요."

msgid "Choose…"
msgstr "선택…"

msgid "Classic"
msgstr "클래식"

msgid "Combine multiple windows of one app into a single icon"
msgstr "하나의 앱의 여러 창을 하나의 아이콘으로 결합"

msgid "Danger Zone"
msgstr "위험 구역"

msgid "Display the Activities button on the taskbar"
msgstr "작업 표시줄에 활동 버튼을 표시합니다"

msgid "Enable grouping"
msgstr "그룹화 활성화"

