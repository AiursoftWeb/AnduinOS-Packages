msgstr "Đặt lại cài đặt màn hình desktop"

msgid "Reset desktop settings?"
msgstr "Đặt lại cài đặt màn hình desktop?"

msgid "Restore all GNOME Shell settings to factory defaults"
msgstr "Khôi phục tất cả cài đặt GNOME Shell về mặc định gốc"

msgid "Right"
msgstr "Phải"

msgid "Select image"
msgstr "Chọn ảnh"

msgid "Seperated"
msgstr "Tách biệt"

