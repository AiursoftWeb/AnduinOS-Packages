msgid "Show Network"
msgstr "Hiện mạng"

msgid "Show Weather"
msgstr "Hiện thời tiết"

msgid "Show or hide built-in panel elements."
msgstr "Hiển thị hoặc ẩn các thành phần bảng điều khiển tích hợp."

msgid "Taskbar Elements"
msgstr "Thành phần thanh tác vụ"

msgid "Taskbar Style"
msgstr "Kiểu thanh tác vụ"

msgid "Toggle panel indicator widgets on or off."
msgstr "Bật hoặc tắt các tiện ích biểu tượng trên thanh."

msgid "Top"
msgstr "Trên"

msgid "Tweaks"
msgstr "Tinh chỉnh"

msgid "Use Vista taskbar behavior"
msgstr "Hành vi thanh tác vụ Vista"

msgid "Wallpaper"
msgstr "Hình nền"

msgid "Windows 11"
msgstr "Show Desktop Icons"

msgid "✓ Activities button — {action}n"
msgstr "✓ Nút hoạt động — {action}n"

msgid "✓ Applied — {style} | {pos}"
msgstr "✓ Đã áp dụng — {style} | {pos}"

msgid "✓ Desktop settings reset. Restart Shell to apply."
msgstr "✓ Đã đặt lại cài đặt desktop. Khởi động lại Shell để áp dụng."

msgid "✓ GDM wallpaper applied"
msgstr "✓ Đã áp dụng hình nền GDM"

msgid "✓ {label} — {action}d"
msgstr "✓ {label} — Đã {action}"

msgid "✗ Failed to apply position"
msgstr "✗ Không thể áp dụng vị trí"

msgid "✗ Failed to apply style"
msgstr "✗ Không thể áp dụng kiểu"

msgid "✗ Failed to reset"
msgstr "✗ Không thể đặt lại"

msgid "✗ Failed to set GDM wallpaper"
msgstr "✗ Không thể đặt hình nền GDM"

msgid "✗ Failed to toggle activities button"
msgstr "✗ Không thể chuyển đổi nút hoạt động"

msgid "✗ Failed to {action} {label}"
msgstr "✗ Không thể {action} {label}"

msgid "✗ Please select an image first"
msgstr "✗ Vui lòng chọn ảnh trước"

