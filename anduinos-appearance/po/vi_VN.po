msgid "About AnduinOS Appearance"
msgstr "Giới thiệu về Giao diện AnduinOS"

msgid "Advanced"
msgstr "Nâng cao"

msgid "AnduinOS Appearance"
msgstr "Giao diện AnduinOS"

msgid "AnduinOS Team"
msgstr "Đội ngũ AnduinOS"

msgid "Appearance"
msgstr "Giao diện"

msgid "Apply to Login Screen"
msgstr "Áp dụng cho màn hình đăng nhập"

msgid "Bottom"
msgstr "Dưới"

msgid "Cancel"
msgstr "Hủy"

msgid "Choose an image for the GDM login screen background."
msgstr "Chọn ảnh cho nền màn hình đăng nhập GDM."

msgid "Choose the visual style of your taskbar."
msgstr "Chọn kiểu hiển thị cho thanh tác vụ của bạn."

msgid "Choose…"
msgstr "Chọn…"

msgid "Classic"
msgstr "Cổ điển"

