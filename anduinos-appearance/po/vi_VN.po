msgstr "Hiển thị nút Hoạt động trên thanh tác vụ"

msgid "Enable grouping"
msgstr "Bật nhóm"

msgid "Extension Settings"
msgstr "Cài tiện ích mở rộng"

msgid "GDM Wallpaper"
msgstr "Hình nền GDM"

msgid "Group apps"
msgstr "Nhóm ứng dụng"

msgid "Images"
msgstr "Ảnh"

