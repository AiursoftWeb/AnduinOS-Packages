msgstr "✗ Не вдалося застосувати стиль"

msgid "✗ Failed to reset"
msgstr "✗ Не вдалося скинути"

msgid "✗ Failed to set GDM wallpaper"
msgstr "✗ Не вдалося встановити шпалери GDM"

msgid "✗ Failed to toggle activities button"
msgstr "✗ Не вдалося перемкнути кнопку «Огляд»"

msgid "✗ Failed to {action} {label}"
msgstr "✗ Не вдалося {action} {label}"

msgid "✗ Please select an image first"
msgstr "✗ Спочатку виберіть зображення"

