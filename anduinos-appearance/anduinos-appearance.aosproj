<Project Sdk="Aiursoft.Apkg.Sdk">
  <PropertyGroup>
    <PackageName>anduinos-appearance</PackageName>
    <PackageVersion>2.0.2-1+$(SuiteShortName)</PackageVersion>
    <Maintainer>AnduinOS Team &lt;anduin@aiursoft.com&gt;</Maintainer>
    <PackageDescription>AnduinOS Appearance — toggle between Centered and Classic taskbar layouts</PackageDescription>
    <Section>utils</Section>
    <PackageHomepage>https://www.anduinos.com</PackageHomepage>
    <RepositoryUrl>https://github.com/AiursoftWeb/AnduinOS-Packages</RepositoryUrl>
    <LicenseType>GPL-3.0</LicenseType>
    <AppStreamDeveloperName>AnduinOS Team</AppStreamDeveloperName>
    <AppStreamMetadataLicense>CC0-1.0</AppStreamMetadataLicense>
    <TargetDistro>anduinos</TargetDistro>
    <TargetSuites>noble-addon resolute-addon</TargetSuites>
    <TargetArchitectures>amd64 arm64</TargetArchitectures>
    <Component>main</Component>
    <SuiteShortNameMap>noble-addon=noble resolute-addon=resolute</SuiteShortNameMap>
  </PropertyGroup>

  <ItemGroup>
    <DependencyCheckSource Url="https://mirror.aiursoft.com/ubuntu" SuiteMap="noble-addon=noble resolute-addon=resolute" />
  </ItemGroup>

  <ItemGroup>
    <Dependency Include="python3" />
    <Dependency Include="dconf-cli" />
    <Dependency Include="anduinos-gdm3-wallpaper" />
  </ItemGroup>

  <ItemGroup>
    <IncludeScript Include="obj/anduinos-appearance" Target="/usr/bin/anduinos-appearance" />
    <IncludeFile Include="src/anduinos_appearance/__init__.py" Target="/usr/lib/python3/dist-packages/anduinos_appearance/__init__.py" />
    <IncludeFile Include="src/anduinos_appearance/layout.py" Target="/usr/lib/python3/dist-packages/anduinos_appearance/layout.py" />
    <IncludeFile Include="src/anduinos_appearance/preview.py" Target="/usr/lib/python3/dist-packages/anduinos_appearance/preview.py" />
    <IncludeFolder Include="locale" Target="/usr/share/locale" />
    <IncludeFile Include="data/com.anduinos.Appearance.service" Target="/usr/share/dbus-1/services/com.anduinos.Appearance.service" />
  </ItemGroup>

  <ItemGroup>
    <AppStreamApplication Include="data/anduinos-appearance.desktop" Icon="data/anduinos-appearance.svg" />
    <AppStreamScreenshot Include="screenshots/taskbar-style.png" Default="true" Caption="Choose a taskbar layout that matches your workflow" Environment="GNOME:dark" />
    <AppStreamScreenshot Include="screenshots/panel-widgets.png" Caption="Configure panel widgets and their placement" Environment="GNOME:dark" />
  </ItemGroup>

  <ItemGroup>
    <PrebuildCommand Run="PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=src python3 -m unittest discover -s tests -v" />
    <PrebuildCommand Run="bash build.sh amd64" Condition="'$(Arch)' == 'amd64'" />
    <PrebuildCommand Run="bash build.sh arm64" Condition="'$(Arch)' == 'arm64'" />
  </ItemGroup>
</Project>
