WIDGETS = {
    'weather': (_('Show Weather'), 'simple-weather@romanlefler.com'),
    'network': (_('Show Network'), 'network-stats@gnome.noroadsleft.xyz'),
    'desktop_icons': (_('Show Desktop Icons'), 'ding@rastersoft.com'),
