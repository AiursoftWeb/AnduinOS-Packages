#, python-brace-format
msgid ""
"Choose a detected AnduinOS installation below. We inspect disks read-only "
"and verify the selected device again before opening it."
msgstr ""
"Vælg en registreret AnduinOS-installation nedenfor. Vi undersøger diske "
"skrivebeskyttet og kontrollerer den valgte enhed igen, før vi åbner den."

#: src/anduinos_rescue_center/app.py:292
#, python-brace-format
msgid "Back to detected systems"
msgstr "Tilbage til registrerede systemer"

#: src/anduinos_rescue_center/app.py:297
#, python-brace-format
msgid "All detected disks and partitions"
msgstr "Alle registrerede diske og partitioner"

#: src/anduinos_rescue_center/app.py:298
#, python-brace-format
msgid ""
"For systems not found automatically. The selected partition is checked again"
" before repair."
msgstr ""
"Til systemer, der ikke blev fundet automatisk. Den valgte partition "
"kontrolleres igen før reparation."

