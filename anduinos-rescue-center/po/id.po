msgstr "Buat titik pemulihan atau kembalikan sistem ke kondisi sebelumnya."

#: src/anduinos_rescue_center/app.py:608
#, python-brace-format
msgid "Check the installed kernel, GRUB and EFI boot path."
msgstr "Periksa kernel yang terpasang, GRUB, dan jalur boot EFI."

#: src/anduinos_rescue_center/app.py:608
#: src/anduinos_rescue_center/app.py:1016
#, python-brace-format
msgid "Diagnose and repair boot"
msgstr "Diagnosis dan perbaikan boot"

