msgstr "선택한 오프라인 설치본에서 읽은 정보입니다. 작업을 수행하기 전에 장치 식별 정보를 다시 확인합니다."

#: src/anduinos_rescue_center/app.py:731
#, python-brace-format
msgid "System"
msgstr "시스템"

#: src/anduinos_rescue_center/app.py:734
#, python-brace-format
msgid "Operating system"
msgstr "운영 체제"

#: src/anduinos_rescue_center/app.py:735
#, python-brace-format
msgid "Version"
msgstr "버전"

#: src/anduinos_rescue_center/app.py:736
#, python-brace-format
msgid "Computer name"
msgstr "컴퓨터 이름"

#: src/anduinos_rescue_center/app.py:737
#, python-brace-format
msgid "Filesystem"
msgstr "파일 시스템"

#: src/anduinos_rescue_center/app.py:738
#, python-brace-format
msgid "Partition"
msgstr "파티션"

#: src/anduinos_rescue_center/app.py:739
#, python-brace-format
