msgstr ""
"Skapa en återställningspunkt eller återställ systemet till ett tidigare "
"tillstånd."

#: src/anduinos_rescue_center/app.py:608
#, python-brace-format
msgid "Check the installed kernel, GRUB and EFI boot path."
msgstr "Kontrollera den installerade kärnan, GRUB och EFI-startsökvägen."

#: src/anduinos_rescue_center/app.py:608
#: src/anduinos_rescue_center/app.py:1016
#, python-brace-format
msgid "Diagnose and repair boot"
msgstr "Diagnostisera och reparera uppstarten"

