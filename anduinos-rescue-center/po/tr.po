#, python-brace-format
msgid "Unknown partition"
msgstr "Bilinmeyen bölüm"

#: src/anduinos_rescue_center/app.py:596
#, python-brace-format
msgid "Recovery tools"
msgstr "Kurtarma araçları"

#: src/anduinos_rescue_center/app.py:598
#, python-brace-format
msgid "Reset a password"
msgstr "Parolayı sıfırla"

#: src/anduinos_rescue_center/app.py:598
#, python-brace-format
msgid "Restore access to a local account."
msgstr "Yerel hesaba erişimi geri yükleyin."

