#, python-brace-format
msgid "Create a recovery point or roll back the system."
msgstr "Crie um ponto de restauro ou reverta o sistema."

#: src/anduinos_rescue_center/app.py:608
#, python-brace-format
msgid "Check the installed kernel, GRUB and EFI boot path."
msgstr "Verifique o núcleo instalado, o GRUB e o caminho de arranque EFI."

#: src/anduinos_rescue_center/app.py:608
#: src/anduinos_rescue_center/app.py:1016
#, python-brace-format
msgid "Diagnose and repair boot"
msgstr "Diagnosticar e reparar o arranque"

