#, python-brace-format
msgid "Recovery tools"
msgstr "Ferramentas de recuperação"

#: src/anduinos_rescue_center/app.py:598
#, python-brace-format
msgid "Reset a password"
msgstr "Repor uma palavra-passe"

#: src/anduinos_rescue_center/app.py:598
