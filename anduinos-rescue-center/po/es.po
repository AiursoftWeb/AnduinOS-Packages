#, python-brace-format
msgid "Recovery tools"
msgstr "Herramientas de recuperación"

#: src/anduinos_rescue_center/app.py:598
#, python-brace-format
msgid "Reset a password"
msgstr "Restablecer una contraseña"

#: src/anduinos_rescue_center/app.py:598
#, python-brace-format
