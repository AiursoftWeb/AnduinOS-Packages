msgstr ""
"Trabaje en esta instalación sin conexión. Elija una herramienta a la "
"izquierda; el sistema en ejecución no se modificará."

#: src/anduinos_rescue_center/app.py:589
#, python-brace-format
msgid "Offline installation · {partition}"
msgstr "Instalación sin conexión · {partition}"

#: src/anduinos_rescue_center/app.py:590
#, python-brace-format
msgid "Unknown partition"
msgstr "Partición desconocida"

