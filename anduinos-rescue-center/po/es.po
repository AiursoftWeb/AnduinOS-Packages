#, python-brace-format
msgid "Back to detected systems"
msgstr "Volver a los sistemas detectados"

#: src/anduinos_rescue_center/app.py:297
#, python-brace-format
msgid "All detected disks and partitions"
msgstr "Todos los discos y particiones detectados"

#: src/anduinos_rescue_center/app.py:298
#, python-brace-format
msgid ""
"For systems not found automatically. The selected partition is checked again"
" before repair."
msgstr ""
"Para sistemas que no se hayan encontrado automáticamente. La partición "
"seleccionada se vuelve a comprobar antes de la reparación."

