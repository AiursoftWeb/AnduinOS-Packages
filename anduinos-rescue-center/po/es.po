msgstr "Esta no es una sesión Live"

#: src/anduinos_rescue_center/app.py:208
#, python-brace-format
msgid ""
"Rescue Center is designed for the AnduinOS Live environment. Continuing here"
" is not recommended. The currently running system will remain unavailable as"
" a repair target."
msgstr ""
"El Centro de rescate está diseñado para el entorno Live de AnduinOS. No se "
"recomienda continuar aquí. El sistema que se está ejecutando no estará "
"disponible como objetivo de reparación."

#: src/anduinos_rescue_center/app.py:212
#, python-brace-format
msgid "Continue anyway"
msgstr "Continuar de todos modos"

#: src/anduinos_rescue_center/app.py:231
#, python-brace-format
msgid "Looking for AnduinOS installations"
msgstr "Buscando instalaciones de AnduinOS"

#: src/anduinos_rescue_center/app.py:232
#, python-brace-format
msgid "Inspecting disks without changing their filesystems…"
msgstr "Inspeccionando discos sin modificar sus sistemas de archivos…"

