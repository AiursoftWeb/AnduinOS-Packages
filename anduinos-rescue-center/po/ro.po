msgstr ""
"Creați un punct de recuperare sau reveniți la o stare anterioară a "
"sistemului."

#: src/anduinos_rescue_center/app.py:608
#, python-brace-format
msgid "Check the installed kernel, GRUB and EFI boot path."
msgstr "Verificați nucleul instalat, GRUB și calea de pornire EFI."

#: src/anduinos_rescue_center/app.py:608
#: src/anduinos_rescue_center/app.py:1016
#, python-brace-format
msgid "Diagnose and repair boot"
msgstr "Diagnosticați și reparați pornirea"

