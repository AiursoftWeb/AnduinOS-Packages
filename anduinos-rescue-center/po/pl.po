#, python-brace-format
msgid "Offline recovery"
msgstr "Odzyskiwanie offline"

#: src/anduinos_rescue_center/app.py:108 src/anduinos_rescue_center/app.py:159
#, python-brace-format
msgid "Rescue Center"
msgstr "Centrum odzyskiwania"

#: src/anduinos_rescue_center/app.py:109
#, python-brace-format
msgid "Back"
msgstr "Wstecz"

#: src/anduinos_rescue_center/app.py:113
#, python-brace-format
msgid "Scan again"
msgstr "Zeskanuj ponownie"

#: src/anduinos_rescue_center/app.py:175
#, python-brace-format
msgid "Choose another system"
msgstr "Wybierz inny system"

