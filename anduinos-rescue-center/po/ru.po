#: data/anduinos-rescue-center-live-shortcut.desktop:3
msgid "Prepare AnduinOS Rescue Center desktop shortcut"
msgstr "Подготовить ярлык Центра восстановления AnduinOS на рабочем столе"

#: data/com.anduinos.RescueCenter.desktop:2
#: data/com.anduinos.RescueCenter.desktop:14
#: src/anduinos_rescue_center/app.py:100
#, python-brace-format
msgid "AnduinOS Rescue Center"
msgstr "AnduinOS"

#: data/com.anduinos.RescueCenter.desktop:3
msgid "Find and repair an installed AnduinOS system"
msgstr "Найти и восстановить установленную систему AnduinOS"

#: data/com.anduinos.RescueCenter.desktop:9
msgid "rescue;recovery;snapshot;password;files;"
msgstr "спасение;восстановление;снимок;пароль;файлы;"

#: data/com.anduinos.RescueCenter.desktop:15
msgid ""
"Recover files, accounts, and snapshots from an offline AnduinOS installation"
msgstr ""
"Восстановить файлы, учётные записи и снимки из отключённой установки "
"AnduinOS"

#: data/com.anduinos.RescueCenter.desktop:19
msgid ""
"Find installed AnduinOS systems from a Live session and perform carefully "
"scoped offline recovery operations."
msgstr ""
"Найдите установленные системы AnduinOS из сеанса Live и выполните тщательно "
"ограниченные операции восстановления в автономном режиме."

#: scripts/anduinos-rescue-center-live-helper:12
#, python-brace-format
msgid "The passwordless rescue helper is restricted to AnduinOS Live"
msgstr "Восстановление без пароля доступно только в AnduinOS Live"

#: src/anduinos_rescue_center/app.py:35 src/anduinos_rescue_center/app.py:41
#, python-brace-format
msgid "Unknown size"
msgstr "Размер неизвестен"

#: src/anduinos_rescue_center/app.py:108
#, python-brace-format
msgid "Offline recovery"
msgstr "Автономное восстановление"

#: src/anduinos_rescue_center/app.py:108 src/anduinos_rescue_center/app.py:159
#, python-brace-format
msgid "Rescue Center"
msgstr "Центр восстановления"

#: src/anduinos_rescue_center/app.py:109
#, python-brace-format
msgid "Back"
msgstr "Назад"

#: src/anduinos_rescue_center/app.py:113
#, python-brace-format
msgid "Scan again"
msgstr "Сканировать еще раз"

#: src/anduinos_rescue_center/app.py:175
#, python-brace-format
msgid "Choose another system"
msgstr "Выбрать другую систему"

#: src/anduinos_rescue_center/app.py:185 src/anduinos_rescue_center/app.py:463
#: src/anduinos_rescue_center/app.py:540
#, python-brace-format
msgid "Home"
msgstr "Главная"

#: src/anduinos_rescue_center/app.py:185
#, python-brace-format
msgid "Offline AnduinOS"
msgstr "Автономная AnduinOS"

#: src/anduinos_rescue_center/app.py:188
#, python-brace-format
msgid "Show recovery tools"
msgstr "Показать средства восстановления"

#: src/anduinos_rescue_center/app.py:206
#, python-brace-format
msgid "This is not a Live session"
msgstr "Это не сеанс Live"

#: src/anduinos_rescue_center/app.py:208
#, python-brace-format
msgid ""
"Rescue Center is designed for the AnduinOS Live environment. Continuing here"
" is not recommended. The currently running system will remain unavailable as"
" a repair target."
msgstr ""
"Центр восстановления предназначен для среды AnduinOS Live. Продолжать здесь "
"не рекомендуется. Система, запущенная в данный момент, останется недоступной"
" в качестве цели восстановления."

#: src/anduinos_rescue_center/app.py:212
#, python-brace-format
msgid "Continue anyway"
msgstr "Всё равно продолжить"

#: src/anduinos_rescue_center/app.py:231
#, python-brace-format
msgid "Looking for AnduinOS installations"
msgstr "Поиск установленных систем AnduinOS"

#: src/anduinos_rescue_center/app.py:232
#, python-brace-format
msgid "Inspecting disks without changing their filesystems…"
msgstr "Проверка дисков без изменения файловых систем…"

#: src/anduinos_rescue_center/app.py:248
#, python-brace-format
msgid "Could not scan this computer"
msgstr "Не удалось проверить этот компьютер"

#: src/anduinos_rescue_center/app.py:263
#, python-brace-format
msgid "START YOUR RECOVERY"
msgstr "НАЧНИТЕ ВОССТАНОВЛЕНИЕ"

#: src/anduinos_rescue_center/app.py:264
#, python-brace-format
msgid "Find the system you want to repair"
msgstr "Найдите систему, которую хотите восстановить"

#: src/anduinos_rescue_center/app.py:266
#, python-brace-format
msgid ""
"Choose a detected AnduinOS installation below. We inspect disks read-only "
"and verify the selected device again before opening it."
msgstr ""
"Выберите найденную установку AnduinOS ниже. Мы проверяем диски только для "
"чтения и повторно проверяем выбранное устройство перед его открытием."

#: src/anduinos_rescue_center/app.py:292
#, python-brace-format
msgid "Back to detected systems"
msgstr "Назад к найденным системам"

#: src/anduinos_rescue_center/app.py:297
#, python-brace-format
msgid "All detected disks and partitions"
msgstr "Все найденные диски и разделы"

#: src/anduinos_rescue_center/app.py:298
#, python-brace-format
msgid ""
"For systems not found automatically. The selected partition is checked again"
" before repair."
msgstr ""
"Для систем, не найденных автоматически. Перед восстановлением выбранный "
"раздел будет проверен ещё раз."

#: src/anduinos_rescue_center/app.py:307
#, python-brace-format
msgid "No AnduinOS installation found"
msgstr "Установка AnduinOS не найдена"

#: src/anduinos_rescue_center/app.py:308
#, python-brace-format
msgid ""
"Use Advanced selection to inspect the disks and partitions on this computer."
msgstr ""
"Используйте расширенный выбор, чтобы просмотреть диски и разделы на этом "
"компьютере."

#: src/anduinos_rescue_center/app.py:313
#, python-brace-format
msgid "Advanced selection"
msgstr "Расширенный выбор"

#: src/anduinos_rescue_center/app.py:327
#, python-brace-format
msgid "Open {system} installation on {partition}"
msgstr "Открыть систему {system} на разделе {partition}"

#: src/anduinos_rescue_center/app.py:329
#, python-brace-format
msgid "unknown partition"
msgstr "неизвестный раздел"

#: src/anduinos_rescue_center/app.py:344 src/anduinos_rescue_center/app.py:709
#: src/anduinos_rescue_center/app.py:735 src/anduinos_rescue_center/app.py:736
#: src/anduinos_rescue_center/app.py:737 src/anduinos_rescue_center/app.py:738
#: src/anduinos_rescue_center/app.py:739
#: src/anduinos_rescue_center/app.py:1072
#: src/anduinos_rescue_center/app.py:1080
#, python-brace-format
msgid "Unknown"
msgstr "Неизвестно"

#: src/anduinos_rescue_center/app.py:349 src/anduinos_rescue_center/app.py:393
#, python-brace-format
msgid "Running system"
msgstr "Запущенная система"

#: src/anduinos_rescue_center/app.py:350 src/anduinos_rescue_center/app.py:368
#: src/anduinos_rescue_center/app.py:395
#, python-brace-format
msgid "Live installation media"
msgstr "Установочный носитель Live"

#: src/anduinos_rescue_center/app.py:351
#, python-brace-format
msgid "Unavailable for recovery"
msgstr "Недоступно для восстановления"

#: src/anduinos_rescue_center/app.py:363
#, python-brace-format
msgid "Disk"
msgstr "Диск"

#: src/anduinos_rescue_center/app.py:380
#, python-brace-format
msgid "Unknown filesystem"
msgstr "Неизвестная файловая система"

#: src/anduinos_rescue_center/app.py:383
#, python-brace-format
msgid "Could not inspect"
msgstr "Не удалось проверить"

#: src/anduinos_rescue_center/app.py:397
#, python-brace-format
msgid "Windows cannot be repaired here"
msgstr "Здесь нельзя восстановить Windows"

#: src/anduinos_rescue_center/app.py:399
#, python-brace-format
msgid "Not available for recovery"
msgstr "Недоступно для восстановления"

#: src/anduinos_rescue_center/app.py:407
#, python-brace-format
msgid "Inspecting the selected system"
msgstr "Проверка выбранной системы"

#: src/anduinos_rescue_center/app.py:408
#, python-brace-format
msgid "Re-checking its disk identity and reading system information…"
msgstr "Повторная проверка идентификатора диска и чтение сведений о системе…"

#: src/anduinos_rescue_center/app.py:427 src/anduinos_rescue_center/app.py:440
#, python-brace-format
msgid "Could not open this installation"
msgstr "Не удалось открыть эту установленную систему"

#: src/anduinos_rescue_center/app.py:430 src/anduinos_rescue_center/app.py:665
#: src/anduinos_rescue_center/app.py:690 src/anduinos_rescue_center/app.py:812
#: src/anduinos_rescue_center/app.py:981
#: src/anduinos_rescue_center/app.py:1224
#: src/anduinos_rescue_center/app.py:1449
#, python-brace-format
msgid "Close"
msgstr "Закрыть"

#: src/anduinos_rescue_center/app.py:451
#, python-brace-format
msgid "SELECTED INSTALLATION"
msgstr "ВЫБРАННАЯ УСТАНОВКА"

#: src/anduinos_rescue_center/app.py:464 src/anduinos_rescue_center/app.py:540
#, python-brace-format
msgid "Password reset"
msgstr "Сброс пароля"

#: src/anduinos_rescue_center/app.py:465 src/anduinos_rescue_center/app.py:540
#, python-brace-format
msgid "File browser"
msgstr "Файловый менеджер"

#: src/anduinos_rescue_center/app.py:469 src/anduinos_rescue_center/app.py:541
#: src/anduinos_rescue_center/app.py:603
#: src/anduinos_rescue_center/app.py:1262
#, python-brace-format
msgid "Snapshots & restore"
msgstr "Снимки и восстановление"

#: src/anduinos_rescue_center/app.py:472 src/anduinos_rescue_center/app.py:541
#, python-brace-format
msgid "Boot repair"
msgstr "Восстановление загрузки"

#: src/anduinos_rescue_center/app.py:473 src/anduinos_rescue_center/app.py:542
#: src/anduinos_rescue_center/app.py:609 src/anduinos_rescue_center/app.py:640
#, python-brace-format
msgid "Emergency terminal"
msgstr "Аварийный терминал"

#: src/anduinos_rescue_center/app.py:475 src/anduinos_rescue_center/app.py:542
#: src/anduinos_rescue_center/app.py:612
#, python-brace-format
msgid "System details"
msgstr "Сведения о системе"

#: src/anduinos_rescue_center/app.py:479
#, python-brace-format
msgid "Open {page} page"
msgstr "Открыть страницу «{page}»"

#: src/anduinos_rescue_center/app.py:578
#, python-brace-format
msgid "A calmer way back"
msgstr "Спокойный путь к восстановлению"

#: src/anduinos_rescue_center/app.py:578
#, python-brace-format
msgid "RECOVERY WORKSPACE"
msgstr "СРЕДА ВОССТАНОВЛЕНИЯ"

#: src/anduinos_rescue_center/app.py:579
#, python-brace-format
msgid ""
"Work on this offline installation. Choose a tool on the left; your running "
"system remains untouched."
msgstr ""
"Работайте с этой установленной системой в автономном режиме. Выберите "
"инструмент слева — работающая система останется нетронутой."

#: src/anduinos_rescue_center/app.py:589
#, python-brace-format
msgid "Offline installation · {partition}"
msgstr "Установленная система · {partition}"

#: src/anduinos_rescue_center/app.py:590
#, python-brace-format
msgid "Unknown partition"
msgstr "Неизвестный раздел"

#: src/anduinos_rescue_center/app.py:596
#, python-brace-format
msgid "Recovery tools"
msgstr "Инструменты восстановления"

#: src/anduinos_rescue_center/app.py:598
#, python-brace-format
msgid "Reset a password"
msgstr "Сбросить пароль"

#: src/anduinos_rescue_center/app.py:598
#, python-brace-format
msgid "Restore access to a local account."
msgstr "Восстановить доступ к локальной учётной записи."

#: src/anduinos_rescue_center/app.py:599
#, python-brace-format
msgid "Browse and copy files"
msgstr "Просмотр и копирование файлов"

#: src/anduinos_rescue_center/app.py:599
#, python-brace-format
msgid "Explore the offline system and copy data out."
msgstr "Просмотрите автономную систему и скопируйте данные."

#: src/anduinos_rescue_center/app.py:604
#, python-brace-format
msgid "Create a recovery point or roll back the system."
msgstr "Создать точку восстановления или откатить систему."

#: src/anduinos_rescue_center/app.py:608
#, python-brace-format
msgid "Check the installed kernel, GRUB and EFI boot path."
msgstr "Проверить установленное ядро, GRUB и путь загрузки EFI."

#: src/anduinos_rescue_center/app.py:608
#: src/anduinos_rescue_center/app.py:1016
#, python-brace-format
msgid "Diagnose and repair boot"
msgstr "Диагностика и восстановление загрузки"

#: src/anduinos_rescue_center/app.py:609
#, python-brace-format
msgid "Open an expert shell in this offline system."
msgstr "Открыть экспертную оболочку в этой автономной системе."

#: src/anduinos_rescue_center/app.py:612
#, python-brace-format
msgid "Review the installation before making changes."
msgstr "Проверьте установку, прежде чем вносить изменения."

#: src/anduinos_rescue_center/app.py:633
#, python-brace-format
msgid ""
"Snapshot restore is available only for the standard AnduinOS Btrfs layout. "
"File recovery and password reset remain available here."
msgstr ""
"Восстановление из снимка доступно только для стандартной разметки AnduinOS с"
" Btrfs. Здесь также доступны восстановление файлов и сброс пароля."

#: src/anduinos_rescue_center/app.py:640
#, python-brace-format
msgid "ADVANCED RECOVERY"
msgstr "РАСШИРЕННОЕ ВОССТАНОВЛЕНИЕ"

#: src/anduinos_rescue_center/app.py:641
#, python-brace-format
msgid ""
"Open a root shell inside the selected offline system. Commands can change or"
" delete its files."
msgstr ""
"Откройте оболочку root внутри выбранной автономной системы. Команды могут "
"изменять или удалять её файлы."

#: src/anduinos_rescue_center/app.py:644
#, python-brace-format
msgid ""
"The terminal will show the target partition before entering it. Type exit "
"when finished. Recovery will unmount its temporary filesystems and report "
"any cleanup failure."
msgstr ""
"Перед входом терминал покажет целевой раздел. По завершении введите exit. "
"Средство восстановления размонтирует временно подключённые файловые системы "
"и сообщит о любых сбоях очистки."

#: src/anduinos_rescue_center/app.py:648
#, python-brace-format
msgid "Open target terminal"
msgstr "Открыть терминал целевой системы"

#: src/anduinos_rescue_center/app.py:653
#, python-brace-format
msgid "Open Live terminal instead"
msgstr "Вместо этого открыть терминал Live"

#: src/anduinos_rescue_center/app.py:664 src/anduinos_rescue_center/app.py:689
#, python-brace-format
msgid "Could not open terminal"
msgstr "Не удалось открыть терминал"

#: src/anduinos_rescue_center/app.py:674
#, python-brace-format
msgid "Open an expert root shell?"
msgstr "Открыть экспертную оболочку root?"

#: src/anduinos_rescue_center/app.py:675
#, python-brace-format
msgid ""
"Target: {path}\n"
"\n"
"The shell can make unrestricted changes to this offline installation and can also access Live hardware. Use it only if you understand the commands."
msgstr ""
"Цель: {path}\n"
"\n"
"Оболочка позволяет вносить любые изменения в установку системы, которая сейчас не запущена, а также обращаться к оборудованию Live. Используйте её, только если понимаете команды."

#: src/anduinos_rescue_center/app.py:678 src/anduinos_rescue_center/app.py:760
#: src/anduinos_rescue_center/app.py:1132
#: src/anduinos_rescue_center/app.py:1365
#: src/anduinos_rescue_center/app.py:1411
#, python-brace-format
msgid "Cancel"
msgstr "Отмена"

#: src/anduinos_rescue_center/app.py:679
#, python-brace-format
msgid "Open terminal"
msgstr "Открыть терминал"

#: src/anduinos_rescue_center/app.py:699
#, python-brace-format
msgid "ACCOUNT ACCESS"
msgstr "ДОСТУП К УЧЁТНОЙ ЗАПИСИ"

#: src/anduinos_rescue_center/app.py:699
#, python-brace-format
msgid "Reset a local password"
msgstr "Сбросить пароль локальной учётной записи"

#: src/anduinos_rescue_center/app.py:700
#, python-brace-format
msgid ""
"Choose an account on the offline installation. Existing encrypted login "
"keyrings are not unlocked by a password reset."
msgstr ""
"Выберите учётную запись в системе, которая сейчас не запущена. Сброс пароля "
"не разблокирует существующие зашифрованные связки ключей для входа."

#: src/anduinos_rescue_center/app.py:702
#, python-brace-format
msgid "Local accounts"
msgstr "Локальные учётные записи"

#: src/anduinos_rescue_center/app.py:712
#, python-brace-format
msgid "Password locked"
msgstr "Пароль заблокирован"

#: src/anduinos_rescue_center/app.py:715 src/anduinos_rescue_center/app.py:761
#, python-brace-format
msgid "Reset password"
msgstr "Сбросить пароль"

#: src/anduinos_rescue_center/app.py:721
#, python-brace-format
msgid "No local accounts found"
msgstr "Локальные учётные записи не найдены"

#: src/anduinos_rescue_center/app.py:728
#, python-brace-format
msgid "INSTALLATION DETAILS"
msgstr "СВЕДЕНИЯ ОБ УСТАНОВКЕ"

#: src/anduinos_rescue_center/app.py:728
#, python-brace-format
msgid "Know what you are repairing"
msgstr "Узнайте, что вы восстанавливаете"

#: src/anduinos_rescue_center/app.py:729
#, python-brace-format
msgid ""
"Information read from the selected offline installation. Its device identity"
" is rechecked before each operation."
msgstr ""
"Сведения, полученные из выбранной автономной установки. Идентификатор "
"устройства повторно проверяется перед каждой операцией."

#: src/anduinos_rescue_center/app.py:731
#, python-brace-format
msgid "System"
msgstr "Система"

#: src/anduinos_rescue_center/app.py:734
#, python-brace-format
msgid "Operating system"
msgstr "Операционная система"

#: src/anduinos_rescue_center/app.py:735
#, python-brace-format
msgid "Version"
msgstr "Версия"

#: src/anduinos_rescue_center/app.py:736
#, python-brace-format
msgid "Computer name"
msgstr "Имя компьютера"

#: src/anduinos_rescue_center/app.py:737
#, python-brace-format
msgid "Filesystem"
msgstr "Файловая система"

#: src/anduinos_rescue_center/app.py:738
#, python-brace-format
msgid "Partition"
msgstr "Раздел"

#: src/anduinos_rescue_center/app.py:739
#, python-brace-format
msgid "Installed kernels"
msgstr "Установленные ядра"

#: src/anduinos_rescue_center/app.py:740
#, python-brace-format
msgid "Available"
msgstr "Доступно"

#: src/anduinos_rescue_center/app.py:740
#, python-brace-format
msgid "Requires the standard AnduinOS Btrfs layout"
msgstr "Требуется стандартная структура Btrfs в AnduinOS"

#: src/anduinos_rescue_center/app.py:740
#, python-brace-format
msgid "Snapshots"
msgstr "Снимки"

#: src/anduinos_rescue_center/app.py:746
#, python-brace-format
msgid "New password"
msgstr "Новый пароль"

#: src/anduinos_rescue_center/app.py:747
#, python-brace-format
msgid "Confirm new password"
msgstr "Подтвердите новый пароль"

#: src/anduinos_rescue_center/app.py:753
#, python-brace-format
msgid "Reset the password for {username}?"
msgstr "Сбросить пароль пользователя {username}?"

#: src/anduinos_rescue_center/app.py:755
#, python-brace-format
msgid ""
"This changes the local login password on the selected offline system. It "
"does not unlock an existing encrypted login keyring."
msgstr ""
"Это изменит пароль для локального входа в выбранной системе, которая сейчас "
"не запущена. Это не разблокирует существующую зашифрованную связку ключей "
"для входа."

#: src/anduinos_rescue_center/app.py:782
#, python-brace-format
msgid "Resetting the password"
msgstr "Сброс пароля"

#: src/anduinos_rescue_center/app.py:783
#, python-brace-format
msgid "Writing the new local account password safely…"
msgstr "Безопасно записываем новый пароль локальной учётной записи…"

#: src/anduinos_rescue_center/app.py:809
#, python-brace-format
msgid "Password reset complete"
msgstr "Пароль сброшен"

#: src/anduinos_rescue_center/app.py:810
#, python-brace-format
msgid "The local login password for {username} was changed."
msgstr "Пароль для локального входа пользователя {username} изменён."

#: src/anduinos_rescue_center/app.py:834
#, python-brace-format
