#: src/anduinos_rescue_center/app.py:1016
#, python-brace-format
msgid "Diagnose and repair boot"
msgstr "Selvitä ja korjaa käynnistysongelmia"

#: src/anduinos_rescue_center/app.py:609
#, python-brace-format
msgid "Open an expert shell in this offline system."
msgstr ""
"Avaa asiantuntijapäätteessä komentotulkki tässä offline-tilassa olevassa "
"järjestelmässä."

