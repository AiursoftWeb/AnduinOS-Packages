msgstr ""
"Créer un point de récupération ou restaurer le système à un état antérieur."

#: src/anduinos_rescue_center/app.py:608
#, python-brace-format
msgid "Check the installed kernel, GRUB and EFI boot path."
msgstr "Vérifiez le noyau installé, GRUB et le chemin de démarrage EFI."

#: src/anduinos_rescue_center/app.py:608
#: src/anduinos_rescue_center/app.py:1016
#, python-brace-format
msgid "Diagnose and repair boot"
msgstr "Diagnostiquer et réparer le démarrage"

