[Desktop Entry]
Name=AnduinOS Rescue Center
Comment=Find and repair an installed AnduinOS system
Exec=anduinos-rescue-center
Icon=com.anduinos.RescueCenter
Terminal=false
Type=Application
Categories=System;
Keywords=rescue;recovery;snapshot;password;files;
StartupNotify=true
StartupWMClass=com.anduinos.RescueCenter

[X-AppStream-Metadata]
Name=AnduinOS Rescue Center
Summary=Recover files, accounts, and snapshots from an offline AnduinOS installation
DeveloperName=AnduinOS Team
ProjectLicense=GPL-3.0
MetadataLicense=CC0-1.0
Description=Find installed AnduinOS systems from a Live session and perform carefully scoped offline recovery operations.
