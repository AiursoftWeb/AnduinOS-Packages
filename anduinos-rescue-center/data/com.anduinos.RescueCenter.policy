<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
  "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>AnduinOS</vendor>
  <vendor_url>https://www.anduinos.com</vendor_url>
  <action id="com.anduinos.RescueCenter.helper">
    <description>Inspect and repair offline systems with AnduinOS Rescue Center</description>
    <description xml:lang="ar_SA">فحص الأنظمة غير المتصلة وإصلاحها باستخدام مركز إنقاذ AnduinOS</description>
    <description xml:lang="zh_CN">使用 AnduinOS 救援中心检查和修复离线系统</description>
    <description xml:lang="zh_HK">使用 AnduinOS 救援中心檢查及修復離線系統</description>
    <description xml:lang="zh_TW">使用 AnduinOS 救援中心檢查與修復離線系統</description>
    <description xml:lang="da_DK">Undersøg og reparer offline-systemer med AnduinOS Redningscenter</description>
    <description xml:lang="nl_NL">Offline systemen inspecteren en herstellen met AnduinOS Reddingscentrum</description>
    <description xml:lang="en_GB">Inspect and repair offline systems with AnduinOS Rescue Centre</description>
    <description xml:lang="fi_FI">Tarkasta ja korjaa offline-järjestelmiä AnduinOS-palautuskeskuksella</description>
    <description xml:lang="fr_FR">Examiner et réparer des systèmes hors ligne avec le Centre de secours AnduinOS</description>
    <description xml:lang="de_DE">Offline-Systeme mit dem AnduinOS-Rettungscenter untersuchen und reparieren</description>
    <description xml:lang="el_GR">Έλεγχος και επισκευή συστημάτων εκτός σύνδεσης με το Κέντρο διάσωσης AnduinOS</description>
    <description xml:lang="hi_IN">AnduinOS बचाव केंद्र से ऑफ़लाइन सिस्टम की जाँच और मरम्मत करें</description>
    <description xml:lang="id_ID">Periksa dan perbaiki sistem luring dengan Pusat Penyelamatan AnduinOS</description>
    <description xml:lang="it_IT">Esamina e ripara i sistemi offline con il Centro di ripristino AnduinOS</description>
    <description xml:lang="ja_JP">AnduinOS レスキューセンターでオフラインシステムを検査・修復</description>
    <description xml:lang="ko_KR">AnduinOS 복구 센터로 오프라인 시스템 검사 및 복구</description>
    <description xml:lang="pl_PL">Sprawdź i napraw systemy offline za pomocą Centrum ratunkowego AnduinOS</description>
    <description xml:lang="pt_PT">Inspecionar e reparar sistemas offline com o Centro de Recuperação AnduinOS</description>
    <description xml:lang="pt_BR">Inspecionar e reparar sistemas offline com a Central de Recuperação do AnduinOS</description>
    <description xml:lang="ro_RO">Inspectați și reparați sisteme offline cu Centrul de recuperare AnduinOS</description>
    <description xml:lang="ru_RU">Проверка и восстановление автономных систем с помощью Центра восстановления AnduinOS</description>
    <description xml:lang="es_ES">Inspeccionar y reparar sistemas sin conexión con el Centro de rescate de AnduinOS</description>
    <description xml:lang="sv_SE">Inspektera och reparera offline-system med AnduinOS räddningscenter</description>
    <description xml:lang="th_TH">ตรวจสอบและซ่อมแซมระบบออฟไลน์ด้วยศูนย์กู้คืน AnduinOS</description>
    <description xml:lang="tr_TR">AnduinOS Kurtarma Merkezi ile çevrimdışı sistemleri inceleyin ve onarın</description>
    <description xml:lang="uk_UA">Перевірка та відновлення автономних систем за допомогою Центру відновлення AnduinOS</description>
    <description xml:lang="vi_VN">Kiểm tra và sửa chữa hệ thống ngoại tuyến bằng Trung tâm cứu hộ AnduinOS</description>
    <message>Authentication is required to inspect or repair an offline operating system</message>
    <message xml:lang="ar_SA">المصادقة مطلوبة لفحص نظام تشغيل غير متصل أو إصلاحه</message>
    <message xml:lang="zh_CN">检查或修复离线操作系统需要身份验证</message>
    <message xml:lang="zh_HK">檢查或修復離線作業系統需要身分驗證</message>
    <message xml:lang="zh_TW">檢查或修復離線作業系統需要身分驗證</message>
    <message xml:lang="da_DK">Godkendelse er påkrævet for at undersøge eller reparere et offline-operativsystem</message>
    <message xml:lang="nl_NL">Authenticatie is vereist om een offline besturingssysteem te inspecteren of te herstellen</message>
    <message xml:lang="en_GB">Authentication is required to inspect or repair an offline operating system</message>
    <message xml:lang="fi_FI">Offline-käyttöjärjestelmän tarkastaminen tai korjaaminen vaatii tunnistautumisen</message>
    <message xml:lang="fr_FR">Une authentification est requise pour examiner ou réparer un système d’exploitation hors ligne</message>
    <message xml:lang="de_DE">Zum Untersuchen oder Reparieren eines Offline-Betriebssystems ist eine Authentifizierung erforderlich</message>
    <message xml:lang="el_GR">Απαιτείται έλεγχος ταυτότητας για τον έλεγχο ή την επισκευή ενός λειτουργικού συστήματος εκτός σύνδεσης</message>
    <message xml:lang="hi_IN">ऑफ़लाइन ऑपरेटिंग सिस्टम की जाँच या मरम्मत के लिए प्रमाणीकरण आवश्यक है</message>
    <message xml:lang="id_ID">Autentikasi diperlukan untuk memeriksa atau memperbaiki sistem operasi luring</message>
    <message xml:lang="it_IT">È richiesta l’autenticazione per esaminare o riparare un sistema operativo offline</message>
    <message xml:lang="ja_JP">オフラインのオペレーティングシステムを検査または修復するには認証が必要です</message>
    <message xml:lang="ko_KR">오프라인 운영 체제를 검사하거나 복구하려면 인증이 필요합니다</message>
    <message xml:lang="pl_PL">Uwierzytelnienie jest wymagane do sprawdzenia lub naprawy systemu operacyjnego offline</message>
    <message xml:lang="pt_PT">É necessária autenticação para inspecionar ou reparar um sistema operativo offline</message>
    <message xml:lang="pt_BR">É necessária autenticação para inspecionar ou reparar um sistema operacional offline</message>
    <message xml:lang="ro_RO">Este necesară autentificarea pentru a inspecta sau repara un sistem de operare offline</message>
    <message xml:lang="ru_RU">Для проверки или восстановления автономной операционной системы требуется аутентификация</message>
    <message xml:lang="es_ES">Se requiere autenticación para inspeccionar o reparar un sistema operativo sin conexión</message>
    <message xml:lang="sv_SE">Autentisering krävs för att inspektera eller reparera ett offline-operativsystem</message>
    <message xml:lang="th_TH">จำเป็นต้องมีการยืนยันตัวตนเพื่อตรวจสอบหรือซ่อมแซมระบบปฏิบัติการออฟไลน์</message>
    <message xml:lang="tr_TR">Çevrimdışı bir işletim sistemini incelemek veya onarmak için kimlik doğrulaması gereklidir</message>
    <message xml:lang="uk_UA">Для перевірки або відновлення автономної операційної системи потрібна автентифікація</message>
    <message xml:lang="vi_VN">Cần xác thực để kiểm tra hoặc sửa chữa hệ điều hành ngoại tuyến</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/anduinos-rescue-center-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
  <action id="com.anduinos.RescueCenter.live-helper">
    <description>Inspect and repair offline systems from AnduinOS Live</description>
    <description xml:lang="ar_SA">فحص الأنظمة غير المتصلة وإصلاحها من AnduinOS Live</description>
    <description xml:lang="zh_CN">从 AnduinOS Live 检查和修复离线系统</description>
    <description xml:lang="zh_HK">從 AnduinOS Live 檢查及修復離線系統</description>
    <description xml:lang="zh_TW">從 AnduinOS Live 檢查與修復離線系統</description>
    <description xml:lang="da_DK">Undersøg og reparer offline-systemer fra AnduinOS Live</description>
    <description xml:lang="nl_NL">Offline systemen inspecteren en herstellen vanuit AnduinOS Live</description>
    <description xml:lang="en_GB">Inspect and repair offline systems from AnduinOS Live</description>
    <description xml:lang="fi_FI">Tarkasta ja korjaa offline-järjestelmiä AnduinOS Live -ympäristöstä</description>
    <description xml:lang="fr_FR">Examiner et réparer des systèmes hors ligne depuis AnduinOS Live</description>
    <description xml:lang="de_DE">Offline-Systeme aus AnduinOS Live untersuchen und reparieren</description>
    <description xml:lang="el_GR">Έλεγχος και επισκευή συστημάτων εκτός σύνδεσης από το AnduinOS Live</description>
    <description xml:lang="hi_IN">AnduinOS Live से ऑफ़लाइन सिस्टम की जाँच और मरम्मत करें</description>
    <description xml:lang="id_ID">Periksa dan perbaiki sistem luring dari AnduinOS Live</description>
    <description xml:lang="it_IT">Esamina e ripara i sistemi offline da AnduinOS Live</description>
    <description xml:lang="ja_JP">AnduinOS Live からオフラインシステムを検査・修復</description>
    <description xml:lang="ko_KR">AnduinOS Live에서 오프라인 시스템 검사 및 복구</description>
    <description xml:lang="pl_PL">Sprawdź i napraw systemy offline z AnduinOS Live</description>
    <description xml:lang="pt_PT">Inspecionar e reparar sistemas offline a partir do AnduinOS Live</description>
    <description xml:lang="pt_BR">Inspecionar e reparar sistemas offline pelo AnduinOS Live</description>
    <description xml:lang="ro_RO">Inspectați și reparați sisteme offline din AnduinOS Live</description>
    <description xml:lang="ru_RU">Проверка и восстановление автономных систем из AnduinOS Live</description>
    <description xml:lang="es_ES">Inspeccionar y reparar sistemas sin conexión desde AnduinOS Live</description>
    <description xml:lang="sv_SE">Inspektera och reparera offline-system från AnduinOS Live</description>
    <description xml:lang="th_TH">ตรวจสอบและซ่อมแซมระบบออฟไลน์จาก AnduinOS Live</description>
    <description xml:lang="tr_TR">AnduinOS Live üzerinden çevrimdışı sistemleri inceleyin ve onarın</description>
    <description xml:lang="uk_UA">Перевірка та відновлення автономних систем з AnduinOS Live</description>
    <description xml:lang="vi_VN">Kiểm tra và sửa chữa hệ thống ngoại tuyến từ AnduinOS Live</description>
    <message>AnduinOS Live is requesting access to an offline operating system</message>
    <message xml:lang="ar_SA">يطلب AnduinOS Live الوصول إلى نظام تشغيل غير متصل</message>
    <message xml:lang="zh_CN">AnduinOS Live 正在请求访问离线操作系统</message>
    <message xml:lang="zh_HK">AnduinOS Live 正在要求存取離線作業系統</message>
    <message xml:lang="zh_TW">AnduinOS Live 正在要求存取離線作業系統</message>
    <message xml:lang="da_DK">AnduinOS Live anmoder om adgang til et offline-operativsystem</message>
    <message xml:lang="nl_NL">AnduinOS Live vraagt toegang tot een offline besturingssysteem</message>
    <message xml:lang="en_GB">AnduinOS Live is requesting access to an offline operating system</message>
    <message xml:lang="fi_FI">AnduinOS Live pyytää pääsyä offline-käyttöjärjestelmään</message>
    <message xml:lang="fr_FR">AnduinOS Live demande l’accès à un système d’exploitation hors ligne</message>
    <message xml:lang="de_DE">AnduinOS Live fordert Zugriff auf ein Offline-Betriebssystem an</message>
    <message xml:lang="el_GR">Το AnduinOS Live ζητά πρόσβαση σε ένα λειτουργικό σύστημα εκτός σύνδεσης</message>
    <message xml:lang="hi_IN">AnduinOS Live ऑफ़लाइन ऑपरेटिंग सिस्टम तक पहुँच का अनुरोध कर रहा है</message>
    <message xml:lang="id_ID">AnduinOS Live meminta akses ke sistem operasi luring</message>
    <message xml:lang="it_IT">AnduinOS Live richiede l’accesso a un sistema operativo offline</message>
    <message xml:lang="ja_JP">AnduinOS Live がオフラインのオペレーティングシステムへのアクセスを要求しています</message>
    <message xml:lang="ko_KR">AnduinOS Live가 오프라인 운영 체제에 대한 접근을 요청하고 있습니다</message>
    <message xml:lang="pl_PL">AnduinOS Live żąda dostępu do systemu operacyjnego offline</message>
    <message xml:lang="pt_PT">O AnduinOS Live está a solicitar acesso a um sistema operativo offline</message>
    <message xml:lang="pt_BR">O AnduinOS Live está solicitando acesso a um sistema operacional offline</message>
    <message xml:lang="ro_RO">AnduinOS Live solicită acces la un sistem de operare offline</message>
    <message xml:lang="ru_RU">AnduinOS Live запрашивает доступ к автономной операционной системе</message>
    <message xml:lang="es_ES">AnduinOS Live solicita acceso a un sistema operativo sin conexión</message>
    <message xml:lang="sv_SE">AnduinOS Live begär åtkomst till ett offline-operativsystem</message>
    <message xml:lang="th_TH">AnduinOS Live กำลังขอเข้าถึงระบบปฏิบัติการออฟไลน์</message>
    <message xml:lang="tr_TR">AnduinOS Live çevrimdışı bir işletim sistemine erişim istiyor</message>
    <message xml:lang="uk_UA">AnduinOS Live запитує доступ до автономної операційної системи</message>
    <message xml:lang="vi_VN">AnduinOS Live đang yêu cầu quyền truy cập vào hệ điều hành ngoại tuyến</message>
    <defaults>
      <allow_any>yes</allow_any>
      <allow_inactive>yes</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/anduinos-rescue-center-live-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
