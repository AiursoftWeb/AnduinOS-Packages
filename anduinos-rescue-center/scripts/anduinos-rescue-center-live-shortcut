#!/bin/sh
# Create the Rescue Center launcher only in the current AnduinOS Live overlay.

set -eu

[ "$(id -u)" -ne 0 ] || exit 0
[ -d /cdrom ] || exit 0
test -f /run/anduinos-live/environment || exit 0

desktop_dir="$(xdg-user-dir DESKTOP 2>/dev/null || true)"
[ -n "$desktop_dir" ] || desktop_dir="$HOME/Desktop"

# Never let a malformed XDG setting write outside the Live user's home.
case "$desktop_dir" in
    "$HOME"/*) ;;
    *) exit 0 ;;
esac

source=/usr/share/applications/com.anduinos.RescueCenter.desktop
destination="$desktop_dir/com.anduinos.RescueCenter.desktop"
[ -f "$source" ] || exit 0

mkdir -p "$desktop_dir"
install -m 0755 "$source" "$destination"

# GNOME/DING uses this metadata to show the application icon as a trusted
# launcher instead of an inert desktop file.
gio set "$destination" metadata::trusted true >/dev/null 2>&1 || true
