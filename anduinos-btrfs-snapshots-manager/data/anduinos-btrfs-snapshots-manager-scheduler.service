[Unit]
Description=Disk Snapshots Manager automatic snapshot run
Documentation=file:/usr/share/doc/anduinos-btrfs-snapshots-manager/README.md
After=dbus.service local-fs.target
ConditionPathIsMountPoint=/.snapshots

[Service]
Type=oneshot
ExecStart=/usr/libexec/anduinos-btrfs-snapshots-manager-scheduler
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectHome=read-only
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=~@clock @cpu-emulation @debug @module @mount @obsolete @privileged @raw-io @reboot @resources @swap
CapabilityBoundingSet=
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
UMask=0077
