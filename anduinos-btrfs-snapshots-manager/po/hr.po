#: src/btrfs-snapshots-manager/src/ui/btrfs_settings/filesystem.rs
msgid ""
"Btrfs does not provide an on/off real-time deduplication switch. Tools such "
"as duperemove and BEES use different strategies, resource limits, and scan "
"scopes. Disk Snapshots Manager will not silently install or run one without "
"a complete policy."
msgstr ""
"Btrfs nema prekidač za deduplikaciju u stvarnom vremenu. Alati poput "
"duperemovea i BEES-a razlikuju se po postupcima, ograničenjima resursa i "
"opsegu pregleda. Upravitelj snimki diska neće ih potajno instalirati ni "
"pokrenuti bez potpunih postavki."

#: src/btrfs-snapshots-manager/src/ui/btrfs_settings/maintenance/balance.rs
msgid "Btrfs examined {0} block groups and relocated {1}."
msgstr "Btrfs je pregledao grupe blokova ({0}) i premjestio ih {1}."

#: src/btrfs-snapshots-manager/src/ui/btrfs_settings/maintenance/balance.rs
msgid "Btrfs finished relocating underused data and metadata block groups."
msgstr ""
"Btrfs je dovršio premještanje slabo popunjenih grupa blokova podataka i "
"metapodataka."

#: src/btrfs-snapshots-manager/src/ui/btrfs_settings/maintenance/defrag.rs
msgid ""
"Btrfs finished rewriting eligible file extents below /home with ZSTD "
"compression."
msgstr ""
"Btrfs je dovršio ponovno zapisivanje prikladnih raspona datoteka pod /home "
"uz kompresiju ZSTD."

