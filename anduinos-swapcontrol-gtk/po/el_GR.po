msgid "<i>Recommended: {0} MiB, lz4, priority 100 (for {1} GiB RAM)</i>"
msgstr "<i>Συνιστώμενο: {0} MiB, lz4, προτεραιότητα 100 (για {1} GiB RAM)</i>"

#: src/views/swap_view.rs:777
msgid "Active — {0} GiB used / {1} GiB total"
msgstr "Ενεργό — {0} GiB χρησιμοποιούνται / {1} GiB συνολικά"

