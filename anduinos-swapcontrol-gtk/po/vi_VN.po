#: src/views/dashboard_view.rs:551
msgid "Not configured"
msgstr "Chưa cấu hình"

#: src/views/dashboard_view.rs:553
msgid "Resume target missing"
msgstr "Mục tiêu tiếp tục ngủ đông bị thiếu"

#: src/views/dashboard_view.rs:555
msgid "Resume target inactive"
msgstr "Mục tiêu tiếp tục ngủ đông không hoạt động"

#: src/views/dashboard_view.rs:557
msgid "Swap too small"
msgstr "Bộ nhớ ảo quá nhỏ"

#: src/views/dashboard_view.rs:559
msgid "Not ready"
