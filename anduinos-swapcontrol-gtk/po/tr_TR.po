#: src/views/swap_view.rs:267
msgid ""
"lz4 = fast (recommended), zstd = best ratio, lzo = legacy. Changing requires"
" zswap restart."
msgstr ""
"lz4 = hızlı (önerilen), zstd = en iyi oran, lzo = eski. Değiştirmek, "
"Zswap'ın yeniden başlatılmasını gerektirir."

