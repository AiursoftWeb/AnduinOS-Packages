#: src/swap/persist.rs:74
msgid ""
"The package 'anduinos-swap-config' is not installed.\n"
"\n"
"Zram changes cannot be applied or persisted without it.\n"
"Install 'anduinos-swap-config' to manage zram from this GUI."
msgstr ""
"Pakiet 'anduinos-swap-config' nie jest zainstalowany.\n"
"\n"
"Zmiany Zram nie mogą zostać zastosowane ani utrwalone bez niego.\n"
"Zainstaluj 'anduinos-swap-config', aby zarządzać zramem z tego interfejsu GUI."

#: src/swap/persist.rs:133
msgid ""
"The package 'anduinos-swap-config' is not installed.\n"
"\n"
"Zswap changes cannot be applied or persisted without it.\n"
"Install 'anduinos-swap-config' to manage zswap from this GUI."
msgstr ""
"Pakiet 'anduinos-swap-config' nie jest zainstalowany.\n"
"\n"
"Zmiany zswap nie mogą zostać zastosowane ani utrwalone bez niego.\n"
"Zainstaluj 'anduinos-swap-config', aby zarządzać zswap z tego interfejsu GUI."

