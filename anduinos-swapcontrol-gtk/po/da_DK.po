msgid ""
"lz4 = fast (recommended), zstd = best ratio, lzo = legacy. Changing requires"
" zswap restart."
msgstr ""
"lz4 = hurtig (anbefalet), zstd = bedste komprimering, lzo = legacy. Ændring "
"kræver genstart af zswap."

