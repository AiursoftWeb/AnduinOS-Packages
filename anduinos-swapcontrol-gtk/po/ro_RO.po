msgid "default"
msgstr "implicit"

#: src/views/swap_view.rs:267
msgid ""
"lz4 = fast (recommended), zstd = best ratio, lzo = legacy. Changing requires"
" zswap restart."
msgstr ""
"lz4 = rapid (recomandat), zstd = cea mai bună rată, lzo = vechi. Schimbarea "
"necesită restartarea zswap."

