#: src/views/swap_view.rs:267
msgid ""
"lz4 = fast (recommended), zstd = best ratio, lzo = legacy. Changing requires"
" zswap restart."
msgstr ""
"lz4 = nopea (suositus), zstd = paras pakkaussuhde, lzo = perinteinen. Muutos"
" vaatii zswapin uudelleenkäynnistyksen."

