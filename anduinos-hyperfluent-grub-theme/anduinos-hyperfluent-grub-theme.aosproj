<Project Sdk="Aiursoft.Apkg.Sdk">
  <PropertyGroup>
    <PackageName>anduinos-hyperfluent-grub-theme</PackageName>
    <PackageVersion>2.0.4-1+$(SuiteShortName)</PackageVersion>
    <Maintainer>AnduinOS Team &lt;anduin@aiursoft.com&gt;</Maintainer>
    <PackageDescription>Optional HyperFluent GRUB theme for AnduinOS</PackageDescription>
    <Section>admin</Section>
    <PackageHomepage>https://www.anduinos.com</PackageHomepage>
    <RepositoryUrl>https://github.com/AiursoftWeb/AnduinOS-Packages</RepositoryUrl>
    <LicenseType>GPL-3.0</LicenseType>
    <TargetDistro>anduinos</TargetDistro>
    <TargetSuites>noble-addon resolute-addon</TargetSuites>
    <TargetArchitectures>all</TargetArchitectures>
    <Component>main</Component>
    <SuiteShortNameMap>noble-addon=noble resolute-addon=resolute</SuiteShortNameMap>
  </PropertyGroup>

  <ItemGroup>
    <DependencyCheckSource Url="https://mirror.aiursoft.com/ubuntu"
                           SuiteMap="noble-addon=noble resolute-addon=resolute" />
    <Dependency Include="grub2-common" />
  </ItemGroup>

  <ItemGroup>
    <IncludeFolder Include="assets/theme/" Target="/usr/share/grub/themes/anduinos-hyperfluent/" />
    <IncludeFile Include="assets/30-anduinos-hyperfluent.cfg"
                 Target="/etc/default/grub.d/30-anduinos-hyperfluent.cfg" />
    <IncludeFile Include="LICENSE"
                 Target="/usr/share/doc/anduinos-hyperfluent-grub-theme/LICENSE" />
    <IncludeFile Include="UPSTREAM.md"
                 Target="/usr/share/doc/anduinos-hyperfluent-grub-theme/UPSTREAM.md" />
    <PostInstallScript Include="scripts/postinst.sh" />
    <PostRemoveScript Include="scripts/postrm.sh" />
    <TestCommand Name="source" Profile="anduinos-package-release-test"
                 Run="PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s tests -v"
                 TimeoutSeconds="300" />
  </ItemGroup>
</Project>
