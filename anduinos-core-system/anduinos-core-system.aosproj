<Project Sdk="Aiursoft.Apkg.Sdk">
  <PropertyGroup>
    <PackageName>anduinos-core-system</PackageName>
    <PackageVersion>2.0.2-5+$(SuiteShortName)</PackageVersion>
    <Maintainer>AnduinOS Team &lt;anduin@aiursoft.com&gt;</Maintainer>
    <PackageDescription>AnduinOS core system foundation metapackage — essential system services, networking, hardware support, and administration tools. This is the base layer for all AnduinOS variants (Desktop, Server, IoT).</PackageDescription>
    <Section>metapackages</Section>
    <PackageHomepage>https://www.anduinos.com</PackageHomepage>
    <RepositoryUrl>https://github.com/AiursoftWeb/AnduinOS-Packages</RepositoryUrl>
    <LicenseType>GPL-3.0</LicenseType>
    <TargetDistro>anduinos</TargetDistro>
    <TargetSuites>noble-addon resolute-addon</TargetSuites>
    <TargetArchitectures>amd64 arm64</TargetArchitectures>
    <Component>main</Component>
    <SuiteShortNameMap>noble-addon=noble resolute-addon=resolute</SuiteShortNameMap>
    <Conflicts>casper, initramfs-tools, initramfs-tools-core, initramfs-tools-bin, busybox-initramfs, finalrd</Conflicts>
  </PropertyGroup>

  <ItemGroup>
    <PrebuildCommand Run="PYTHONDONTWRITEBYTECODE=1 python3 ../tests/test_dracut_policy.py" />
    <PrebuildCommand Run="PYTHONDONTWRITEBYTECODE=1 python3 tests/test_migration_guard.py" />
    <PreInstallScript Include="scripts/preinst.sh" />
    <PostInstallScript Include="scripts/postinst.sh" />
    <PreRemoveScript Include="scripts/prerm.sh" />
    <IncludeScript Include="assets/anduinos-dracut-verify" Target="/usr/libexec/anduinos-dracut-verify" />
    <IncludeScript Include="assets/anduinos-update-initramfs" Target="/usr/libexec/anduinos-update-initramfs" />
    <IncludeScript Include="assets/anduinos-update-grub" Target="/usr/libexec/anduinos-update-grub" />
    <IncludeScript Include="dracut/99anduinos-migration-proof/module-setup.sh"
                   Target="/usr/lib/dracut/modules.d/99anduinos-migration-proof/module-setup.sh" />
    <IncludeScript Include="dracut/99anduinos-migration-proof/anduinos-migration-proof.sh"
                   Target="/usr/lib/dracut/modules.d/99anduinos-migration-proof/anduinos-migration-proof.sh" />
    <!-- ============================================================
         Layer 0 — Container base (minimal shell + networking)
         ============================================================ -->
    <Dependency Include="anduinos-container" />

    <!-- ============================================================
         Layer 1 — Core System (boot, init, kernel, firmware)
         Removing these = unbootable system.
         ============================================================ -->
    <Dependency Include="grub-common" />
    <Dependency Include="grub-efi-amd64 | grub-pc" Condition="'$(Arch)' == 'amd64'" />
    <Dependency Include="grub-efi-arm64" Condition="'$(Arch)' == 'arm64'" />
    <!-- Installed amd64 systems deliberately carry both platform module sets:
         the installer writes both Legacy BIOS and UEFI boot paths so moving a
         disk between firmware modes remains supported. The non-conflicting
         -bin packages, signed UEFI payload and shim are persistent system
         capabilities, not temporary dependencies of the Live installer. -->
    <Dependency Include="grub-pc-bin" Condition="'$(Arch)' == 'amd64'" />
    <Dependency Include="grub-efi-amd64-bin" Condition="'$(Arch)' == 'amd64'" />
    <Dependency Include="grub-efi-amd64-signed" Condition="'$(Arch)' == 'amd64'" />
    <Dependency Include="grub-efi-arm64-bin" Condition="'$(Arch)' == 'arm64'" />
    <Dependency Include="grub-efi-arm64-signed" Condition="'$(Arch)' == 'arm64'" />
    <Dependency Include="shim-signed" />
    <Dependency Include="grub2-common" />
    <Dependency Include="anduinos-grub-style" />
    <Dependency Include="init" />
    <Dependency Include="systemd-sysv" />
    <Dependency Include="linux-base" />
    <Dependency Include="linux-generic-hwe-26.04" Condition="'$(Suite)' == 'resolute-addon'" />
    <Dependency Include="linux-firmware" />
    <Dependency Include="systemd" />
    <Dependency Include="systemd-hwe-hwdb" />
    <!-- AnduinOS has one early-boot implementation. Alternatives and legacy
         generator packages are deliberately forbidden by the package contract. -->
    <Dependency Include="dracut" />
    <Dependency Include="dracut-core" />
    <Dependency Include="dracut-install" />
    <Dependency Include="efibootmgr" />
    <Dependency Include="kmod" />

    <!-- ============================================================
         Networking (core — system won't have connectivity without these)
         ============================================================ -->
    <Dependency Include="libnss-systemd" />
    <Dependency Include="network-manager" />
    <Dependency Include="wpasupplicant" />
    <Dependency Include="iproute2" />

    <!-- ============================================================
         Firewall — one of these three is required; ufw is preferred
         ============================================================ -->
    <Dependency Include="ufw | iptables | nftables" />

    <!-- ============================================================
         Security
         ============================================================ -->
    <Dependency Include="openssh-client" />

    <!-- ============================================================
         PAM / Authentication / Session
         ============================================================ -->
    <Dependency Include="libpam-systemd" />
    <Dependency Include="libpam-modules" />
    <Dependency Include="libpam-modules-bin" />
    <Dependency Include="dbus" />
    <Dependency Include="dbus-bin" />
    <Dependency Include="dbus-user-session" />

    <!-- ============================================================
         Filesystem & Storage (core — FUSE is required)
         ============================================================ -->
    <Dependency Include="libfuse2t64" />
    <Dependency Include="libfuse3-4" />

    <!-- ============================================================
         Locale & Timezone
         ============================================================ -->
    <Dependency Include="resolvconf" />

    <!-- ============================================================
         Essential CLI / Networking Tools
         ============================================================ -->
    <Dependency Include="wget" />
    <Dependency Include="uuid-runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- ============================================================
         Recommends: security & networking supplements
         ============================================================ -->
    <Recommend Include="ufw" />
    <Recommend Include="nftables" />
    <Recommend Include="iptables" />
    <Recommend Include="sudo-rs" />
    <Recommend Include="apparmor" />
    <Recommend Include="dhcpcd-base" />
    <Recommend Include="dnsmasq-base" />

    <!-- ============================================================
         Recommends: filesystem & storage tools
         ============================================================ -->
    <Recommend Include="dosfstools" />
    <Recommend Include="cifs-utils" />
    <Recommend Include="parted" />
    <Recommend Include="fdisk" />
    <Recommend Include="hdparm" />

    <!-- ============================================================
         Recommends: system maintenance
         ============================================================ -->
    <Recommend Include="cron" />
    <Recommend Include="logrotate" />
    <Recommend Include="rsync" />

    <!-- ============================================================
         Recommends: AnduinOS system tuning
         ============================================================ -->
    <Recommend Include="anduinos-system-tweaks" />

    <!-- ============================================================
         Recommends: CLI tools & utilities
         ============================================================ -->

    <Recommend Include="man-db" />

    <!-- ============================================================
         Recommends: hardware introspection
         ============================================================ -->
    <Recommend Include="pciutils" />
    <Recommend Include="usbutils" />
    <Recommend Include="lshw" />
    <Recommend Include="ethtool" />
    <Recommend Include="hwdata" />

    <!-- ============================================================
         Recommends: power-user / admin tools
         ============================================================ -->
    <Recommend Include="htop" />
    <Recommend Include="fastfetch" />
    <Recommend Include="net-tools" />
    <Recommend Include="iputils-tracepath" />
    <Recommend Include="traceroute" />
    <Recommend Include="httping" />
    <Recommend Include="smartmontools" />
    <Recommend Include="mdadm" />
    <Recommend Include="whois" />
    <Recommend Include="bind9-dnsutils" />

    <Recommend Include="busybox-static" />
    <Recommend Include="command-not-found" />
    <Recommend Include="cpio" />
    <Recommend Include="crash" />
    <Recommend Include="debconf-i18n" />
    <Recommend Include="dmidecode" />
    <Recommend Include="dns-root-data" />
    <Recommend Include="eject" />
    <Recommend Include="gettext" />
    <Recommend Include="ibverbs-providers" />
    <Recommend Include="libmbim-utils" />
    <Recommend Include="manpages" />
    <Recommend Include="manpages-dev" />
    <Recommend Include="media-types" />
    <Recommend Include="mtr-tiny" />
    <Recommend Include="numactl" />
    <Recommend Include="powermgmt-base" />
    <Recommend Include="python3-rich" />
    <Recommend Include="python3-systemd" />
    <Recommend Include="strace" />
    <Recommend Include="tcpdump" />
    <Recommend Include="time" />
    <Recommend Include="xauth" />

    <!-- PAM extras (enterprise / biometric) -->
    <Recommend Include="libpam-cap" />
    <Recommend Include="libpam-fprintd" />
    <Recommend Include="libpam-pwquality" />
    <Recommend Include="libpam-sss" />

    <!-- Networking & Storage extras -->
    <Recommend Include="networkd-dispatcher" />
    <Recommend Include="dmsetup" />
    <Recommend Include="systemd-cryptsetup" />
    <Recommend Include="publicsuffix" />

    <!-- Hardware extras -->
    <Recommend Include="modemmanager" />
    <Recommend Include="thermald" />
    <Recommend Include="usb-modeswitch" />
    <Recommend Include="libopengl0" />
    <Recommend Include="bolt" />
    <Recommend Include="cracklib-runtime" />
  </ItemGroup>

</Project>
