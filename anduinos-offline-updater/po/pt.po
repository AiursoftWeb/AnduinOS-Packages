msgid "A newer updater is required"
msgstr "É necessário um atualizador mais recente"

msgid "AnduinOS update packages"
msgstr "Pacotes de atualização do AnduinOS"

msgid "Cannot preview this update"
msgstr "Não é possível visualizar esta atualização"

msgid "Check required"
msgstr "Verificação obrigatória"

msgid "Checking your update…"
msgstr "Verificando sua atualização…"

msgid "Choose Update File"
msgstr "Selecionar arquivo de atualização"

msgid "Choose an AnduinOS update package.\nNo internet connection needed to check the file."
msgstr "Selecione um pacote de atualização do AnduinOS.\nNenhuma conexão com a internet é necessária para verificar o arquivo."

msgid "Choose another file"
msgstr "Selecionar outro arquivo"

msgid "Choose one local .atgz file."
msgstr "Selecione um arquivo .atgz local."

msgid "Close"
msgstr "Fechar"

msgid "Could not open the file"
msgstr "Não foi possível abrir o arquivo"

msgid "Could not open the website"
msgstr "Não foi possível abrir o site"

msgid "Current version"
msgstr "Versão atual"

msgid "Disabled"
msgstr "Desativado"

msgid "Get updates from your Pro benefits center"
msgstr "Obtenha atualizações no seu centro de benefícios Pro"

msgid "Installation space and snapshot availability must be checked again before installing."
msgstr "O espaço de instalação e a disponibilidade de snapshot devem ser verificados novamente antes de instalar."

msgid "No system packages were changed."
msgstr "Nenhum pacote do sistema foi alterado."

msgid "Official .atgz update packages are a paid AnduinOS Pro benefit."
msgstr "Os pacotes de atualização .atgz oficiais são um benefício pago do AnduinOS Pro."

msgid "Offline Updater"
msgstr "Atualizador offline"

msgid "Package changes"
msgstr "Alterações nos pacotes"

msgid "Package expansion estimate"
msgstr "Estimativa de expansão de pacotes"

msgid "Preview only. Installing updates is not available in this build."
msgstr "Somente pré-visualização. A instalação de atualizações não está disponível nesta versão."

msgid "Review your update"
msgstr "Revise sua atualização"

msgid "System snapshot"
msgstr "Snapshot do sistema"

msgid "Technical details"
msgstr "Detalhes técnicos"

msgid "Temporary storage"
msgstr "Armazenamento temporário"

msgid "The update could not be checked. Try choosing the file again."
msgstr "A atualização não pôde ser verificada. Tente selecionar o arquivo novamente."

msgid "Unavailable"
msgstr "Indisponível"

msgid "Unknown"
msgstr "Desconhecido"

msgid "Update from a file"
msgstr "Atualizar a partir de um arquivo"

msgid "Update to"
msgstr "Atualizar para"

msgid "Verifying the signature and checking your system. This may take a few minutes."
msgstr "Verificando a assinatura e seu sistema. Isso pode levar alguns minutos."

msgid "You already have this update"
msgstr "Você já possui esta atualização"

msgid "or drop an .atgz file here"
msgstr "ou solte um arquivo .atgz aqui"

msgid "Check an AnduinOS offline update package"
msgstr "Verifique um pacote de atualização offline do AnduinOS"
