msgid "A newer updater is required"
msgstr "Потрібен новіший оновлювач"

msgid "AnduinOS update packages"
msgstr "Пакети оновлень AnduinOS"

msgid "Cannot preview this update"
msgstr "Неможливо переглянути це оновлення"

msgid "Check required"
msgstr "Перевірка обов'язкова"

msgid "Checking your update…"
msgstr "Перевірка вашого оновлення…"

msgid "Choose Update File"
msgstr "Обрати файл оновлення"

msgid "Choose an AnduinOS update package.\nNo internet connection needed to check the file."
msgstr "Оберіть пакет оновлення AnduinOS.\nДля перевірки файлу інтернет не потрібен."

msgid "Choose another file"
msgstr "Обрати інший файл"

msgid "Choose one local .atgz file."
msgstr "Оберіть один локальний файл .atgz."

msgid "Close"
msgstr "Закрити"

msgid "Could not open the file"
msgstr "Не вдалося відкрити файл"

msgid "Could not open the website"
msgstr "Не вдалося відкрити веб-сайт"

msgid "Current version"
msgstr "Поточна версія"

msgid "Disabled"
msgstr "Вимкнено"

msgid "Get updates from your Pro benefits center"
msgstr "Отримуйте оновлення з вашого центру переваг Pro"

msgid "Installation space and snapshot availability must be checked again before installing."
msgstr "Перед встановленням потрібно знову перевірити наявність місця для встановлення та доступність знімка системи."

msgid "No system packages were changed."
msgstr "Системні пакети не були змінені."

msgid "Official .atgz update packages are a paid AnduinOS Pro benefit."
msgstr "Офіційні пакети оновлень .atgz є платною перевагою AnduinOS Pro."

msgid "Offline Updater"
msgstr "Офлайн-оновлювач"

msgid "Package changes"
msgstr "Зміни пакетів"

msgid "Package expansion estimate"
msgstr "Оцінка розпакування пакетів"

msgid "Preview only. Installing updates is not available in this build."
msgstr "Лише перегляд. Встановлення оновлень недоступне в цій збірці."

msgid "Review your update"
msgstr "Перегляньте ваше оновлення"

msgid "System snapshot"
msgstr "Знімок системи"

msgid "Technical details"
msgstr "Технічні деталі"

msgid "Temporary storage"
msgstr "Тимчасове сховище"

msgid "The update could not be checked. Try choosing the file again."
msgstr "Не вдалося перевірити оновлення. Спробуйте обрати файл ще раз."

msgid "Unavailable"
msgstr "Недоступно"

msgid "Unknown"
msgstr "Невідомо"

msgid "Update from a file"
msgstr "Оновлення з файлу"

msgid "Update to"
msgstr "Оновити до"

msgid "Verifying the signature and checking your system. This may take a few minutes."
msgstr "Перевірка підпису та аналіз вашої системи. Це може зайняти кілька хвилин."

msgid "You already have this update"
msgstr "У вас вже є це оновлення"

msgid "or drop an .atgz file here"
msgstr "або перетягніть файл .atgz сюди"

msgid "Check an AnduinOS offline update package"
msgstr "Перевірка пакета офлайн-оновлення AnduinOS"
