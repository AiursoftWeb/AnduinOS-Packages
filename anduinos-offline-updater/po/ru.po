msgid "A newer updater is required"
msgstr "Требуется более новая версия средства обновления"

msgid "AnduinOS update packages"
msgstr "Пакеты обновления AnduinOS"

#, python-brace-format
msgid "AnduinOS {source} → {target}"
msgstr "AnduinOS {source} → {target}"

#, python-brace-format
msgid "AnduinOS {version}"
msgstr "AnduinOS {version}"

msgid "Authorize importing the file and checking the installation plan. No packages are installed yet."
msgstr "Разрешите импорт файла и проверку плана установки. Пакеты ещё не установлены."

msgid "Cannot preview this update"
msgstr "Не удалось предпросмотреть это обновление"

msgid "Cannot read the update status"
msgstr "Не удалось прочитать статус обновления"

msgid "Check required"
msgstr "Проверка обязательна"

msgid "Check the details before trying again."
msgstr "Проверьте детали и попробуйте снова."

msgid "Checking the installation…"
msgstr "Проверка установки…"

msgid "Checking your update…"
msgstr "Проверка вашего обновления…"

msgid "Choose Update File"
msgstr "Выбрать файл обновления"

msgid ""
"Choose an AnduinOS update package.\n"
"No internet connection needed to check the file."
msgstr ""
"Выберите пакет обновления AnduinOS.\n"
"Для проверки файла не требуется подключение к интернету."

msgid "Choose another file"
msgstr "Выбрать другой файл"

msgid "Choose one local .atgz file."
msgstr "Выберите один локальный файл .atgz."

msgid "Close"
msgstr "Закрыть"

msgid "Continue"
msgstr "Продолжить"

msgid "Could not open the file"
msgstr "Не удалось открыть файл"

msgid "Could not open the website"
msgstr "Не удалось открыть веб-сайт"

msgid "Could not save the update session"
msgstr "Не удалось сохранить сессию обновления"

msgid "Current version"
msgstr "Текущая версия"

msgid "Disabled"
msgstr "Отключено"

msgid "Done"
msgstr "Готово"

msgid "Get updates from your Pro benefits center"
msgstr "Получайте обновления в центре преимуществ Pro"

msgid "Installation space and snapshot availability must be checked again before installing."
msgstr "Перед установкой необходимо снова проверить наличие места для установки и возможность создания снимка системы."

msgid "Installing your update…"
msgstr "Установка обновления…"

msgid "Keep an independent backup of important files."
msgstr "Сохраните независимый резервный копирование важных файлов."

msgid "Keep this job ID to reconnect from the command line."
msgstr "Сохраните этот ID задачи для повторного подключения из командной строки."

msgid "Keep your computer connected to power. Closing this window will not stop the update."
msgstr "Держите компьютер подключённым к сети. Закрытие этого окна не остановит обновление."

msgid "Keep your computer connected to power. You can close this window and return to check progress."
msgstr "Держите компьютер подключённым к сети. Вы можете закрыть это окно и вернуться позже для проверки прогресса."

msgid "No system packages were changed."
msgstr "Системные пакеты не были изменены."

msgid "Official .atgz update packages are a paid AnduinOS Pro benefit."
msgstr "Официальные пакеты обновления .atgz — это платное преимущество AnduinOS Pro."

msgid "Offline Updater"
msgstr "Офлайн-средство обновления"

msgid "Package changes"
msgstr "Изменения пакетов"

msgid "Package expansion estimate"
msgstr "Оценка размера распаковки"

#, python-brace-format
msgid "Planned update: {source} → {target}"
msgstr "Запланировано: {source} → {target}"

msgid "Preparing your update…"
msgstr "Подготовка обновления…"

msgid "Reconnect"
msgstr "Переподключиться"

msgid "Reconnecting to your update…"
msgstr "Переподключение к вашему обновлению…"

msgid "Remove Imported File"
msgstr "Удалить импортированный файл"

msgid "Removing the imported file…"
msgstr "Удаление импортированного файла…"

msgid "Restart your computer to finish applying the update."
msgstr "Перезагрузите компьютер, чтобы завершить применение обновления."

msgid "Restarting the updater…"
msgstr "Перезапуск обновляющей программы…"

msgid "Review your update"
msgstr "Проверьте обновление"

#, python-brace-format
msgid "Stage {current} of {total}"
msgstr "Этап {current} из {total}"

msgid "Start Update"
msgstr "Начать обновление"

msgid "Starting your update…"
msgstr "Запуск обновления…"

msgid "System snapshot"
msgstr "Снимок системы"

msgid "Technical details"
msgstr "Технические детали"

msgid "Temporary storage"
msgstr "Временное хранилище"

msgid "The request did not complete. Authorization may have been cancelled."
msgstr "Запрос не был завершён. Авторизация могла быть отменена."

msgid "The update could not be checked. Try choosing the file again."
msgstr "Не удалось проверить обновление. Попробуйте выбрать файл снова."

msgid "The update may still be running. Reconnect to check it; do not start another installation."
msgstr "Обновление может всё ещё выполняться. Переподключитесь для проверки; не запускайте другую установку."

msgid "The updater has been upgraded. Review and confirm the remaining update."
msgstr "Обновляющая программа была обновлена. Просмотрите и подтвердите оставшееся обновление."

msgid "This removes the imported copy and job history, not your original download."
msgstr "Это удалит импортированную копию и историю задач, а не исходную загрузку."

msgid "This update needs review"
msgstr "Это обновление требует проверки"

msgid "Unavailable"
msgstr "Недоступно"

msgid "Unexpected update response."
msgstr "Непредвиденный ответ обновления."

msgid "Unknown"
msgstr "Неизвестно"

msgid "Update complete"
msgstr "Обновление завершено"

msgid "Update could not start"
msgstr "Не удалось запустить обновление"

msgid "Update failed"
msgstr "Ошибка обновления"

msgid "Update from a file"
msgstr "Обновление из файла"

msgid "Update to"
msgstr "Обновить до"

msgid "Use the command line to review this older update session, or remove its imported file and choose it again."
msgstr "Используйте командную строку для проверки этой более ранней сессии обновления или удалите импортированный файл и выберите его снова."

msgid "Verifying the signature and checking your system. This may take a few minutes."
msgstr "Проверка подписи и проверка системы. Это может занять несколько минут."

msgid "Working…"
msgstr "Выполняется…"

msgid "You already have this update"
msgstr "У вас уже есть это обновление"

msgid "You can keep using your computer."
msgstr "Компьютер готов к работе."

msgid "or drop an .atgz file here"
msgstr "или перетащите файл .atgz сюда"
