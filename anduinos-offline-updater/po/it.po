msgid "A newer updater is required"
msgstr "È richiesto un programmatore di aggiornamento più recente"

msgid "AnduinOS update packages"
msgstr "Pacchetti di aggiornamento AnduinOS"

msgid "Cannot preview this update"
msgstr "Impossibile anteprima questo aggiornamento"

msgid "Check required"
msgstr "Verifica obbligatoria"

msgid "Checking your update…"
msgstr "Verifica del tuo aggiornamento…"

msgid "Choose Update File"
msgstr "Seleziona file di aggiornamento"

msgid "Choose an AnduinOS update package.\nNo internet connection needed to check the file."
msgstr "Seleziona un pacchetto di aggiornamento AnduinOS.\nNon è necessaria la connessione a Internet per verificare il file."

msgid "Choose another file"
msgstr "Seleziona un altro file"

msgid "Choose one local .atgz file."
msgstr "Seleziona un file .atgz locale."

msgid "Close"
msgstr "Chiudi"

msgid "Could not open the file"
msgstr "Impossibile aprire il file"

msgid "Could not open the website"
msgstr "Impossibile aprire il sito Web"

msgid "Current version"
msgstr "Versione attuale"

msgid "Disabled"
msgstr "Disattivato"

msgid "Get updates from your Pro benefits center"
msgstr "Ottieni aggiornamenti dal tuo centro vantaggi Pro"

msgid "Installation space and snapshot availability must be checked again before installing."
msgstr "Lo spazio di installazione e la disponibilità dello snapshot del sistema devono essere verificati nuovamente prima dell'installazione."

msgid "No system packages were changed."
msgstr "Nessun pacchetto di sistema è stato modificato."

msgid "Official .atgz update packages are a paid AnduinOS Pro benefit."
msgstr "I pacchetti di aggiornamento .atgz ufficiali sono un vantaggio a pagamento di AnduinOS Pro."

msgid "Offline Updater"
msgstr "Aggiornatore offline"

msgid "Package changes"
msgstr "Modifiche ai pacchetti"

msgid "Package expansion estimate"
msgstr "Stima dell'espansione dei pacchetti"

msgid "Preview only. Installing updates is not available in this build."
msgstr "Solo anteprima. L'installazione degli aggiornamenti non è disponibile in questa build."

msgid "Review your update"
msgstr "Rivedi il tuo aggiornamento"

msgid "System snapshot"
msgstr "Snapshot del sistema"

msgid "Technical details"
msgstr "Dettagli tecnici"

msgid "Temporary storage"
msgstr "Archiviazione temporanea"

msgid "The update could not be checked. Try choosing the file again."
msgstr "Non è stato possibile verificare l'aggiornamento. Prova a selezionare di nuovo il file."

msgid "Unavailable"
msgstr "Non disponibile"

msgid "Unknown"
msgstr "Sconosciuto"

msgid "Update from a file"
msgstr "Aggiorna da un file"

msgid "Update to"
msgstr "Aggiorna a"

msgid "Verifying the signature and checking your system. This may take a few minutes."
msgstr "Verifica della firma e controllo del sistema. Potrebbero essere necessari alcuni minuti."

msgid "You already have this update"
msgstr "Hai già questo aggiornamento"

msgid "or drop an .atgz file here"
msgstr "oppure trascina qui un file .atgz"

msgid "Check an AnduinOS offline update package"
msgstr "Verifica un pacchetto di aggiornamento offline AnduinOS"
