msgid "A newer updater is required"
msgstr "Diperlukan updater versi yang lebih baru"

msgid "AnduinOS update packages"
msgstr "Paket pembaruan AnduinOS"

#, python-brace-format
msgid "AnduinOS {source} → {target}"
msgstr "AnduinOS {source} → {target}"

#, python-brace-format
msgid "AnduinOS {version}"
msgstr "AnduinOS {version}"

msgid "Authorize importing the file and checking the installation plan. No packages are installed yet."
msgstr "Otorisasi impor file dan pemeriksaan rencana instalasi. Belum ada paket yang diinstal."

msgid "Cannot preview this update"
msgstr "Tidak dapat menampilkan pratinjau pembaruan ini"

msgid "Cannot read the update status"
msgstr "Tidak dapat membaca status pembaruan"

msgid "Check required"
msgstr "Periksa persyaratan"

msgid "Check the details before trying again."
msgstr "Periksa detail sebelum mencoba lagi."

msgid "Checking the installation…"
msgstr "Memeriksa instalasi…"

msgid "Checking your update…"
msgstr "Memeriksa pembaruan Anda…"

msgid "Choose Update File"
msgstr "Pilih File Pembaruan"

msgid ""
"Choose an AnduinOS update package.\n"
"No internet connection needed to check the file."
msgstr ""
"Pilih paket pembaruan AnduinOS.\n"
"Tidak perlu koneksi internet untuk memeriksa file."

msgid "Choose another file"
msgstr "Pilih file lain"

msgid "Choose one local .atgz file."
msgstr "Pilih satu file .atgz lokal."

msgid "Close"
msgstr "Tutup"

msgid "Continue"
msgstr "Lanjutkan"

msgid "Could not open the file"
msgstr "Tidak dapat membuka file"

msgid "Could not open the website"
msgstr "Tidak dapat membuka situs web"

msgid "Could not save the update session"
msgstr "Tidak dapat menyimpan sesi pembaruan"

msgid "Current version"
msgstr "Versi saat ini"

msgid "Disabled"
msgstr "Nonaktif"

msgid "Done"
msgstr "Selesai"

msgid "Get updates from your Pro benefits center"
msgstr "Dapatkan pembaruan dari pusat manfaat Pro Anda"

msgid "Installation space and snapshot availability must be checked again before installing."
msgstr "Ruang instalasi dan ketersediaan snapshot sistem harus diperiksa kembali sebelum menginstal."

msgid "Installing your update…"
msgstr "Menginstal pembaruan Anda…"

msgid "Keep an independent backup of important files."
msgstr "Simpan cadangan independen file penting."

msgid "Keep this job ID to reconnect from the command line."
msgstr "Simpan ID tugas ini untuk terhubung kembali dari baris perintah."

msgid "Keep your computer connected to power. Closing this window will not stop the update."
msgstr "Jaga komputer tetap terhubung ke sumber daya. Menutup jendela ini tidak akan menghentikan pembaruan."

msgid "Keep your computer connected to power. You can close this window and return to check progress."
msgstr "Jaga komputer tetap terhubung ke sumber daya. Anda dapat menutup jendela ini dan kembali untuk memeriksa kemajuan."

msgid "No system packages were changed."
msgstr "Tidak ada paket sistem yang diubah."

msgid "Official .atgz update packages are a paid AnduinOS Pro benefit."
msgstr "Paket pembaruan .atgz resmi adalah manfaat berbayar AnduinOS Pro."

msgid "Offline Updater"
msgstr "Offline Updater"

msgid "Package changes"
msgstr "Perubahan paket"

msgid "Package expansion estimate"
msgstr "Perkiraan ekspansi paket"

#, python-brace-format
msgid "Planned update: {source} → {target}"
msgstr "Pembaruan direncanakan: {source} → {target}"

msgid "Preparing your update…"
msgstr "Menyiapkan pembaruan Anda…"

msgid "Reconnect"
msgstr "Hubungkan Ulang"

msgid "Reconnecting to your update…"
msgstr "Menghubungkan kembali ke pembaruan Anda…"

msgid "Remove Imported File"
msgstr "Hapus File Impor"

msgid "Removing the imported file…"
msgstr "Menghapus file impor…"

msgid "Restart your computer to finish applying the update."
msgstr "Mulai ulang komputer Anda untuk menyelesaikan penerapan pembaruan."

msgid "Restarting the updater…"
msgstr "Memulai ulang pembaru…"

msgid "Review your update"
msgstr "Tinjau pembaruan Anda"

#, python-brace-format
msgid "Stage {current} of {total}"
msgstr "Tahap {current} dari {total}"

msgid "Start Update"
msgstr "Mulai Pembaruan"

msgid "Starting your update…"
msgstr "Memulai pembaruan Anda…"

msgid "System snapshot"
msgstr "Snapshot sistem"

msgid "Technical details"
msgstr "Detail teknis"

msgid "Temporary storage"
msgstr "Penyimpanan sementara"

msgid "The request did not complete. Authorization may have been cancelled."
msgstr "Permintaan tidak selesai. Otorisasi mungkin dibatalkan."

msgid "The update could not be checked. Try choosing the file again."
msgstr "Pembaruan tidak dapat diperiksa. Coba pilih file lagi."

msgid "The update may still be running. Reconnect to check it; do not start another installation."
msgstr "Pembaruan mungkin masih berjalan. Hubungkan kembali untuk memeriksanya; jangan mulai instalasi lain."

msgid "The updater has been upgraded. Review and confirm the remaining update."
msgstr "Pembaru telah diperbarui. Tinjau dan konfirmasi sisa pembaruan."

msgid "This removes the imported copy and job history, not your original download."
msgstr "Ini menghapus salinan impor dan riwayat tugas, bukan unduhan asli Anda."

msgid "This update needs review"
msgstr "Pembaruan ini perlu ditinjau"

msgid "Unavailable"
msgstr "Tidak tersedia"

msgid "Unexpected update response."
msgstr "Respons pembaruan tidak terduga."

msgid "Unknown"
msgstr "Tidak diketahui"

msgid "Update complete"
msgstr "Pembaruan selesai"

msgid "Update could not start"
msgstr "Pembaruan tidak dapat dimulai"

msgid "Update failed"
msgstr "Pembaruan gagal"

msgid "Update from a file"
msgstr "Pembaruan dari file"

msgid "Update to"
msgstr "Pembaruan ke"

msgid "Use the command line to review this older update session, or remove its imported file and choose it again."
msgstr "Gunakan baris perintah untuk meninjau sesi pembaruan lama ini, atau hapus file impornya dan pilih lagi."

msgid "Verifying the signature and checking your system. This may take a few minutes."
msgstr "Memverifikasi tanda tangan dan memeriksa sistem Anda. Ini mungkin memakan waktu beberapa menit."

msgid "Working…"
msgstr "Bekerja…"

msgid "You already have this update"
msgstr "Anda sudah memiliki pembaruan ini"

msgid "You can keep using your computer."
msgstr "Anda bisa terus menggunakan komputer."

msgid "or drop an .atgz file here"
msgstr "atau jatuhkan file .atgz di sini"
