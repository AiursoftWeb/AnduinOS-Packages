msgid ""
msgstr ""
"Project-Id-Version: AnduinOS Offline Updater 2.1.0-14\n"
"Report-Msgid-Bugs-To: \n"
"POT-Creation-Date: 2026-11-15 10:11+0000\n"
"PO-Revision-Date: 2026-11-23 04:07+0000\n"
"Last-Translator: AnduinOS Team <anduin@aiursoft.com>\n"
"Language-Team: Croatian\n"
"Language: hr\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=3; plural=(n%10==1 && n%100!=11 ? 0 : n%10>=2 && "
"n%10<=4 && (n%100<12 || n%100>14) ? 1 : 2);\n"

msgid "A newer updater is required"
msgstr "Potrebna je novija verzija ažurirača"

msgid "AnduinOS update packages"
msgstr "Paketi ažuriranja AnduinOS-a"

#, python-brace-format
msgid "AnduinOS {source} → {target}"
msgstr "AnduinOS {source} → {target}"

#, python-brace-format
msgid "AnduinOS {version}"
msgstr "AnduinOS {version}"

msgid ""
"Authorize importing the file and checking the installation plan. No packages "
"are installed yet."
msgstr ""
"Odobrite uvoz datoteke i provjeru plana instalacije. Paketi još nisu "
"instalirani."

msgid "Built (UTC)"
msgstr "Izrađeno (UTC)"

msgid "Cannot install this update"
msgstr "Nije moguće instalirati ovo ažuriranje"

msgid "Cannot preview this update"
msgstr "Nije moguće pregledati ovo ažuriranje"

msgid "Cannot read the update status"
msgstr "Nije moguće pročitati status ažuriranja"

msgid "Check required"
msgstr "Potrebna je provjera"

msgid "Check the details before trying again."
msgstr "Provjerite pojedinosti prije ponovnog pokušaja."

msgid "Checking the installation…"
msgstr "Provjerava se instalacija…"

msgid "Checking your update…"
msgstr "Provjerava se ažuriranje…"

msgid "Choose Update File"
msgstr "Odaberi datoteku ažuriranja"

msgid ""
"Choose an AnduinOS update package.\n"
"No internet connection needed to check the file."
msgstr ""
"Odaberite paket ažuriranja AnduinOS-a.\n"
"Za provjeru datoteke nije potrebna internetska veza."

msgid "Choose another file"
msgstr "Odaberi drugu datoteku"

msgid "Choose one local .atgz file."
msgstr "Odaberite jednu lokalnu datoteku .atgz."

msgid "Close"
msgstr "Zatvori"

msgid "Continue"
msgstr "Nastavi"

msgid "Could not open the file"
msgstr "Nije moguće otvoriti datoteku"

msgid "Could not open the website"
msgstr "Nije moguće otvoriti web-stranicu"

msgid "Could not save the update session"
msgstr "Nije moguće spremiti sesiju ažuriranja"

msgid "Disabled"
msgstr "Onemogućeno"

msgid "Done"
msgstr "Gotovo"

msgid "File size"
msgstr "Veličina datoteke"

msgid "Get updates from your Pro benefits center"
msgstr "Preuzmite ažuriranja iz centra pogodnosti Pro"

msgid ""
"Installation space and snapshot availability must be checked again before "
"installing."
msgstr ""
"Prije instalacije potrebno je ponovno provjeriti prostor za instalaciju i "
"dostupnost snimke sustava."

msgid "Installing your update…"
msgstr "Instalira se ažuriranje…"

msgid "Keep an independent backup of important files."
msgstr "Izradite zasebnu sigurnosnu kopiju važnih datoteka."

msgid "Keep this job ID to reconnect from the command line."
msgstr ""
"Sačuvajte ID ovog zadatka da biste se ponovno povezali iz naredbenog retka."

msgid ""
"Keep your computer connected to power. Closing this window will not stop the "
"update."
msgstr ""
"Držite računalo priključeno na napajanje. Zatvaranje ovog prozora neće "
"zaustaviti ažuriranje."

msgid ""
"Keep your computer connected to power. You can close this window and return "
"to check progress."
msgstr ""
"Držite računalo priključeno na napajanje. Možete zatvoriti ovaj prozor i "
"vratiti se da biste provjerili napredak."

msgid "No system packages were changed."
msgstr "Nijedan sistemski paket nije promijenjen."

msgid "Official .atgz update packages are a paid AnduinOS Pro benefit."
msgstr "Službeni paketi ažuriranja .atgz plaćena su pogodnost AnduinOS Pro-a."

msgid "Offline Updater"
msgstr "Izvanmrežno ažuriranje"

msgid "Package changes"
msgstr "Promjene paketa"

msgid "Package expansion estimate"
msgstr "Procjena prostora za raspakirane pakete"

#, python-brace-format
msgid "Planned update: {source} → {target}"
msgstr "Planirano ažuriranje: {source} → {target}"

msgid "Preparing your update…"
msgstr "Priprema se ažuriranje…"

msgid "Reconnect"
msgstr "Ponovno se poveži"

msgid "Reconnecting to your update…"
msgstr "Ponovno se povezujete s ažuriranjem…"

msgid "Remove Imported File"
msgstr "Ukloni uvezenu datoteku"

msgid "Removing the imported file…"
msgstr "Uklanja se uvezena datoteka…"

msgid "Restart your computer to finish applying the update."
msgstr "Ponovno pokrenite računalo da biste dovršili primjenu ažuriranja."

msgid "Restarting the updater…"
msgstr "Ponovno se pokreće ažurirač…"

msgid "Review your update"
msgstr "Pregledajte ažuriranje"

msgid "Signature"
msgstr "Potpis"

#, python-brace-format
msgid "Stage {current} of {total}"
msgstr "Faza {current} od {total}"

msgid "Start Update"
msgstr "Pokreni ažuriranje"

msgid "Starting your update…"
msgstr "Pokreće se ažuriranje…"

msgid "System snapshot"
msgstr "Snimka sustava"

msgid "Technical details"
msgstr "Tehnički detalji"

msgid "Temporary storage"
msgstr "Privremena pohrana"

msgid ""
"The current system version could not be determined. Check your system before "
"updating."
msgstr ""
"Nije moguće odrediti trenutačnu verziju sustava. Provjerite sustav prije "
"ažuriranja."

msgid "The request did not complete. Authorization may have been cancelled."
msgstr "Zahtjev nije dovršen. Autorizacija je možda otkazana."

msgid "The update could not be checked. Try choosing the file again."
msgstr ""
"Nije moguće provjeriti ažuriranje. Pokušajte ponovno odabrati datoteku."

msgid ""
"The update may still be running. Reconnect to check it; do not start another "
"installation."
msgstr ""
"Ažuriranje je možda još u tijeku. Ponovno se povežite da biste provjerili "
"njegov status; nemojte pokretati drugu instalaciju."

msgid "The updater has been upgraded. Review and confirm the remaining update."
msgstr "Ažurirač je nadograđen. Pregledajte i potvrdite preostalo ažuriranje."

msgid "This computer"
msgstr "Ovo računalo"

msgid "This file has not passed verification."
msgstr "Ova datoteka nije prošla provjeru."

msgid ""
"This package is for a different AnduinOS series. Choose an update for your "
"system version."
msgstr ""
"Ovaj je paket namijenjen drugom izdanju AnduinOS-a. Odaberite ažuriranje za "
"verziju svojeg sustava."

#, python-brace-format
msgid ""
"This package is for a different architecture. Choose a package for "
"{architecture}."
msgstr ""
"Ovaj je paket namijenjen drugoj arhitekturi. Odaberite paket za arhitekturu "
"{architecture}."

#, python-brace-format
msgid ""
"This package is for a different system branch. Choose an update for {suite}."
msgstr ""
"Ovaj je paket namijenjen drugoj grani sustava. Odaberite ažuriranje za "
"{suite}."

msgid ""
"This removes the imported copy and job history, not your original download."
msgstr ""
"Time se uklanjaju uvezena kopija i povijest zadatka, a ne izvorno preuzeta "
"datoteka."

msgid "This update needs review"
msgstr "Ovo ažuriranje treba pregledati"

msgid "This update requires AnduinOS."
msgstr "Ovo ažuriranje zahtijeva AnduinOS."

msgid "Unavailable"
msgstr "Nedostupno"

msgid "Unexpected update response."
msgstr "Neočekivan odgovor ažuriranja."

msgid "Unknown"
msgstr "Nepoznato"

msgid "Update complete"
msgstr "Ažuriranje je dovršeno"

msgid "Update could not start"
msgstr "Ažuriranje nije moguće pokrenuti"

msgid "Update failed"
msgstr "Ažuriranje nije uspjelo"

msgid "Update from a file"
msgstr "Ažuriranje iz datoteke"

msgid "Update package"
msgstr "Paket ažuriranja"

msgid ""
"Use the command line to review this older update session, or remove its "
"imported file and choose it again."
msgstr ""
"Pregledajte ovu stariju sesiju ažuriranja u naredbenom retku ili uklonite "
"njezinu uvezenu datoteku i ponovno je odaberite."

msgid "Verified"
msgstr "Potvrđeno"

msgid ""
"Verifying the signature and checking your system. This may take a few "
"minutes."
msgstr "Provjerava se potpis i sustav. To može potrajati nekoliko minuta."

msgid "Working…"
msgstr "Obrada…"

msgid "You already have this update"
msgstr "Već imate ovo ažuriranje"

msgid "You can keep using your computer."
msgstr "Možete nastaviti upotrebljavati računalo."

#, python-brace-format
msgid ""
"Your system is newer than this update. Choose an update for {version} or "
"later."
msgstr ""
"Vaš je sustav noviji od ovog ažuriranja. Odaberite ažuriranje za verziju "
"{version} ili noviju."

msgid "or drop an .atgz file here"
msgstr "ili ovdje ispustite datoteku .atgz"

msgid "Cancel"
msgstr "Odustani"

msgid "Packages to remove"
msgstr "Paketi za uklanjanje"

msgid "Remove and update"
msgstr "Ukloni i ažuriraj"

msgid "Remove the listed software and update?"
msgstr "Ukloniti navedeni softver i ažurirati?"

msgid "Review removal and update"
msgstr "Pregledaj uklanjanje i ažuriranje"

msgid "Some software must be removed to continue"
msgstr "Neki softver mora se ukloniti za nastavak"

msgid "These packages will be removed. Applications or development tools that depend on them may stop working."
msgstr "Ovi paketi bit će uklonjeni. Primjene ili alati za razvoj koji ovise o njima mogu prestati s radom."

msgid "This update cannot update the following software for another architecture. Removing it may affect your applications or development tools."
msgstr "Ovo ažuriranje ne može ažurirati sljedeći softver za drugu arhitekturu. Uklanjanje može utjecati na vaše primjene ili alate za razvoj."
