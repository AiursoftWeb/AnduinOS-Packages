msgid "A newer updater is required"
msgstr "En nyare uppdateringshanterare krävs"

msgid "A recovery snapshot could not be confirmed."
msgstr "Kunde inte bekräfta ett återställningsmoment."

msgid "AnduinOS update packages"
msgstr "AnduinOS-uppdateringspaket"

msgid "Authorize importing the file and checking the installation plan. No packages are installed yet."
msgstr "Autorisera import av filen och kontroll av installationsplanen. Inga paket är installerade ännu."

msgid "Cannot preview this update"
msgstr "Kan inte förhandsvisa denna uppdatering"

msgid "Cannot read the update status"
msgstr "Kan inte läsa uppdateringsstatusen"

msgid "Check required"
msgstr "Kontroll krävs"

msgid "Checking the installation…"
msgstr "Kontrollerar installationen…"

msgid "Checking your update…"
msgstr "Kontrollerar din uppdatering…"

msgid "Choose Update File"
msgstr "Välj uppdateringsfil"

msgid ""
"Choose an AnduinOS update package.\n"
"No internet connection needed to check the file."
msgstr ""
"Välj ett AnduinOS-uppdateringspaket.\n"
"Ingen internetanslutning krävs för att kontrollera filen."

msgid "Choose another file"
msgstr "Välj en annan fil"

msgid "Choose one local .atgz file."
msgstr "Välj en lokal .atgz-fil."

msgid "Close"
msgstr "Stäng"

msgid "Continue"
msgstr "Fortsätt"

msgid "Could not open the file"
msgstr "Kunde inte öppna filen"

msgid "Could not open the website"
msgstr "Kunde inte öppna webbplatsen"

msgid "Could not save the update session"
msgstr "Kunde inte spara uppdateringspasset"

msgid "Current version"
msgstr "Aktuell version"

msgid "Disabled"
msgstr "Inaktiverad"

msgid "Get updates from your Pro benefits center"
msgstr "Hämta uppdateringar från din Pro-fördelscentral"

msgid "Installation space and snapshot availability must be checked again before installing."
msgstr "Installationsutrymme och tillgänglighet för systemsnapshot måste kontrolleras igen innan installation."

msgid "Installing your update…"
msgstr "Installerar din uppdatering…"

msgid "Keep an independent backup of important files."
msgstr "Bevara en oberoende säkerhetskopia av viktiga filer."

msgid "Keep this job ID to reconnect from the command line."
msgstr "Bevara det här jobb-ID:t för att återansluta från kommandoraden."

msgid "Keep your computer connected to power. Closing this window will not stop the update."
msgstr "Håll datorn ansluten till ström. Att stänga det här fönstret stoppar inte uppdateringen."

msgid "Keep your computer connected to power. You can close this window and return to check progress."
msgstr "Håll datorn ansluten till ström. Du kan stänga det här fönstret och återkomma för att kontrollera framdriften."

msgid "No snapshot was needed"
msgstr "Inget moment behövdes"

msgid "No system packages were changed."
msgstr "Inga systempaket ändrades."

msgid "Official .atgz update packages are a paid AnduinOS Pro benefit."
msgstr "Officiella .atgz-uppdateringspaket är en betald AnduinOS Pro-fördel."

msgid "Offline Updater"
msgstr "Offline-uppdaterare"

msgid "Package changes"
msgstr "Paketändringar"

msgid "Package expansion estimate"
msgstr "Uppskattning av paketexpansion"

msgid "Preparing your update…"
msgstr "Förbereder din uppdatering…"

msgid "Reconnect"
msgstr "Återanslut"

msgid "Reconnecting to your update…"
msgstr "Återansluter till din uppdatering…"

msgid "Remove Imported File"
msgstr "Ta bort importerad fil"

msgid "Removing the imported file…"
msgstr "Tar bort den importerade filen…"

msgid "Restart your computer to finish applying the update."
msgstr "Starta om datorn för att slutföra tillämpningen av uppdateringen."

msgid "Restarting the updater…"
msgstr "Startar om uppdateraren…"

msgid "Review your update"
msgstr "Granska din uppdatering"

msgid "Some packages may already have changed. Check the details before trying again."
msgstr "Vissa paket kan redan ha ändrats. Kontrollera detaljerna innan du försöker igen."

#, python-brace-format
msgid "Stage {current} of {total}"
msgstr "Steg {current} av {total}"

msgid "Start Update"
msgstr "Starta uppdatering"

msgid "Starting your update…"
msgstr "Startar din uppdatering…"

msgid "System snapshot"
msgstr "Systemsnapshot"

msgid "System snapshot created"
msgstr "Systemmoment skapat"

msgid "System snapshots are disabled"
msgstr "Systemmoment är inaktiverade"

msgid "System snapshots are unavailable"
msgstr "Systemmoment är inte tillgängliga"

msgid "Technical details"
msgstr "Tekniska detaljer"

msgid "Temporary storage"
msgstr "Temporär lagring"

msgid "The request did not complete. Authorization may have been cancelled."
msgstr "Begärandet slutfördes inte. Autoriseringen kan ha avbrutits."

msgid "The update could not be checked. Try choosing the file again."
msgstr "Uppdateringen kunde inte kontrolleras. Försök välja filen igen."

msgid "The update may still be running. Reconnect to check it; do not start another installation."
msgstr "Uppdateringen kan fortfarande pågå. Återanslut för att kontrollera; starta inte en ny installation."

msgid "The updater has been upgraded. Review and confirm the remaining update."
msgstr "Uppdateraren har uppgraderats. Granska och bekräfta den återstående uppdateringen."

msgid "This removes the imported copy and job history, not your original download."
msgstr "Detta tar bort den importerade kopian och jobbhistoriken, inte din ursprungliga nedladdning."

msgid "This update needs review"
msgstr "Denna uppdatering behöver granskas"

msgid "Unavailable"
msgstr "Otillgänglig"

msgid "Unexpected update response."
msgstr "Oväntat uppdaterings svar."

msgid "Unknown"
msgstr "Okänd"

msgid "Update complete"
msgstr "Uppdatering klar"

msgid "Update from a file"
msgstr "Uppdatera från fil"

msgid "Update stopped"
msgstr "Uppdatering stoppad"

msgid "Update to"
msgstr "Uppdatera till"

msgid "Use the command line to review this older update session, or remove its imported file and choose it again."
msgstr "Använd kommandoraden för att granska det här äldre uppdateringspasset, eller ta bort dess importerade fil och välj den igen."

msgid "Verifying the signature and checking your system. This may take a few minutes."
msgstr "Verifierar signatur och kontrollerar ditt system. Detta kan ta några minuter."

msgid "Working…"
msgstr "Arbetar…"

msgid "You already have this update"
msgstr "Du har redan denna uppdatering"

msgid "Your installed packages have been checked."
msgstr "Dina installerade paket har kontrollerats."

msgid "or drop an .atgz file here"
msgstr "eller släpp en .atgz-fil här"

#~ msgid "Preview only. Installing updates is not available in this build."
#~ msgstr "Endast förhandsvisning. Installation av uppdateringar är inte tillgänglig i denna version."

#~ msgid "Check an AnduinOS offline update package"
#~ msgstr "Kontrollera ett AnduinOS offline-uppdateringspaket"
