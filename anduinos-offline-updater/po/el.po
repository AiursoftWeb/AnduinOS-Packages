msgid "A newer updater is required"
msgstr "Απαιτείται νεότερη έκδοση ενημερωτή"

msgid "AnduinOS update packages"
msgstr "Πακέτα ενημέρωσης AnduinOS"

msgid "Cannot preview this update"
msgstr "Δεν είναι δυνατή η προεπισκόπηση αυτής της ενημέρωσης"

msgid "Check required"
msgstr "Έλεγχος απαιτείται"

msgid "Checking your update…"
msgstr "Έλεγχος ενημέρωσής σας…"

msgid "Choose Update File"
msgstr "Επιλογή αρχείου ενημέρωσης"

msgid "Choose an AnduinOS update package.\nNo internet connection needed to check the file."
msgstr "Επιλέξτε ένα πακέτο ενημέρωσης AnduinOS.\nΔεν απαιτείται σύνδεση στο διαδίκτυο για τον έλεγχο του αρχείου."

msgid "Choose another file"
msgstr "Επιλέξτε άλλο αρχείο"

msgid "Choose one local .atgz file."
msgstr "Επιλέξτε ένα τοπικό αρχείο .atgz."

msgid "Close"
msgstr "Κλείσιμο"

msgid "Could not open the file"
msgstr "Δεν ήταν δυνατή η άνοιξη του αρχείου"

msgid "Could not open the website"
msgstr "Δεν ήταν δυνατή η άνοιξη της ιστοσελίδας"

msgid "Current version"
msgstr "Τρέχουσα έκδοση"

msgid "Disabled"
msgstr "Απενεργοποιημένο"

msgid "Get updates from your Pro benefits center"
msgstr "Λάβετε ενημερώσεις από το κέντρο προνομίων Pro σας"

msgid "Installation space and snapshot availability must be checked again before installing."
msgstr "Πρέπει να επαναληφθεί ο έλεγχος του χώρου εγκατάστασης και της διαθεσιμότητας στιγμιότυπου πριν την εγκατάσταση."

msgid "No system packages were changed."
msgstr "Δεν άλλαξαν πακέτα συστήματος."

msgid "Official .atgz update packages are a paid AnduinOS Pro benefit."
msgstr "Τα επίσημα πακέτα ενημέρωσης .atgz είναι ένα επί πληρωμή προνόμιο AnduinOS Pro."

msgid "Offline Updater"
msgstr "Εκτός σύνδεσης Ενημερωτής"

msgid "Package changes"
msgstr "Αλλαγές πακέτων"

msgid "Package expansion estimate"
msgstr "Εκτίμηση επέκτασης πακέτων"

msgid "Preview only. Installing updates is not available in this build."
msgstr "Μόνο προεπισκόπηση. Η εγκατάσταση ενημερώσεων δεν είναι διαθέσιμη σε αυτή την έκδοση."

msgid "Review your update"
msgstr "Επισκόπηση ενημέρωσής σας"

msgid "System snapshot"
msgstr "Στιγμιότυπο συστήματος"

msgid "Technical details"
msgstr "Τεχνικές λεπτομέρειες"

msgid "Temporary storage"
msgstr "Προσωρινή αποθήκευση"

msgid "The update could not be checked. Try choosing the file again."
msgstr "Δεν ήταν δυνατός ο έλεγχος της ενημέρωσης. Προσπαθήστε να επιλέξετε ξανά το αρχείο."

msgid "Unavailable"
msgstr "Μη διαθέσιμο"

msgid "Unknown"
msgstr "Άγνωστο"

msgid "Update from a file"
msgstr "Ενημέρωση από αρχείο"

msgid "Update to"
msgstr "Ενημέρωση σε"

msgid "Verifying the signature and checking your system. This may take a few minutes."
msgstr "Επαλήθευση υπογραφής και έλεγχος συστήματος. Μπορεί να πάρει μερικά λεπτά."

msgid "You already have this update"
msgstr "Έχετε ήδη αυτή την ενημέρωση"

msgid "or drop an .atgz file here"
msgstr "ή ρίξτε ένα αρχείο .atgz εδώ"

msgid "Check an AnduinOS offline update package"
msgstr "Έλεγχος πακέτου εκτός σύνδεσης ενημέρωσης AnduinOS"
