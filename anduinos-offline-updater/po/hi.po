msgid "A newer updater is required"
msgstr "नए अपडेटर की आवश्यकता है"

msgid "AnduinOS update packages"
msgstr "AnduinOS अपडेट पैकेज"

msgid "Cannot preview this update"
msgstr "इस अपडेट का पूर्वावलोकन नहीं किया जा सकता"

msgid "Check required"
msgstr "जाँच आवश्यक है"

msgid "Checking your update…"
msgstr "आपका अपडेट जाँचा जा रहा है…"

msgid "Choose Update File"
msgstr "अपडेट फ़ाइल चुनें"

msgid "Choose an AnduinOS update package.\nNo internet connection needed to check the file."
msgstr "AnduinOS अपडेट पैकेज चुनें।\nफ़ाइल जाँचने के लिए इंटरनेट कनेक्शन की आवश्यकता नहीं है।"

msgid "Choose another file"
msgstr "कोई अन्य फ़ाइल चुनें"

msgid "Choose one local .atgz file."
msgstr "एक स्थानीय .atgz फ़ाइल चुनें।"

msgid "Close"
msgstr "बंद करें"

msgid "Could not open the file"
msgstr "फ़ाइल नहीं खुल सकी"

msgid "Could not open the website"
msgstr "वेबसाइट नहीं खुल सकी"

msgid "Current version"
msgstr "वर्तमान संस्करण"

msgid "Disabled"
msgstr "निष्क्रिय"

msgid "Get updates from your Pro benefits center"
msgstr "अपने Pro लाभ केंद्र से अपडेट प्राप्त करें"

msgid "Installation space and snapshot availability must be checked again before installing."
msgstr "इंस्टॉल करने से पहले इंस्टॉलेशन स्पेस और सिस्टम स्नैपशॉट की उपलब्धता की पुनः जाँच करनी होगी।"

msgid "No system packages were changed."
msgstr "कोई सिस्टम पैकेज बदला नहीं गया।"

msgid "Official .atgz update packages are a paid AnduinOS Pro benefit."
msgstr "आधिकारिक .atgz अपडेट पैकेज AnduinOS Pro का भुगतान किया गया लाभ है।"

msgid "Offline Updater"
msgstr "ऑफ़लाइन अपडेटर"

msgid "Package changes"
msgstr "पैकेज परिवर्तन"

msgid "Package expansion estimate"
msgstr "पैकेज विस्तार का अनुमान"

msgid "Preview only. Installing updates is not available in this build."
msgstr "केवल पूर्वावलोकन। इस बिल्ड में अपडेट इंस्टॉल करना उपलब्ध नहीं है।"

msgid "Review your update"
msgstr "अपना अपडेट समीक्षा करें"

msgid "System snapshot"
msgstr "सिस्टम स्नैपशॉट"

msgid "Technical details"
msgstr "तकनीकी विवरण"

msgid "Temporary storage"
msgstr "अस्थायी भंडारण"

msgid "The update could not be checked. Try choosing the file again."
msgstr "अपडेट की जाँच नहीं की जा सकी। पुनः फ़ाइल चुनने का प्रयास करें।"

msgid "Unavailable"
msgstr "अनुपलब्ध"

msgid "Unknown"
msgstr "अज्ञात"

msgid "Update from a file"
msgstr "फ़ाइल से अपडेट करें"

msgid "Update to"
msgstr "अपडेट करें"

msgid "Verifying the signature and checking your system. This may take a few minutes."
msgstr "हस्ताक्षर सत्यापित कर रहे हैं और आपका सिस्टम जाँच रहे हैं। इसमें कुछ मिनट लग सकते हैं।"

msgid "You already have this update"
msgstr "आपके पास इस अपडेट की पहले से उपलब्धता है"

msgid "or drop an .atgz file here"
msgstr "या यहाँ एक .atgz फ़ाइल छोड़ें"

msgid "Check an AnduinOS offline update package"
msgstr "AnduinOS ऑफ़लाइन अपडेट पैकेज की जाँच करें"
