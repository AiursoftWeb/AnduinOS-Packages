msgid "A newer updater is required"
msgstr "Un programme de mise à jour plus récent est requis"

msgid "AnduinOS update packages"
msgstr "Paquets de mise à jour AnduinOS"

msgid "Authorize importing the file and checking the installation plan. No packages are installed yet."
msgstr "Autorisez l'importation du fichier et la vérification du plan d'installation. Aucun paquet n'est installé pour l'instant."

msgid "Cannot preview this update"
msgstr "Impossible d’apercevoir cette mise à jour"

msgid "Cannot read the update status"
msgstr "Impossible de lire l'état de la mise à jour"

msgid "Check required"
msgstr "Vérification requise"

msgid "Checking the installation…"
msgstr "Vérification de l'installation…"

msgid "Checking your update…"
msgstr "Vérification de votre mise à jour…"

msgid "Choose Update File"
msgstr "Choisir le fichier de mise à jour"

msgid ""
"Choose an AnduinOS update package.\n"
"No internet connection needed to check the file."
msgstr ""
"Choisissez un paquet de mise à jour AnduinOS.\n"
"Aucune connexion Internet n’est nécessaire pour vérifier le fichier."

msgid "Choose another file"
msgstr "Choisir un autre fichier"

msgid "Choose one local .atgz file."
msgstr "Choisissez un fichier .atgz local."

msgid "Close"
msgstr "Fermer"

msgid "Continue"
msgstr "Continuer"

msgid "Could not open the file"
msgstr "Impossible d’ouvrir le fichier"

msgid "Could not open the website"
msgstr "Impossible d’ouvrir le site Web"

msgid "Could not save the update session"
msgstr "Impossible d'enregistrer la session de mise à jour"

msgid "Current version"
msgstr "Version actuelle"

msgid "Disabled"
msgstr "Désactivé"

msgid "Exit"
msgstr "Quitter"

msgid "Get updates from your Pro benefits center"
msgstr "Obtenez les mises à jour depuis votre centre d’avantages Pro"

msgid "Installation space and snapshot availability must be checked again before installing."
msgstr "L’espace d’installation et la disponibilité des instantanés système doivent être revérifiés avant l’installation."

msgid "Installing your update…"
msgstr "Installation de votre mise à jour…"

msgid "Keep an independent backup of important files."
msgstr "Conservez une sauvegarde indépendante des fichiers importants."

msgid "Keep this job ID to reconnect from the command line."
msgstr "Conservez cet identifiant de tâche pour vous reconnecter depuis la ligne de commande."

msgid "Keep your computer connected to power. Closing this window will not stop the update."
msgstr "Gardez votre ordinateur branché sur secteur. Fermer cette fenêtre n'arrêtera pas la mise à jour."

msgid "Keep your computer connected to power. You can close this window and return to check progress."
msgstr "Gardez votre ordinateur branché sur secteur. Vous pouvez fermer cette fenêtre et revenir vérifier l'avancement."

msgid "No system packages were changed."
msgstr "Aucun paquet système n’a été modifié."

msgid "Official .atgz update packages are a paid AnduinOS Pro benefit."
msgstr "Les paquets de mise à jour .atgz officiels sont un avantage payant d’AnduinOS Pro."

msgid "Offline Updater"
msgstr "Metteur à jour hors ligne"

msgid "Package changes"
msgstr "Modifications des paquets"

msgid "Package expansion estimate"
msgstr "Estimation de l’extraction des paquets"

msgid "Preparing your update…"
msgstr "Préparation de votre mise à jour…"

msgid "Reconnect"
msgstr "Se reconnecter"

msgid "Reconnecting to your update…"
msgstr "Reconnexion à votre mise à jour…"

msgid "Remove Imported File"
msgstr "Supprimer le fichier importé"

msgid "Removing the imported file…"
msgstr "Suppression du fichier importé…"

msgid "Restart your computer to finish applying the update."
msgstr "Redémarrez votre ordinateur pour terminer l'application de la mise à jour."

msgid "Restarting the updater…"
msgstr "Redémarrage du gestionnaire de mises à jour…"

msgid "Review your update"
msgstr "Vérifiez votre mise à jour"

#, python-brace-format
msgid "Stage {current} of {total}"
msgstr "Étape {current} sur {total}"

msgid "Start Update"
msgstr "Démarrer la mise à jour"

msgid "Starting your update…"
msgstr "Démarrage de votre mise à jour…"

msgid "System snapshot"
msgstr "Instantané système"

msgid "Technical details"
msgstr "Détails techniques"

msgid "Temporary storage"
msgstr "Stockage temporaire"

msgid "The request did not complete. Authorization may have been cancelled."
msgstr "La requête n'a pas abouti. L'autorisation a peut-être été annulée."

msgid "The update could not be checked. Try choosing the file again."
msgstr "La mise à jour n’a pas pu être vérifiée. Essayez de choisir le fichier à nouveau."

msgid "The update may still be running. Reconnect to check it; do not start another installation."
msgstr "La mise à jour est peut-être toujours en cours. Reconnectez-vous pour vérifier ; ne lancez pas une autre installation."

msgid "The updater has been upgraded. Review and confirm the remaining update."
msgstr "Le gestionnaire de mises à jour a été mis à niveau. Examinez et confirmez la mise à jour restante."

msgid "This removes the imported copy and job history, not your original download."
msgstr "Cela supprime la copie importée et l'historique des tâches, pas votre téléchargement d'origine."

msgid "This update needs review"
msgstr "Cette mise à jour nécessite une vérification"

msgid "Unavailable"
msgstr "Indisponible"

msgid "Unexpected update response."
msgstr "Réponse de mise à jour inattendue."

msgid "Unknown"
msgstr "Inconnu"

msgid "Update complete"
msgstr "Mise à jour terminée"

msgid "Update could not start"
msgstr "Impossible de démarrer la mise à jour"

msgid "Update failed"
msgstr "Échec de la mise à jour"

msgid "Update from a file"
msgstr "Mise à jour depuis un fichier"

msgid "Update to"
msgstr "Mettre à jour vers"

msgid "Use the command line to review this older update session, or remove its imported file and choose it again."
msgstr "Utilisez la ligne de commande pour examiner cette ancienne session de mise à jour, ou supprimez son fichier importé et choisissez-la à nouveau."

msgid "Verifying the signature and checking your system. This may take a few minutes."
msgstr "Vérification de la signature et de votre système. Cela peut prendre quelques minutes."

msgid "Working…"
msgstr "Traitement en cours…"

msgid "You already have this update"
msgstr "Vous avez déjà cette mise à jour"

msgid "or drop an .atgz file here"
msgstr "ou déposez un fichier .atgz ici"
