msgid "A newer updater is required"
msgstr "Un programme de mise à jour plus récent est requis"

msgid "AnduinOS update packages"
msgstr "Paquets de mise à jour AnduinOS"

msgid "Cannot preview this update"
msgstr "Impossible d’apercevoir cette mise à jour"

msgid "Check required"
msgstr "Vérification requise"

msgid "Checking your update…"
msgstr "Vérification de votre mise à jour…"

msgid "Choose Update File"
msgstr "Choisir le fichier de mise à jour"

msgid "Choose an AnduinOS update package.\nNo internet connection needed to check the file."
msgstr "Choisissez un paquet de mise à jour AnduinOS.\nAucune connexion Internet n’est nécessaire pour vérifier le fichier."

msgid "Choose another file"
msgstr "Choisir un autre fichier"

msgid "Choose one local .atgz file."
msgstr "Choisissez un fichier .atgz local."

msgid "Close"
msgstr "Fermer"

msgid "Could not open the file"
msgstr "Impossible d’ouvrir le fichier"

msgid "Could not open the website"
msgstr "Impossible d’ouvrir le site Web"

msgid "Current version"
msgstr "Version actuelle"

msgid "Disabled"
msgstr "Désactivé"

msgid "Get updates from your Pro benefits center"
msgstr "Obtenez les mises à jour depuis votre centre d’avantages Pro"

msgid "Installation space and snapshot availability must be checked again before installing."
msgstr "L’espace d’installation et la disponibilité des instantanés système doivent être revérifiés avant l’installation."

msgid "No system packages were changed."
msgstr "Aucun paquet système n’a été modifié."

msgid "Official .atgz update packages are a paid AnduinOS Pro benefit."
msgstr "Les paquets de mise à jour .atgz officiels sont un avantage payant d’AnduinOS Pro."

msgid "Offline Updater"
msgstr "Metteur à jour hors ligne"

msgid "Package changes"
msgstr "Modifications des paquets"

msgid "Package expansion estimate"
msgstr "Estimation de l’extraction des paquets"

msgid "Preview only. Installing updates is not available in this build."
msgstr "Aperçu uniquement. L’installation des mises à jour n’est pas disponible dans cette version."

msgid "Review your update"
msgstr "Vérifiez votre mise à jour"

msgid "System snapshot"
msgstr "Instantané système"

msgid "Technical details"
msgstr "Détails techniques"

msgid "Temporary storage"
msgstr "Stockage temporaire"

msgid "The update could not be checked. Try choosing the file again."
msgstr "La mise à jour n’a pas pu être vérifiée. Essayez de choisir le fichier à nouveau."

msgid "Unavailable"
msgstr "Indisponible"

msgid "Unknown"
msgstr "Inconnu"

msgid "Update from a file"
msgstr "Mise à jour depuis un fichier"

msgid "Update to"
msgstr "Mettre à jour vers"

msgid "Verifying the signature and checking your system. This may take a few minutes."
msgstr "Vérification de la signature et de votre système. Cela peut prendre quelques minutes."

msgid "You already have this update"
msgstr "Vous avez déjà cette mise à jour"

msgid "or drop an .atgz file here"
msgstr "ou déposez un fichier .atgz ici"

msgid "Check an AnduinOS offline update package"
msgstr "Vérifier un paquet de mise à jour hors ligne AnduinOS"
