msgid "A newer updater is required"
msgstr "Der kræves en nyere opdatering"

msgid "A recovery snapshot could not be confirmed."
msgstr "En gendannelsessnap kunne ikke bekræftes."

msgid "AnduinOS update packages"
msgstr "AnduinOS-opdateringspakker"

msgid "Authorize importing the file and checking the installation plan. No packages are installed yet."
msgstr "Godkend import af filen og kontrol af installationsplanen. Ingen pakker er installeret endnu."

msgid "Cannot preview this update"
msgstr "Kan ikke forudvise denne opdatering"

msgid "Cannot read the update status"
msgstr "Kan ikke læse opdateringsstatus"

msgid "Check required"
msgstr "Kontrol påkrævet"

msgid "Checking the installation…"
msgstr "Tjekker installationen…"

msgid "Checking your update…"
msgstr "Kontrollerer din opdatering…"

msgid "Choose Update File"
msgstr "Vælg opdateringsfil"

msgid ""
"Choose an AnduinOS update package.\n"
"No internet connection needed to check the file."
msgstr ""
"Vælg en AnduinOS-opdateringspakke.\n"
"Der kræves ikke internetforbindelse for at kontrollere filen."

msgid "Choose another file"
msgstr "Vælg en anden fil"

msgid "Choose one local .atgz file."
msgstr "Vælg én lokal .atgz-fil."

msgid "Close"
msgstr "Luk"

msgid "Continue"
msgstr "Fortsæt"

msgid "Could not open the file"
msgstr "Kunne ikke åbne filen"

msgid "Could not open the website"
msgstr "Kunne ikke åbne webstedet"

msgid "Could not save the update session"
msgstr "Kunne ikke gemme opdateringssessionen"

msgid "Current version"
msgstr "Aktuel version"

msgid "Disabled"
msgstr "Deaktiveret"

msgid "Get updates from your Pro benefits center"
msgstr "Hent opdateringer fra dit Pro-fordelecenter"

msgid "Installation space and snapshot availability must be checked again before installing."
msgstr "Installationsplads og tilgængelighed af system-snapshot skal kontrolleres igen før installation."

msgid "Installing your update…"
msgstr "Installerer din opdatering…"

msgid "Keep an independent backup of important files."
msgstr "Opret uafhængig sikkerhedskopi af vigtige filer."

msgid "Keep this job ID to reconnect from the command line."
msgstr "Gem dette job-ID for at genforbinde fra kommandolinjen."

msgid "Keep your computer connected to power. Closing this window will not stop the update."
msgstr "Hold computeren tilsluttet strømmen. Lukningen af dette vindue stopper ikke opdateringen."

msgid "Keep your computer connected to power. You can close this window and return to check progress."
msgstr "Hold computeren tilsluttet strømmen. Du kan lukke dette vindue og vende tilbage for at tjekke fremskridt."

msgid "No snapshot was needed"
msgstr "Ingen snap var nødvendig"

msgid "No system packages were changed."
msgstr "Ingen systempakker blev ændret."

msgid "Official .atgz update packages are a paid AnduinOS Pro benefit."
msgstr "Officielle .atgz-opdateringspakker er en betalt AnduinOS Pro-fordeel."

msgid "Offline Updater"
msgstr "Offline-opdaterer"

msgid "Package changes"
msgstr "Pakkeændringer"

msgid "Package expansion estimate"
msgstr "Estimat for pakkeudpakning"

msgid "Preparing your update…"
msgstr "Forbereder din opdatering…"

msgid "Reconnect"
msgstr "Genforbind"

msgid "Reconnecting to your update…"
msgstr "Genforbinder til din opdatering…"

msgid "Remove Imported File"
msgstr "Fjern importeret fil"

msgid "Removing the imported file…"
msgstr "Fjerner den importerede fil…"

msgid "Restart your computer to finish applying the update."
msgstr "Genstart computeren for at færdiggøre opdateringen."

msgid "Restarting the updater…"
msgstr "Genstarter opdateringsprogrammet…"

msgid "Review your update"
msgstr "Gennemgå din opdatering"

msgid "Some packages may already have changed. Check the details before trying again."
msgstr "Nogle pakker kan allerede være ændret. Tjek detaljerne, før du prøver igen."

#, python-brace-format
msgid "Stage {current} of {total}"
msgstr "Trin {current} af {total}"

msgid "Start Update"
msgstr "Start opdatering"

msgid "Starting your update…"
msgstr "Starter din opdatering…"

msgid "System snapshot"
msgstr "System-snapshot"

msgid "System snapshot created"
msgstr "Systemsnap oprettet"

msgid "System snapshots are disabled"
msgstr "Systemsnaps er deaktiveret"

msgid "System snapshots are unavailable"
msgstr "Systemsnaps er utilgængelige"

msgid "Technical details"
msgstr "Tekniske detaljer"

msgid "Temporary storage"
msgstr "Midlertidig opbevaring"

msgid "The request did not complete. Authorization may have been cancelled."
msgstr "Anmodningen blev ikke fuldført. Godkendelse kan være blevet annulleret."

msgid "The update could not be checked. Try choosing the file again."
msgstr "Opdateringen kunne ikke kontrolleres. Prøv at vælge filen igen."

msgid "The update may still be running. Reconnect to check it; do not start another installation."
msgstr "Opdateringen kører muligvis stadig. Genforbind for at tjekke den; start ikke en ny installation."

msgid "The updater has been upgraded. Review and confirm the remaining update."
msgstr "Opdateringsprogrammet er opdateret. Gennemse og bekræft den resterende opdatering."

msgid "This removes the imported copy and job history, not your original download."
msgstr "Dette fjerner den importerede kopi og jobhistorikken, ikke din oprindelige download."

msgid "This update needs review"
msgstr "Denne opdatering skal gennemses"

msgid "Unavailable"
msgstr "Ikke tilgængelig"

msgid "Unexpected update response."
msgstr "Uventet opdateringssvar."

msgid "Unknown"
msgstr "Ukendt"

msgid "Update complete"
msgstr "Opdatering fuldført"

msgid "Update from a file"
msgstr "Opdater fra fil"

msgid "Update stopped"
msgstr "Opdatering stoppet"

msgid "Update to"
msgstr "Opdater til"

msgid "Use the command line to review this older update session, or remove its imported file and choose it again."
msgstr "Brug kommandolinjen til at gennemse denne ældre opdateringssession, eller fjern den importerede fil og vælg den igen."

msgid "Verifying the signature and checking your system. This may take a few minutes."
msgstr "Verificerer signaturen og kontrollerer dit system. Dette kan tage et par minutter."

msgid "Working…"
msgstr "Arbejder…"

msgid "You already have this update"
msgstr "Du har allerede denne opdatering"

msgid "Your installed packages have been checked."
msgstr "Dine installerede pakker er blevet kontrolleret."

msgid "or drop an .atgz file here"
msgstr "eller slip en .atgz-fil her"

#~ msgid "Preview only. Installing updates is not available in this build."
#~ msgstr "Kun forudvisning. Installation af opdateringer er ikke tilgængelig i denne version."

#~ msgid "Check an AnduinOS offline update package"
#~ msgstr "Kontroller en AnduinOS offline-opdateringspakke"
