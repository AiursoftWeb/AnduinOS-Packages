<?xml version="1.0" encoding="UTF-8"?>
<policyconfig>
  <vendor>AnduinOS</vendor>
  <vendor_url>https://www.anduinos.com</vendor_url>
  <action id="com.anduinos.OfflineUpdater.install">
    <description>Install a signed AnduinOS offline update</description>
    <description xml:lang="zh_TW">安裝已加密簽章的 AnduinOS 離線更新</description>
    <description xml:lang="zh_HK">安裝已簽署的 AnduinOS 離線更新</description>
    <description xml:lang="zh_CN">安装已签名的 AnduinOS 离线更新</description>
    <description xml:lang="vi">Cài đặt bản cập nhật ngoại tuyến AnduinOS đã ký</description>
    <description xml:lang="uk">Встановити підписане офлайн-оновлення AnduinOS</description>
    <description xml:lang="tr">İmzalı bir AnduinOS çevrimdışı güncellemesi yükleyin</description>
    <description xml:lang="th">ติดตั้งการอัปเดตออฟไลน์ของ AnduinOS ที่มีการลงนาม</description>
    <description xml:lang="sv">Installera en kryptografiskt signerad AnduinOS-offlineuppdatering</description>
    <description xml:lang="ru">Установить подписанное офлайн-обновление AnduinOS</description>
    <description xml:lang="ro">Instalare a unei actualizări offline semnate criptografic pentru AnduinOS</description>
    <description xml:lang="pt_BR">Instalar uma atualização offline assinada do AnduinOS</description>
    <description xml:lang="pt">Instalar uma atualização offline assinada do AnduinOS</description>
    <description xml:lang="pl">Zainstaluj podpisany offline'owy aktualizacja AnduinOS</description>
    <description xml:lang="nl">Installeer een ondertekende AnduinOS offline-update</description>
    <description xml:lang="ko">서명된 AnduinOS 오프라인 업데이트 설치</description>
    <description xml:lang="ja">署名済みのAnduinOSオフライン更新プログラムをインストールします</description>
    <description xml:lang="it">Instalar una actualización sin conexión de AnduinOS firmada</description>
    <description xml:lang="id">Instal pembaruan offline AnduinOS yang ditandatangani</description>
    <description xml:lang="hi">एक हस्ताक्षरित AnduinOS ऑफ़लाइन अपडेट इंस्टॉल करें</description>
    <description xml:lang="fr">Installer une mise à jour hors ligne d'AnduinOS signée</description>
    <description xml:lang="fi">Asenna allekirjoitettu AnduinOS-päivitys verkottomana</description>
    <description xml:lang="es">Instalar una actualización sin conexión de AnduinOS firmada</description>
    <description xml:lang="en_GB">Install a signed AnduinOS offline update</description>
    <description xml:lang="el">Instale una actualización sin conexión de AnduinOS firmada</description>
    <description xml:lang="de">Ein signiertes AnduinOS-Offline-Update installieren</description>
    <description xml:lang="da">Installér en kryptografisk signeret AnduinOS-offlineopdatering</description>
    <description xml:lang="ar">تثبيت تحديث AnduinOS غير متصل موقّع</description>
    <message>Authentication is required to prepare or install an offline update</message>
    <message xml:lang="zh_TW">準備或安裝離線更新需要進行身份驗證</message>
    <message xml:lang="zh_HK">準備或安裝離線更新需要驗證</message>
    <message xml:lang="zh_CN">准备或安装离线更新需要管理员身份验证</message>
    <message xml:lang="vi">Cần xác thực để chuẩn bị hoặc cài đặt bản cập nhật ngoại tuyến</message>
    <message xml:lang="uk">Для підготовки або встановлення офлайн-оновлення потрібне автентифікування</message>
    <message xml:lang="tr">Çevrimdışı bir güncelleme hazırlamak veya yüklemek için kimlik doğrulaması gereklidir</message>
    <message xml:lang="th">ต้องมีการยืนยันตัวตนเพื่อเตรียมหรือติดตั้งการอัปเดตออฟไลน์</message>
    <message xml:lang="sv">Autentisering krävs för att förbereda eller installera en offlineuppdatering</message>
    <message xml:lang="ru">Требуется аутентификация для подготовки или установки офлайн-обновления</message>
    <message xml:lang="ro">Autentificarea este necesară pentru a pregăti sau instala o actualizare offline</message>
    <message xml:lang="pt_BR">É necessária autenticação para preparar ou instalar uma atualização offline</message>
    <message xml:lang="pt">A autenticação é necessária para preparar ou instalar uma atualização offline</message>
    <message xml:lang="pl">Wymagane jest uwierzytelnienie, aby przygotować lub zainstalować aktualizację offline</message>
    <message xml:lang="nl">Er is authenticatie vereist om een offline-update voor te bereiden of te installeren</message>
    <message xml:lang="ko">오프라인 업데이트를 준비하거나 설치하려면 인증이 필요합니다</message>
    <message xml:lang="ja">オフライン更新プログラムの準備またはインストールには認証が必要です</message>
    <message xml:lang="it">Se requiere autenticación para preparar o instalar una actualización sin conexión</message>
    <message xml:lang="id">Autentikasi diperlukan untuk menyiapkan atau menginstal pembaruan offline</message>
    <message xml:lang="hi">एक ऑफ़लाइन अपडेट की तैयारी या इंस्टॉलेशन के लिए प्रामाणिकता आवश्यक है</message>
    <message xml:lang="fr">Une authentification est requise pour préparer ou installer une mise à jour hors ligne</message>
    <message xml:lang="fi">Valtuutus vaaditaan verkottoman päivityksen valmisteluun tai asennukseen</message>
    <message xml:lang="es">Se requiere autenticación para preparar o instalar una actualización sin conexión</message>
    <message xml:lang="en_GB">Authentication is required to prepare or install an offline update</message>
    <message xml:lang="el">Se requiere autenticación para preparar o instalar una actualización sin conexión</message>
    <message xml:lang="de">Zur Vorbereitung oder Installation eines Offline-Updates ist eine Authentifizierung erforderlich</message>
    <message xml:lang="da">Godkendelse er påkrævet for at forberede eller installere en offlineopdatering</message>
    <message xml:lang="ar">يتطلب المصادقة لتحضير أو تثبيت تحديث غير متصل</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/anduinos-offline-updater-helper</annotate>
  </action>
</policyconfig>
