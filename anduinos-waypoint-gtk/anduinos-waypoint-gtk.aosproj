<Project Sdk="Aiursoft.Apkg.Sdk">
  <PropertyGroup>
    <PackageName>anduinos-waypoint-gtk</PackageName>
    <PackageVersion>0.1.0-5+$(SuiteShortName)</PackageVersion>
    <Maintainer>AnduinOS Team &lt;anduin@aiursoft.com&gt;</Maintainer>
    <PackageDescription>AnduinOS Waypoint — graphical Btrfs system recovery and Personal Files history</PackageDescription>
    <Section>admin</Section>
    <PackageHomepage>https://www.anduinos.com</PackageHomepage>
    <RepositoryUrl>https://github.com/AiursoftWeb/AnduinOS-Packages</RepositoryUrl>
    <LicenseType>GPL-3.0</LicenseType>
    <AppStreamDeveloperName>AnduinOS Team</AppStreamDeveloperName>
    <AppStreamMetadataLicense>CC0-1.0</AppStreamMetadataLicense>
    <TargetDistro>anduinos</TargetDistro>
    <TargetSuites>resolute-addon</TargetSuites>
    <TargetArchitectures>amd64 arm64</TargetArchitectures>
    <Component>main</Component>
    <SuiteShortNameMap>resolute-addon=resolute</SuiteShortNameMap>
  </PropertyGroup>

  <ItemGroup>
    <DependencyCheckSource
        Url="https://mirror.aiursoft.com/ubuntu"
        SuiteMap="resolute-addon=resolute" />
  </ItemGroup>

  <ItemGroup>
    <Dependency Include="libgtk-4-1" />
    <Dependency Include="libadwaita-1-0" />
    <Dependency Include="btrfs-progs" />
    <Dependency Include="util-linux" />
    <Dependency Include="polkitd" />
    <Dependency Include="dbus-bin" />
    <Dependency Include="jq" />
    <Dependency Include="systemd" />
    <Dependency Include="apt" />
    <Dependency Include="dpkg" />
    <Dependency Include="initramfs-tools" />
    <Dependency Include="grub2-common" />
    <Dependency Include="anduinos-secureboot-toolkit" />
    <Dependency Include="kmod" />
    <Dependency Include="sbsigntool" />
    <Dependency Include="python3-nautilus" />
  </ItemGroup>

  <ItemGroup>
    <PrebuildCommand Run="bash scripts/prebuild-check.sh" />
    <PrebuildCommand Run="bash build.sh amd64" Condition="'$(Arch)' == 'amd64'" />
    <PrebuildCommand Run="bash build.sh arm64" Condition="'$(Arch)' == 'arm64'" />
  </ItemGroup>

  <ItemGroup>
    <PostInstallScript Include="scripts/postinst.sh" />
    <PreRemoveScript Include="scripts/prerm.sh" />
    <PostRemoveScript Include="scripts/postrm.sh" />
    <SystemdUnit Include="data/anduinos-waypoint-helper.service" AutoEnable="false" />
    <SystemdUnit Include="data/anduinos-waypoint-scheduler.service" AutoEnable="false" />
    <SystemdUnit Include="data/anduinos-waypoint-confirm.service" AutoEnable="false" />
  </ItemGroup>

  <ItemGroup>
    <IncludeScript Include="obj/anduinos-waypoint-gtk" Target="/usr/bin/anduinos-waypoint-gtk" />
    <IncludeScript Include="obj/anduinos-waypoint-helper" Target="/usr/libexec/anduinos-waypoint-helper" />
    <IncludeScript Include="obj/anduinos-waypoint-scheduler" Target="/usr/libexec/anduinos-waypoint-scheduler" />
    <IncludeScript Include="obj/anduinos-waypoint-notifier" Target="/usr/libexec/anduinos-waypoint-notifier" />
    <IncludeScript Include="obj/anduinos-waypoint-initramfs" Target="/usr/libexec/anduinos-waypoint-initramfs" />
    <IncludeScript Include="obj/anduinos-waypoint-boot-config" Target="/usr/libexec/anduinos-waypoint-boot-config" />
    <IncludeScript Include="obj/anduinos-waypoint-confirm" Target="/usr/libexec/anduinos-waypoint-confirm" />
    <IncludeScript Include="obj/anduinos-waypoint-apt-hook" Target="/usr/libexec/anduinos-waypoint-apt-hook" />
    <IncludeScript Include="obj/anduinos-waypoint-cli" Target="/usr/bin/anduinos-waypoint-cli" />
    <IncludeScript Include="data/initramfs-hook" Target="/usr/share/initramfs-tools/hooks/anduinos-waypoint" />
    <IncludeScript Include="data/initramfs-local-premount" Target="/usr/share/initramfs-tools/scripts/local-premount/anduinos-waypoint" />
    <IncludeScript Include="data/09_anduinos_waypoint" Target="/etc/grub.d/09_anduinos_waypoint" />
    <IncludeScript Include="data/01_anduinos_waypoint_env" Target="/etc/grub.d/01_anduinos_waypoint_env" />
    <IncludeScript Include="data/no-os-prober" Target="/usr/libexec/anduinos-waypoint/no-os-prober/os-prober" />
    <IncludeScript Include="data/no-os-prober" Target="/usr/libexec/anduinos-waypoint/no-os-prober/linux-boot-prober" />
    <IncludeScript Include="scripts/qualify-recovery-vm.sh" Target="/usr/share/doc/anduinos-waypoint-gtk/qualify-recovery-vm.sh" />
    <IncludeScript Include="scripts/test-installed-policy.sh" Target="/usr/share/doc/anduinos-waypoint-gtk/test-installed-policy.sh" />
    <DpkgTrigger Include="update-initramfs" Type="activate-await" />
    <IncludeFile Include="assets/schedules.toml" Target="/usr/share/anduinos-waypoint/defaults/schedules.toml" />
    <IncludeFile Include="assets/apt-snapshots.toml" Target="/usr/share/anduinos-waypoint/defaults/apt-snapshots.toml" />
    <IncludeFile Include="data/org.anduinos.Waypoint.policy" Target="/usr/share/polkit-1/actions/org.anduinos.Waypoint.policy" />
    <IncludeFile Include="data/50-org.anduinos.Waypoint-root.rules" Target="/usr/share/polkit-1/rules.d/50-org.anduinos.Waypoint-root.rules" />
    <IncludeFile Include="data/51-org.anduinos.Waypoint-desktop.rules" Target="/usr/share/polkit-1/rules.d/51-org.anduinos.Waypoint-desktop.rules" />
    <IncludeFile Include="data/org.anduinos.Waypoint.conf" Target="/usr/share/dbus-1/system.d/org.anduinos.Waypoint.conf" />
    <IncludeFile Include="data/org.anduinos.Waypoint.service" Target="/usr/share/dbus-1/system-services/org.anduinos.Waypoint.service" />
    <IncludeFile Include="data/org.anduinos.Waypoint.Session.service" Target="/usr/share/dbus-1/services/org.anduinos.Waypoint.service" />
    <IncludeFile Include="data/anduinos_waypoint_file_history.py" Target="/usr/share/nautilus-python/extensions/anduinos_waypoint_file_history.py" />
    <IncludeFile Include="data/org.anduinos.Waypoint.Notifier.desktop" Target="/etc/xdg/autostart/org.anduinos.Waypoint.Notifier.desktop" />
    <IncludeFile Include="data/anduinos-waypoint.tmpfiles" Target="/usr/lib/tmpfiles.d/anduinos-waypoint.conf" />
    <IncludeFile Include="data/90-anduinos-waypoint" Target="/etc/apt/apt.conf.d/90-anduinos-waypoint" />
    <IncludeFile Include="upstream/LICENSE" Target="/usr/share/doc/anduinos-waypoint-gtk/copyright" />
    <IncludeFile Include="LICENSE" Target="/usr/share/doc/anduinos-waypoint-gtk/LICENSE.GPL-3.0" />
    <IncludeFile Include="upstream/README.md" Target="/usr/share/doc/anduinos-waypoint-gtk/UPSTREAM.md" />
    <IncludeFile Include="README.md" Target="/usr/share/doc/anduinos-waypoint-gtk/README.md" />
    <IncludeFile Include="docs/VM-QUALIFICATION.md" Target="/usr/share/doc/anduinos-waypoint-gtk/VM-QUALIFICATION.md" />
    <IncludeFile Include="docs/RECOVERY-SCOPE.md" Target="/usr/share/doc/anduinos-waypoint-gtk/RECOVERY-SCOPE.md" />
    <IncludeFile Include="docs/deployment-v1.schema.json" Target="/usr/share/anduinos-waypoint/deployment-v1.schema.json" />
    <IncludeFile Include="docs/rollback-v1.schema.json" Target="/usr/share/anduinos-waypoint/rollback-v1.schema.json" />
    <IncludeFile Include="docs/external-backup-v1.schema.json" Target="/usr/share/anduinos-waypoint/external-backup-v1.schema.json" />
    <IncludeFile Include="docs/personal-snapshot-v1.schema.json" Target="/usr/share/anduinos-waypoint/personal-snapshot-v1.schema.json" />
    <IncludeFile Include="docs/personal-backup-v1.schema.json" Target="/usr/share/anduinos-waypoint/personal-backup-v1.schema.json" />
    <IncludeFolder Include="obj/locale" Target="/usr/share/locale" />
  </ItemGroup>

  <ItemGroup>
    <AppStreamApplication Include="data/org.anduinos.Waypoint.desktop"
                          Icon="data/org.anduinos.Waypoint.svg"
                          Metainfo="data/org.anduinos.Waypoint.metainfo.xml" />
    <AppStreamScreenshot Include="screenshots/overview.png" Default="true"
                         Caption="Review protected, manual, scheduled, and package recovery points"
                         Environment="GNOME:dark" />
    <AppStreamScreenshot Include="screenshots/scheduled-recovery.png"
                         Caption="Configure automatic recovery schedules and independent retention policies"
                         Environment="GNOME:dark" />
  </ItemGroup>
</Project>
