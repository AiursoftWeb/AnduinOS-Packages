[Desktop Entry]
Name=AnduinOS Waypoint
GenericName=System Recovery and File History
GenericName[zh_CN]=系统恢复与文件历史
Comment=Recover AnduinOS and restore deleted Personal Files
Comment[zh_CN]=恢复 AnduinOS 并找回误删的个人文件
Exec=anduinos-waypoint-gtk
Icon=org.anduinos.Waypoint
Terminal=false
Type=Application
DBusActivatable=true
Categories=GNOME;GTK;System;
Keywords=backup;snapshot;restore;recovery;btrfs;rollback;file history;deleted files;
Keywords[zh_CN]=备份;快照;还原;恢复;回滚;系统恢复;文件历史;误删文件;
StartupNotify=true
