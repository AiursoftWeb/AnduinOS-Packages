[Unit]
Description=AnduinOS Waypoint automatic recovery scheduler
Documentation=file:/usr/share/doc/anduinos-waypoint-gtk/README.md
After=dbus.service local-fs.target
ConditionPathIsMountPoint=/.snapshots

[Service]
Type=simple
ExecStart=/usr/libexec/anduinos-waypoint-scheduler
Restart=on-failure
RestartSec=30s
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectHome=read-only
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=~@clock @cpu-emulation @debug @module @mount @obsolete @privileged @raw-io @reboot @resources @swap
CapabilityBoundingSet=
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
UMask=0077

[Install]
WantedBy=multi-user.target
