{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.anduinos.com/schemas/waypoint/personal-backup-v1.schema.json",
  "title": "AnduinOS Waypoint external Personal Files backup manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "backup_id", "created_at", "format", "source",
    "stream_sha256", "stream_size_bytes", "referenced_bytes"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "backup_id": { "type": "string", "format": "uuid" },
    "created_at": { "type": "string", "format": "date-time" },
    "format": { "const": "full-btrfs-send-v1" },
    "source": { "$ref": "personal-snapshot-v1.schema.json" },
    "stream_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "stream_size_bytes": { "type": "integer", "minimum": 1 },
    "referenced_bytes": { "type": "integer", "minimum": 1 }
  }
}
