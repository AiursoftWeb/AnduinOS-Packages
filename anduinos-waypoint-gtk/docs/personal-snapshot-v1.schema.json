{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.anduinos.com/schemas/waypoint/personal-snapshot-v1.schema.json",
  "title": "AnduinOS Waypoint Personal Files snapshot record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "kind", "state", "created_at", "title",
    "reason", "snapshot_uuid", "pinned", "failure"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "format": "uuid" },
    "kind": { "enum": ["manual", "automatic", "imported"] },
    "state": { "enum": ["creating", "ready", "broken", "deleting"] },
    "created_at": { "type": "string", "format": "date-time" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
    "schedule_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,49}$"
    },
    "snapshot_uuid": { "type": ["string", "null"], "format": "uuid" },
    "snapshot_parent_uuid": { "type": ["string", "null"], "format": "uuid" },
    "pinned": { "type": "boolean" },
    "failure": { "type": ["string", "null"], "maxLength": 2000 }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "automatic" } }, "required": ["kind"] },
      "then": { "required": ["schedule_id"] },
      "else": { "not": { "required": ["schedule_id"] } }
    },
    {
      "if": { "properties": { "state": { "const": "ready" } }, "required": ["state"] },
      "then": { "properties": { "snapshot_uuid": { "type": "string", "format": "uuid" } } }
    }
  ]
}
