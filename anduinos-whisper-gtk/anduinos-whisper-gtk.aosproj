<Project Sdk="Aiursoft.Apkg.Sdk">
  <PropertyGroup>
    <PackageName>anduinos-whisper-gtk</PackageName>
    <PackageVersion>2.0.2-12+$(SuiteShortName)</PackageVersion>
    <Maintainer>AnduinOS Team &lt;anduin@aiursoft.com&gt;</Maintainer>
    <PackageDescription>AnduinOS Voice Typing settings, microphone training, GNOME shortcut, and non-focusing floating microphone bar.</PackageDescription>
    <Section>gnome</Section>
    <PackageHomepage>https://www.anduinos.com</PackageHomepage>
    <RepositoryUrl>https://github.com/AiursoftWeb/AnduinOS-Packages</RepositoryUrl>
    <LicenseType>GPL-3.0</LicenseType>
    <AppStreamDeveloperName>AnduinOS Team</AppStreamDeveloperName>
    <AppStreamMetadataLicense>CC0-1.0</AppStreamMetadataLicense>
    <TargetDistro>anduinos</TargetDistro>
    <TargetSuites>resolute-addon</TargetSuites>
    <TargetArchitectures>all</TargetArchitectures>
    <Component>main</Component>
    <SuiteShortNameMap>resolute-addon=resolute</SuiteShortNameMap>
  </PropertyGroup>

  <ItemGroup>
    <DependencyCheckSource Url="https://mirror.aiursoft.com/ubuntu" SuiteMap="resolute-addon=resolute" />
  </ItemGroup>

  <ItemGroup>
    <Dependency Include="anduinos-whisper-framework (&gt;= 2.0.2-8)" />
    <Dependency Include="python3" />
    <Dependency Include="python3-gi" />
    <Dependency Include="gir1.2-gtk-4.0" />
    <Dependency Include="gir1.2-adw-1" />
    <Dependency Include="gnome-shell (&gt;= 49)" />
    <Dependency Include="dconf-gsettings-backend | gsettings-backend" />
  </ItemGroup>

  <ItemGroup>
    <IncludeScript Include="src/anduinos-whisper-gtk" Target="/usr/bin/anduinos-whisper-gtk" />
    <IncludeFolder Include="src/anduinos_whisper_gtk" Target="/usr/lib/python3/dist-packages/anduinos_whisper_gtk" />
    <IncludeFolder Include="data/voice-typing@anduinos.com" Target="/usr/share/gnome-shell/extensions/voice-typing@anduinos.com" />
    <IncludeFile Include="resources/com.anduinos.VoiceTyping.Settings.svg" Target="/usr/share/icons/hicolor/scalable/apps/com.anduinos.VoiceTyping.Settings.svg" />
  </ItemGroup>

  <ItemGroup>
    <AppStreamApplication Include="data/com.anduinos.VoiceTyping.Settings.desktop" Icon="resources/com.anduinos.VoiceTyping.Settings.svg" />
  </ItemGroup>

  <ItemGroup>
    <PrebuildCommand Run="PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=src:../anduinos-whisper-framework/src python3 -m unittest discover -s tests -v" />
  </ItemGroup>
</Project>
