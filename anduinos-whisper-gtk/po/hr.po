#: src/anduinos_whisper_gtk/app.py:54 src/anduinos_whisper_gtk/app.py:77
#: src/anduinos_whisper_gtk/app.py:108 src/anduinos_whisper_gtk/app.py:458
msgid "Voice Typing"
