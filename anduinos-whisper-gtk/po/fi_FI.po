msgstr "Suorituskykyä mitataan — mikrofoni pois päältä"

#: data/voice-typing@anduinos.com/extension.js:75
msgid "Recognizing…"
msgstr "Tunnistetaan…"

#: data/voice-typing@anduinos.com/extension.js:76
#: data/voice-typing@anduinos.com/extension.js:401
msgid "Finishing recognition…"
msgstr "Tunnistaminen käynnissä…"

#: data/voice-typing@anduinos.com/extension.js:77
msgid "Testing microphone…"
msgstr "Testataan mikrofonia…"

#: data/voice-typing@anduinos.com/extension.js:78
msgid "No speech detected"
msgstr "Puhetta ei havaittu"

#: data/voice-typing@anduinos.com/extension.js:79
msgid "Microphone unavailable"
msgstr "Mikrofoni ei ole käytettävissä"

#: data/voice-typing@anduinos.com/extension.js:83
#, javascript-format
msgid ""
"Optimizing recognition for first use: %d seconds remaining (microphone off; "
"click the microphone to cancel)"
msgstr ""
"Tunnistusta optimoidaan ensimmäistä käyttöä varten: %d sekuntia jäljellä "
"(mikrofoni pois päältä; peruuta napsauttamalla mikrofonia)"

#: data/voice-typing@anduinos.com/extension.js:84
#, javascript-format
msgid ""
"Measuring recognition performance: %d seconds remaining (microphone off; "
"click the microphone to cancel)"
msgstr ""
"Mittataan tunnistuksen suorituskykyä: %d sekuntia jäljellä (mikrofoni pois "
"päältä; napsauta mikrofonia keskeyttääksesi)"

#: data/voice-typing@anduinos.com/extension.js:88
#: data/voice-typing@anduinos.com/extension.js:344
msgid "Auto"
msgstr "Automaattinen"

#: data/voice-typing@anduinos.com/extension.js:414
#: data/voice-typing@anduinos.com/extension.js:475
msgid "Off"
msgstr "Pois"

#: data/voice-typing@anduinos.com/extension.js:598
msgid "Voice typing is disabled in password fields"
msgstr "Äänikirjoitus on poistettu käytöstä salasanakentissä"

