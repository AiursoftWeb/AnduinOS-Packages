msgid "Microphone input level"
msgstr "Nível de entrada do microfone"

#: src/anduinos_whisper_gtk/app.py:260
msgid "Microphone test"
msgstr "Teste do microfone"

#: src/anduinos_whisper_gtk/app.py:261
