msgid "Microphone Training"
msgstr "Treinamento do microfone"

#: src/anduinos_whisper_gtk/app.py:234
msgid "Calibrate your speaking setup"
msgstr "Calibrar sua configuração de fala"

#: src/anduinos_whisper_gtk/app.py:236
msgid ""
"Whisper does not need a personal voice profile. Use this page to check "
"microphone level, distance, and background noise."
msgstr ""
"O Whisper não requer um perfil de voz pessoal. Use esta página para "
"verificar o nível de entrada do microfone, a distância até o microfone e o "
"ruído de fundo."

#: src/anduinos_whisper_gtk/app.py:242
msgid "Practice phrase"
msgstr "Frase de prática"

#: src/anduinos_whisper_gtk/app.py:243
msgid "“Voice typing makes writing faster and more accessible.”"
msgstr "“A digitação por voz torna a escrita mais rápida e acessível.”"

#: src/anduinos_whisper_gtk/app.py:249
msgid "Input level"
msgstr "Nível de entrada"

#: src/anduinos_whisper_gtk/app.py:250
msgid "Speak normally; aim for the middle of the meter"
msgstr ""
"Fale normalmente; procure manter o nível de entrada próximo ao centro do "
"medidor"

