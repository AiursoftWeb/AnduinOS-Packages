#: src/anduinos_whisper_gtk/app.py:46
msgid "Sign out required"
msgstr "Cần đăng xuất"

#: src/anduinos_whisper_gtk/app.py:47
msgid "Needs attention"
msgstr "Cần xử lý"

#: src/anduinos_whisper_gtk/app.py:51
msgid "Sign out and back in to finish enabling Voice Typing."
msgstr ""
"Đăng xuất rồi đăng nhập lại để hoàn tất việc bật nhập liệu bằng giọng nói."

#: src/anduinos_whisper_gtk/app.py:91
msgid "Settings"
msgstr "Cài đặt"

#: src/anduinos_whisper_gtk/app.py:98
msgid ""
"Use the keyboard shortcut to dictate into the focused application. Speech is"
" processed locally and is never uploaded."
msgstr ""
"Dùng phím tắt để nhập liệu bằng giọng nói vào ứng dụng đang hoạt động. Giọng"
" nói được xử lý trên máy tính này và tuyệt đối không được tải lên."

#: src/anduinos_whisper_gtk/app.py:103
msgid "Status"
msgstr "Trạng thái"

#: src/anduinos_whisper_gtk/app.py:103
msgid "Checking the local service…"
msgstr "Đang kiểm tra dịch vụ cục bộ…"

#: src/anduinos_whisper_gtk/app.py:107 src/anduinos_whisper_gtk/app.py:435
msgid "Start"
msgstr "Bắt đầu"

#: src/anduinos_whisper_gtk/app.py:116
msgid "Input"
msgstr "Đầu vào"

#: src/anduinos_whisper_gtk/app.py:117
msgid "System default"
msgstr "Mặc định của hệ thống"

#: src/anduinos_whisper_gtk/app.py:120
msgid "Microphone"
msgstr "Micro"

#: src/anduinos_whisper_gtk/app.py:131
msgid "Language"
msgstr "Ngôn ngữ"

#: src/anduinos_whisper_gtk/app.py:142
msgid "Behavior"
msgstr "Hành vi"

#: src/anduinos_whisper_gtk/app.py:144
msgid "Keyboard shortcut"
msgstr "Phím tắt bàn phím"

#: src/anduinos_whisper_gtk/app.py:145
msgid "Activate voice typing from anywhere"
msgstr "Kích hoạt nhập liệu bằng giọng nói trong bất kỳ ứng dụng nào"

#: src/anduinos_whisper_gtk/app.py:149
msgid "Disabled"
msgstr "Tắt"

#: src/anduinos_whisper_gtk/app.py:153
msgid "Change…"
msgstr "Thay đổi…"

#: src/anduinos_whisper_gtk/app.py:164
msgid "Noise reduction"
msgstr "Giảm tiếng ồn"

#: src/anduinos_whisper_gtk/app.py:165
msgid ""
"Reduce background noise and balance microphone level; restart listening "
"after changing this"
msgstr ""
"Giảm tiếng ồn nền và cân bằng mức micro; khởi động lại nghe sau khi thay đổi"

#: src/anduinos_whisper_gtk/app.py:169
msgid "Automatic punctuation"
msgstr "Tự động thêm dấu câu"

#: src/anduinos_whisper_gtk/app.py:170
msgid "Keep punctuation recognized from speech"
msgstr "Giữ nguyên các dấu câu được nhận dạng từ giọng nói"

#: src/anduinos_whisper_gtk/app.py:174
msgid "Voice commands"
msgstr "Lệnh giọng nói"

#: src/anduinos_whisper_gtk/app.py:175
msgid "Recognize commands such as “new line” and “comma”"
msgstr "Nhận dạng các lệnh như “xuống dòng” và “dấu phẩy”"

#: src/anduinos_whisper_gtk/app.py:179
msgid "Live transcription"
msgstr "Chuyển giọng nói thành văn bản theo thời gian thực"

#: src/anduinos_whisper_gtk/app.py:180
msgid "Show words in the microphone bar while you speak"
msgstr "Hiển thị các từ trong thanh micrô khi bạn nói"

#: src/anduinos_whisper_gtk/app.py:184
msgid "Final result preview"
msgstr "Xem trước kết quả cuối cùng"

#: src/anduinos_whisper_gtk/app.py:185
msgid "Pause briefly before inserting the completed phrase"
msgstr "Tạm dừng một chút trước khi chèn cụm từ hoàn chỉnh"

#: src/anduinos_whisper_gtk/app.py:189
msgid "Start and stop sounds"
msgstr "Âm báo bắt đầu và dừng"

#: src/anduinos_whisper_gtk/app.py:190
msgid "Play a subtle microphone cue"
msgstr "Phát âm báo nhẹ nhàng cho micro"

#: src/anduinos_whisper_gtk/app.py:200
msgid "Performance diagnostics"
msgstr "Chẩn đoán hiệu suất"

#: src/anduinos_whisper_gtk/app.py:201
msgid ""
"Export timings from the current voice session. No recordings or recognized "
"text are included."
msgstr ""
"Xuất thời gian từ phiên giọng nói hiện tại. Không bao gồm bản ghi âm hoặc "
"văn bản được nhận dạng."

#: src/anduinos_whisper_gtk/app.py:203 src/anduinos_whisper_gtk/app.py:297
msgid "Export diagnostic report"
msgstr "Xuất báo cáo chẩn đoán"

#: src/anduinos_whisper_gtk/app.py:204
msgid "Export"
msgstr "Xuất"

#: src/anduinos_whisper_gtk/app.py:212
msgid "Recognition performance"
msgstr "Hiệu năng nhận dạng"

#: src/anduinos_whisper_gtk/app.py:214
msgid ""
"Changes apply next time listening starts. Automatic selection measures "
"bundled audio without using your microphone or changing your model."
msgstr ""
"Thay đổi sẽ áp dụng vào lần nghe tiếp theo. Việc chọn tự động sẽ đo âm thanh"
" đi kèm mà không dùng micro của bạn hay thay đổi mô hình."

#: src/anduinos_whisper_gtk/app.py:220
msgid ""
"First use takes at most 10 seconds and results are cached. Wait for "
"Listening before speaking; press the microphone button again to cancel "
"preparation."
msgstr ""
"Lần sử dụng đầu tiên mất tối đa 10 giây và kết quả sẽ được lưu bộ nhớ đệm. "
"Hãy chờ cho đến khi hiển thị Đang nghe trước khi nói; nhấn nút micro một lần"
" nữa để hủy chuẩn bị."

#: src/anduinos_whisper_gtk/app.py:226
msgid "Recognition backend"
msgstr "Bộ xử lý nhận dạng"

#: src/anduinos_whisper_gtk/app.py:227
msgid "Automatic (measured)"
msgstr "Tự động (đã đo lường)"

#: src/anduinos_whisper_gtk/app.py:227
msgid "CPU"
msgstr "CPU"

#: src/anduinos_whisper_gtk/app.py:227
msgid "GPU (CPU fallback)"
msgstr "GPU (dự phòng CPU)"

#: src/anduinos_whisper_gtk/app.py:234
msgid "Recognition threads"
msgstr "Số luồng nhận dạng"

#: src/anduinos_whisper_gtk/app.py:234
msgid "0 selects automatically; more threads are not always faster"
msgstr "0 sẽ tự động chọn; nhiều luồng hơn không nhất thiết là nhanh hơn"

#: src/anduinos_whisper_gtk/app.py:242
msgid "Measure again on next start"
msgstr "Đo lại khi khởi động tiếp theo"

#: src/anduinos_whisper_gtk/app.py:244
msgid "A complete test may take up to one minute. The microphone remains off."
msgstr ""
"Một bài kiểm tra hoàn chỉnh có thể mất đến một phút. Micro vẫn ở chế độ tắt."

#: src/anduinos_whisper_gtk/app.py:247
msgid "Retest"
msgstr "Kiểm tra lại"

#: src/anduinos_whisper_gtk/app.py:251
msgid "Restore automatic backend and thread selection"
msgstr "Khôi phục lựa chọn backend và luồng tự động"

#: src/anduinos_whisper_gtk/app.py:253
msgid "Restore defaults"
msgstr "Khôi phục mặc định"

#: src/anduinos_whisper_gtk/app.py:276
msgid "Performance will be measured next time listening starts"
msgstr "Hiệu suất sẽ được đo vào lần nghe tiếp theo"

#: src/anduinos_whisper_gtk/app.py:291
msgid "No diagnostic report available"
msgstr "Không có báo cáo chẩn đoán nào"

#: src/anduinos_whisper_gtk/app.py:292
msgid ""
"Start a voice session, then export its report before closing the microphone "
"bar."
msgstr "Bắt đầu phiên thoại, sau đó xuất báo cáo trước khi đóng thanh micro."

#: src/anduinos_whisper_gtk/app.py:294 src/anduinos_whisper_gtk/app.py:318
#: src/anduinos_whisper_gtk/app.py:627
msgid "Close"
msgstr "Đóng"

#: src/anduinos_whisper_gtk/app.py:316
msgid "Could not save diagnostic report"
msgstr "Không thể lưu báo cáo chẩn đoán"

#: src/anduinos_whisper_gtk/app.py:317
msgid "Check that the selected folder is writable and has free space."
msgstr ""
"Kiểm tra xem thư mục đã chọn có khả ghi và có dung lượng trống hay không."

#: src/anduinos_whisper_gtk/app.py:322
msgid "Models"
msgstr "Mô hình"

#: src/anduinos_whisper_gtk/app.py:325
msgid "Offline speech models"
msgstr "Mô hình nhận dạng giọng nói ngoại tuyến"

#: src/anduinos_whisper_gtk/app.py:327
msgid ""
"The Base multilingual model is installed with Voice Typing. Optional models "
"are verified before use."
msgstr ""
"Mô hình đa ngôn ngữ Base đã được cài đặt cùng với Nhập liệu bằng giọng nói. "
"Các mô hình tùy chọn sẽ được xác minh trước khi sử dụng."

#: src/anduinos_whisper_gtk/app.py:340
msgid "Remove downloaded model"
msgstr "Xóa mô hình đã tải xuống"

#: src/anduinos_whisper_gtk/app.py:343
#, python-format
msgid "Remove %s"
msgstr "Xóa %s"

#: src/anduinos_whisper_gtk/app.py:357
msgid "Microphone Training"
msgstr "Hiệu chỉnh micro"

#: src/anduinos_whisper_gtk/app.py:361
msgid "Check your speaking setup"
msgstr "Kiểm tra cài đặt nói của bạn"

#: src/anduinos_whisper_gtk/app.py:363
msgid ""
"Whisper does not need a personal voice profile. Use this page to check the "
"processed microphone level, distance, and background noise. This test does "
"not train the model or measure recognition accuracy."
msgstr ""
"Whisper không cần hồ sơ giọng nói cá nhân. Sử dụng trang này để kiểm tra mức"
" độ micrô đã xử lý, khoảng cách và tiếng ồn nền. Bài kiểm tra này không huấn"
" luyện mô hình hoặc đo độ chính xác nhận dạng."

#: src/anduinos_whisper_gtk/app.py:370
msgid "Practice phrase"
msgstr "Câu thực hành"

#: src/anduinos_whisper_gtk/app.py:371
msgid "“Voice typing makes writing faster and more accessible.”"
msgstr "“Nhập liệu bằng giọng nói giúp viết nhanh hơn và dễ tiếp cận hơn.”"

#: src/anduinos_whisper_gtk/app.py:377
msgid "Input level"
msgstr "Mức tín hiệu đầu vào"

#: src/anduinos_whisper_gtk/app.py:378
msgid "Speak normally; aim for the middle of the meter"
msgstr "Nói bình thường; cố gắng giữ mức tín hiệu gần giữa thang đo"

#: src/anduinos_whisper_gtk/app.py:382
msgid "Microphone input level"
msgstr "Mức tín hiệu đầu vào của micro"

#: src/anduinos_whisper_gtk/app.py:388
msgid "Microphone test"
msgstr "Kiểm tra micro"

#: src/anduinos_whisper_gtk/app.py:389
msgid "No audio is saved during this test"
msgstr "Không có âm thanh nào được lưu trữ trong quá trình kiểm tra này"

#: src/anduinos_whisper_gtk/app.py:391 src/anduinos_whisper_gtk/app.py:687
msgid "Start Test"
msgstr "Bắt đầu kiểm tra"

#: src/anduinos_whisper_gtk/app.py:396
msgid "Tips for better recognition"
msgstr "Mẹo để nhận dạng chính xác hơn"

#: src/anduinos_whisper_gtk/app.py:399
msgid "Speak naturally"
msgstr "Nói tự nhiên"

#: src/anduinos_whisper_gtk/app.py:400
msgid "Use short phrases and pause briefly between sentences"
msgstr "Sử dụng các cụm từ ngắn và tạm dừng một chút giữa các câu"

#: src/anduinos_whisper_gtk/app.py:404
msgid "Reduce background noise"
msgstr "Giảm tiếng ồn nền"

#: src/anduinos_whisper_gtk/app.py:405
msgid "Keep the microphone close without speaking directly into it"
msgstr "Giữ micro gần miệng nhưng không nói trực tiếp vào micro"

#: src/anduinos_whisper_gtk/app.py:409
msgid "Choose the language"
msgstr "Chọn ngôn ngữ"

#: src/anduinos_whisper_gtk/app.py:410
msgid "A fixed language is faster than automatic detection"
msgstr ""
"Sử dụng một ngôn ngữ cố định sẽ nhanh hơn việc tự động phát hiện ngôn ngữ"

#: src/anduinos_whisper_gtk/app.py:433
msgid "Stop"
msgstr "Dừng"

#: src/anduinos_whisper_gtk/app.py:471
msgid "Set Keyboard Shortcut"
msgstr "Đặt phím tắt bàn phím"

#: src/anduinos_whisper_gtk/app.py:493
msgid "Press the new shortcut"
msgstr "Nhấn phím tắt mới"

#: src/anduinos_whisper_gtk/app.py:497
msgid "The keys you press will be used to start or stop Voice Typing."
msgstr ""
"Các phím bạn nhấn sẽ được dùng để bắt đầu hoặc dừng nhập liệu bằng giọng "
"nói."

#: src/anduinos_whisper_gtk/app.py:505
msgid "Waiting for input…"
msgstr "Đang chờ nhập liệu…"

#: src/anduinos_whisper_gtk/app.py:511
msgid "Esc cancels · Backspace disables the shortcut"
msgstr "Nhấn Esc để hủy · Nhấn Backspace để tắt phím tắt"

#: src/anduinos_whisper_gtk/app.py:573
#, python-format
msgid "Download %s from Hugging Face?"
msgstr "Tải xuống %s từ Hugging Face?"

#: src/anduinos_whisper_gtk/app.py:575
msgid ""
"This optional model is hosted by Hugging Face, a third-party service. AnduinOS is not affiliated with, sponsored by, or partnered with Hugging Face.\n"
"\n"
"If you continue, your computer will connect directly to huggingface.co. Hugging Face will receive your public IP address and that address may reveal your approximate location.\n"
"\n"
"Privacy policy: https://huggingface.co/privacy"
msgstr ""
"Mô hình tùy chọn này do Hugging Face, một dịch vụ bên thứ ba, lưu trữ. AnduinOS không liên kết, không được tài trợ và không hợp tác với Hugging Face.\n"
"\n"
"Nếu bạn tiếp tục, máy tính của bạn sẽ kết nối trực tiếp với huggingface.co. Hugging Face sẽ nhận được địa chỉ IP công khai của bạn và địa chỉ này có thể tiết lộ vị trí gần đúng của bạn.\n"
"\n"
"Chính sách quyền riêng tư: https://huggingface.co/privacy"

#: src/anduinos_whisper_gtk/app.py:584 src/anduinos_whisper_gtk/app.py:638
msgid "Cancel"
msgstr "Hủy"

#: src/anduinos_whisper_gtk/app.py:585
msgid "Continue Download"
msgstr "Tiếp tục tải xuống"

#: src/anduinos_whisper_gtk/app.py:607 src/anduinos_whisper_gtk/app.py:666
msgid "Downloading…"
msgstr "Đang tải xuống…"

#: src/anduinos_whisper_gtk/app.py:625
msgid "Retry"
msgstr "Thử lại"

#: src/anduinos_whisper_gtk/app.py:626
msgid "Model download failed"
msgstr "Tải xuống mô hình thất bại"

#: src/anduinos_whisper_gtk/app.py:635
#, python-format
msgid "Remove %s model?"
msgstr "Xóa mô hình %s?"

#: src/anduinos_whisper_gtk/app.py:636
msgid "The model can be downloaded again later."
msgstr "Mô hình có thể được tải xuống lại sau này."

#: src/anduinos_whisper_gtk/app.py:639
msgid "Remove"
msgstr "Xóa"

#: src/anduinos_whisper_gtk/app.py:675
msgid "In Use"
msgstr "Đang sử dụng"

#: src/anduinos_whisper_gtk/app.py:678
msgid "Use"
msgstr "Sử dụng"

#: src/anduinos_whisper_gtk/app.py:681
msgid "Download"
msgstr "Tải xuống"

#: src/anduinos_whisper_gtk/app.py:687
msgid "Stop Test"
msgstr "Dừng kiểm tra"

#: src/anduinos_whisper_gtk/app.py:721
msgid "AnduinOS Voice Typing"
msgstr "AnduinOS Nhập liệu bằng giọng nói"

#: src/anduinos_whisper_gtk/app.py:723
msgid "AnduinOS Team"
msgstr "Đội ngũ AnduinOS"

#: src/anduinos_whisper_gtk/app.py:725
msgid "Private, offline speech-to-text for the whole desktop."
msgstr ""
"Chuyển giọng nói thành văn bản riêng tư, ngoại tuyến trên toàn bộ môi trường"
" máy tính để bàn."

#: src/anduinos_whisper_gtk/app.py:733
#, python-format
msgid "%.0f MB"
msgstr "%.0f MB"

#: data/voice-typing@anduinos.com/extension.js:72
msgid "Loading speech model…"
msgstr "Đang tải mô hình giọng nói…"

#: data/voice-typing@anduinos.com/extension.js:73
msgid "Measuring performance — microphone off"
msgstr "Đang đo hiệu năng — tắt micro"

#: data/voice-typing@anduinos.com/extension.js:75
msgid "Recognizing…"
msgstr "Đang nhận dạng…"

#: data/voice-typing@anduinos.com/extension.js:76
#: data/voice-typing@anduinos.com/extension.js:401
msgid "Finishing recognition…"
msgstr "Đang hoàn tất nhận dạng…"

#: data/voice-typing@anduinos.com/extension.js:77
msgid "Testing microphone…"
msgstr "Đang kiểm tra micro…"

#: data/voice-typing@anduinos.com/extension.js:78
msgid "No speech detected"
