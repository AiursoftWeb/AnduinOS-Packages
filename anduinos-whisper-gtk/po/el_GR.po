msgid "Voice Typing"
msgstr "Φωνητική πληκτρολόγηση"

#: src/anduinos_whisper_gtk/app.py:45
#: data/voice-typing@anduinos.com/extension.js:71
#: data/voice-typing@anduinos.com/extension.js:112
#: data/voice-typing@anduinos.com/extension.js:170
