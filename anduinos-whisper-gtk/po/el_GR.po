#: data/voice-typing@anduinos.com/extension.js:504
msgid "Ready"
msgstr "Έτοιμο"

#: src/anduinos_whisper_gtk/app.py:46
#: data/voice-typing@anduinos.com/extension.js:74
#: data/voice-typing@anduinos.com/extension.js:393
#: data/voice-typing@anduinos.com/extension.js:480
msgid "Listening…"
msgstr "Ακρόαση…"

#: src/anduinos_whisper_gtk/app.py:47
msgid "Sign out required"
msgstr "Απαιτείται αποσύνδεση"

#: src/anduinos_whisper_gtk/app.py:48
msgid "Needs attention"
msgstr "Απαιτείται προσοχή"

#: src/anduinos_whisper_gtk/app.py:52
msgid "Sign out and back in to finish enabling Voice Typing."
msgstr ""
"Αποσυνδεθείτε και συνδεθείτε ξανά για να ολοκληρωθεί η ενεργοποίηση της "
"φωνητικής πληκτρολόγησης."

#: src/anduinos_whisper_gtk/app.py:92
msgid "Settings"
msgstr "Ρυθμίσεις"

#: src/anduinos_whisper_gtk/app.py:99
msgid ""
"Use the keyboard shortcut to dictate into the focused application. Speech is "
"processed locally and is never uploaded."
msgstr ""
"Χρησιμοποιήστε τη συντόμευση πληκτρολογίου για να υπαγορεύσετε στην εφαρμογή "
"που έχει εστίαση. Η ομιλία επεξεργάζεται σε αυτόν τον υπολογιστή και δεν "
"αποστέλλεται ποτέ."

#: src/anduinos_whisper_gtk/app.py:104
msgid "Status"
msgstr "Κατάσταση"

#: src/anduinos_whisper_gtk/app.py:104
msgid "Checking the local service…"
msgstr "Έλεγχος της τοπικής υπηρεσίας…"

#: src/anduinos_whisper_gtk/app.py:108 src/anduinos_whisper_gtk/app.py:432
msgid "Start"
msgstr "Έναρξη"

#: src/anduinos_whisper_gtk/app.py:117
msgid "Input"
msgstr "Είσοδος"

#: src/anduinos_whisper_gtk/app.py:118
msgid "System default"
msgstr "Προεπιλογή συστήματος"

#: src/anduinos_whisper_gtk/app.py:121
msgid "Microphone"
msgstr "Μικρόφωνο"

#: src/anduinos_whisper_gtk/app.py:132
msgid "Language"
msgstr "Γλώσσα"

#: src/anduinos_whisper_gtk/app.py:143
msgid "Behavior"
msgstr "Συμπεριφορά"

#: src/anduinos_whisper_gtk/app.py:145
msgid "Keyboard shortcut"
msgstr "Συντόμευση πληκτρολογίου"

#: src/anduinos_whisper_gtk/app.py:146
msgid "Activate voice typing from anywhere"
msgstr "Ενεργοποίηση φωνητικής πληκτρολόγησης από οπουδήποτε"

#: src/anduinos_whisper_gtk/app.py:150
msgid "Disabled"
msgstr "Απενεργοποιημένο"

#: src/anduinos_whisper_gtk/app.py:154
msgid "Change…"
msgstr "Αλλαγή…"

#: src/anduinos_whisper_gtk/app.py:166
msgid "Noise reduction"
msgstr "Μείωση θορύβου"

#: src/anduinos_whisper_gtk/app.py:167
msgid ""
"Reduce background noise and balance microphone level; restart listening "
"after changing this"
msgstr ""
"Μείωση θορύβου φόντου και ισορροπία επιπέδου μικροφώνου· επανεκκίνηση "
"ακρόασης μετά την αλλαγή"

#: src/anduinos_whisper_gtk/app.py:171
msgid "Automatic punctuation"
msgstr "Αυτόματη στίξη"

#: src/anduinos_whisper_gtk/app.py:172
msgid "Keep punctuation recognized from speech"
msgstr "Διατήρηση της στίξης που αναγνωρίζεται από την ομιλία"

#: src/anduinos_whisper_gtk/app.py:176
msgid "Voice commands"
msgstr "Φωνητικές εντολές"

#: src/anduinos_whisper_gtk/app.py:177
msgid "Recognize commands such as “new line” and “comma”"
msgstr "Αναγνώριση εντολών όπως «νέα γραμμή» και «κόμμα»"

#: src/anduinos_whisper_gtk/app.py:181
msgid "Final result preview"
msgstr "Προεπισκόπηση τελικού αποτελέσματος"

#: src/anduinos_whisper_gtk/app.py:182
msgid "Pause briefly before inserting the completed phrase"
msgstr "Κάντε μια σύντομη παύση πριν από την εισαγωγή της ολοκληρωμένης φράσης"

#: src/anduinos_whisper_gtk/app.py:186
msgid "Start and stop sounds"
msgstr "Ήχοι έναρξης και λήξης"

#: src/anduinos_whisper_gtk/app.py:187
msgid "Play a subtle microphone cue"
msgstr "Αναπαραγωγή διακριτικού ηχητικού σήματος μικροφώνου"

#: src/anduinos_whisper_gtk/app.py:197
msgid "Performance diagnostics"
msgstr "Διαγνωστικά απόδοσης"

#: src/anduinos_whisper_gtk/app.py:198
msgid ""
"Export timings from the current voice session. No recordings or recognized "
"text are included."
msgstr ""
"Εξαγωγή χρονομετρήσεων από την τρέχουσα φωνητική συνεδρία. Δεν "
"περιλαμβάνονται ηχογραφήσεις ή αναγνωρισμένο κείμενο."

#: src/anduinos_whisper_gtk/app.py:200 src/anduinos_whisper_gtk/app.py:294
msgid "Export diagnostic report"
msgstr "Εξαγωγή αναφοράς διαγνωστικών"

#: src/anduinos_whisper_gtk/app.py:201
msgid "Export"
msgstr "Εξαγωγή"

#: src/anduinos_whisper_gtk/app.py:209
msgid "Recognition performance"
msgstr "Επιδόσεις αναγνώρισης"

#: src/anduinos_whisper_gtk/app.py:211
msgid ""
"Changes apply next time listening starts. Automatic selection measures "
"bundled audio without using your microphone or changing your model."
msgstr ""
"Οι αλλαγές εφαρμόζονται την επόμενη φορά που η ακρόαση θα ξεκινήσει. Η "
"αυτόματη επιλογή μετρά τα ενσωματωμένα ήχους χωρίς να χρησιμοποιεί το "
"μικρόφωνό σας ή να αλλάζει το μοντέλο σας."

#: src/anduinos_whisper_gtk/app.py:217
msgid ""
"First use takes at most 10 seconds and results are cached. Wait for "
"Listening before speaking; press the microphone button again to cancel "
"preparation."
msgstr ""
"Η πρώτη χρήση διαρκεί έως και 10 δευτερόλεπτα και τα αποτελέσματα "
"αποθηκεύονται σε προσωρινή μνήμη. Περιμένετε την κατάσταση «Ακρόαση» πριν "
"μιλήσετε· πατήστε ξανά το κουμπί μικροφώνου για ακύρωση της προετοιμασίας."

#: src/anduinos_whisper_gtk/app.py:223
msgid "Recognition backend"
msgstr "Πυρήνας αναγνώρισης"

#: src/anduinos_whisper_gtk/app.py:224
msgid "Automatic (measured)"
msgstr "Αυτόματο (μετρημένο)"

#: src/anduinos_whisper_gtk/app.py:224
msgid "CPU"
msgstr "Επεξεργαστής"

#: src/anduinos_whisper_gtk/app.py:224
msgid "GPU (CPU fallback)"
msgstr "GPU (εναλλακτική CPU)"

#: src/anduinos_whisper_gtk/app.py:231
msgid "Recognition threads"
msgstr "Νήματα αναγνώρισης"

#: src/anduinos_whisper_gtk/app.py:231
msgid "0 selects automatically; more threads are not always faster"
msgstr "Το 0 επιλέγει αυτόματα· περισσότερα νήματα δεν είναι πάντα ταχύτερα"

#: src/anduinos_whisper_gtk/app.py:239
msgid "Measure again on next start"
msgstr "Επανάληψη μέτρησης στην επόμενη εκκίνηση"

#: src/anduinos_whisper_gtk/app.py:241
msgid "A complete test may take up to one minute. The microphone remains off."
msgstr ""
"Ο πλήρης έλεγχος μπορεί να διαρκέσει έως ένα λεπτό. Το μικρόφωνο παραμένει "
"απενεργοποιημένο."

#: src/anduinos_whisper_gtk/app.py:244
msgid "Retest"
msgstr "Επανέλεγχος"

#: src/anduinos_whisper_gtk/app.py:248
msgid "Restore automatic backend and thread selection"
msgstr "Επαναφορά αυτόματης επιλογής backend και νημάτων"

#: src/anduinos_whisper_gtk/app.py:250
msgid "Restore defaults"
msgstr "Επαναφορά προεπιλογών"

#: src/anduinos_whisper_gtk/app.py:273
msgid "Performance will be measured next time listening starts"
msgstr "Η απόδοση θα μετρηθεί την επόμενη φορά που θα ξεκινήσει η ακρόαση"

#: src/anduinos_whisper_gtk/app.py:288
msgid "No diagnostic report available"
msgstr "Δεν υπάρχει διαθέσιμη αναφορά διάγνωσης"

#: src/anduinos_whisper_gtk/app.py:289
msgid ""
"Start a voice session, then export its report before closing the microphone "
"bar."
msgstr ""
"Εκκινήστε μια φωνητική συνεδρία και στη συνέχεια εξάγετε την αναφορά της "
"πριν κλείσετε την μπάρα μικροφώνου."

#: src/anduinos_whisper_gtk/app.py:291 src/anduinos_whisper_gtk/app.py:315
#: src/anduinos_whisper_gtk/app.py:647
msgid "Close"
msgstr "Κλείσιμο"

#: src/anduinos_whisper_gtk/app.py:313
msgid "Could not save diagnostic report"
msgstr "Δεν ήταν δυνατή η αποθήκευση της αναφοράς διάγνωσης"

#: src/anduinos_whisper_gtk/app.py:314
msgid "Check that the selected folder is writable and has free space."
msgstr ""
"Βεβαιωθείτε ότι έχετε δικαίωμα εγγραφής στον επιλεγμένο φάκελο και ότι "
"υπάρχει ελεύθερος χώρος."

#: src/anduinos_whisper_gtk/app.py:319
msgid "Models"
msgstr "Μοντέλα"

#: src/anduinos_whisper_gtk/app.py:322
msgid "Offline speech models"
msgstr "Μοντέλα αναγνώρισης ομιλίας εκτός σύνδεσης"

#: src/anduinos_whisper_gtk/app.py:324
msgid ""
"The Base multilingual model is installed with Voice Typing. Optional models "
"are verified before use."
msgstr ""
"Το πολυγλωσσικό μοντέλο Base εγκαθίσταται μαζί με τη φωνητική πληκτρολόγηση. "
"Τα προαιρετικά μοντέλα επαληθεύονται πριν χρησιμοποιηθούν."

#: src/anduinos_whisper_gtk/app.py:337
msgid "Remove downloaded model"
msgstr "Αφαίρεση του κατεβασμένου μοντέλου"

#: src/anduinos_whisper_gtk/app.py:340
#, python-format
msgid "Remove %s"
msgstr "Αφαίρεση του %s"

#: src/anduinos_whisper_gtk/app.py:354
msgid "Microphone Training"
msgstr "Βαθμονόμηση μικροφώνου"

#: src/anduinos_whisper_gtk/app.py:358
msgid "Check your speaking setup"
msgstr "Ελέγξτε τη ρύθμισή σας ομιλίας"

#: src/anduinos_whisper_gtk/app.py:360
msgid ""
"Whisper does not need a personal voice profile. Use this page to check the "
"processed microphone level, distance, and background noise. This test does "
"not train the model or measure recognition accuracy."
msgstr ""
"Το Whisper δεν απαιτεί προσωπικό προφίλ φωνής. Χρησιμοποιήστε αυτή τη σελίδα "
"για ελέγχο του επεξεργασμένου επιπέδου μικροφώνου, της απόστασης και του "
"θορύβου του φόντου. Αυτό το τεστ δεν εκπαιδεύει το μοντέλο ούτε μετρά την "
"ακρίβεια αναγνώρισης."

#: src/anduinos_whisper_gtk/app.py:367
msgid "Practice phrase"
msgstr "Φράση εξάσκησης"

#: src/anduinos_whisper_gtk/app.py:368
msgid "“Voice typing makes writing faster and more accessible.”"
msgstr "«Η φωνητική πληκτρολόγηση κάνει τη γραφή ταχύτερη και πιο προσβάσιμη.»"

#: src/anduinos_whisper_gtk/app.py:374
msgid "Input level"
msgstr "Στάθμη εισόδου"

#: src/anduinos_whisper_gtk/app.py:375
msgid "Speak normally; aim for the middle of the meter"
msgstr ""
"Μιλήστε φυσιολογικά· διατηρήστε τη στάθμη εισόδου κοντά στο κέντρο του "
"μετρητή"

#: src/anduinos_whisper_gtk/app.py:379
msgid "Microphone input level"
msgstr "Στάθμη εισόδου μικροφώνου"

#: src/anduinos_whisper_gtk/app.py:385
msgid "Microphone test"
msgstr "Δοκιμή μικροφώνου"

#: src/anduinos_whisper_gtk/app.py:386
msgid "No audio is saved during this test"
msgstr "Δεν αποθηκεύονται δεδομένα ήχου κατά τη διάρκεια αυτής της δοκιμής"

#: src/anduinos_whisper_gtk/app.py:388 src/anduinos_whisper_gtk/app.py:707
msgid "Start Test"
msgstr "Έναρξη δοκιμής"

#: src/anduinos_whisper_gtk/app.py:393
msgid "Tips for better recognition"
msgstr "Συμβουλές για καλύτερη αναγνώριση"

#: src/anduinos_whisper_gtk/app.py:396
msgid "Speak naturally"
msgstr "Μιλήστε φυσικά"

#: src/anduinos_whisper_gtk/app.py:397
msgid "Use short phrases and pause briefly between sentences"
msgstr ""
"Χρησιμοποιήστε σύντομες φράσεις και κάντε μικρή παύση μεταξύ των προτάσεων"

#: src/anduinos_whisper_gtk/app.py:401
msgid "Reduce background noise"
msgstr "Μείωση του θορύβου φόντου"

#: src/anduinos_whisper_gtk/app.py:402
msgid "Keep the microphone close without speaking directly into it"
msgstr "Κρατήστε το μικρόφωνο κοντά, χωρίς να μιλάτε απευθείας σε αυτό"

#: src/anduinos_whisper_gtk/app.py:406
msgid "Choose the language"
msgstr "Επιλέξτε τη γλώσσα"

#: src/anduinos_whisper_gtk/app.py:407
msgid "A fixed language is faster than automatic detection"
msgstr "Η σταθερή γλώσσα είναι ταχύτερη από την αυτόματη ανίχνευση"

#: src/anduinos_whisper_gtk/app.py:430
msgid "Stop"
msgstr "Διακοπή"

#: src/anduinos_whisper_gtk/app.py:448
msgid "Live transcription"
msgstr "Μεταγραφή σε πραγματικό χρόνο"

#: src/anduinos_whisper_gtk/app.py:449
msgid "Automatic enables live transcription only when performance allows"
msgstr ""
"Η αυτόματη λειτουργία ενεργοποιεί τη ζωντανή μεταγραφή μόνο όταν το "
"επιτρέπει η απόδοση"

#: src/anduinos_whisper_gtk/app.py:450
msgid "Automatic"
msgstr "Αυτόματα"

#: src/anduinos_whisper_gtk/app.py:450
msgid "On"
msgstr "Ενεργό"

#: src/anduinos_whisper_gtk/app.py:450
#: data/voice-typing@anduinos.com/extension.js:414
#: data/voice-typing@anduinos.com/extension.js:475
msgid "Off"
msgstr "Απενεργοποιημένο"

#: src/anduinos_whisper_gtk/app.py:491
msgid "Set Keyboard Shortcut"
msgstr "Ορισμός συντόμευσης πληκτρολογίου"

#: src/anduinos_whisper_gtk/app.py:513
msgid "Press the new shortcut"
msgstr "Πατήστε τη νέα συντόμευση"

#: src/anduinos_whisper_gtk/app.py:517
msgid "The keys you press will be used to start or stop Voice Typing."
msgstr ""
"Τα πλήκτρα που θα πατήσετε θα χρησιμοποιηθούν για την έναρξη ή τη διακοπή "
"της φωνητικής πληκτρολόγησης."

#: src/anduinos_whisper_gtk/app.py:525
msgid "Waiting for input…"
msgstr "Αναμονή εισόδου…"

#: src/anduinos_whisper_gtk/app.py:531
msgid "Esc cancels · Backspace disables the shortcut"
msgstr "Esc ακυρώνει · Backspace απενεργοποιεί τη συντόμευση"

#: src/anduinos_whisper_gtk/app.py:593
#, python-format
msgid "Download %s from Hugging Face?"
msgstr "Λήψη του %s από το Hugging Face;"

#: src/anduinos_whisper_gtk/app.py:595
msgid ""
"This optional model is hosted by Hugging Face, a third-party service. "
"AnduinOS is not affiliated with, sponsored by, or partnered with Hugging "
"Face.\n"
"\n"
"If you continue, your computer will connect directly to huggingface.co. "
"Hugging Face will receive your public IP address and that address may reveal "
"your approximate location.\n"
"\n"
"Privacy policy: https://huggingface.co/privacy"
msgstr ""
"Αυτό το προαιρετικό μοντέλο φιλοξενείται από το Hugging Face, μια υπηρεσία "
"τρίτου μέρους. Το AnduinOS δεν συνδέεται με το Hugging Face, δεν "
"χρηματοδοτείται από αυτό και δεν διατηρεί σχέση συνεργασίας μαζί του.\n"
"\n"
"Αν συνεχίσετε, ο υπολογιστής σας θα συνδεθεί απευθείας στο huggingface.co. "
"Το Hugging Face θα λάβει τη δημόσια διεύθυνση IP σας, η οποία ενδέχεται να "
"αποκαλύψει την κατά προσέγγιση τοποθεσία σας.\n"
"\n"
"Πολιτική απορρήτου: https://huggingface.co/privacy"

#: src/anduinos_whisper_gtk/app.py:604 src/anduinos_whisper_gtk/app.py:658
msgid "Cancel"
msgstr "Ακύρωση"

#: src/anduinos_whisper_gtk/app.py:605
msgid "Continue Download"
msgstr "Συνέχεια λήψης"

#: src/anduinos_whisper_gtk/app.py:627 src/anduinos_whisper_gtk/app.py:686
msgid "Downloading…"
msgstr "Λήψη…"

#: src/anduinos_whisper_gtk/app.py:645
msgid "Retry"
msgstr "Επαναδοκιμή"

#: src/anduinos_whisper_gtk/app.py:646
msgid "Model download failed"
msgstr "Η λήψη του μοντέλου απέτυχε"

#: src/anduinos_whisper_gtk/app.py:655
#, python-format
msgid "Remove %s model?"
msgstr "Αφαίρεση του μοντέλου %s;"

#: src/anduinos_whisper_gtk/app.py:656
msgid "The model can be downloaded again later."
msgstr "Το μοντέλο μπορεί να ληφθεί ξανά αργότερα."

#: src/anduinos_whisper_gtk/app.py:659
msgid "Remove"
msgstr "Αφαίρεση"

#: src/anduinos_whisper_gtk/app.py:695
msgid "In Use"
msgstr "Σε χρήση"

#: src/anduinos_whisper_gtk/app.py:698
msgid "Use"
msgstr "Χρήση"

#: src/anduinos_whisper_gtk/app.py:701
msgid "Download"
msgstr "Λήψη"

#: src/anduinos_whisper_gtk/app.py:707
msgid "Stop Test"
msgstr "Διακοπή δοκιμής"

#: src/anduinos_whisper_gtk/app.py:741
msgid "AnduinOS Voice Typing"
msgstr "Φωνητική πληκτρολόγηση AnduinOS"

#: src/anduinos_whisper_gtk/app.py:743
msgid "AnduinOS Team"
msgstr "Ομάδα AnduinOS"

#: src/anduinos_whisper_gtk/app.py:745
msgid "Private, offline speech-to-text for the whole desktop."
msgstr ""
