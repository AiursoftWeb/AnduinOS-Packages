#: src/anduinos_whisper_gtk/app.py:448
msgid "Live transcription"
msgstr "Gerçek zamanlı transkripsiyon"

#: src/anduinos_whisper_gtk/app.py:449
msgid "Automatic enables live transcription only when performance allows"
msgstr ""
"Otomatik mod, yalnızca performans yeterliyse canlı yazıya dökmeyi "
