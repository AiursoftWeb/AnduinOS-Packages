#: data/voice-typing@anduinos.com/extension.js:344
msgid "Auto"
msgstr "Automatyczne"

#: data/voice-typing@anduinos.com/extension.js:597
msgid "Voice typing is disabled in password fields"
msgstr "Dyktowanie głosowe jest wyłączone w polach haseł"

#: data/voice-typing@anduinos.com/extension.js:603
msgid "Select a text field before dictating"
msgstr "Wybierz pole tekstowe przed dyktowaniem"

