#: src/anduinos_whisper_gtk/app.py:164
msgid "Automatic punctuation"
msgstr "Автоматическая пунктуация"

#: src/anduinos_whisper_gtk/app.py:165
msgid "Keep punctuation recognized from speech"
msgstr "Сохранять знаки препинания, распознанные в речи"

#: src/anduinos_whisper_gtk/app.py:169
msgid "Voice commands"
msgstr "Голосовые команды"

#: src/anduinos_whisper_gtk/app.py:170
msgid "Recognize commands such as “new line” and “comma”"
msgstr "Распознавать команды, такие как «новая строка» и «запятая»"

#: src/anduinos_whisper_gtk/app.py:174
msgid "Live transcription"
msgstr "Транскрибирование в реальном времени"

#: src/anduinos_whisper_gtk/app.py:175
msgid "Show words in the microphone bar while you speak"
msgstr "Показывать слова на панели микрофона, пока вы говорите"

#: src/anduinos_whisper_gtk/app.py:179
msgid "Final result preview"
msgstr "Предпросмотр итогового результата"

#: src/anduinos_whisper_gtk/app.py:180
msgid "Pause briefly before inserting the completed phrase"
msgstr "Краткая пауза перед вставкой готовой фразы"

#: src/anduinos_whisper_gtk/app.py:184
msgid "Start and stop sounds"
msgstr "Звуковые сигналы запуска и остановки"

#: src/anduinos_whisper_gtk/app.py:185
msgid "Play a subtle microphone cue"
msgstr "Воспроизводить тихий звуковой сигнал состояния микрофона"

#: src/anduinos_whisper_gtk/app.py:195
msgid "Models"
msgstr "Модели"

#: src/anduinos_whisper_gtk/app.py:198
msgid "Offline speech models"
msgstr "Автономные модели распознавания речи"

#: src/anduinos_whisper_gtk/app.py:200
msgid ""
"The Base multilingual model is installed with Voice Typing. Optional models "
"are verified before use."
msgstr ""
"Многоязычная модель Base устанавливается вместе с голосовым вводом. "
"Дополнительные модели проверяются перед использованием."

#: src/anduinos_whisper_gtk/app.py:213
msgid "Remove downloaded model"
msgstr "Удалить скачанную модель"

#: src/anduinos_whisper_gtk/app.py:216
#, python-format
msgid "Remove %s"
msgstr "Удалить %s"

#: src/anduinos_whisper_gtk/app.py:230
msgid "Microphone Training"
msgstr "Калибровка микрофона"

#: src/anduinos_whisper_gtk/app.py:234
msgid "Calibrate your speaking setup"
msgstr "Калибровка условий диктовки"

#: src/anduinos_whisper_gtk/app.py:236
msgid ""
"Whisper does not need a personal voice profile. Use this page to check "
"microphone level, distance, and background noise."
msgstr ""
"Whisper не требует создания личного голосового профиля. Используйте эту "
"страницу, чтобы проверить уровень микрофона, расстояние и фоновый шум."

#: src/anduinos_whisper_gtk/app.py:242
msgid "Practice phrase"
msgstr "Фраза для тренировки"

#: src/anduinos_whisper_gtk/app.py:243
msgid "“Voice typing makes writing faster and more accessible.”"
msgstr "«Голосовой ввод делает написание текста быстрее и доступнее»."

#: src/anduinos_whisper_gtk/app.py:249
msgid "Input level"
msgstr "Уровень входного сигнала"

#: src/anduinos_whisper_gtk/app.py:250
msgid "Speak normally; aim for the middle of the meter"
msgstr ""
"Говорите в обычном темпе; старайтесь держать уровень входного сигнала в "
"середине шкалы"

#: src/anduinos_whisper_gtk/app.py:254
msgid "Microphone input level"
msgstr "Уровень входного сигнала микрофона"

#: src/anduinos_whisper_gtk/app.py:260
msgid "Microphone test"
msgstr "Тест микрофона"

#: src/anduinos_whisper_gtk/app.py:261
msgid "No audio is saved during this test"
msgstr "Аудиозапись не сохраняется во время этого теста"

#: src/anduinos_whisper_gtk/app.py:263 src/anduinos_whisper_gtk/app.py:559
msgid "Start Test"
msgstr "Начать тест"

#: src/anduinos_whisper_gtk/app.py:268
msgid "Tips for better recognition"
msgstr "Советы по улучшению распознавания"

#: src/anduinos_whisper_gtk/app.py:271
msgid "Speak naturally"
msgstr "Говорите естественно"

#: src/anduinos_whisper_gtk/app.py:272
msgid "Use short phrases and pause briefly between sentences"
msgstr ""
"Используйте короткие фразы и делайте краткие паузы между предложениями"

#: src/anduinos_whisper_gtk/app.py:276
msgid "Reduce background noise"
msgstr "Снизить фоновый шум"

#: src/anduinos_whisper_gtk/app.py:277
msgid "Keep the microphone close without speaking directly into it"
msgstr "Держите микрофон близко ко рту, но не говорите прямо в него"

#: src/anduinos_whisper_gtk/app.py:281
msgid "Choose the language"
msgstr "Выберите язык"

#: src/anduinos_whisper_gtk/app.py:282
msgid "A fixed language is faster than automatic detection"
msgstr ""
"Распознавание с заданным языком выполняется быстрее, чем с автоматическим "
"определением"

#: src/anduinos_whisper_gtk/app.py:305
msgid "Stop"
msgstr "Остановить"

#: src/anduinos_whisper_gtk/app.py:343
msgid "Set Keyboard Shortcut"
msgstr "Установить горячую клавишу"

#: src/anduinos_whisper_gtk/app.py:365
msgid "Press the new shortcut"
msgstr "Нажмите новую горячую клавишу"

#: src/anduinos_whisper_gtk/app.py:369
msgid "The keys you press will be used to start or stop Voice Typing."
msgstr ""
"Нажатые вами клавиши будут использоваться для запуска или остановки "
"голосового ввода."

#: src/anduinos_whisper_gtk/app.py:377
msgid "Waiting for input…"
msgstr "Ожидание нажатия клавиши…"

#: src/anduinos_whisper_gtk/app.py:383
msgid "Esc cancels · Backspace disables the shortcut"
msgstr "Esc — отмена · Backspace — отключение горячей клавиши"

#: src/anduinos_whisper_gtk/app.py:445
#, python-format
msgid "Download %s from Hugging Face?"
msgstr "Скачать %s с Hugging Face?"

#: src/anduinos_whisper_gtk/app.py:447
msgid ""
"This optional model is hosted by Hugging Face, a third-party service. AnduinOS is not affiliated with, sponsored by, or partnered with Hugging Face.\n"
"\n"
"If you continue, your computer will connect directly to huggingface.co. Hugging Face will receive your public IP address and that address may reveal your approximate location.\n"
"\n"
"Privacy policy: https://huggingface.co/privacy"
msgstr ""
"Эта дополнительная модель размещается на Hugging Face, стороннем сервисе. AnduinOS не аффилирована с Hugging Face, не спонсируется им и не состоит с ним в партнёрских отношениях.\n"
"\n"
"Если вы продолжите, ваш компьютер установит прямое соединение с huggingface.co. Hugging Face получит ваш публичный IP-адрес, который может раскрыть ваше примерное местоположение.\n"
"\n"
"Политика конфиденциальности: https://huggingface.co/privacy"

