<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>AnduinOS</vendor>
  <vendor_url>https://www.anduinos.com</vendor_url>
  <action id="com.anduinos.SecureBootToolkit.manage">
    <description>Configure Secure Boot trust and repair DKMS signatures</description>
    <description xml:lang="zh_CN">配置安全启动信任并修复 DKMS 签名</description>
    <message>Authentication is required to configure Secure Boot trust</message>
    <message xml:lang="zh_CN">配置安全启动信任需要身份验证</message>
    <icon_name>security-high-symbolic</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/anduinos-secureboot-helper</annotate>
  </action>
</policyconfig>
