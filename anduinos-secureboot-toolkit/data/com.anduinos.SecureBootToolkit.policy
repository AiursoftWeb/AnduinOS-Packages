<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>AnduinOS</vendor>
  <vendor_url>https://www.anduinos.com</vendor_url>
  <action id="com.anduinos.SecureBootToolkit.manage">
    <description>Configure Secure Boot trust and repair DKMS signatures</description>
    <description xml:lang="ar_SA">تكوين الثقة في Secure Boot وإصلاح تواقيع DKMS</description>
    <description xml:lang="da_DK">Konfigurer Secure Boot-tillid og reparer DKMS-signaturer</description>
    <description xml:lang="de_DE">Secure Boot-Vertrauen konfigurieren und DKMS-Signaturen reparieren</description>
    <description xml:lang="el_GR">Διαμόρφωση εμπιστοσύνης Secure Boot και επισκευή υπογραφών DKMS</description>
    <description xml:lang="en_GB">Configure Secure Boot trust and repair DKMS signatures</description>
    <description xml:lang="es_ES">Configurar la confianza de Secure Boot y reparar las firmas de DKMS</description>
    <description xml:lang="fi_FI">Määritä Secure Boot -luottamus ja korjaa DKMS-allekirjoitukset</description>
    <description xml:lang="fr_FR">Configurer la confiance Secure Boot et réparer les signatures DKMS</description>
    <description xml:lang="hi_IN">Secure Boot विश्वास कॉन्फ़िगर करें और DKMS हस्ताक्षरों की मरम्मत करें</description>
    <description xml:lang="id_ID">Konfigurasikan kepercayaan Secure Boot dan perbaiki tanda tangan DKMS</description>
    <description xml:lang="it_IT">Configura l'attendibilità di Secure Boot e ripara le firme DKMS</description>
    <description xml:lang="ja_JP">Secure Boot の信頼を設定し、DKMS 署名を修復する</description>
    <description xml:lang="ko_KR">Secure Boot 신뢰 구성 및 DKMS 서명 복구</description>
    <description xml:lang="nl_NL">Secure Boot-vertrouwen configureren en DKMS-handtekeningen repareren</description>
    <description xml:lang="pl_PL">Skonfiguruj zaufanie Secure Boot i napraw podpisy DKMS</description>
    <description xml:lang="pt_BR">Configurar a confiança do Secure Boot e reparar as assinaturas DKMS</description>
    <description xml:lang="pt_PT">Configurar a confiança do Secure Boot e reparar as assinaturas DKMS</description>
    <description xml:lang="ro_RO">Configurează încrederea Secure Boot și repară semnăturile DKMS</description>
    <description xml:lang="ru_RU">Настройка доверия Secure Boot и восстановление сигнатур DKMS</description>
    <description xml:lang="sv_SE">Konfigurera Secure Boot-förtroende och reparera DKMS-signaturer</description>
    <description xml:lang="th_TH">กำหนดค่าความไว้วางใจของ Secure Boot และซ่อมแซมลายเซ็น DKMS</description>
    <description xml:lang="tr_TR">Güvenli Önyükleme güvenini yapılandırın ve DKMS imzalarını onarın</description>
    <description xml:lang="uk_UA">Налаштування довіри Secure Boot та відновлення підписів DKMS</description>
    <description xml:lang="vi_VN">Cấu hình độ tin cậy của Secure Boot và sửa chữa chữ ký DKMS</description>
    <description xml:lang="zh_HK">設定 Secure Boot 信任並修復 DKMS 簽名</description>
    <description xml:lang="zh_TW">設定 Secure Boot 信任並修復 DKMS 簽章</description>
    <description xml:lang="zh_CN">配置安全启动信任并修复 DKMS 签名</description>
    <message>Authentication is required to configure Secure Boot trust</message>
    <message xml:lang="ar_SA">المصادقة مطلوبة لتكوين الثقة في Secure Boot</message>
    <message xml:lang="da_DK">Godkendelse er påkrævet for at konfigurere Secure Boot-tillid</message>
    <message xml:lang="de_DE">Authentifizierung ist erforderlich, um das Secure Boot-Vertrauen zu konfigurieren</message>
    <message xml:lang="el_GR">Απαιτείται έλεγχος ταυτότητας για τη διαμόρφωση της εμπιστοσύνης Secure Boot</message>
    <message xml:lang="en_GB">Authentication is required to configure Secure Boot trust</message>
    <message xml:lang="es_ES">Se requiere autenticación para configurar la confianza de Secure Boot</message>
    <message xml:lang="fi_FI">Secure Boot -luottamuksen määrittäminen vaatii todennuksen</message>
    <message xml:lang="fr_FR">L'authentification est requise pour configurer la confiance Secure Boot</message>
    <message xml:lang="hi_IN">Secure Boot ट्रस्ट कॉन्फ़िगर करने के लिए प्रमाणीकरण आवश्यक है</message>
    <message xml:lang="id_ID">Otentikasi diperlukan untuk mengonfigurasi kepercayaan Secure Boot</message>
    <message xml:lang="it_IT">È richiesta l'autenticazione per configurare l'attendibilità di Secure Boot</message>
    <message xml:lang="ja_JP">Secure Boot の信頼を設定するには認証が必要です</message>
    <message xml:lang="ko_KR">Secure Boot 신뢰를 구성하려면 인증이 필요합니다</message>
    <message xml:lang="nl_NL">Authenticatie is vereist om Secure Boot-vertrouwen te configureren</message>
    <message xml:lang="pl_PL">Wymagane jest uwierzytelnienie, aby skonfigurować zaufanie Secure Boot</message>
    <message xml:lang="pt_BR">É necessária autenticação para configurar a confiança do Secure Boot</message>
    <message xml:lang="pt_PT">É necessária autenticação para configurar a confiança do Secure Boot</message>
    <message xml:lang="ro_RO">Este necesară autentificarea pentru a configura încrederea Secure Boot</message>
    <message xml:lang="ru_RU">Требуется аутентификация для настройки доверия Secure Boot</message>
    <message xml:lang="sv_SE">Autentisering krävs för att konfigurera Secure Boot-förtroende</message>
    <message xml:lang="th_TH">จำเป็นต้องมีการตรวจสอบสิทธิ์เพื่อกำหนดค่าความไว้วางใจของ Secure Boot</message>
    <message xml:lang="tr_TR">Güvenli Önyükleme güvenini yapılandırmak için kimlik doğrulaması gereklidir</message>
    <message xml:lang="uk_UA">Потрібна автентифікація для налаштування довіри Secure Boot</message>
    <message xml:lang="vi_VN">Yêu cầu xác thực để cấu hình độ tin cậy của Secure Boot</message>
    <message xml:lang="zh_HK">設定 Secure Boot 信任需要身分驗證</message>
    <message xml:lang="zh_TW">設定 Secure Boot 信任需要身分驗證</message>
    <message xml:lang="zh_CN">配置安全启动信任需要身份验证</message>
    <icon_name>security-high-symbolic</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/anduinos-secureboot-helper</annotate>
  </action>
</policyconfig>
