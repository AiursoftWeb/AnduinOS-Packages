<Project Sdk="Aiursoft.Apkg.Sdk">
  <PropertyGroup>
    <PackageName>anduinos-secureboot-toolkit</PackageName>
    <PackageVersion>1.0.0-6+$(SuiteShortName)</PackageVersion>
    <Maintainer>AnduinOS Team &lt;anduin@aiursoft.com&gt;</Maintainer>
    <PackageDescription>Shared Secure Boot, MOK, and DKMS signing toolkit for AnduinOS applications</PackageDescription>
    <Section>admin</Section>
    <PackageHomepage>https://www.anduinos.com</PackageHomepage>
    <RepositoryUrl>https://github.com/AiursoftWeb/AnduinOS-Packages</RepositoryUrl>
    <LicenseType>GPL-3.0</LicenseType>
    <TargetDistro>anduinos</TargetDistro>
    <TargetSuites>noble-addon resolute-addon</TargetSuites>
    <TargetArchitectures>all</TargetArchitectures>
    <Component>main</Component>
    <SuiteShortNameMap>noble-addon=noble resolute-addon=resolute</SuiteShortNameMap>
  </PropertyGroup>

  <ItemGroup>
    <DependencyCheckSource Url="https://mirror.aiursoft.com/ubuntu" SuiteMap="noble-addon=noble resolute-addon=resolute" />
  </ItemGroup>

  <ItemGroup>
    <Dependency Include="python3" />
    <Dependency Include="python3-gi" />
    <Dependency Include="gir1.2-gtk-4.0" />
    <Dependency Include="gir1.2-adw-1" />
    <Dependency Include="mokutil" />
    <Dependency Include="openssl" />
    <Dependency Include="shim-signed" />
    <Dependency Include="kmod" />
    <Dependency Include="dkms" />
    <Dependency Include="pkexec" />
  </ItemGroup>

  <ItemGroup>
    <IncludeFile Include="src/anduinos_secureboot/__init__.py" Target="/usr/lib/python3/dist-packages/anduinos_secureboot/__init__.py" />
    <IncludeFile Include="src/anduinos_secureboot/client.py" Target="/usr/lib/python3/dist-packages/anduinos_secureboot/client.py" />
    <IncludeFile Include="src/anduinos_secureboot/inspect.py" Target="/usr/lib/python3/dist-packages/anduinos_secureboot/inspect.py" />
    <IncludeFile Include="src/anduinos_secureboot/model.py" Target="/usr/lib/python3/dist-packages/anduinos_secureboot/model.py" />
    <IncludeFile Include="src/anduinos_secureboot/operations.py" Target="/usr/lib/python3/dist-packages/anduinos_secureboot/operations.py" />
    <IncludeFile Include="src/anduinos_secureboot/ui.py" Target="/usr/lib/python3/dist-packages/anduinos_secureboot/ui.py" />
    <IncludeScript Include="scripts/anduinos-secureboot-helper" Target="/usr/libexec/anduinos-secureboot-helper" />
    <IncludeScript Include="scripts/anduinos-securebootctl" Target="/usr/bin/anduinos-securebootctl" />
    <IncludeFile Include="data/com.anduinos.SecureBootToolkit.policy" Target="/usr/share/polkit-1/actions/com.anduinos.SecureBootToolkit.policy" />
    <IncludeFile Include="README.md" Target="/usr/share/doc/anduinos-secureboot-toolkit/README.md" />
  </ItemGroup>

  <ItemGroup>
    <PrebuildCommand Run="PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s tests -v" />
  </ItemGroup>
</Project>
