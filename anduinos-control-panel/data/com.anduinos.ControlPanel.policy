<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>AnduinOS</vendor>
  <vendor_url>https://www.anduinos.com</vendor_url>
  <action id="com.anduinos.ControlPanel.manage-boot-settings">
    <description>Change boot menu settings</description>
    <description xml:lang="ar_SA">تغيير إعدادات قائمة الإقلاع</description>
    <description xml:lang="da_DK">Ændre bootmenuindstillingerne</description>
    <description xml:lang="de_DE">Boot-Menü-Einstellungen ändern</description>
    <description xml:lang="el_GR">Αλλαγή ρυθμίσεων μενού εκκίνησης</description>
    <description xml:lang="en_GB">Change boot menu settings</description>
    <description xml:lang="es_ES">Cambiar la configuración del menú de arranque</description>
    <description xml:lang="fi_FI">Muuta käynnistysvalikon asetuksia</description>
    <description xml:lang="fr_FR">Modifier les paramètres du menu de démarrage</description>
    <description xml:lang="hi_IN">बूट मेनू सेटिंग्स बदलें</description>
    <description xml:lang="id_ID">Ubah pengaturan menu boot</description>
    <description xml:lang="it_IT">Modifica le impostazioni del menu di avvio</description>
    <description xml:lang="ja_JP">ブートメニュー設定を変更</description>
    <description xml:lang="ko_KR">부팅 메뉴 설정 변경</description>
    <description xml:lang="nl_NL">Opstartmenu-instellingen wijzigen</description>
    <description xml:lang="pl_PL">Zmiana ustawień menu rozruchu</description>
    <description xml:lang="pt_BR">Alterar as configurações do menu de inicialização</description>
    <description xml:lang="pt_PT">Alterar as definições do menu de arranque</description>
    <description xml:lang="ro_RO">Modifică setările meniului de pornire</description>
    <description xml:lang="ru_RU">Изменить настройки меню загрузки</description>
    <description xml:lang="sv_SE">Ändra startmenyinställningar</description>
    <description xml:lang="th_TH">เปลี่ยนการตั้งค่าเมนูการบูต</description>
    <description xml:lang="tr_TR">Önyükleme menüsü ayarlarını değiştir</description>
    <description xml:lang="uk_UA">Змінити налаштування меню завантаження</description>
    <description xml:lang="vi_VN">Thay đổi cài đặt menu khởi động</description>
    <description xml:lang="zh_HK">更改開機選單設定</description>
    <description xml:lang="zh_TW">變更開機選單設定</description>
    <description xml:lang="zh_CN">更改启动菜单设置</description>
    <message>Authentication is required to change boot menu settings</message>
    <message xml:lang="ar_SA">يتطلب تغيير إعدادات قائمة الإقلاع المصادقة</message>
    <message xml:lang="da_DK">Autentificering kræves for at ændre bootmenuindstillingerne</message>
    <message xml:lang="de_DE">Zur Änderung der Boot-Menü-Einstellungen ist eine Authentifizierung erforderlich.</message>
    <message xml:lang="el_GR">Απαιτείται έλεγχος ταυτότητας για την αλλαγή των ρυθμίσεων του μενού εκκίνησης</message>
    <message xml:lang="en_GB">Authentication is required to change boot menu settings</message>
    <message xml:lang="es_ES">Se requiere autenticación para cambiar la configuración del menú de arranque</message>
    <message xml:lang="fi_FI">Käynnistysvalikon asetuksia ei voi muuttaa ilman todennusta.</message>
    <message xml:lang="fr_FR">L’authentification est requise pour modifier les paramètres du menu de démarrage</message>
    <message xml:lang="hi_IN">बूट मेनू सेटिंग्स बदलने के लिए प्रमाणीकरण आवश्यक है</message>
    <message xml:lang="id_ID">Otentikasi diperlukan untuk mengubah pengaturan menu boot</message>
    <message xml:lang="it_IT">L'autenticazione è richiesta per modificare le impostazioni del menu di avvio</message>
    <message xml:lang="ja_JP">ブートメニュー設定を変更するには認証が必要です</message>
    <message xml:lang="ko_KR">부팅 메뉴 설정을 변경하려면 인증이 필요합니다</message>
    <message xml:lang="nl_NL">Authenticatie is vereist om de opstartmenu-instellingen te wijzigen</message>
    <message xml:lang="pl_PL">Wymagane jest uwierzytelnienie, aby zmienić ustawienia menu rozruchu</message>
    <message xml:lang="pt_BR">É necessária autenticação para alterar as configurações do menu de inicialização</message>
    <message xml:lang="pt_PT">É necessária autenticação para alterar as definições do menu de arranque</message>
    <message xml:lang="ro_RO">Autentificarea este necesară pentru a modifica setările meniului de pornire.</message>
    <message xml:lang="ru_RU">Для изменения настроек меню загрузки требуется аутентификация</message>
    <message xml:lang="sv_SE">Autentisering krävs för att ändra startmenyinställningar</message>
    <message xml:lang="th_TH">จำเป็นต้องมีการตรวจสอบสิทธิ์เพื่อเปลี่ยนการตั้งค่าเมนูการบูต</message>
    <message xml:lang="tr_TR">Önyükleme menüsü ayarlarını değiştirmek için kimlik doğrulaması gerekir</message>
    <message xml:lang="uk_UA">Для зміни налаштувань меню завантаження потрібна автентифікація</message>
    <message xml:lang="vi_VN">Yêu cầu xác thực để thay đổi cài đặt menu khởi động</message>
    <message xml:lang="zh_HK">更改開機選單設定需要身份驗證</message>
    <message xml:lang="zh_TW">變更開機選單設定需要身分驗證</message>
    <message xml:lang="zh_CN">更改启动菜单设置需要身份验证</message>
    <icon_name>com.anduinos.ControlPanel</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/anduinos-control-panel/boot-settings-helper</annotate>
  </action>
</policyconfig>
