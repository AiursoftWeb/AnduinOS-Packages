msgstr "✓ การติดตั้งเสร็จสิ้นเรียบร้อยแล้ว"

#: src/anduinos_control_panel/app.py:1117
msgid "Open Bottles"
msgstr "เปิด Bottles"

#: src/anduinos_control_panel/app.py:1122
msgid "Bottles installed"
msgstr "ติดตั้ง Bottles แล้ว"

