#: src/anduinos_control_panel/app.py:1185
#: src/anduinos_control_panel/app.py:1371
msgid "Installing…"
msgstr "กำลังติดตั้ง…"

#: src/anduinos_control_panel/app.py:980
msgid "Downloading and installing Bottles… This may take a few minutes."
msgstr "กำลังดาวน์โหลดและติดตั้ง Bottles… อาจใช้เวลาหลายนาที"

#: src/anduinos_control_panel/app.py:985
msgid "Preparing Flathub and Bottles installation…"
msgstr "กำลังเตรียมการติดตั้ง Flathub และ Bottles…"

#: src/anduinos_control_panel/app.py:999
msgid "✓ Bottles is ready."
msgstr "✓ Bottles พร้อมใช้งานแล้ว"

#: src/anduinos_control_panel/app.py:1003
#: src/anduinos_control_panel/app.py:1210
#: src/anduinos_control_panel/app.py:1398
#: src/anduinos_control_panel/app.py:1619
msgid "✓ Installation completed successfully."
msgstr "✓ การติดตั้งเสร็จสิ้นเรียบร้อยแล้ว"

#: src/anduinos_control_panel/app.py:1005
msgid "Open Bottles"
msgstr "เปิด Bottles"

#: src/anduinos_control_panel/app.py:1010
msgid "Bottles installed"
msgstr "ติดตั้ง Bottles แล้ว"

#: src/anduinos_control_panel/app.py:1016
#: src/anduinos_control_panel/app.py:1223
#: src/anduinos_control_panel/app.py:1442
msgid "✗ Installation failed. Review Advanced Output."
msgstr "✗ การติดตั้งล้มเหลว กรุณาตรวจสอบผลลัพธ์ขั้นสูง"

#: src/anduinos_control_panel/app.py:1021
#: src/anduinos_control_panel/app.py:1228
#: src/anduinos_control_panel/app.py:1447
#: src/anduinos_control_panel/app.py:1642
msgid "✗ Operation failed: "
msgstr "✗ การดำเนินการล้มเหลว: "

