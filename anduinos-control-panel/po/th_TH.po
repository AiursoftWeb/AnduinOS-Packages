msgstr "กำลังเตรียมการติดตั้ง Flathub และ Bottles…"

#: src/anduinos_control_panel/app.py:1111
msgid "✓ Bottles is ready."
msgstr "✓ Bottles พร้อมใช้งานแล้ว"

#: src/anduinos_control_panel/app.py:1115
#: src/anduinos_control_panel/app.py:1322
#: src/anduinos_control_panel/app.py:1510
