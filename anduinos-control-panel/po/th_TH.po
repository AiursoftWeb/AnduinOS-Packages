#: src/anduinos_control_panel/app.py:1230
#: src/anduinos_control_panel/app.py:1449
#: src/anduinos_control_panel/app.py:1644
msgid "Retry"
msgstr "ลองใหม่"

#: src/anduinos_control_panel/app.py:1053
msgid "Deja Dup Backups"
msgstr "การสำรองข้อมูลด้วย Deja Dup"

#: src/anduinos_control_panel/app.py:1067
msgid "Permission Settings"
msgstr "การตั้งค่าสิทธิ์"

#: src/anduinos_control_panel/app.py:1085
msgid "Flatseal"
msgstr "Flatseal"

#: src/anduinos_control_panel/app.py:1087
msgid ""
"Review and control what files, devices, network connections, and services "
"Flatpak applications can access."
msgstr ""
"ตรวจสอบและควบคุมว่าแอปพลิเคชัน Flatpak สามารถเข้าถึงไฟล์ อุปกรณ์ "
"การเชื่อมต่อเครือข่าย และบริการใดได้บ้าง"

#: src/anduinos_control_panel/app.py:1092
msgid "Install Flatseal"
msgstr "ติดตั้ง Flatseal"

#: src/anduinos_control_panel/app.py:1094
msgid "Administrator authentication is required when installation starts"
msgstr "จำเป็นต้องมีการตรวจสอบสิทธิ์ผู้ดูแลระบบเมื่อเริ่มการติดตั้ง"

#: src/anduinos_control_panel/app.py:1186
msgid "Downloading and installing Flatseal…"
msgstr "กำลังดาวน์โหลดและติดตั้ง Flatseal…"

#: src/anduinos_control_panel/app.py:1191
msgid "Preparing Flatseal installation…"
msgstr "กำลังเตรียมการติดตั้ง Flatseal…"

#: src/anduinos_control_panel/app.py:1206
msgid "✓ Flatseal is ready."
msgstr "✓ Flatseal พร้อมใช้งานแล้ว"

#: src/anduinos_control_panel/app.py:1212
msgid "Open Flatseal"
msgstr "เปิด Flatseal"

#: src/anduinos_control_panel/app.py:1217
msgid "Flatseal installed"
msgstr "ติดตั้ง Flatseal แล้ว"

#: src/anduinos_control_panel/app.py:1249
msgid "Install Voice Typing"
msgstr "ติดตั้งการพิมพ์ด้วยเสียง"

#: src/anduinos_control_panel/app.py:1267
msgid "Offline Voice Typing"
msgstr "การพิมพ์ด้วยเสียงแบบออฟไลน์"

#: src/anduinos_control_panel/app.py:1269
msgid ""
"Press Super + H to dictate into browsers, editors, messages, terminals, and "
"other applications. Audio stays on this computer."
msgstr ""
"กด Super + H เพื่อพิมพ์ด้วยเสียงในเบราว์เซอร์ โปรแกรมแก้ไข ข้อความ "
"เทอร์มินัล และแอปพลิเคชันอื่น ๆ เสียงจะอยู่บนคอมพิวเตอร์เครื่องนี้เท่านั้น"

#: src/anduinos_control_panel/app.py:1274
msgid "Private by default"
msgstr "เป็นส่วนตัวโดยค่าเริ่มต้น"

#: src/anduinos_control_panel/app.py:1275
msgid "Speech is recognized locally with whisper.cpp"
msgstr "การจดจำเสียงพูดดำเนินการบนคอมพิวเตอร์เครื่องนี้ด้วย whisper.cpp"

#: src/anduinos_control_panel/app.py:1280
msgid "About 140 MB to download"
msgstr "ต้องดาวน์โหลดประมาณ 140 MB"

#: src/anduinos_control_panel/app.py:1282
msgid ""
"Includes the multilingual Base model; optional models are available later"
msgstr "รวมโมเดล Base ที่รองรับหลายภาษา; โมเดลทางเลือกจะพร้อมใช้งานในภายหลัง"

#: src/anduinos_control_panel/app.py:1291
msgid "Administrator authentication is required when installation starts."
msgstr "จำเป็นต้องมีการตรวจสอบสิทธิ์ผู้ดูแลระบบเมื่อเริ่มการติดตั้ง"

#: src/anduinos_control_panel/app.py:1376
msgid "Downloading the local engine and multilingual speech model…"
msgstr "กำลังดาวน์โหลดเอนจินภายในเครื่องและโมเดลเสียงที่รองรับหลายภาษา…"

#: src/anduinos_control_panel/app.py:1382
msgid "Preparing Voice Typing installation…"
msgstr "กำลังเตรียมการติดตั้งการพิมพ์ด้วยเสียง…"

#: src/anduinos_control_panel/app.py:1425
msgid ""
"✓ Installed. Sign out and back in once, then press Super + H to start Voice "
"Typing."
msgstr ""
"✓ ติดตั้งแล้ว กรุณาออกจากระบบและเข้าสู่ระบบอีกครั้งหนึ่ง จากนั้นกด Super + H"
" เพื่อเริ่มการพิมพ์ด้วยเสียง"

#: src/anduinos_control_panel/app.py:1429
msgid "Open Settings"
msgstr "เปิดการตั้งค่า"

#: src/anduinos_control_panel/app.py:1435
msgid "Voice Typing installed — sign out to finish"
msgstr "ติดตั้งการพิมพ์ด้วยเสียงแล้ว — ออกจากระบบเพื่อเสร็จสิ้น"

#: src/anduinos_control_panel/app.py:1466
msgid "On-device AI"
msgstr "AI บนอุปกรณ์"

#: src/anduinos_control_panel/app.py:1484
msgid "Why AI"
msgstr "Why AI"

#: src/anduinos_control_panel/app.py:1486
msgid ""
"Run the Why AI assistant locally. The model and runtime are installed only "
"when this option is enabled."
msgstr ""
"เรียกใช้ผู้ช่วย Why AI บนคอมพิวเตอร์เครื่องนี้ "
"โมเดลและรันไทม์จะได้รับการติดตั้งเฉพาะเมื่อเปิดใช้งานตัวเลือกนี้เท่านั้น"

#: src/anduinos_control_panel/app.py:1491
msgid "Install on-device AI"
msgstr "ติดตั้ง AI บนอุปกรณ์"

#: src/anduinos_control_panel/app.py:1492
msgid "Enable the local Why AI stack on this computer"
msgstr "เปิดใช้งานชุดซอฟต์แวร์ Why AI ภายในเครื่องบนคอมพิวเตอร์เครื่องนี้"

#: src/anduinos_control_panel/app.py:1586
msgid "Applying…"
msgstr "กำลังนำไปใช้…"

#: src/anduinos_control_panel/app.py:1588
msgid "Downloading and installing Why AI… This may take about 10 minutes."
msgstr "กำลังดาวน์โหลดและติดตั้ง Why AI… อาจใช้เวลาประมาณ 10 นาที"

#: src/anduinos_control_panel/app.py:1590
msgid "Disabling the local Why AI stack…"
msgstr "กำลังปิดใช้งานชุดซอฟต์แวร์ Why AI ภายในเครื่อง…"

#: src/anduinos_control_panel/app.py:1597
msgid "Preparing package operation…"
msgstr "กำลังเตรียมการดำเนินการกับแพ็กเกจ…"

#: src/anduinos_control_panel/app.py:1611
msgid "✓ On-device AI is ready."
msgstr "✓ AI บนอุปกรณ์พร้อมใช้งานแล้ว"

#: src/anduinos_control_panel/app.py:1613
msgid "✓ On-device AI is disabled."
msgstr "✓ ปิดใช้งาน AI บนอุปกรณ์แล้ว"

#: src/anduinos_control_panel/app.py:1619
msgid "✓ Change completed successfully."
msgstr "✓ การเปลี่ยนแปลงเสร็จสิ้นเรียบร้อยแล้ว"

#: src/anduinos_control_panel/app.py:1628
msgid "On-device AI enabled"
msgstr "เปิดใช้งาน AI บนอุปกรณ์แล้ว"

#: src/anduinos_control_panel/app.py:1630
msgid "On-device AI disabled"
msgstr "ปิดใช้งาน AI บนอุปกรณ์แล้ว"

#: src/anduinos_control_panel/app.py:1638
msgid "✗ Package operation failed. Review Advanced Output."
msgstr "✗ การดำเนินการกับแพ็กเกจล้มเหลว กรุณาตรวจสอบผลลัพธ์ขั้นสูง"

#: src/anduinos_control_panel/app.py:1715
