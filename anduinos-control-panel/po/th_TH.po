msgid "Open Deja Dup backups"
msgstr "เปิดการสำรองข้อมูลด้วย Deja Dup"

#: src/anduinos_control_panel/app.py:373
msgid "Install Deja Dup from the app store"
msgstr "ติดตั้ง Deja Dup จากร้านค้าแอป"

#: src/anduinos_control_panel/app.py:384 src/anduinos_control_panel/app.py:398
