#: src/anduinos_control_panel/app.py:1628
msgid "On-device AI enabled"
msgstr "Cihaz üzerinde çalışan yapay zekâ etkinleştirildi"

#: src/anduinos_control_panel/app.py:1630
msgid "On-device AI disabled"
msgstr "Cihaz üzerinde çalışan yapay zekâ devre dışı bırakıldı"

