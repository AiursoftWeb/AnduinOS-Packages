#: src/anduinos_control_panel/prediction_settings.py:25
#: src/anduinos_control_panel/prediction_settings.py:41
#: src/anduinos_control_panel/topics.py:181
msgid "Bash Command Predictions"
msgstr "Bash Komut Tahminleri"

#: src/anduinos_control_panel/prediction_settings.py:42
msgid ""
"Predict commands locally from your history and current context. No model "
"download or on-device LLM is needed."
msgstr ""
"Geçmişinizden ve mevcut bağlamdan yerel olarak komut tahmin eder. Model "
"indirme veya cihazda LLM gerekmez."

#: src/anduinos_control_panel/prediction_settings.py:45
msgid "Configure your preferences below, then install to use predictions."
msgstr ""
"Aşağıda tercihlerinizi yapılandırın, ardından tahminleri kullanmak için "
"yükleyin."

#: src/anduinos_control_panel/prediction_settings.py:52
msgid ""
"Changes take effect in newly opened Bash terminals. Saved settings override "
"legacy environment variables."
msgstr ""
"Değişiklikler yeni açılan Bash terminallerinde uygulanır. Kaydedilen ayarlar "
"eski ortam değişkenlerinin önüne geçer."

#: src/anduinos_control_panel/prediction_settings.py:55
msgid "Enable command predictions"
msgstr "Komut tahminlerini etkinleştir"

#: src/anduinos_control_panel/prediction_settings.py:55
msgid "Show suggestions while typing in Bash."
msgstr "Bash içinde yazarken önerileri göster."

#: src/anduinos_control_panel/prediction_settings.py:56
msgid "Learn from command history"
msgstr "Komut geçmişinden öğren"

#: src/anduinos_control_panel/prediction_settings.py:56
msgid ""
"Use Bash history, frequency, directories, and command sequences to "
"personalize suggestions."
msgstr ""
"Bash geçmişi, sıklık, dizinler ve komut sıralarıyla önerileri kişiselleştir."

#: src/anduinos_control_panel/prediction_settings.py:57
msgid "Remember my usage habits"
msgstr "Kullanım alışkanlıklarımı hatırla"

#: src/anduinos_control_panel/prediction_settings.py:57
msgid ""
"Save learned usage habits on this computer for predictions after closing the "
"terminal. When off, Bash command history is still used."
msgstr ""
"Terminal kapatıldıktan sonra tahminlerde kullanmak için öğrenilen "
"alışkanlıkları bu bilgisayara kaydet. Kapalıyken Bash komut geçmişi yine "
"kullanılır."

#: src/anduinos_control_panel/prediction_settings.py:67
msgid "Clear saved learning"
msgstr "Kaydedilen öğrenmeyi temizle"

#: src/anduinos_control_panel/prediction_settings.py:68
msgid ""
"Keeps Bash history and your settings. Reopen existing terminals to discard "
"their in-memory learning."
msgstr ""
"Bash geçmişini ve ayarlarınızı korur. Bellekteki öğrenmeyi atmak için mevcut "
"terminalleri yeniden açın."

#: src/anduinos_control_panel/prediction_settings.py:69
#: src/anduinos_control_panel/prediction_settings.py:143
msgid "Clear"
msgstr "Temizle"

#: src/anduinos_control_panel/prediction_settings.py:73
msgid "Restore default settings"
msgstr "Varsayılan ayarları geri yükle"

#: src/anduinos_control_panel/prediction_settings.py:73
msgid "Does not delete learned data."
msgstr "Öğrenilen verileri silmez."

#: src/anduinos_control_panel/prediction_settings.py:74
msgid "Restore Defaults"
msgstr "Varsayılanları Geri Yükle"

#: src/anduinos_control_panel/prediction_settings.py:78
msgid ""
"At the end of a line, press Right Arrow or End to accept a suggestion. Press "
"Enter to run the command."
msgstr ""
"Satır sonunda öneriyi kabul etmek için Sağ Ok veya End tuşuna basın. Komutu "
"çalıştırmak için Enter tuşuna basın."

#: src/anduinos_control_panel/prediction_settings.py:119
#, python-brace-format
msgid "Could not update prediction settings: {error}"
msgstr "Tahmin ayarları güncellenemedi: {error}"

#: src/anduinos_control_panel/prediction_settings.py:134
msgid "Default settings restored. Reopen Bash terminals to apply them."
msgstr ""
"Varsayılan ayarlar geri yüklendi. Uygulamak için Bash terminallerini yeniden "
"açın."

#: src/anduinos_control_panel/prediction_settings.py:140
msgid "Clear saved learning?"
msgstr "Kaydedilen öğrenme temizlensin mi?"

#: src/anduinos_control_panel/prediction_settings.py:141
msgid "Only prediction learning is removed. Your Bash command history is kept."
msgstr "Yalnızca tahmin öğrenmesi kaldırılır. Bash komut geçmişiniz korunur."

#: src/anduinos_control_panel/prediction_settings.py:166
msgid ""
"Saved learning cleared. Older terminals cannot save it again; reopen them to "
"resume learning persistence."
msgstr ""
"Kaydedilen öğrenme temizlendi. Eski terminaller bunu tekrar kaydedemez; "
"kaydetmeye devam etmek için yeniden açın."

#: src/anduinos_control_panel/prediction_settings.py:185
msgid "Installation complete. Open a new Bash terminal to use predictions."
msgstr ""
"Kurulum tamamlandı. Tahminleri kullanmak için yeni bir Bash terminali açın."

#: src/anduinos_control_panel/prediction_settings.py:185
msgid "Package installation could not be confirmed. Please retry."
msgstr "Paket kurulumu doğrulanamadı. Yeniden deneyin."

#: src/anduinos_control_panel/prediction_settings.py:190
#, python-brace-format
msgid "Installation failed: {error}"
msgstr "Kurulum başarısız: {error}"

