msgid "Enable the local Why AI stack on this computer"
msgstr "Bu bilgisayarda yerel Why AI yığınını etkinleştirin"

#: src/anduinos_control_panel/app.py:1753
msgid "Applying…"
msgstr "Uygulanıyor…"

#: src/anduinos_control_panel/app.py:1755
msgid "Downloading and installing Why AI… This may take about 10 minutes."
msgstr ""
"Why AI indiriliyor ve kuruluyor… Bu işlem yaklaşık 10 dakika sürebilir."

#: src/anduinos_control_panel/app.py:1757
msgid "Disabling the local Why AI stack…"
msgstr "Yerel Why AI yığını devre dışı bırakılıyor…"

#: src/anduinos_control_panel/app.py:1764
msgid "Preparing package operation…"
msgstr "Paket işlemi hazırlanıyor…"

#: src/anduinos_control_panel/app.py:1778
msgid "✓ On-device AI is ready."
msgstr "✓ Cihaz üzerinde çalışan yapay zekâ hazır."

#: src/anduinos_control_panel/app.py:1780
msgid "✓ On-device AI is disabled."
msgstr "✓ Cihaz üzerinde çalışan yapay zekâ devre dışı bırakıldı."

#: src/anduinos_control_panel/app.py:1786
msgid "✓ Change completed successfully."
msgstr "✓ Değişiklik başarıyla tamamlandı."

