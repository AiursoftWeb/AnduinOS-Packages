msgstr "Không thể cài đặt thành phần được khuyến nghị."

#: src/anduinos_control_panel/app.py:588
msgid "Installation failed"
msgstr "Cài đặt thất bại"

#: src/anduinos_control_panel/app.py:635
msgid "Startup and Boot"
msgstr "Khởi động"

#: src/anduinos_control_panel/app.py:653
msgid "Boot menu"
msgstr "Menu khởi động"

#: src/anduinos_control_panel/app.py:655
msgid ""
"Choose how long the boot menu waits before starting the default system."
msgstr ""
"Chọn thời gian chờ của menu khởi động trước khi khởi động hệ thống mặc định."

#: src/anduinos_control_panel/app.py:659
msgid "Boot menu wait time"
msgstr "Thời gian chờ menu khởi động"

#: src/anduinos_control_panel/app.py:661
msgid "The same delay is used after an interrupted or unsuccessful startup."
msgstr ""
"Thời gian chờ này cũng được áp dụng sau khi quá trình khởi động bị gián đoạn"
" hoặc không thành công."

#: src/anduinos_control_panel/app.py:668
#, python-format
msgid "%d seconds"
msgstr "%d giây"

#: src/anduinos_control_panel/app.py:676
msgid "Boot display"
msgstr "Hiển thị khởi động"

#: src/anduinos_control_panel/app.py:678
msgid "Choose the size of the GRUB menu and startup logo."
msgstr "Chọn kích thước của menu GRUB và logo khởi động."

#: src/anduinos_control_panel/app.py:682
msgid "Display mode"
msgstr "Chế độ hiển thị"

#: src/anduinos_control_panel/app.py:684
msgid "Native resolution shows more detail; large text is easier to read."
msgstr "Độ phân giải gốc hiển thị nhiều chi tiết hơn; chữ lớn dễ đọc hơn."

#: src/anduinos_control_panel/app.py:692
msgid "Native resolution"
msgstr "Độ phân giải gốc"

#: src/anduinos_control_panel/app.py:692
msgid "Large text mode"
msgstr "Chế độ chữ lớn"

#: src/anduinos_control_panel/app.py:714
#: src/anduinos_control_panel/app.py:1007
#: src/anduinos_control_panel/app.py:1214
#: src/anduinos_control_panel/app.py:1431
#: src/anduinos_control_panel/app.py:1623
msgid "Close"
msgstr "Đóng"

#: src/anduinos_control_panel/app.py:716
#: src/anduinos_control_panel/app.py:1540
#: src/anduinos_control_panel/app.py:1544
msgid "Apply"
msgstr "Áp dụng"

#: src/anduinos_control_panel/app.py:776
msgid "Updating the boot menu…"
msgstr "Đang cập nhật menu khởi động…"

#: src/anduinos_control_panel/app.py:790
msgid "Boot settings updated. The change applies on the next startup."
msgstr ""
"Đã cập nhật cài đặt khởi động. Thay đổi sẽ được áp dụng ở lần khởi động tiếp"
" theo."

#: src/anduinos_control_panel/app.py:793
msgid "Boot settings updated"
msgstr "Đã cập nhật cài đặt khởi động"

#: src/anduinos_control_panel/app.py:800
msgid "The boot setting could not be changed."
msgstr "Không thể thay đổi cài đặt khởi động."

#: src/anduinos_control_panel/app.py:831
msgid "This application is available from the app store."
msgstr "Ứng dụng này có sẵn trên Cửa hàng ứng dụng."

#: src/anduinos_control_panel/app.py:834
msgid "Open App Store"
msgstr "Mở Cửa hàng ứng dụng"

#: src/anduinos_control_panel/app.py:878
msgid "Bottles"
msgstr "Bottles"

#: src/anduinos_control_panel/app.py:880
msgid ""
"Run Windows applications in isolated compatibility environments powered by "
"Wine and Bottles."
msgstr ""
"Chạy các ứng dụng Windows trong các môi trường cách ly tương thích, dựa trên"
" Wine và Bottles."

#: src/anduinos_control_panel/app.py:885
msgid "Install Bottles"
msgstr "Cài đặt Bottles"

#: src/anduinos_control_panel/app.py:886
msgid "Downloads Bottles and its runtime from Flathub"
msgstr "Tải Bottles và môi trường chạy của ứng dụng từ Flathub"

#: src/anduinos_control_panel/app.py:902
#: src/anduinos_control_panel/app.py:1109
#: src/anduinos_control_panel/app.py:1302
#: src/anduinos_control_panel/app.py:1506
msgid "Advanced Output"
msgstr "Đầu ra nâng cao"

#: src/anduinos_control_panel/app.py:936
#: src/anduinos_control_panel/app.py:1143
msgid "Start"
msgstr "Bắt đầu"

#: src/anduinos_control_panel/app.py:978
#: src/anduinos_control_panel/app.py:1185
#: src/anduinos_control_panel/app.py:1371
msgid "Installing…"
msgstr "Đang cài đặt…"

#: src/anduinos_control_panel/app.py:980
msgid "Downloading and installing Bottles… This may take a few minutes."
msgstr "Đang tải xuống và cài đặt Bottles… Quá trình này có thể mất vài phút."

#: src/anduinos_control_panel/app.py:985
msgid "Preparing Flathub and Bottles installation…"
msgstr "Đang chuẩn bị cài đặt Flathub và Bottles…"

#: src/anduinos_control_panel/app.py:999
msgid "✓ Bottles is ready."
msgstr "✓ Bottles đã sẵn sàng."

#: src/anduinos_control_panel/app.py:1003
#: src/anduinos_control_panel/app.py:1210
#: src/anduinos_control_panel/app.py:1398
#: src/anduinos_control_panel/app.py:1619
msgid "✓ Installation completed successfully."
msgstr "✓ Cài đặt đã hoàn tất thành công."

#: src/anduinos_control_panel/app.py:1005
msgid "Open Bottles"
msgstr "Mở Bottles"

#: src/anduinos_control_panel/app.py:1010
msgid "Bottles installed"
msgstr "Bottles đã được cài đặt"

#: src/anduinos_control_panel/app.py:1016
#: src/anduinos_control_panel/app.py:1223
#: src/anduinos_control_panel/app.py:1442
msgid "✗ Installation failed. Review Advanced Output."
msgstr "✗ Cài đặt thất bại. Kiểm tra đầu ra nâng cao."

#: src/anduinos_control_panel/app.py:1021
#: src/anduinos_control_panel/app.py:1228
#: src/anduinos_control_panel/app.py:1447
#: src/anduinos_control_panel/app.py:1642
msgid "✗ Operation failed: "
msgstr "✗ Thao tác thất bại: "

#: src/anduinos_control_panel/app.py:1023
#: src/anduinos_control_panel/app.py:1230
#: src/anduinos_control_panel/app.py:1449
#: src/anduinos_control_panel/app.py:1644
msgid "Retry"
msgstr "Thử lại"

#: src/anduinos_control_panel/app.py:1053
msgid "Deja Dup Backups"
msgstr "Sao lưu Deja Dup"

#: src/anduinos_control_panel/app.py:1067
msgid "Permission Settings"
msgstr "Cài đặt quyền truy cập"

#: src/anduinos_control_panel/app.py:1085
msgid "Flatseal"
msgstr "Flatseal"

#: src/anduinos_control_panel/app.py:1087
msgid ""
"Review and control what files, devices, network connections, and services "
"Flatpak applications can access."
msgstr ""
"Xem xét và kiểm soát các tệp, thiết bị, kết nối mạng và dịch vụ mà các ứng "
"dụng Flatpak có thể truy cập."

#: src/anduinos_control_panel/app.py:1092
msgid "Install Flatseal"
msgstr "Cài đặt Flatseal"

#: src/anduinos_control_panel/app.py:1094
msgid "Administrator authentication is required when installation starts"
msgstr "Yêu cầu xác thực quản trị viên khi bắt đầu cài đặt"

#: src/anduinos_control_panel/app.py:1186
msgid "Downloading and installing Flatseal…"
msgstr "Đang tải xuống và cài đặt Flatseal…"

#: src/anduinos_control_panel/app.py:1191
msgid "Preparing Flatseal installation…"
msgstr "Đang chuẩn bị cài đặt Flatseal…"

#: src/anduinos_control_panel/app.py:1206
msgid "✓ Flatseal is ready."
msgstr "✓ Flatseal đã sẵn sàng."

#: src/anduinos_control_panel/app.py:1212
msgid "Open Flatseal"
msgstr "Mở Flatseal"

#: src/anduinos_control_panel/app.py:1217
msgid "Flatseal installed"
msgstr "Flatseal đã được cài đặt"

#: src/anduinos_control_panel/app.py:1249
msgid "Install Voice Typing"
msgstr "Cài đặt nhập liệu bằng giọng nói"

#: src/anduinos_control_panel/app.py:1267
msgid "Offline Voice Typing"
msgstr "Nhập liệu bằng giọng nói ngoại tuyến"

#: src/anduinos_control_panel/app.py:1269
msgid ""
"Press Super + H to dictate into browsers, editors, messages, terminals, and "
"other applications. Audio stays on this computer."
msgstr ""
"Nhấn Super + H để nhập liệu bằng giọng nói trong trình duyệt, trình soạn "
"thảo, ứng dụng nhắn tin, cửa sổ dòng lệnh và các ứng dụng khác. Âm thanh "
"không rời khỏi máy tính này."

#: src/anduinos_control_panel/app.py:1274
msgid "Private by default"
msgstr "Riêng tư theo mặc định"

#: src/anduinos_control_panel/app.py:1275
msgid "Speech is recognized locally with whisper.cpp"
msgstr "Giọng nói được nhận dạng trên máy tính này bằng whisper.cpp"

#: src/anduinos_control_panel/app.py:1280
msgid "About 140 MB to download"
msgstr "Khoảng 140 MB để tải xuống"

#: src/anduinos_control_panel/app.py:1282
msgid ""
"Includes the multilingual Base model; optional models are available later"
msgstr ""
"Bao gồm mô hình đa ngôn ngữ Base; các mô hình tùy chọn sẽ có sẵn sau này"

#: src/anduinos_control_panel/app.py:1291
msgid "Administrator authentication is required when installation starts."
msgstr "Yêu cầu xác thực quản trị viên khi bắt đầu cài đặt."

#: src/anduinos_control_panel/app.py:1376
msgid "Downloading the local engine and multilingual speech model…"
msgstr ""
"Đang tải xuống công cụ xử lý cục bộ và mô hình nhận dạng giọng nói đa ngôn "
"ngữ…"

#: src/anduinos_control_panel/app.py:1382
msgid "Preparing Voice Typing installation…"
msgstr "Đang chuẩn bị cài đặt nhập liệu bằng giọng nói…"

#: src/anduinos_control_panel/app.py:1425
msgid ""
"✓ Installed. Sign out and back in once, then press Super + H to start Voice "
"Typing."
msgstr ""
"✓ Đã cài đặt. Đăng xuất rồi đăng nhập lại một lần, sau đó nhấn Super + H để "
"bắt đầu nhập liệu bằng giọng nói."

#: src/anduinos_control_panel/app.py:1429
msgid "Open Settings"
msgstr "Mở cài đặt"

#: src/anduinos_control_panel/app.py:1435
msgid "Voice Typing installed — sign out to finish"
msgstr "Đã cài đặt nhập liệu bằng giọng nói — đăng xuất để hoàn tất"

#: src/anduinos_control_panel/app.py:1466
msgid "On-device AI"
msgstr "AI trên thiết bị"

#: src/anduinos_control_panel/app.py:1484
msgid "Why AI"
msgstr "Why AI"

#: src/anduinos_control_panel/app.py:1486
msgid ""
"Run the Why AI assistant locally. The model and runtime are installed only "
"when this option is enabled."
msgstr ""
"Chạy trợ lý Why AI trên máy tính này. Mô hình và môi trường chạy chỉ được "
"cài đặt khi tùy chọn này được bật."

#: src/anduinos_control_panel/app.py:1491
msgid "Install on-device AI"
msgstr "Cài đặt AI trên thiết bị"

#: src/anduinos_control_panel/app.py:1492
msgid "Enable the local Why AI stack on this computer"
msgstr "Bật ngăn xếp Why AI cục bộ trên máy tính này"

#: src/anduinos_control_panel/app.py:1586
msgid "Applying…"
msgstr "Đang áp dụng…"

#: src/anduinos_control_panel/app.py:1588
msgid "Downloading and installing Why AI… This may take about 10 minutes."
msgstr ""
"Đang tải xuống và cài đặt Why AI… Quá trình này có thể mất khoảng 10 phút."

#: src/anduinos_control_panel/app.py:1590
msgid "Disabling the local Why AI stack…"
msgstr "Đang tắt ngăn xếp Why AI cục bộ…"

#: src/anduinos_control_panel/app.py:1597
msgid "Preparing package operation…"
msgstr "Đang chuẩn bị thao tác gói…"

#: src/anduinos_control_panel/app.py:1611
msgid "✓ On-device AI is ready."
msgstr "✓ AI trên thiết bị đã sẵn sàng."

#: src/anduinos_control_panel/app.py:1613
msgid "✓ On-device AI is disabled."
msgstr "✓ AI trên thiết bị đã bị tắt."

#: src/anduinos_control_panel/app.py:1619
msgid "✓ Change completed successfully."
msgstr "✓ Thay đổi đã hoàn tất thành công."

#: src/anduinos_control_panel/app.py:1628
msgid "On-device AI enabled"
msgstr "AI trên thiết bị đã được bật"

#: src/anduinos_control_panel/app.py:1630
msgid "On-device AI disabled"
msgstr "AI trên thiết bị đã bị tắt"

#: src/anduinos_control_panel/app.py:1638
