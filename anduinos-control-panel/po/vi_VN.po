msgid "Authentication is required to read the boot menu."
msgstr "Cần xác thực để đọc menu khởi động."

#: src/anduinos_control_panel/app.py:711
msgid "Boot menu wait time"
msgstr "Thời gian chờ menu khởi động"

#: src/anduinos_control_panel/app.py:713
msgid "The same delay is used after an interrupted or unsuccessful startup."
msgstr ""
"Thời gian chờ này cũng được áp dụng sau khi quá trình khởi động bị gián đoạn "
"hoặc không thành công."

#: src/anduinos_control_panel/app.py:720
#, python-format
msgid "%d seconds"
msgstr "%d giây"

#: src/anduinos_control_panel/app.py:732
msgid "Boot display"
msgstr "Hiển thị khởi động"

#: src/anduinos_control_panel/app.py:734
msgid "Choose the size of the GRUB menu and startup logo."
msgstr "Chọn kích thước của menu GRUB và logo khởi động."

#: src/anduinos_control_panel/app.py:738
msgid "Display mode"
msgstr "Chế độ hiển thị"

