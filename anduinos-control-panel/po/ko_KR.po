msgstr "Flatseal 설치 준비 중…"

#: src/anduinos_control_panel/app.py:1370
msgid "✓ Flatseal is ready."
msgstr "✓ Flatseal이 준비되었습니다."

#: src/anduinos_control_panel/app.py:1376
msgid "Open Flatseal"
msgstr "Flatseal 열기"

#: src/anduinos_control_panel/app.py:1381
msgid "Flatseal installed"
msgstr "Flatseal 설치 완료"

