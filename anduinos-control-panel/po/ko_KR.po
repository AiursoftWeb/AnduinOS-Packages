msgid "Authentication was cancelled."
msgstr "인증이 취소되었습니다."

#: src/anduinos_control_panel/app.py:587
msgid "The recommended component could not be installed."
msgstr "권장 구성 요소를 설치할 수 없습니다."

#: src/anduinos_control_panel/app.py:588
msgid "Installation failed"
msgstr "설치에 실패했습니다"

#: src/anduinos_control_panel/app.py:635
msgid "Startup and Boot"
msgstr "시작 및 부팅"

#: src/anduinos_control_panel/app.py:653
msgid "Boot menu"
msgstr "부팅 메뉴"

#: src/anduinos_control_panel/app.py:655
msgid ""
"Choose how long the boot menu waits before starting the default system."
msgstr "기본 시스템이 시작되기 전에 부팅 메뉴가 대기하는 시간을 선택하세요."

#: src/anduinos_control_panel/app.py:659
msgid "Boot menu wait time"
msgstr "부팅 메뉴 대기 시간"

#: src/anduinos_control_panel/app.py:661
msgid "The same delay is used after an interrupted or unsuccessful startup."
msgstr "부팅이 중단되거나 실패한 후에도 동일한 대기 시간이 적용됩니다."

#: src/anduinos_control_panel/app.py:668
#, python-format
msgid "%d seconds"
msgstr "%d초"

#: src/anduinos_control_panel/app.py:676
msgid "Boot display"
msgstr "부팅 화면"

#: src/anduinos_control_panel/app.py:678
msgid "Choose the size of the GRUB menu and startup logo."
msgstr "GRUB 메뉴와 시작 로고의 크기를 선택하세요."

#: src/anduinos_control_panel/app.py:682
msgid "Display mode"
msgstr "표시 모드"

#: src/anduinos_control_panel/app.py:684
msgid "Native resolution shows more detail; large text is easier to read."
msgstr "네이티브 해상도는 더 많은 세부 사항을 표시하며, 큰 글씨는 읽기 편합니다."

#: src/anduinos_control_panel/app.py:692
msgid "Native resolution"
msgstr "네이티브 해상도"

#: src/anduinos_control_panel/app.py:692
msgid "Large text mode"
msgstr "큰 글씨 모드"

#: src/anduinos_control_panel/app.py:714
#: src/anduinos_control_panel/app.py:1007
#: src/anduinos_control_panel/app.py:1214
#: src/anduinos_control_panel/app.py:1431
#: src/anduinos_control_panel/app.py:1623
msgid "Close"
msgstr "닫기"

