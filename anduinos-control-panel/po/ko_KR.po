#: src/anduinos_control_panel/app.py:1334
msgid "Install"
msgstr "설치"

#: src/anduinos_control_panel/app.py:569
#, python-format
msgid "Installing %s…"
msgstr "%s 설치 중…"

#: src/anduinos_control_panel/app.py:578
#, python-format
msgid "%s installed"
msgstr "설치 완료: %s"

