#: src/anduinos_control_panel/app.py:1309
msgid "Start"
msgstr "Rozpocznij"

#: src/anduinos_control_panel/app.py:1128
#: src/anduinos_control_panel/app.py:1351
#: src/anduinos_control_panel/app.py:1547
msgid "Installing…"
msgstr "Instalowanie…"

#: src/anduinos_control_panel/app.py:1130
msgid "Downloading and installing Bottles… This may take a few minutes."
msgstr "Pobieranie i instalowanie Bottles… Może to potrwać kilka minut."

#: src/anduinos_control_panel/app.py:1135
msgid "Preparing Flathub and Bottles installation…"
msgstr "Przygotowywanie instalacji Flathub i Bottles…"

#: src/anduinos_control_panel/app.py:1149
msgid "✓ Bottles is ready."
msgstr "✓ Bottles jest gotowy."

#: src/anduinos_control_panel/app.py:1153
#: src/anduinos_control_panel/app.py:1376
#: src/anduinos_control_panel/app.py:1574
#: src/anduinos_control_panel/app.py:1795
msgid "✓ Installation completed successfully."
msgstr "✓ Instalacja zakończona pomyślnie."

#: src/anduinos_control_panel/app.py:1155
msgid "Open Bottles"
msgstr "Otwórz Bottles"

#: src/anduinos_control_panel/app.py:1160
msgid "Bottles installed"
msgstr "Zainstalowano Bottles"

#: src/anduinos_control_panel/app.py:1166
#: src/anduinos_control_panel/app.py:1389
#: src/anduinos_control_panel/app.py:1618
msgid "✗ Installation failed. Review Advanced Output."
