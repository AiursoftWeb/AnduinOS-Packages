#: src/anduinos_control_panel/app.py:1380
#: src/anduinos_control_panel/app.py:1607
#: src/anduinos_control_panel/app.py:1799
msgid "Close"
msgstr "Zamknij"

#: src/anduinos_control_panel/app.py:771 src/anduinos_control_panel/app.py:1716
#: src/anduinos_control_panel/app.py:1720
msgid "Apply"
msgstr "Zastosuj"

#: src/anduinos_control_panel/app.py:827
msgid "Custom setting (unchanged)"
msgstr "Własne ustawienie (niezmienione)"

#: src/anduinos_control_panel/app.py:842
msgid "Only operating systems already in the boot menu are listed."
msgstr ""
"Na liście znajdują się tylko systemy operacyjne już obecne w menu "
"rozruchowym."

#: src/anduinos_control_panel/app.py:843
msgid "No supported operating systems were found in the boot menu."
msgstr "Nie znaleziono obsługiwanych systemów operacyjnych w menu rozruchowym."

#: src/anduinos_control_panel/app.py:846 src/anduinos_control_panel/app.py:850
msgid "The boot menu could not be read."
msgstr "Nie udało się odczytać menu rozruchowego."

#: src/anduinos_control_panel/app.py:861
msgid "Reading the boot menu…"
msgstr "Odczytywanie menu rozruchu…"

#: src/anduinos_control_panel/app.py:916
msgid "Updating the boot menu…"
msgstr "Aktualizowanie menu rozruchu…"

#: src/anduinos_control_panel/app.py:939
msgid "Boot settings updated. The change applies on the next startup."
msgstr ""
"Zaktualizowano ustawienia rozruchu. Zmiana zostanie zastosowana przy "
"następnym uruchomieniu."

#: src/anduinos_control_panel/app.py:942
msgid "Boot settings updated"
msgstr "Zaktualizowano ustawienia rozruchu"

#: src/anduinos_control_panel/app.py:949
msgid "The boot setting could not be changed."
msgstr "Nie udało się zmienić ustawienia rozruchu."

#: src/anduinos_control_panel/app.py:981
msgid "This application is available from the app store."
msgstr "Ta aplikacja jest dostępna w sklepie z aplikacjami."

#: src/anduinos_control_panel/app.py:984
msgid "Open App Store"
msgstr "Otwórz sklep z aplikacjami"

#: src/anduinos_control_panel/app.py:1028
msgid "Bottles"
msgstr "Bottles"

#: src/anduinos_control_panel/app.py:1030
msgid ""
"Run Windows applications in isolated compatibility environments powered by "
"Wine and Bottles."
msgstr ""
"Uruchamia aplikacje systemu Windows w izolowanych środowiskach zgodności "
"opartych na Wine i Bottles."

#: src/anduinos_control_panel/app.py:1035
msgid "Install Bottles"
msgstr "Zainstaluj Bottles"

#: src/anduinos_control_panel/app.py:1036
msgid "Downloads Bottles and its runtime from Flathub"
msgstr "Pobiera Bottles i jego środowisko uruchomieniowe z Flathub"

#: src/anduinos_control_panel/app.py:1052
#: src/anduinos_control_panel/app.py:1275
#: src/anduinos_control_panel/app.py:1478
#: src/anduinos_control_panel/app.py:1682
#: src/anduinos_control_panel/prediction_settings.py:84
msgid "Advanced Output"
msgstr "Zaawansowane dane wyjściowe"

