#: src/anduinos_control_panel/app.py:1206
msgid "Deja Dup Backups"
msgstr "Kopie zapasowe Deja Dup"

#: src/anduinos_control_panel/app.py:1215
msgid "Factory Reset Is Not Available"
msgstr "Przywracanie ustawień fabrycznych jest niedostępne"

#: src/anduinos_control_panel/app.py:1217
msgid ""
"This system does not support factory reset. Reinstall AnduinOS and choose "
"the Btrfs filesystem to enable it."
msgstr ""
"Ten system nie obsługuje przywracania ustawień fabrycznych. Zainstaluj "
"ponownie AnduinOS i wybierz system plików Btrfs, aby włączyć tę funkcję."

#: src/anduinos_control_panel/app.py:1233
#: src/anduinos_control_panel/topics.py:272
msgid "Permission Settings"
msgstr "Ustawienia uprawnień"

#: src/anduinos_control_panel/app.py:1251
msgid "Flatseal"
msgstr "Flatseal"

#: src/anduinos_control_panel/app.py:1253
msgid ""
"Review and control what files, devices, network connections, and services "
"Flatpak applications can access."
msgstr ""
"Przeglądaj i kontroluj, do jakich plików, urządzeń, połączeń sieciowych i "
"usług mają dostęp aplikacje Flatpak."

#: src/anduinos_control_panel/app.py:1258
msgid "Install Flatseal"
msgstr "Zainstaluj Flatseal"

#: src/anduinos_control_panel/app.py:1260
msgid "Administrator authentication is required when installation starts"
msgstr ""
"Wymagane jest uwierzytelnienie administratora przy rozpoczęciu instalacji"

#: src/anduinos_control_panel/app.py:1352
msgid "Downloading and installing Flatseal…"
msgstr "Pobieranie i instalowanie Flatseal…"

#: src/anduinos_control_panel/app.py:1357
msgid "Preparing Flatseal installation…"
msgstr "Przygotowywanie instalacji Flatseal…"

#: src/anduinos_control_panel/app.py:1372
msgid "✓ Flatseal is ready."
msgstr "✓ Flatseal jest gotowy."

#: src/anduinos_control_panel/app.py:1378
msgid "Open Flatseal"
msgstr "Otwórz Flatseal"

#: src/anduinos_control_panel/app.py:1383
msgid "Flatseal installed"
msgstr "Zainstalowano Flatseal"

#: src/anduinos_control_panel/app.py:1425
msgid "Install Voice Typing"
msgstr "Zainstaluj dyktowanie głosowe"

#: src/anduinos_control_panel/app.py:1443
msgid "Offline Voice Typing"
msgstr "Dyktowanie głosowe offline"

#: src/anduinos_control_panel/app.py:1445
msgid ""
"Press Super + H to dictate into browsers, editors, messages, terminals, and "
"other applications. Audio stays on this computer."
msgstr ""
"Naciśnij Super + H, aby dyktować w przeglądarkach, edytorach, "
"komunikatorach, terminalach i innych aplikacjach. Dane audio nie są wysyłane "
"poza ten komputer."

#: src/anduinos_control_panel/app.py:1450
msgid "Private by default"
msgstr "Domyślnie prywatne"

#: src/anduinos_control_panel/app.py:1451
msgid "Speech is recognized locally with whisper.cpp"
msgstr "Rozpoznawanie mowy odbywa się na tym komputerze za pomocą whisper.cpp"

#: src/anduinos_control_panel/app.py:1456
msgid "About 140 MB to download"
msgstr "Około 140 MB do pobrania"

#: src/anduinos_control_panel/app.py:1458
msgid ""
"Includes the multilingual Base model; optional models are available later"
msgstr ""
"Zawiera wielojęzyczny model Base; opcjonalne modele będą dostępne później"

#: src/anduinos_control_panel/app.py:1467
#: src/anduinos_control_panel/prediction_settings.py:177
msgid "Administrator authentication is required when installation starts."
msgstr ""
"Wymagane jest uwierzytelnienie administratora przy rozpoczęciu instalacji."

#: src/anduinos_control_panel/app.py:1552
msgid "Downloading the local engine and multilingual speech model…"
msgstr ""
"Pobieranie lokalnego silnika i wielojęzycznego modelu rozpoznawania mowy…"

#: src/anduinos_control_panel/app.py:1558
msgid "Preparing Voice Typing installation…"
msgstr "Przygotowywanie instalacji dyktowania głosowego…"

#: src/anduinos_control_panel/app.py:1601
msgid ""
"✓ Installed. Sign out and back in once, then press Super + H to start Voice "
"Typing."
msgstr ""
"✓ Zainstalowano. Wyloguj się i zaloguj ponownie, a następnie naciśnij Super "
"+ H, aby rozpocząć dyktowanie głosowe."

#: src/anduinos_control_panel/app.py:1605
msgid "Open Settings"
msgstr "Otwórz ustawienia"

#: src/anduinos_control_panel/app.py:1611
msgid "Voice Typing installed — sign out to finish"
msgstr ""
"Zainstalowano dyktowanie głosowe — wyloguj się, aby dokończyć konfigurację"

#: src/anduinos_control_panel/app.py:1642
#: src/anduinos_control_panel/topics.py:281
msgid "On-device AI"
msgstr "Sztuczna inteligencja działająca na urządzeniu"

#: src/anduinos_control_panel/app.py:1660
msgid "Why AI"
msgstr "Why AI"

#: src/anduinos_control_panel/app.py:1662
msgid ""
"Run the Why AI assistant locally. The model and runtime are installed only "
"when this option is enabled."
msgstr ""
"Uruchamiaj asystenta Why AI na tym komputerze. Model i środowisko "
"uruchomieniowe są instalowane tylko wtedy, gdy ta opcja jest włączona."

#: src/anduinos_control_panel/app.py:1667
msgid "Install on-device AI"
msgstr "Zainstaluj sztuczną inteligencję działającą na urządzeniu"

#: src/anduinos_control_panel/app.py:1668
msgid "Enable the local Why AI stack on this computer"
msgstr "Włącz lokalny stos Why AI na tym komputerze"

#: src/anduinos_control_panel/app.py:1762
msgid "Applying…"
msgstr "Zastosowywanie…"

#: src/anduinos_control_panel/app.py:1764
msgid "Downloading and installing Why AI… This may take about 10 minutes."
msgstr "Pobieranie i instalowanie Why AI… Może to potrwać około 10 minut."

#: src/anduinos_control_panel/app.py:1766
msgid "Disabling the local Why AI stack…"
msgstr "Wyłączanie lokalnego stosu Why AI…"

#: src/anduinos_control_panel/app.py:1773
msgid "Preparing package operation…"
msgstr "Przygotowywanie operacji pakietowej…"

#: src/anduinos_control_panel/app.py:1787
msgid "✓ On-device AI is ready."
msgstr "✓ Sztuczna inteligencja działająca na urządzeniu jest gotowa."

