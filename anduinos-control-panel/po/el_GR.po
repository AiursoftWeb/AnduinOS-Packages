msgstr "Σάρωση εγγράφων και επιλογή σαρωτή"

#: src/anduinos_control_panel/app.py:282
msgid "Install Document Scanner"
msgstr "Εγκατάσταση σαρωτή εγγράφων"

#: src/anduinos_control_panel/app.py:288
msgid "Appearance"
msgstr "Εμφάνιση"

#: src/anduinos_control_panel/app.py:296
msgid "Programs"
msgstr "Εφαρμογές"

#: src/anduinos_control_panel/app.py:304
#: src/anduinos_control_panel/topics.py:273
msgid "Manage application permissions with Flatseal"
msgstr "Διαχείριση αδειών εφαρμογών με το Flatseal"

#: src/anduinos_control_panel/app.py:306
msgid "Install Flatseal to manage application permissions"
msgstr "Εγκατάσταση του Flatseal για τη διαχείριση των αδειών εφαρμογών"

#: src/anduinos_control_panel/app.py:312
msgid "AI Stack"
msgstr "Στοίβα τεχνητής νοημοσύνης"

#: src/anduinos_control_panel/app.py:317 src/anduinos_control_panel/app.py:321
msgid "Installed"
msgstr "Εγκατεστημένο"

#: src/anduinos_control_panel/app.py:317 src/anduinos_control_panel/app.py:321
#: src/anduinos_control_panel/prediction_settings.py:44
msgid "Not installed"
msgstr "Μη εγκατεστημένο"

#: src/anduinos_control_panel/app.py:326
msgid "Configure microphone, language, shortcut, and training"
msgstr "Διαμόρφωση μικροφώνου, γλώσσας, συντόμευσης και εκπαίδευσης"

#: src/anduinos_control_panel/app.py:328
msgid "Install private, offline speech-to-text"
msgstr "Εγκατάσταση ιδιωτικής, εκτός σύνδεσης αναγνώρισης ομιλίας"

#: src/anduinos_control_panel/app.py:334 src/anduinos_control_panel/app.py:1004
msgid "Windows Compatibility"
msgstr "Συμβατότητα με Windows"

#: src/anduinos_control_panel/app.py:340
msgid "Open your Windows application environments"
msgstr "Άνοιγμα των περιβαλλόντων εφαρμογών Windows"

#: src/anduinos_control_panel/app.py:342
msgid "Install Bottles to run Windows applications"
msgstr "Εγκατάσταση του Bottles για την εκτέλεση εφαρμογών Windows"

#: src/anduinos_control_panel/app.py:348
msgid "Backup and Recovery"
msgstr "Αντίγραφα ασφαλείας και επαναφορά"

#: src/anduinos_control_panel/app.py:390
msgid "Open Deja Dup backups"
msgstr "Άνοιγμα αντιγράφων ασφαλείας Deja Dup"

#: src/anduinos_control_panel/app.py:392
msgid "Install Deja Dup from the app store"
msgstr "Εγκατάσταση του Deja Dup από το κατάστημα εφαρμογών"

#: src/anduinos_control_panel/app.py:403 src/anduinos_control_panel/app.py:420
#: src/anduinos_control_panel/app.py:434 src/anduinos_control_panel/app.py:1948
msgid "Setting not found"
msgstr "Η ρύθμιση δεν βρέθηκε"

#: src/anduinos_control_panel/app.py:553 src/anduinos_control_panel/app.py:564
#: src/anduinos_control_panel/app.py:573
msgid "Could not open this setting"
msgstr "Δεν ήταν δυνατό το άνοιγμα αυτής της ρύθμισης"

#: src/anduinos_control_panel/app.py:572
msgid "The application exited before it could be opened."
msgstr "Η εφαρμογή τερματίστηκε πριν μπορέσει να ανοίξει."

#: src/anduinos_control_panel/app.py:579
msgid "OK"
msgstr "Εντάξει"

#: src/anduinos_control_panel/app.py:585 src/anduinos_control_panel/app.py:974
#, python-format
msgid "Install %s?"
msgstr "Εγκατάσταση του %s;"

#: src/anduinos_control_panel/app.py:587
#, python-format
msgid ""
"%s is a recommended component, but it is not installed. You can reinstall it "
"now."
msgstr ""
"Το προτεινόμενο στοιχείο δεν είναι εγκατεστημένο: %s. Μπορείτε να το "
"εγκαταστήσετε ξανά τώρα."

#: src/anduinos_control_panel/app.py:592 src/anduinos_control_panel/app.py:977
#: src/anduinos_control_panel/app.py:1078
#: src/anduinos_control_panel/app.py:1298
#: src/anduinos_control_panel/app.py:1499
#: src/anduinos_control_panel/app.py:1705
#: src/anduinos_control_panel/prediction_settings.py:142
msgid "Cancel"
msgstr "Ακύρωση"

#: src/anduinos_control_panel/app.py:593 src/anduinos_control_panel/app.py:1501
#: src/anduinos_control_panel/prediction_settings.py:46
msgid "Install"
msgstr "Εγκατάσταση"

#: src/anduinos_control_panel/app.py:602
#, python-format
msgid "Installing %s…"
msgstr "Εγκατάσταση του %s…"

#: src/anduinos_control_panel/app.py:611
#, python-format
msgid "%s installed"
msgstr "Η εγκατάσταση ολοκληρώθηκε: %s"

#: src/anduinos_control_panel/app.py:618 src/anduinos_control_panel/app.py:843
#: src/anduinos_control_panel/app.py:941
#: src/anduinos_control_panel/software_sources.py:394
msgid "Authentication was cancelled."
msgstr "Η πιστοποίηση ακυρώθηκε."

#: src/anduinos_control_panel/app.py:620
msgid "The recommended component could not be installed."
msgstr "Δεν ήταν δυνατή η εγκατάσταση του προτεινόμενου στοιχείου."

#: src/anduinos_control_panel/app.py:621
msgid "Installation failed"
msgstr "Η εγκατάσταση απέτυχε"

#: src/anduinos_control_panel/app.py:669
#: src/anduinos_control_panel/topics.py:86
msgid "Startup and Boot"
msgstr "Έναρξη εφαρμογών και εκκίνηση συστήματος"

#: src/anduinos_control_panel/app.py:687
msgid "Boot menu"
msgstr "Μενού εκκίνησης"

#: src/anduinos_control_panel/app.py:689
msgid "Choose how long the boot menu waits before starting the default system."
msgstr ""
"Επιλέξτε πόσο χρόνο θα περιμένει το μενού εκκίνησης πριν εκκινήσει το "
"προεπιλεγμένο σύστημα."

#: src/anduinos_control_panel/app.py:694
msgid "Default operating system"
msgstr "Προεπιλεγμένο λειτουργικό σύστημα"

#: src/anduinos_control_panel/app.py:695
msgid "Starts automatically when the boot menu wait time ends."
msgstr "Εκκινείται αυτόματα όταν λήξει ο χρόνος αναμονής του μενού εκκίνησης."

#: src/anduinos_control_panel/app.py:697 src/anduinos_control_panel/app.py:824
msgid "Current setting (unchanged)"
msgstr "Τρέχουσα ρύθμιση (αμετάβλητη)"

#: src/anduinos_control_panel/app.py:701 src/anduinos_control_panel/app.py:1167
#: src/anduinos_control_panel/app.py:1387
#: src/anduinos_control_panel/app.py:1616
#: src/anduinos_control_panel/app.py:1811
msgid "Retry"
msgstr "Επαναδοκιμή"

#: src/anduinos_control_panel/app.py:705
msgid "Authentication is required to read the boot menu."
msgstr "Απαιτείται επαλήθευση για την ανάγνωση του μενού εκκίνησης."

#: src/anduinos_control_panel/app.py:708
msgid "Boot menu wait time"
msgstr "Χρόνος αναμονής μενού εκκίνησης"

#: src/anduinos_control_panel/app.py:710
msgid "The same delay is used after an interrupted or unsuccessful startup."
msgstr ""
"Η ίδια καθυστέρηση χρησιμοποιείται και μετά από διακοπή ή αποτυχημένη "
"εκκίνηση."

#: src/anduinos_control_panel/app.py:717
#, python-format
msgid "%d seconds"
msgstr "%d s"

#: src/anduinos_control_panel/app.py:725
msgid "Boot display"
msgstr "Οθόνη εκκίνησης"

#: src/anduinos_control_panel/app.py:727
msgid "Choose the size of the GRUB menu and startup logo."
msgstr "Επιλέξτε το μέγεθος του μενού GRUB και του λογότυπου εκκίνησης."

#: src/anduinos_control_panel/app.py:731
msgid "Display mode"
msgstr "Λειτουργία προβολής"

#: src/anduinos_control_panel/app.py:733
msgid "Native resolution shows more detail; large text is easier to read."
msgstr ""
"Η εγγενής ανάλυση δείχνει περισσότερες λεπτομέρειες· το μεγάλο κείμενο είναι "
"πιο εύκολο να διαβαστεί."

#: src/anduinos_control_panel/app.py:741
msgid "Native resolution"
msgstr "Εγγενής ανάλυση"

#: src/anduinos_control_panel/app.py:741
msgid "Large text mode"
msgstr "Λειτουργία μεγάλου κειμένου"

#: src/anduinos_control_panel/app.py:763 src/anduinos_control_panel/app.py:1151
#: src/anduinos_control_panel/app.py:1371
#: src/anduinos_control_panel/app.py:1598
#: src/anduinos_control_panel/app.py:1790
msgid "Close"
msgstr "Κλείσιμο"

#: src/anduinos_control_panel/app.py:765 src/anduinos_control_panel/app.py:1707
#: src/anduinos_control_panel/app.py:1711
msgid "Apply"
msgstr "Εφαρμογή"

#: src/anduinos_control_panel/app.py:821
msgid "Custom setting (unchanged)"
msgstr "Προσαρμοσμένη ρύθμιση (αμετάβλητη)"

#: src/anduinos_control_panel/app.py:836
msgid "Only operating systems already in the boot menu are listed."
msgstr ""
"Στον κατάλογο περιλαμβάνονται μόνο τα λειτουργικά συστήματα που βρίσκονται "
"ήδη στο μενού εκκίνησης."

#: src/anduinos_control_panel/app.py:837
msgid "No supported operating systems were found in the boot menu."
msgstr "Δεν βρέθηκαν υποστηριζόμενα λειτουργικά συστήματα στο μενού εκκίνησης."

#: src/anduinos_control_panel/app.py:840 src/anduinos_control_panel/app.py:844
msgid "The boot menu could not be read."
msgstr "Το μενού εκκίνησης δεν μπορεί να διαβαστεί."

#: src/anduinos_control_panel/app.py:855
msgid "Reading the boot menu…"
msgstr "Ανάγνωση μενού εκκίνησης…"

#: src/anduinos_control_panel/app.py:910
msgid "Updating the boot menu…"
msgstr "Ενημέρωση του μενού εκκίνησης…"

#: src/anduinos_control_panel/app.py:933
msgid "Boot settings updated. The change applies on the next startup."
msgstr ""
"Οι ρυθμίσεις εκκίνησης ενημερώθηκαν. Η αλλαγή ισχύει την επόμενη εκκίνηση."

#: src/anduinos_control_panel/app.py:936
msgid "Boot settings updated"
msgstr "Οι ρυθμίσεις εκκίνησης ενημερώθηκαν"

#: src/anduinos_control_panel/app.py:943
msgid "The boot setting could not be changed."
msgstr "Δεν ήταν δυνατή η αλλαγή της ρύθμισης εκκίνησης."

#: src/anduinos_control_panel/app.py:975
msgid "This application is available from the app store."
msgstr "Αυτή η εφαρμογή είναι διαθέσιμη από το κατάστημα εφαρμογών."

#: src/anduinos_control_panel/app.py:978
msgid "Open App Store"
msgstr "Άνοιγμα καταστήματος εφαρμογών"

#: src/anduinos_control_panel/app.py:1022
msgid "Bottles"
msgstr "Bottles"

#: src/anduinos_control_panel/app.py:1024
msgid ""
"Run Windows applications in isolated compatibility environments powered by "
"Wine and Bottles."
msgstr ""
"Εκτέλεση εφαρμογών Windows σε απομονωμένα περιβάλλοντα συμβατότητας με τη "
"χρήση του Wine και του Bottles."

#: src/anduinos_control_panel/app.py:1029
msgid "Install Bottles"
msgstr "Εγκατάσταση του Bottles"

#: src/anduinos_control_panel/app.py:1030
msgid "Downloads Bottles and its runtime from Flathub"
msgstr "Λήψη του Bottles και του περιβάλλοντος εκτέλεσής του από το Flathub"

#: src/anduinos_control_panel/app.py:1046
#: src/anduinos_control_panel/app.py:1266
#: src/anduinos_control_panel/app.py:1469
#: src/anduinos_control_panel/app.py:1673
#: src/anduinos_control_panel/prediction_settings.py:84
msgid "Advanced Output"
msgstr "Αναλυτικές πληροφορίες"

#: src/anduinos_control_panel/app.py:1080
#: src/anduinos_control_panel/app.py:1300
msgid "Start"
msgstr "Έναρξη"

#: src/anduinos_control_panel/app.py:1122
#: src/anduinos_control_panel/app.py:1342
#: src/anduinos_control_panel/app.py:1538
msgid "Installing…"
msgstr "Εγκατάσταση…"

#: src/anduinos_control_panel/app.py:1124
msgid "Downloading and installing Bottles… This may take a few minutes."
msgstr "Λήψη και εγκατάσταση του Bottles… Αυτό μπορεί να πάρει μερικά λεπτά."

#: src/anduinos_control_panel/app.py:1129
msgid "Preparing Flathub and Bottles installation…"
msgstr "Προετοιμασία εγκατάστασης του Flathub και του Bottles…"

#: src/anduinos_control_panel/app.py:1143
msgid "✓ Bottles is ready."
msgstr "✓ Το Bottles είναι έτοιμο."

#: src/anduinos_control_panel/app.py:1147
#: src/anduinos_control_panel/app.py:1367
#: src/anduinos_control_panel/app.py:1565
#: src/anduinos_control_panel/app.py:1786
msgid "✓ Installation completed successfully."
msgstr "✓ Η εγκατάσταση ολοκληρώθηκε επιτυχώς."

#: src/anduinos_control_panel/app.py:1149
msgid "Open Bottles"
msgstr "Άνοιγμα του Bottles"

#: src/anduinos_control_panel/app.py:1154
msgid "Bottles installed"
msgstr "Εγκαταστάθηκε το Bottles"

#: src/anduinos_control_panel/app.py:1160
#: src/anduinos_control_panel/app.py:1380
#: src/anduinos_control_panel/app.py:1609
msgid "✗ Installation failed. Review Advanced Output."
msgstr "✗ Η εγκατάσταση απέτυχε. Ελέγξτε τις αναλυτικές πληροφορίες."

#: src/anduinos_control_panel/app.py:1165
#: src/anduinos_control_panel/app.py:1385
#: src/anduinos_control_panel/app.py:1614
#: src/anduinos_control_panel/app.py:1809
msgid "✗ Operation failed: "
msgstr "✗ Η λειτουργία απέτυχε: "

#: src/anduinos_control_panel/app.py:1197
msgid "Deja Dup Backups"
msgstr "Αντίγραφα ασφαλείας Deja Dup"

#: src/anduinos_control_panel/app.py:1206
msgid "Factory Reset Is Not Available"
msgstr "Η επαναφορά εργοστασιακών ρυθμίσεων δεν είναι διαθέσιμη"

#: src/anduinos_control_panel/app.py:1208
msgid ""
"This system does not support factory reset. Reinstall AnduinOS and choose "
"the Btrfs filesystem to enable it."
msgstr "Αυτό το σύστημα δεν υποστηρίζει επαναφορά εργοστασιακών ρυθμίσεων. Εγκαταστήστε ξανά το AnduinOS και επιλέξτε το σύστημα αρχείων Btrfs για να την ενεργοποιήσετε."

#: src/anduinos_control_panel/app.py:1224
#: src/anduinos_control_panel/topics.py:272
msgid "Permission Settings"
msgstr "Ρυθμίσεις δικαιωμάτων"

#: src/anduinos_control_panel/app.py:1242
msgid "Flatseal"
msgstr "Flatseal"

#: src/anduinos_control_panel/app.py:1244
msgid ""
"Review and control what files, devices, network connections, and services "
"Flatpak applications can access."
msgstr ""
"Εξετάστε και ελέγξτε ποια αρχεία, συσκευές, συνδέσεις δικτύου και υπηρεσίες "
"μπορούν να προσπελάσουν οι εφαρμογές Flatpak."

#: src/anduinos_control_panel/app.py:1249
msgid "Install Flatseal"
msgstr "Εγκατάσταση του Flatseal"

#: src/anduinos_control_panel/app.py:1251
msgid "Administrator authentication is required when installation starts"
msgstr "Απαιτείται πιστοποίηση διαχειριστή κατά την έναρξη της εγκατάστασης"

#: src/anduinos_control_panel/app.py:1343
msgid "Downloading and installing Flatseal…"
msgstr "Λήψη και εγκατάσταση του Flatseal…"

#: src/anduinos_control_panel/app.py:1348
msgid "Preparing Flatseal installation…"
msgstr "Προετοιμασία εγκατάστασης του Flatseal…"

#: src/anduinos_control_panel/app.py:1363
msgid "✓ Flatseal is ready."
msgstr "✓ Το Flatseal είναι έτοιμο."

#: src/anduinos_control_panel/app.py:1369
msgid "Open Flatseal"
msgstr "Άνοιγμα του Flatseal"

#: src/anduinos_control_panel/app.py:1374
msgid "Flatseal installed"
msgstr "Εγκαταστάθηκε το Flatseal"

#: src/anduinos_control_panel/app.py:1416
msgid "Install Voice Typing"
msgstr "Εγκατάσταση φωνητικής πληκτρολόγησης"

#: src/anduinos_control_panel/app.py:1434
msgid "Offline Voice Typing"
msgstr "Φωνητική πληκτρολόγηση εκτός σύνδεσης"

#: src/anduinos_control_panel/app.py:1436
msgid ""
"Press Super + H to dictate into browsers, editors, messages, terminals, and "
"other applications. Audio stays on this computer."
msgstr ""
"Πατήστε Super + H για να υπαγορεύσετε σε προγράμματα περιήγησης, προγράμματα "
"επεξεργασίας, μηνύματα, τερματικά και άλλες εφαρμογές. Τα δεδομένα ήχου "
"παραμένουν σε αυτόν τον υπολογιστή."

#: src/anduinos_control_panel/app.py:1441
msgid "Private by default"
msgstr "Ιδιωτικότητα από προεπιλογή"

#: src/anduinos_control_panel/app.py:1442
msgid "Speech is recognized locally with whisper.cpp"
msgstr "Η αναγνώριση ομιλίας γίνεται σε αυτόν τον υπολογιστή με το whisper.cpp"

#: src/anduinos_control_panel/app.py:1447
msgid "About 140 MB to download"
msgstr "Περίπου 140 MB για λήψη"

#: src/anduinos_control_panel/app.py:1449
msgid ""
"Includes the multilingual Base model; optional models are available later"
msgstr ""
"Περιλαμβάνει το πολυγλωσσικό μοντέλο Base· τα προαιρετικά μοντέλα θα είναι "
"διαθέσιμα αργότερα"

#: src/anduinos_control_panel/app.py:1458
#: src/anduinos_control_panel/prediction_settings.py:177
msgid "Administrator authentication is required when installation starts."
msgstr "Απαιτείται πιστοποίηση διαχειριστή κατά την έναρξη της εγκατάστασης."

#: src/anduinos_control_panel/app.py:1543
msgid "Downloading the local engine and multilingual speech model…"
msgstr "Λήψη του τοπικού μηχανισμού και του πολυγλωσσικού μοντέλου ομιλίας…"

#: src/anduinos_control_panel/app.py:1549
msgid "Preparing Voice Typing installation…"
msgstr "Προετοιμασία εγκατάστασης φωνητικής πληκτρολόγησης…"

#: src/anduinos_control_panel/app.py:1592
msgid ""
"✓ Installed. Sign out and back in once, then press Super + H to start Voice "
"Typing."
