#: src/anduinos_control_panel/topics.py:273
msgid "Manage application permissions with Flatseal"
msgstr "Upravljajte dopuštenjima aplikacija pomoću Flatseala"

#: src/anduinos_control_panel/app.py:309
msgid "Install Flatseal to manage application permissions"
msgstr "Instalirajte Flatseal za upravljanje dopuštenjima aplikacija"

#: src/anduinos_control_panel/app.py:315
msgid "AI Stack"
msgstr "Alati za umjetnu inteligenciju"

#: src/anduinos_control_panel/app.py:320 src/anduinos_control_panel/app.py:324
msgid "Installed"
msgstr "Instalirano"

#: src/anduinos_control_panel/app.py:320 src/anduinos_control_panel/app.py:324
#: src/anduinos_control_panel/prediction_settings.py:44
msgid "Not installed"
msgstr "Nije instalirano"

#: src/anduinos_control_panel/app.py:329
msgid "Configure microphone, language, shortcut, and training"
msgstr "Konfigurirajte mikrofon, jezik, prečac i treniranje"

#: src/anduinos_control_panel/app.py:331
msgid "Install private, offline speech-to-text"
msgstr "Instalirajte privatno izvanmrežno pretvaranje govora u tekst"

#: src/anduinos_control_panel/app.py:337 src/anduinos_control_panel/app.py:1010
msgid "Windows Compatibility"
msgstr "Kompatibilnost sa sustavom Windows"

#: src/anduinos_control_panel/app.py:343
msgid "Open your Windows application environments"
msgstr "Otvorite svoja okruženja za aplikacije sustava Windows"

#: src/anduinos_control_panel/app.py:345
msgid "Install Bottles to run Windows applications"
msgstr "Instalirajte Bottles za pokretanje aplikacija sustava Windows"

#: src/anduinos_control_panel/app.py:351
msgid "Backup and Recovery"
msgstr "Sigurnosno kopiranje i oporavak"

#: src/anduinos_control_panel/app.py:393
msgid "Open Deja Dup backups"
msgstr "Otvorite sigurnosne kopije u aplikaciji Deja Dup"

#: src/anduinos_control_panel/app.py:395
msgid "Install Deja Dup from the app store"
msgstr "Instalirajte Deja Dup iz trgovine aplikacija"

#: src/anduinos_control_panel/app.py:406 src/anduinos_control_panel/app.py:423
#: src/anduinos_control_panel/app.py:437 src/anduinos_control_panel/app.py:1957
msgid "Setting not found"
msgstr "Postavka nije pronađena"

#: src/anduinos_control_panel/app.py:556 src/anduinos_control_panel/app.py:567
#: src/anduinos_control_panel/app.py:576
msgid "Could not open this setting"
msgstr "Nije moguće otvoriti ovu postavku"

#: src/anduinos_control_panel/app.py:575
msgid "The application exited before it could be opened."
msgstr "Aplikacija se zatvorila prije otvaranja."

#: src/anduinos_control_panel/app.py:582
msgid "OK"
msgstr "U redu"

#: src/anduinos_control_panel/app.py:588 src/anduinos_control_panel/app.py:980
#, python-format
msgid "Install %s?"
msgstr "Instalirati %s?"

#: src/anduinos_control_panel/app.py:590
#, python-format
msgid ""
"%s is a recommended component, but it is not installed. You can reinstall it "
"now."
msgstr ""
"%s je preporučena komponenta, ali nije instalirana. Možete je sada ponovno "
"instalirati."

#: src/anduinos_control_panel/app.py:595 src/anduinos_control_panel/app.py:983
#: src/anduinos_control_panel/app.py:1084
#: src/anduinos_control_panel/app.py:1307
#: src/anduinos_control_panel/app.py:1508
#: src/anduinos_control_panel/app.py:1714
#: src/anduinos_control_panel/prediction_settings.py:142
msgid "Cancel"
msgstr "Odustani"

#: src/anduinos_control_panel/app.py:596 src/anduinos_control_panel/app.py:1510
#: src/anduinos_control_panel/prediction_settings.py:46
msgid "Install"
msgstr "Instaliraj"

#: src/anduinos_control_panel/app.py:605
#, python-format
msgid "Installing %s…"
msgstr "Instaliranje komponente %s…"

#: src/anduinos_control_panel/app.py:614
#, python-format
msgid "%s installed"
msgstr "%s je instaliran"

#: src/anduinos_control_panel/app.py:621 src/anduinos_control_panel/app.py:849
#: src/anduinos_control_panel/app.py:947
#: src/anduinos_control_panel/software_sources.py:552
msgid "Authentication was cancelled."
msgstr "Autentifikacija je otkazana."

#: src/anduinos_control_panel/app.py:623
msgid "The recommended component could not be installed."
msgstr "Nije moguće instalirati preporučenu komponentu."

#: src/anduinos_control_panel/app.py:624
msgid "Installation failed"
msgstr "Instalacija nije uspjela"

#: src/anduinos_control_panel/app.py:672
#: src/anduinos_control_panel/topics.py:86
msgid "Startup and Boot"
msgstr "Pokretanje sustava"

#: src/anduinos_control_panel/app.py:690
msgid "Boot menu"
msgstr "Izbornik pokretanja"

#: src/anduinos_control_panel/app.py:692
msgid "Choose how long the boot menu waits before starting the default system."
msgstr "Odaberite koliko dugo izbornik čeka prije pokretanja zadanog sustava."

#: src/anduinos_control_panel/app.py:697
msgid "Default operating system"
msgstr "Zadani operacijski sustav"

#: src/anduinos_control_panel/app.py:698
msgid "Starts automatically when the boot menu wait time ends."
msgstr "Automatski se pokreće nakon isteka vremena čekanja u izborniku."

#: src/anduinos_control_panel/app.py:700 src/anduinos_control_panel/app.py:830
msgid "Current setting (unchanged)"
msgstr "Trenutačna postavka (nepromijenjena)"

#: src/anduinos_control_panel/app.py:704 src/anduinos_control_panel/app.py:1173
#: src/anduinos_control_panel/app.py:1396
#: src/anduinos_control_panel/app.py:1625
#: src/anduinos_control_panel/app.py:1820
msgid "Retry"
msgstr "Pokušaj ponovno"

#: src/anduinos_control_panel/app.py:708
msgid "Authentication is required to read the boot menu."
msgstr "Za čitanje izbornika pokretanja potrebna je autentifikacija."

#: src/anduinos_control_panel/app.py:711
msgid "Boot menu wait time"
msgstr "Vrijeme čekanja izbornika pokretanja"

#: src/anduinos_control_panel/app.py:713
msgid "The same delay is used after an interrupted or unsuccessful startup."
msgstr ""
"Isto vrijeme čekanja koristi se nakon prekinutog ili neuspješnog pokretanja."

#: src/anduinos_control_panel/app.py:720
#, python-format
msgid "%d seconds"
msgstr "%d s"

#: src/anduinos_control_panel/app.py:732
msgid "Boot display"
msgstr "Prikaz pri pokretanju"

#: src/anduinos_control_panel/app.py:734
msgid "Choose the size of the GRUB menu and startup logo."
msgstr "Odaberite veličinu GRUB izbornika i logotipa pri pokretanju."

#: src/anduinos_control_panel/app.py:736
msgid ""
"High resolution can make menu text small on 4K displays; the screen's native "
"resolution is not guaranteed at boot."
msgstr ""
"Visoka razlučivost može smanjiti tekst izbornika na 4K zaslonima; izvorna "
"razlučivost zaslona nije zajamčena pri pokretanju."

#: src/anduinos_control_panel/app.py:740
msgid "Display mode"
msgstr "Način prikaza"

#: src/anduinos_control_panel/app.py:747
msgid "High resolution (if available)"
msgstr "Visoka razlučivost (ako je dostupna)"

#: src/anduinos_control_panel/app.py:747
#: src/anduinos_control_panel/software_sources.py:394
msgid "Automatic"
msgstr "Automatski"

#: src/anduinos_control_panel/app.py:747
msgid "Large text mode"
msgstr "Način s velikim tekstom"

#: src/anduinos_control_panel/app.py:769 src/anduinos_control_panel/app.py:1157
#: src/anduinos_control_panel/app.py:1380
#: src/anduinos_control_panel/app.py:1607
#: src/anduinos_control_panel/app.py:1799
msgid "Close"
msgstr "Zatvori"

#: src/anduinos_control_panel/app.py:771 src/anduinos_control_panel/app.py:1716
#: src/anduinos_control_panel/app.py:1720
msgid "Apply"
msgstr "Primijeni"

#: src/anduinos_control_panel/app.py:827
msgid "Custom setting (unchanged)"
msgstr "Prilagođena postavka (nepromijenjena)"

#: src/anduinos_control_panel/app.py:842
msgid "Only operating systems already in the boot menu are listed."
msgstr ""
"Prikazani su samo operacijski sustavi koji se već nalaze u izborniku "
"pokretanja."

#: src/anduinos_control_panel/app.py:843
msgid "No supported operating systems were found in the boot menu."
msgstr "U izborniku pokretanja nisu pronađeni podržani operacijski sustavi."

#: src/anduinos_control_panel/app.py:846 src/anduinos_control_panel/app.py:850
msgid "The boot menu could not be read."
msgstr "Nije moguće pročitati izbornik pokretanja."

#: src/anduinos_control_panel/app.py:861
msgid "Reading the boot menu…"
msgstr "Čitanje izbornika pokretanja…"

#: src/anduinos_control_panel/app.py:916
msgid "Updating the boot menu…"
msgstr "Ažuriranje izbornika pokretanja…"

#: src/anduinos_control_panel/app.py:939
msgid "Boot settings updated. The change applies on the next startup."
msgstr ""
"Postavke pokretanja ažurirane su. Promjena se primjenjuje pri sljedećem "
"pokretanju."

#: src/anduinos_control_panel/app.py:942
msgid "Boot settings updated"
msgstr "Postavke pokretanja ažurirane su"

#: src/anduinos_control_panel/app.py:949
msgid "The boot setting could not be changed."
msgstr "Nije moguće promijeniti postavku pokretanja."

#: src/anduinos_control_panel/app.py:981
msgid "This application is available from the app store."
msgstr "Ova je aplikacija dostupna u trgovini aplikacija."

#: src/anduinos_control_panel/app.py:984
msgid "Open App Store"
msgstr "Otvori trgovinu aplikacija"

#: src/anduinos_control_panel/app.py:1028
msgid "Bottles"
msgstr "Bottles"

#: src/anduinos_control_panel/app.py:1030
msgid ""
"Run Windows applications in isolated compatibility environments powered by "
"Wine and Bottles."
msgstr ""
"Pokrećite aplikacije sustava Windows u izoliranim okruženjima za "
"kompatibilnost pomoću Winea i Bottlesa."

#: src/anduinos_control_panel/app.py:1035
msgid "Install Bottles"
msgstr "Instaliraj Bottles"

#: src/anduinos_control_panel/app.py:1036
msgid "Downloads Bottles and its runtime from Flathub"
msgstr "Preuzima Bottles i njegovo izvršno okruženje s Flathuba"

#: src/anduinos_control_panel/app.py:1052
#: src/anduinos_control_panel/app.py:1275
#: src/anduinos_control_panel/app.py:1478
#: src/anduinos_control_panel/app.py:1682
#: src/anduinos_control_panel/prediction_settings.py:84
msgid "Advanced Output"
msgstr "Detaljan ispis"

#: src/anduinos_control_panel/app.py:1086
#: src/anduinos_control_panel/app.py:1309
msgid "Start"
msgstr "Pokreni"

#: src/anduinos_control_panel/app.py:1128
#: src/anduinos_control_panel/app.py:1351
#: src/anduinos_control_panel/app.py:1547
msgid "Installing…"
msgstr "Instaliranje…"

#: src/anduinos_control_panel/app.py:1130
msgid "Downloading and installing Bottles… This may take a few minutes."
msgstr ""
"Preuzimanje i instaliranje Bottlesa… To može potrajati nekoliko minuta."

#: src/anduinos_control_panel/app.py:1135
msgid "Preparing Flathub and Bottles installation…"
msgstr "Priprema instalacije Flathuba i Bottlesa…"

#: src/anduinos_control_panel/app.py:1149
msgid "✓ Bottles is ready."
msgstr "✓ Bottles je spreman."

#: src/anduinos_control_panel/app.py:1153
#: src/anduinos_control_panel/app.py:1376
#: src/anduinos_control_panel/app.py:1574
#: src/anduinos_control_panel/app.py:1795
msgid "✓ Installation completed successfully."
msgstr "✓ Instalacija je uspješno dovršena."

#: src/anduinos_control_panel/app.py:1155
msgid "Open Bottles"
msgstr "Otvori Bottles"

#: src/anduinos_control_panel/app.py:1160
msgid "Bottles installed"
msgstr "Bottles je instaliran"

#: src/anduinos_control_panel/app.py:1166
#: src/anduinos_control_panel/app.py:1389
#: src/anduinos_control_panel/app.py:1618
msgid "✗ Installation failed. Review Advanced Output."
msgstr "✗ Instalacija nije uspjela. Provjerite detaljan ispis."

#: src/anduinos_control_panel/app.py:1171
#: src/anduinos_control_panel/app.py:1394
#: src/anduinos_control_panel/app.py:1623
#: src/anduinos_control_panel/app.py:1818
msgid "✗ Operation failed: "
msgstr "✗ Radnja nije uspjela: "

#: src/anduinos_control_panel/app.py:1206
msgid "Deja Dup Backups"
msgstr "Sigurnosne kopije Deja Dup"

#: src/anduinos_control_panel/app.py:1215
msgid "Factory Reset Is Not Available"
msgstr "Vraćanje na tvorničke postavke nije dostupno"

#: src/anduinos_control_panel/app.py:1217
msgid ""
"This system does not support factory reset. Reinstall AnduinOS and choose "
"the Btrfs filesystem to enable it."
msgstr ""
"Ovaj sustav ne podržava vraćanje na tvorničke postavke. Ponovno instalirajte "
"AnduinOS i odaberite datotečni sustav Btrfs kako biste omogućili tu "
"mogućnost."

#: src/anduinos_control_panel/app.py:1233
#: src/anduinos_control_panel/topics.py:272
msgid "Permission Settings"
msgstr "Postavke dopuštenja"

#: src/anduinos_control_panel/app.py:1251
msgid "Flatseal"
msgstr "Flatseal"

#: src/anduinos_control_panel/app.py:1253
msgid ""
"Review and control what files, devices, network connections, and services "
"Flatpak applications can access."
msgstr ""
"Pregledajte i kontrolirajte kojim datotekama, uređajima, mrežnim vezama i "
"uslugama aplikacije Flatpak mogu pristupiti."

#: src/anduinos_control_panel/app.py:1258
msgid "Install Flatseal"
msgstr "Instaliraj Flatseal"

#: src/anduinos_control_panel/app.py:1260
msgid "Administrator authentication is required when installation starts"
msgstr "Pri početku instalacije potrebna je administratorska autentifikacija"

#: src/anduinos_control_panel/app.py:1352
msgid "Downloading and installing Flatseal…"
msgstr "Preuzimanje i instaliranje Flatseala…"

#: src/anduinos_control_panel/app.py:1357
msgid "Preparing Flatseal installation…"
msgstr "Priprema instalacije Flatseala…"

#: src/anduinos_control_panel/app.py:1372
msgid "✓ Flatseal is ready."
msgstr "✓ Flatseal je spreman."

#: src/anduinos_control_panel/app.py:1378
msgid "Open Flatseal"
msgstr "Otvori Flatseal"

#: src/anduinos_control_panel/app.py:1383
msgid "Flatseal installed"
msgstr "Flatseal je instaliran"

#: src/anduinos_control_panel/app.py:1425
msgid "Install Voice Typing"
msgstr "Instaliraj glasovno tipkanje"

#: src/anduinos_control_panel/app.py:1443
msgid "Offline Voice Typing"
msgstr "Izvanmrežno glasovno tipkanje"

#: src/anduinos_control_panel/app.py:1445
msgid ""
"Press Super + H to dictate into browsers, editors, messages, terminals, and "
"other applications. Audio stays on this computer."
msgstr ""
"Pritisnite Super + H za diktiranje u preglednicima, uređivačima, porukama, "
"terminalima i drugim aplikacijama. Zvuk ostaje na ovom računalu."

#: src/anduinos_control_panel/app.py:1450
msgid "Private by default"
msgstr "Privatnost je uključena prema zadanim postavkama"

#: src/anduinos_control_panel/app.py:1451
msgid "Speech is recognized locally with whisper.cpp"
msgstr "Govor se prepoznaje lokalno pomoću whisper.cpp-a"

#: src/anduinos_control_panel/app.py:1456
msgid "About 140 MB to download"
msgstr "Približno 140 MB za preuzimanje"

#: src/anduinos_control_panel/app.py:1458
msgid ""
"Includes the multilingual Base model; optional models are available later"
msgstr "Uključuje višejezični model Base; dodatni modeli dostupni su naknadno"

#: src/anduinos_control_panel/app.py:1467
#: src/anduinos_control_panel/prediction_settings.py:177
msgid "Administrator authentication is required when installation starts."
msgstr "Pri početku instalacije potrebna je administratorska autentifikacija."

#: src/anduinos_control_panel/app.py:1552
msgid "Downloading the local engine and multilingual speech model…"
msgstr "Preuzimanje lokalnog mehanizma i višejezičnog modela za govor…"

#: src/anduinos_control_panel/app.py:1558
msgid "Preparing Voice Typing installation…"
msgstr "Priprema instalacije glasovnog tipkanja…"

#: src/anduinos_control_panel/app.py:1601
msgid ""
"✓ Installed. Sign out and back in once, then press Super + H to start Voice "
"Typing."
msgstr ""
"✓ Instalirano. Odjavite se i ponovno prijavite, a zatim pritisnite Super + H "
"za pokretanje glasovnog tipkanja."

#: src/anduinos_control_panel/app.py:1605
msgid "Open Settings"
msgstr "Otvori postavke"

#: src/anduinos_control_panel/app.py:1611
msgid "Voice Typing installed — sign out to finish"
msgstr "Glasovno tipkanje je instalirano — odjavite se za dovršetak"

#: src/anduinos_control_panel/app.py:1642
#: src/anduinos_control_panel/topics.py:281
msgid "On-device AI"
msgstr "Umjetna inteligencija na uređaju"

#: src/anduinos_control_panel/app.py:1660
msgid "Why AI"
msgstr "Why AI"

#: src/anduinos_control_panel/app.py:1662
msgid ""
"Run the Why AI assistant locally. The model and runtime are installed only "
"when this option is enabled."
msgstr ""
"Pokrenite pomoćnika Why AI lokalno. Model i izvršno okruženje instaliraju se "
"samo kada je ova mogućnost omogućena."

#: src/anduinos_control_panel/app.py:1667
msgid "Install on-device AI"
msgstr "Instaliraj umjetnu inteligenciju na uređaju"

#: src/anduinos_control_panel/app.py:1668
msgid "Enable the local Why AI stack on this computer"
msgstr "Omogućite lokalne alate Why AI na ovom računalu"

#: src/anduinos_control_panel/app.py:1762
msgid "Applying…"
msgstr "Primjenjivanje…"

#: src/anduinos_control_panel/app.py:1764
msgid "Downloading and installing Why AI… This may take about 10 minutes."
msgstr "Preuzimanje i instaliranje Why AI-ja… To može potrajati oko 10 minuta."

#: src/anduinos_control_panel/app.py:1766
msgid "Disabling the local Why AI stack…"
msgstr "Onemogućavanje lokalnih alata Why AI…"

#: src/anduinos_control_panel/app.py:1773
msgid "Preparing package operation…"
msgstr "Priprema radnje nad paketom…"

#: src/anduinos_control_panel/app.py:1787
msgid "✓ On-device AI is ready."
msgstr "✓ Umjetna inteligencija na uređaju spremna je."

#: src/anduinos_control_panel/app.py:1789
msgid "✓ On-device AI is disabled."
msgstr "✓ Umjetna inteligencija na uređaju onemogućena je."

#: src/anduinos_control_panel/app.py:1795
msgid "✓ Change completed successfully."
msgstr "✓ Promjena je uspješno dovršena."

#: src/anduinos_control_panel/app.py:1804
msgid "On-device AI enabled"
msgstr "Umjetna inteligencija na uređaju omogućena je"

#: src/anduinos_control_panel/app.py:1806
