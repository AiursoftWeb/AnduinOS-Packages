msgid "Install"
msgstr "Установить"

#: src/anduinos_control_panel/app.py:570
#, python-format
msgid "Installing %s…"
msgstr "Установка %s…"

#: src/anduinos_control_panel/app.py:579
#, python-format
msgid "%s installed"
msgstr "Установлено: %s"

#: src/anduinos_control_panel/app.py:586 src/anduinos_control_panel/app.py:811
#: src/anduinos_control_panel/app.py:909
msgid "Authentication was cancelled."
msgstr "Аутентификация была отменена."

#: src/anduinos_control_panel/app.py:588
msgid "The recommended component could not be installed."
msgstr "Не удалось установить рекомендуемый компонент."

#: src/anduinos_control_panel/app.py:589
msgid "Installation failed"
msgstr "Ошибка установки"

#: src/anduinos_control_panel/app.py:637
#: src/anduinos_control_panel/topics.py:86
msgid "Startup and Boot"
msgstr "Запуск и загрузка"

#: src/anduinos_control_panel/app.py:655
msgid "Boot menu"
msgstr "Меню загрузки"

#: src/anduinos_control_panel/app.py:657
msgid ""
"Choose how long the boot menu waits before starting the default system."
msgstr ""
"Выберите, сколько времени меню загрузки будет ждать перед запуском системы "
"по умолчанию."

#: src/anduinos_control_panel/app.py:662
msgid "Default operating system"
msgstr "Операционная система по умолчанию"

#: src/anduinos_control_panel/app.py:663
msgid "Starts automatically when the boot menu wait time ends."
msgstr ""
"Запускается автоматически по окончании времени ожидания в меню загрузки."

#: src/anduinos_control_panel/app.py:665 src/anduinos_control_panel/app.py:792
msgid "Current setting (unchanged)"
msgstr "Текущая настройка (без изменений)"

#: src/anduinos_control_panel/app.py:669
#: src/anduinos_control_panel/app.py:1135
#: src/anduinos_control_panel/app.py:1342
#: src/anduinos_control_panel/app.py:1561
#: src/anduinos_control_panel/app.py:1756
msgid "Retry"
msgstr "Повторить"

#: src/anduinos_control_panel/app.py:673
msgid "Authentication is required to read the boot menu."
msgstr "Для чтения меню загрузки требуется аутентификация."

#: src/anduinos_control_panel/app.py:676
msgid "Boot menu wait time"
msgstr "Время ожидания меню загрузки"

#: src/anduinos_control_panel/app.py:678
msgid "The same delay is used after an interrupted or unsuccessful startup."
msgstr "Та же задержка используется после прерванной или неудачной загрузки."

#: src/anduinos_control_panel/app.py:685
#, python-format
msgid "%d seconds"
msgstr "%d сек."

#: src/anduinos_control_panel/app.py:693
msgid "Boot display"
msgstr "Отображение при загрузке"

#: src/anduinos_control_panel/app.py:695
msgid "Choose the size of the GRUB menu and startup logo."
msgstr "Выберите размер меню GRUB и логотипа загрузки."

#: src/anduinos_control_panel/app.py:699
msgid "Display mode"
msgstr "Режим отображения"

#: src/anduinos_control_panel/app.py:701
msgid "Native resolution shows more detail; large text is easier to read."
msgstr ""
"При родном разрешении видно больше деталей; крупный текст легче читать."

#: src/anduinos_control_panel/app.py:709
msgid "Native resolution"
msgstr "Родное разрешение"

#: src/anduinos_control_panel/app.py:709
msgid "Large text mode"
msgstr "Крупный текст"

#: src/anduinos_control_panel/app.py:731
#: src/anduinos_control_panel/app.py:1119
#: src/anduinos_control_panel/app.py:1326
#: src/anduinos_control_panel/app.py:1543
#: src/anduinos_control_panel/app.py:1735
msgid "Close"
msgstr "Закрыть"

#: src/anduinos_control_panel/app.py:733
#: src/anduinos_control_panel/app.py:1652
#: src/anduinos_control_panel/app.py:1656
msgid "Apply"
msgstr "Применить"

#: src/anduinos_control_panel/app.py:789
msgid "Custom setting (unchanged)"
msgstr "Пользовательская настройка (без изменений)"

#: src/anduinos_control_panel/app.py:804
msgid "Only operating systems already in the boot menu are listed."
msgstr ""
"В списке отображаются только операционные системы, уже присутствующие в "
"загрузочном меню."

#: src/anduinos_control_panel/app.py:805
msgid "No supported operating systems were found in the boot menu."
msgstr "В загрузочном меню не найдено поддерживаемых операционных систем."

#: src/anduinos_control_panel/app.py:808 src/anduinos_control_panel/app.py:812
msgid "The boot menu could not be read."
msgstr "Не удалось прочитать меню загрузки."

#: src/anduinos_control_panel/app.py:823
msgid "Reading the boot menu…"
msgstr "Чтение загрузочного меню…"

#: src/anduinos_control_panel/app.py:878
msgid "Updating the boot menu…"
msgstr "Обновление меню загрузки…"

#: src/anduinos_control_panel/app.py:901
msgid "Boot settings updated. The change applies on the next startup."
msgstr ""
"Настройки загрузки обновлены. Изменение вступит в силу при следующей "
"загрузке."

#: src/anduinos_control_panel/app.py:904
msgid "Boot settings updated"
msgstr "Настройки загрузки обновлены"

#: src/anduinos_control_panel/app.py:911
msgid "The boot setting could not be changed."
msgstr "Не удалось изменить настройку загрузки."

#: src/anduinos_control_panel/app.py:943
msgid "This application is available from the app store."
msgstr "Это приложение доступно в магазине приложений."

#: src/anduinos_control_panel/app.py:946
msgid "Open App Store"
msgstr "Открыть магазин приложений"

#: src/anduinos_control_panel/app.py:990
msgid "Bottles"
msgstr "Bottles"

#: src/anduinos_control_panel/app.py:992
msgid ""
"Run Windows applications in isolated compatibility environments powered by "
"Wine and Bottles."
msgstr ""
"Запускайте приложения Windows в изолированных средах совместимости на базе "
"Wine и Bottles."

#: src/anduinos_control_panel/app.py:997
msgid "Install Bottles"
msgstr "Установить Bottles"

#: src/anduinos_control_panel/app.py:998
msgid "Downloads Bottles and its runtime from Flathub"
msgstr "Скачивает Bottles и его среду выполнения из Flathub"

#: src/anduinos_control_panel/app.py:1014
#: src/anduinos_control_panel/app.py:1221
#: src/anduinos_control_panel/app.py:1414
#: src/anduinos_control_panel/app.py:1618
msgid "Advanced Output"
msgstr "Дополнительный вывод"

#: src/anduinos_control_panel/app.py:1048
#: src/anduinos_control_panel/app.py:1255
msgid "Start"
msgstr "Начать"

#: src/anduinos_control_panel/app.py:1090
#: src/anduinos_control_panel/app.py:1297
#: src/anduinos_control_panel/app.py:1483
msgid "Installing…"
msgstr "Установка…"

#: src/anduinos_control_panel/app.py:1092
msgid "Downloading and installing Bottles… This may take a few minutes."
msgstr "Скачивание и установка Bottles… Это может занять несколько минут."

#: src/anduinos_control_panel/app.py:1097
msgid "Preparing Flathub and Bottles installation…"
msgstr "Подготовка к установке Flathub и Bottles…"

#: src/anduinos_control_panel/app.py:1111
msgid "✓ Bottles is ready."
msgstr "✓ Bottles готов."

#: src/anduinos_control_panel/app.py:1115
#: src/anduinos_control_panel/app.py:1322
#: src/anduinos_control_panel/app.py:1510
#: src/anduinos_control_panel/app.py:1731
msgid "✓ Installation completed successfully."
msgstr "✓ Установка успешно завершена."

#: src/anduinos_control_panel/app.py:1117
msgid "Open Bottles"
msgstr "Открыть Bottles"

#: src/anduinos_control_panel/app.py:1122
msgid "Bottles installed"
msgstr "Bottles установлен"

#: src/anduinos_control_panel/app.py:1128
#: src/anduinos_control_panel/app.py:1335
#: src/anduinos_control_panel/app.py:1554
msgid "✗ Installation failed. Review Advanced Output."
msgstr "✗ Ошибка установки. Просмотрите Дополнительный вывод."

#: src/anduinos_control_panel/app.py:1133
#: src/anduinos_control_panel/app.py:1340
#: src/anduinos_control_panel/app.py:1559
#: src/anduinos_control_panel/app.py:1754
msgid "✗ Operation failed: "
msgstr "✗ Операция не выполнена: "

#: src/anduinos_control_panel/app.py:1165
msgid "Deja Dup Backups"
msgstr "Резервные копии Deja Dup"

#: src/anduinos_control_panel/app.py:1179
#: src/anduinos_control_panel/topics.py:245
msgid "Permission Settings"
msgstr "Настройки разрешений"

#: src/anduinos_control_panel/app.py:1197
msgid "Flatseal"
msgstr "Flatseal"

#: src/anduinos_control_panel/app.py:1199
msgid ""
"Review and control what files, devices, network connections, and services "
"Flatpak applications can access."
msgstr ""
"Просматривайте и управляйте доступом приложений Flatpak к файлам, "
"устройствам, сетевым соединениям и службам."

#: src/anduinos_control_panel/app.py:1204
msgid "Install Flatseal"
msgstr "Установить Flatseal"

#: src/anduinos_control_panel/app.py:1206
msgid "Administrator authentication is required when installation starts"
msgstr "Для начала установки требуется аутентификация администратора"

#: src/anduinos_control_panel/app.py:1298
msgid "Downloading and installing Flatseal…"
msgstr "Скачивание и установка Flatseal…"

#: src/anduinos_control_panel/app.py:1303
msgid "Preparing Flatseal installation…"
msgstr "Подготовка к установке Flatseal…"

#: src/anduinos_control_panel/app.py:1318
msgid "✓ Flatseal is ready."
msgstr "✓ Flatseal готов."

#: src/anduinos_control_panel/app.py:1324
msgid "Open Flatseal"
msgstr "Открыть Flatseal"

#: src/anduinos_control_panel/app.py:1329
msgid "Flatseal installed"
msgstr "Flatseal установлен"

#: src/anduinos_control_panel/app.py:1361
msgid "Install Voice Typing"
msgstr "Установить голосовой ввод"

#: src/anduinos_control_panel/app.py:1379
msgid "Offline Voice Typing"
msgstr "Автономный голосовой ввод"

#: src/anduinos_control_panel/app.py:1381
msgid ""
"Press Super + H to dictate into browsers, editors, messages, terminals, and "
"other applications. Audio stays on this computer."
msgstr ""
"Нажмите Super + H, чтобы вводить текст голосом в браузерах, редакторах, "
"мессенджерах, терминалах и других приложениях. Аудиоданные остаются на этом "
"компьютере."

#: src/anduinos_control_panel/app.py:1386
msgid "Private by default"
msgstr "Конфиденциально по умолчанию"

#: src/anduinos_control_panel/app.py:1387
msgid "Speech is recognized locally with whisper.cpp"
msgstr "Речь распознаётся на этом компьютере с помощью whisper.cpp"

#: src/anduinos_control_panel/app.py:1392
msgid "About 140 MB to download"
msgstr "Размер загрузки — около 140 МБ"

#: src/anduinos_control_panel/app.py:1394
msgid ""
"Includes the multilingual Base model; optional models are available later"
msgstr ""
"Включает многоязычную модель Base; дополнительные модели станут доступны "
"позже"

#: src/anduinos_control_panel/app.py:1403
msgid "Administrator authentication is required when installation starts."
msgstr "Для начала установки требуется аутентификация администратора."

#: src/anduinos_control_panel/app.py:1488
msgid "Downloading the local engine and multilingual speech model…"
msgstr ""
"Скачивание локального движка и многоязычной модели распознавания речи…"

#: src/anduinos_control_panel/app.py:1494
msgid "Preparing Voice Typing installation…"
msgstr "Подготовка к установке голосового ввода…"

#: src/anduinos_control_panel/app.py:1537
msgid ""
"✓ Installed. Sign out and back in once, then press Super + H to start Voice "
"Typing."
msgstr ""
"✓ Установлено. Выйдите из системы и снова войдите, затем нажмите Super + H, "
"чтобы начать голосовой ввод."

#: src/anduinos_control_panel/app.py:1541
msgid "Open Settings"
msgstr "Открыть настройки"

#: src/anduinos_control_panel/app.py:1547
msgid "Voice Typing installed — sign out to finish"
msgstr ""
"Голосовой ввод установлен — выйдите из системы, чтобы завершить установку"

#: src/anduinos_control_panel/app.py:1578
#: src/anduinos_control_panel/topics.py:254
msgid "On-device AI"
msgstr "ИИ на устройстве"

#: src/anduinos_control_panel/app.py:1596
msgid "Why AI"
msgstr "Why AI"

#: src/anduinos_control_panel/app.py:1598
msgid ""
"Run the Why AI assistant locally. The model and runtime are installed only "
"when this option is enabled."
msgstr ""
"Запускайте ассистента Why AI на этом компьютере. Модель и среда выполнения "
"устанавливаются только при включении этой опции."

#: src/anduinos_control_panel/app.py:1603
msgid "Install on-device AI"
msgstr "Установить ИИ на устройстве"

#: src/anduinos_control_panel/app.py:1604
msgid "Enable the local Why AI stack on this computer"
msgstr "Включить локальный стек Why AI на этом компьютере"

#: src/anduinos_control_panel/app.py:1698
msgid "Applying…"
msgstr "Применение…"

#: src/anduinos_control_panel/app.py:1700
msgid "Downloading and installing Why AI… This may take about 10 minutes."
msgstr "Скачивание и установка Why AI… Это может занять около 10 минут."

#: src/anduinos_control_panel/app.py:1702
msgid "Disabling the local Why AI stack…"
msgstr "Отключение локального стека Why AI…"

#: src/anduinos_control_panel/app.py:1709
msgid "Preparing package operation…"
msgstr "Подготовка к операции с пакетом…"

#: src/anduinos_control_panel/app.py:1723
msgid "✓ On-device AI is ready."
msgstr "✓ ИИ на устройстве готов."

#: src/anduinos_control_panel/app.py:1725
msgid "✓ On-device AI is disabled."
msgstr "✓ ИИ на устройстве отключен."

#: src/anduinos_control_panel/app.py:1731
msgid "✓ Change completed successfully."
msgstr "✓ Изменение успешно выполнено."

#: src/anduinos_control_panel/app.py:1740
msgid "On-device AI enabled"
msgstr "ИИ на устройстве включен"

#: src/anduinos_control_panel/app.py:1742
msgid "On-device AI disabled"
msgstr "ИИ на устройстве отключен"

#: src/anduinos_control_panel/app.py:1750
