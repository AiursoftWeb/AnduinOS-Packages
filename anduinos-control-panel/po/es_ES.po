msgstr ""
"Revise y controle a qué archivos, dispositivos, conexiones de red y "
"servicios pueden acceder las aplicaciones Flatpak."

#: src/anduinos_control_panel/app.py:1092
msgid "Install Flatseal"
msgstr "Instalar Flatseal"

#: src/anduinos_control_panel/app.py:1094
msgid "Administrator authentication is required when installation starts"
msgstr "Se requiere autenticación de administrador al iniciar la instalación"

#: src/anduinos_control_panel/app.py:1186
