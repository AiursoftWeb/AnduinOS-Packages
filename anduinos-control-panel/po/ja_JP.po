msgstr "推奨コンポーネントをインストールできませんでした。"

#: src/anduinos_control_panel/app.py:624
msgid "Installation failed"
msgstr "インストールに失敗しました"

#: src/anduinos_control_panel/app.py:672
#: src/anduinos_control_panel/topics.py:86
msgid "Startup and Boot"
msgstr "システム起動"

#: src/anduinos_control_panel/app.py:690
msgid "Boot menu"
msgstr "ブートメニュー"

#: src/anduinos_control_panel/app.py:692
msgid "Choose how long the boot menu waits before starting the default system."
msgstr ""
"ブートメニューがデフォルトのシステムを起動するまでの待機時間を選択します。"

#: src/anduinos_control_panel/app.py:697
msgid "Default operating system"
msgstr "デフォルトのオペレーティングシステム"

#: src/anduinos_control_panel/app.py:698
msgid "Starts automatically when the boot menu wait time ends."
msgstr "ブートメニューの待機時間が終了すると自動的に開始されます。"

#: src/anduinos_control_panel/app.py:700 src/anduinos_control_panel/app.py:830
msgid "Current setting (unchanged)"
msgstr "現在の設定（変更なし）"

#: src/anduinos_control_panel/app.py:704 src/anduinos_control_panel/app.py:1173
#: src/anduinos_control_panel/app.py:1396
#: src/anduinos_control_panel/app.py:1625
#: src/anduinos_control_panel/app.py:1820
msgid "Retry"
msgstr "再試行"

#: src/anduinos_control_panel/app.py:708
msgid "Authentication is required to read the boot menu."
msgstr "ブートメニューを読み取るには認証が必要です。"

#: src/anduinos_control_panel/app.py:711
msgid "Boot menu wait time"
msgstr "ブートメニューの待機時間"

#: src/anduinos_control_panel/app.py:713
msgid "The same delay is used after an interrupted or unsuccessful startup."
msgstr "中断または失敗した起動後にも、同じ待機時間が使用されます。"

#: src/anduinos_control_panel/app.py:720
#, python-format
msgid "%d seconds"
msgstr "%d 秒"

#: src/anduinos_control_panel/app.py:732
msgid "Boot display"
msgstr "ブート表示"

#: src/anduinos_control_panel/app.py:734
msgid "Choose the size of the GRUB menu and startup logo."
msgstr "GRUBメニューと起動ロゴのサイズを選択します。"

#: src/anduinos_control_panel/app.py:736
msgid ""
"High resolution can make menu text small on 4K displays; the screen's native "
"resolution is not guaranteed at boot."
msgstr "高解像度では4Kディスプレイ上のメニュー文字が小さく見えることがあります。起動時に画面のネイティブ解像度を使用できるとは限りません。"

#: src/anduinos_control_panel/app.py:740
msgid "Display mode"
msgstr "表示モード"

#: src/anduinos_control_panel/app.py:747
msgid "High resolution (if available)"
msgstr "高解像度（利用可能な場合）"

#: src/anduinos_control_panel/app.py:747
msgid "Automatic"
msgstr "自動"

#: src/anduinos_control_panel/app.py:747
msgid "Large text mode"
msgstr "大きな文字モード"

#: src/anduinos_control_panel/app.py:769 src/anduinos_control_panel/app.py:1157
#: src/anduinos_control_panel/app.py:1380
#: src/anduinos_control_panel/app.py:1607
#: src/anduinos_control_panel/app.py:1799
msgid "Close"
msgstr "閉じる"

#: src/anduinos_control_panel/app.py:771 src/anduinos_control_panel/app.py:1716
#: src/anduinos_control_panel/app.py:1720
msgid "Apply"
msgstr "適用"

#: src/anduinos_control_panel/app.py:827
msgid "Custom setting (unchanged)"
msgstr "カスタム設定（変更なし）"

#: src/anduinos_control_panel/app.py:842
msgid "Only operating systems already in the boot menu are listed."
msgstr ""
"ブートメニューに既に登録されているオペレーティングシステムのみがリストされま"
"す。"

#: src/anduinos_control_panel/app.py:843
msgid "No supported operating systems were found in the boot menu."
msgstr ""
"ブートメニューで対応するオペレーティングシステムが見つかりませんでした。"

#: src/anduinos_control_panel/app.py:846 src/anduinos_control_panel/app.py:850
msgid "The boot menu could not be read."
msgstr "ブートメニューを読み取れません。"

#: src/anduinos_control_panel/app.py:861
msgid "Reading the boot menu…"
msgstr "ブートメニューを読み取っています…"

#: src/anduinos_control_panel/app.py:916
msgid "Updating the boot menu…"
msgstr "ブートメニューを更新しています…"

#: src/anduinos_control_panel/app.py:939
msgid "Boot settings updated. The change applies on the next startup."
msgstr "ブート設定が更新されました。変更は次回起動時に適用されます。"

#: src/anduinos_control_panel/app.py:942
msgid "Boot settings updated"
msgstr "ブート設定が更新されました"

#: src/anduinos_control_panel/app.py:949
msgid "The boot setting could not be changed."
msgstr "ブート設定を変更できませんでした。"

#: src/anduinos_control_panel/app.py:981
msgid "This application is available from the app store."
msgstr "このアプリケーションはアプリストアから利用できます。"

#: src/anduinos_control_panel/app.py:984
msgid "Open App Store"
msgstr "アプリストアを開く"

#: src/anduinos_control_panel/app.py:1028
msgid "Bottles"
msgstr "Bottles"

#: src/anduinos_control_panel/app.py:1030
msgid ""
"Run Windows applications in isolated compatibility environments powered by "
"Wine and Bottles."
msgstr ""
"Wine と Bottles を使用して、隔離された互換性環境で Windows アプリケーションを"
"実行します。"

#: src/anduinos_control_panel/app.py:1035
msgid "Install Bottles"
msgstr "Bottles をインストール"

#: src/anduinos_control_panel/app.py:1036
msgid "Downloads Bottles and its runtime from Flathub"
msgstr "Bottles とそのランタイムを Flathub からダウンロードします"

#: src/anduinos_control_panel/app.py:1052
#: src/anduinos_control_panel/app.py:1275
#: src/anduinos_control_panel/app.py:1478
#: src/anduinos_control_panel/app.py:1682
#: src/anduinos_control_panel/prediction_settings.py:84
msgid "Advanced Output"
msgstr "詳細出力"

#: src/anduinos_control_panel/app.py:1086
#: src/anduinos_control_panel/app.py:1309
msgid "Start"
msgstr "開始"

#: src/anduinos_control_panel/app.py:1128
#: src/anduinos_control_panel/app.py:1351
#: src/anduinos_control_panel/app.py:1547
msgid "Installing…"
msgstr "インストール中…"

#: src/anduinos_control_panel/app.py:1130
msgid "Downloading and installing Bottles… This may take a few minutes."
msgstr ""
"Bottles をダウンロードしてインストールしています… 数分かかる場合があります。"

#: src/anduinos_control_panel/app.py:1135
msgid "Preparing Flathub and Bottles installation…"
msgstr "Flathub と Bottles のインストール準備中…"

#: src/anduinos_control_panel/app.py:1149
msgid "✓ Bottles is ready."
msgstr "✓ Bottles の準備ができました。"

#: src/anduinos_control_panel/app.py:1153
#: src/anduinos_control_panel/app.py:1376
#: src/anduinos_control_panel/app.py:1574
#: src/anduinos_control_panel/app.py:1795
msgid "✓ Installation completed successfully."
msgstr "✓ インストールが正常に完了しました。"

#: src/anduinos_control_panel/app.py:1155
msgid "Open Bottles"
msgstr "Bottles を開く"

#: src/anduinos_control_panel/app.py:1160
msgid "Bottles installed"
msgstr "Bottles がインストールされました"

#: src/anduinos_control_panel/app.py:1166
#: src/anduinos_control_panel/app.py:1389
#: src/anduinos_control_panel/app.py:1618
msgid "✗ Installation failed. Review Advanced Output."
msgstr "✗ インストールに失敗しました。詳細出力を確認してください。"

#: src/anduinos_control_panel/app.py:1171
#: src/anduinos_control_panel/app.py:1394
#: src/anduinos_control_panel/app.py:1623
