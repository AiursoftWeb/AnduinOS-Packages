msgid "Updating the boot menu…"
msgstr "बूट मेनू अपडेट किया जा रहा है…"

#: src/anduinos_control_panel/app.py:901
msgid "Boot settings updated. The change applies on the next startup."
msgstr "बूट सेटिंग्स अपडेट हो गईं। बदलाव अगली बार स्टार्टअप पर लागू होगा।"

#: src/anduinos_control_panel/app.py:904
msgid "Boot settings updated"
msgstr "बूट सेटिंग्स अपडेट हो गईं।"

#: src/anduinos_control_panel/app.py:911
msgid "The boot setting could not be changed."
msgstr "बूट सेटिंग बदली नहीं जा सकी।"

#: src/anduinos_control_panel/app.py:943
msgid "This application is available from the app store."
msgstr "यह ऐप्लिकेशन ऐप स्टोर से उपलब्ध है।"

