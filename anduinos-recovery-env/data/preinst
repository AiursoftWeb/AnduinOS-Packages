#!/bin/sh
set -eu
# dpkg distinguishes reinstalls from upgrades here, but not in postinst.
state=/var/lib/anduinos-recovery-env/enable-on-reinstall
case "${1:-}" in
    install)
        if [ -n "${2:-}" ]; then
            mkdir -p /var/lib/anduinos-recovery-env
            : > "$state"
        else
            rm -f "$state"
        fi
        ;;
esac
