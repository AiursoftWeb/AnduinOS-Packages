#!/bin/sh
# Read-only facts for the recovery UI. Never source files from the installed OS.
export PATH=/usr/bin:/bin:/usr/sbin LC_ALL=C
umask 077
mountpoint=/run/recovery-information
mounted=0
cleanup() {
    if [ "$mounted" = 1 ]; then
        timeout -k 1 3 umount "$mountpoint" || exit 1
    fi
}
trap cleanup EXIT
trap 'exit 1' INT TERM
read_value() { [ -f "$1" ] && head -c 4096 "$1" 2>/dev/null || true; }
number() { awk 'NR == 1 && $1 ~ /^[0-9]+$/ {print $1}'; }
secure_boot='Unavailable'
if [ ! -d /sys/firmware/efi ]; then
    secure_boot='Not booted using UEFI'
else
    sb=$(od -An -tu1 -j4 -N1 /sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c 2>/dev/null | number)
    case "$sb" in 0) secure_boot=Disabled ;; 1) secure_boot=Enabled ;; esac
fi
computer=$(read_value /sys/class/dmi/id/product_name)
[ -n "$computer" ] || computer=$(read_value /proc/device-tree/model | tr -d '\000')
cpu=$(awk -F ': *' '/^(model name|Processor|Hardware)[[:space:]]*:/ {print $2; exit}' /proc/cpuinfo)
cpus=$(awk '/^processor[[:space:]]*:/ {n++} END {if (n) print n}' /proc/cpuinfo)
frequency=$(read_value /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq | number)
memory=$(awk '/^MemTotal:/ {print $2 * 1024}' /proc/meminfo)
version=$(read_value /etc/recovery-version)
kernel=$(uname -r)
uuid=
count=0
for arg in $(cat /proc/cmdline); do
    case "$arg" in anduinos.recovery.root=*) uuid=${arg#*=}; count=$((count + 1)) ;; esac
done
device= disk= model= capacity= temperature= os= total= free= available=
notice='The installed system could not be identified. Hardware information is still available.'
if [ "$count" = 1 ] && printf '%s\n' "$uuid" | grep -Eq '^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$'; then
    uuid=$(printf '%s' "$uuid" | tr A-F a-f)
    devices=$(timeout -k 1 3 blkid -c /dev/null -t "UUID=$uuid" -o device 2>/dev/null || true)
    set -- $devices
    if [ "$#" = 1 ] && [ -b "$1" ]; then
        device=$1
        block=$(readlink -f "/sys/class/block/${device##*/}")
        if [ -f "$block/partition" ]; then block=${block%/*}; fi
        disk=/dev/${block##*/}
        model=$(read_value "$block/device/model")
        capacity=$(read_value "$block/size" | number)
        for sensor in "$block"/device/hwmon/hwmon*/temp1_input; do
            temperature=$(read_value "$sensor" | number)
            [ -z "$temperature" ] || break
        done
        notice='The target filesystem could not be read. Space and system version are unavailable.'
        mkdir -p "$mountpoint"
        # Refuse to reuse an unexpected mount; never unmount another operation.
        if ! awk -v path="$mountpoint" '$5 == path {found=1} END {exit !found}' /proc/self/mountinfo &&
           timeout -k 1 3 mount -t btrfs -o ro,rescue=nologreplay,subvolid=5 "$device" "$mountpoint" 2>/dev/null; then
            mounted=1
            root=$mountpoint/@root
            for release in "$root/etc/os-release" "$root/usr/lib/os-release"; do
                resolved=$(readlink -f "$release")
                case "$resolved" in "$root/"*)
                    os=$(read_value "$resolved" | awk '/^PRETTY_NAME=/ {sub(/^PRETTY_NAME=/, ""); sub(/^["\047]/, ""); sub(/["\047]$/, ""); print; exit}')
                    [ -z "$os" ] || break ;;
                esac
            done
            stats=$(timeout -k 1 3 stat -f -c '%S %b %f %a' "$mountpoint" 2>/dev/null || true)
            set -- $stats
            if [ "$#" = 4 ]; then
                total=$(awk -v s="$1" -v n="$2" 'BEGIN {printf "%.0f", s*n}')
                free=$(awk -v s="$1" -v n="$3" 'BEGIN {printf "%.0f", s*n}')
                available=$(awk -v s="$1" -v n="$4" 'BEGIN {printf "%.0f", s*n}')
            fi
            notice='Space is reported for the entire Btrfs filesystem. Snapshots share data; their sizes cannot be added together.'
        fi
    fi
fi
jq -M -n --arg sb "$secure_boot" --arg computer "$computer" --arg cpu "$cpu" --arg cpus "$cpus" \
    --arg frequency "$frequency" --arg memory "$memory" --arg version "$version" --arg kernel "$kernel" \
    --arg device "$device" --arg disk "$disk" --arg model "$model" --arg capacity "$capacity" \
    --arg temperature "$temperature" --arg os "$os" --arg total "$total" --arg free "$free" \
    --arg available "$available" --arg notice "$notice" '
    def value: if length == 0 then "Unavailable" else . end;
    def gib: tonumber? / 1073741824 * 10 | round / 10 | tostring + " GiB";
    def row($name; $v): {name: $name, value: ($v | value)};
    {schema: 1, notice: $notice,
     used_percent: (try (((($total|tonumber) - ($free|tonumber)) / ($total|tonumber) * 100) | round) catch null),
     groups: [
       {title: "Boot environment", rows: [row("Secure Boot"; $sb), row("Recovery version"; $version), row("Recovery kernel"; $kernel)]},
       {title: "Installed system", rows: [row("System"; $os), row("Target partition"; $device),
         row("Filesystem"; if $total == "" then "" else "Btrfs" end), row("Total space"; ([$total | gib][0] // "")),
         row("Used space"; (try (($total|tonumber) - ($free|tonumber) | gib) catch "")),
         row("Available space"; ([$available | gib][0] // ""))]},
       {title: "Hardware", rows: [row("Computer"; $computer), row("CPU"; $cpu), row("Logical CPUs"; $cpus),
         row("CPU 0 frequency (sample)"; (try (($frequency|tonumber) / 1000 | round | tostring + " MHz") catch "")),
         row("Usable memory"; ([$memory | gib][0] // "")), row("System disk"; $disk), row("Disk model"; $model),
         row("Disk capacity"; (try (($capacity|tonumber) * 512 | gib) catch "")),
         row("Disk temperature (sample)"; (try (($temperature|tonumber) / 1000 | tostring + " °C") catch ""))]}
     ]}'
