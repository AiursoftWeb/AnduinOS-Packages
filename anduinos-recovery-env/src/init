#!/bin/sh
# This initramfs never starts or executes programs from the installed system.
export PATH=/usr/bin:/bin:/usr/sbin LC_ALL=C
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mount -t tmpfs tmpfs /run
mount -t tmpfs tmpfs /tmp
exec </dev/console >/dev/console 2>&1
for driver in $(cat /etc/recovery-drivers); do modprobe "$driver"; done
sleep 1
# Direct software rendering. Either graphics backend may be absent on firmware.
recovery-gui drm >> /run/recovery-graphics.log 2>&1 ||
    recovery-gui fbdev >> /run/recovery-graphics.log 2>&1
recovery-gui text
echo 'The graphical browser is unavailable. Continuing with the text menu.'
while :; do
    echo
    echo 'AnduinOS Recovery Environment'
    if ! recovery-action list > /run/recovery-choices.json; then
        echo 'Press Enter to retry, or type REBOOT to restart.'
        read -r answer
        [ "$answer" != REBOOT ] || recovery-action restart
        continue
    fi
    if [ "$(jq -r '.pending != null' /run/recovery-choices.json)" = true ]; then
        echo 'A confirmed recovery was interrupted. Type RESUME to finish, or REBOOT to restart.'
        read -r answer
        case "$answer" in
            RESUME) recovery-action resume || continue ;;
            REBOOT) recovery-action restart; continue ;;
            *) continue ;;
        esac
    else
        jq '[.deployments[] | select(.state == "ready" and .failure == null)]' /run/recovery-choices.json > /run/recovery-ready.json
        count=$(jq 'length' /run/recovery-ready.json)
        jq -r 'to_entries[] | "\(.key + 1). \(.value.created_at)  \(.value.title | @json)"' /run/recovery-ready.json
        echo '0. Restart without restoring'
        printf 'Select a snapshot number: '
        read -r choice
        case "$choice" in 0) recovery-action restart; continue ;; ''|*[!0-9]*) continue ;; esac
        [ "${#choice}" -le 5 ] && [ "$choice" -ge 1 ] && [ "$choice" -le "$count" ] || continue
        index=$(awk -v n="$choice" 'BEGIN {print n - 1}')
        identifier=$(jq -r ".[${index}].id" /run/recovery-ready.json)
        jq -r ".[${index}] | \"Restore: \(.title | @json) (\(.created_at))\"" /run/recovery-ready.json
        echo 'This permanently replaces system files and applications. Personal files remain unchanged.'
        echo 'No new backup snapshot will be created. Type RESTORE to confirm, or press Enter to cancel.'
        read -r answer
        [ "$answer" = RESTORE ] || continue
        recovery-action restore "$identifier" || continue
    fi
    echo 'Recovery completed. Press Enter to restart AnduinOS.'
    read -r ignored
    recovery-action restart
done
