[Desktop Entry]
Type=Application
Name=AnduinOS Help
Comment=Browse the official AnduinOS documentation offline
Comment[zh_CN]=离线浏览 AnduinOS 官方文档
Exec=anduinos-help
Icon=com.anduinos.Help
Terminal=false
