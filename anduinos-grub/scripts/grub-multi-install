#!/bin/sh
set -eu
parameters=$(python3 -m anduinos_secureboot.architecture shell "$(dpkg --print-architecture)")
eval "$parameters"
case "${*:-}" in
  ''|"--target=$BOOT_GRUB_PLATFORM") exec /usr/libexec/anduinos-grub-update deploy ;;
  *) echo 'AnduinOS boot deployment only supports the configured local ESP' >&2; exit 64 ;;
esac
