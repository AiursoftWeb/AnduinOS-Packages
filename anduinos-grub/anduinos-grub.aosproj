<Project Sdk="Aiursoft.Apkg.Sdk">
  <PropertyGroup>
    <PackageName>anduinos-grub</PackageName>
    <PackageVersion>2.0.5+repack1-2+$(SuiteShortName)</PackageVersion>
    <Maintainer>AnduinOS Team &lt;anduin@aiursoft.com&gt;</Maintainer>
    <PackageDescription>AnduinOS GRUB with Btrfs, LUKS2, Argon2id and local unified-MOK signing</PackageDescription>
    <Section>admin</Section>
    <PackageHomepage>https://www.anduinos.com</PackageHomepage>
    <RepositoryUrl>https://github.com/AiursoftWeb/AnduinOS-Packages</RepositoryUrl>
    <LicenseType>GPL-3.0</LicenseType>
    <TargetDistro>anduinos</TargetDistro>
    <TargetSuites>resolute-addon stonking-addon</TargetSuites>
    <TargetArchitectures>amd64 arm64</TargetArchitectures>
    <SuiteShortNameMap>resolute-addon=resolute stonking-addon=stonking</SuiteShortNameMap>
    <Component>main</Component>
    <Provides Condition="'$(Arch)' == 'amd64'">grub-common, grub2-common, grub-pc, grub-pc-bin, grub-efi-amd64, grub-efi-amd64-bin, grub-efi-amd64-unsigned, grub-efi-amd64-signed</Provides>
    <Conflicts Condition="'$(Arch)' == 'amd64'">grub-common, grub2-common, grub-pc, grub-pc-bin, grub-efi-amd64, grub-efi-amd64-bin, grub-efi-amd64-unsigned, grub-efi-amd64-signed</Conflicts>
    <Replaces Condition="'$(Arch)' == 'amd64'">grub-common, grub2-common, grub-pc, grub-pc-bin, grub-efi-amd64, grub-efi-amd64-bin, grub-efi-amd64-unsigned, grub-efi-amd64-signed</Replaces>
    <Provides Condition="'$(Arch)' == 'arm64'">grub-common, grub2-common, grub-efi-arm64, grub-efi-arm64-bin, grub-efi-arm64-unsigned, grub-efi-arm64-signed</Provides>
    <Conflicts Condition="'$(Arch)' == 'arm64'">grub-common, grub2-common, grub-efi-arm64, grub-efi-arm64-bin, grub-efi-arm64-unsigned, grub-efi-arm64-signed</Conflicts>
    <Replaces Condition="'$(Arch)' == 'arm64'">grub-common, grub2-common, grub-efi-arm64, grub-efi-arm64-bin, grub-efi-arm64-unsigned, grub-efi-arm64-signed</Replaces>
  </PropertyGroup>
  <ItemGroup>
    <BuildSource Name="ubuntu-amd64" Url="https://archive.ubuntu.com/ubuntu" Suites="$(SuiteShortName) $(SuiteShortName)-updates $(SuiteShortName)-security" Components="main" SignedBy="/usr/share/keyrings/ubuntu-archive-keyring.gpg" />
    <BuildSource Name="ubuntu-arm64" Url="https://ports.ubuntu.com/ubuntu-ports" Suites="$(SuiteShortName) $(SuiteShortName)-updates $(SuiteShortName)-security" Components="main" SignedBy="/usr/share/keyrings/ubuntu-archive-keyring.gpg" />
    <!-- Both tool payloads are inputs: execute the host's, package only the target's.
         This works on either Linux build host without foreign-architecture execution. -->
    <BuildInput Include="grub2-common" Id="tools-amd64" Sources="ubuntu-amd64" Arch="amd64" />
    <BuildInput Include="grub2-common" Id="tools-arm64" Sources="ubuntu-arm64" Arch="arm64" />
    <BuildInput Include="grub-efi-$(Arch)-bin" Id="modules" Sources="ubuntu-amd64" Arch="$(Arch)" Condition="'$(Arch)' == 'amd64'" />
    <BuildInput Include="grub-efi-$(Arch)-bin" Id="modules" Sources="ubuntu-arm64" Arch="$(Arch)" Condition="'$(Arch)' == 'arm64'" />
    <BuildInput Include="grub-efi-$(Arch)-unsigned" Id="baseline" Sources="ubuntu-amd64" Arch="$(Arch)" Condition="'$(Arch)' == 'amd64'" />
    <BuildInput Include="grub-efi-$(Arch)-unsigned" Id="baseline" Sources="ubuntu-arm64" Arch="$(Arch)" Condition="'$(Arch)' == 'arm64'" />
    <BuildInput Include="grub-pc-bin" Id="bios" Sources="ubuntu-amd64" Arch="amd64" Condition="'$(Arch)' == 'amd64'" />
    <DependencyCheckSource Url="https://mirror.aiursoft.com/ubuntu" SuiteMap="resolute-addon=resolute stonking-addon=stonking" />
    <Dependency Include="anduinos-secureboot-toolkit (&gt;= 2.0.5-8)" />
    <Dependency Include="libc6" />
    <Dependency Include="libdevmapper1.02.1" />
    <Dependency Include="libefiboot1t64" />
    <Dependency Include="libefivar1t64" />
    <Dependency Include="libfreetype6" />
    <Dependency Include="libfuse3-4" />
    <Dependency Include="liblzma5" />
    <Dependency Include="libpng16-16t64" />
    <Dependency Include="libuuid1" />
    <Dependency Include="gettext-base" />
    <Dependency Include="lsb-release" />
    <Dependency Include="ucf" />
    <Dependency Include="debconf" />
    <Dependency Include="python3" />
    <Dependency Include="python3-apt" />
    <Suggest Include="os-prober" />
    <PrebuildCommand Run="bash build.sh" />
    <!-- Apkg auto-detects these service files and generates lifecycle scripts.
         SystemdUnit also copies to /lib, duplicating the /usr/lib payload on
         merged-/usr systems and breaking dpkg unpack/reinstall. -->
    <IncludeFile Include="deploy/grub2-common.service" Target="/usr/lib/systemd/system/grub2-common.service" />
    <IncludeFile Include="deploy/grub-initrd-fallback.service" Target="/usr/lib/systemd/system/grub-initrd-fallback.service" />
    <TestCommand Name="efi-assembly" Profile="anduinos-package-release-test" Run="python3 -m unittest discover -s tests -v" TimeoutSeconds="60" />
    <PostInstallScript Include="scripts/postinst.sh" />
    <IncludeFile Include="README.md" Target="/usr/share/doc/anduinos-grub/README.md" />
  </ItemGroup>
</Project>
