<Project Sdk="Aiursoft.Apkg.Sdk">
  <PropertyGroup>
    <PackageName>base-files</PackageName>
    <PackageVersion>1:2.0.2+$(UpstreamVersion)-1+$(SuiteShortName)</PackageVersion>
    <Maintainer>AnduinOS Team &lt;anduin@aiursoft.com&gt;</Maintainer>
    <PackageDescription>AnduinOS base files (derived from Ubuntu base-files)</PackageDescription>
    <PackageHomepage>https://www.anduinos.com</PackageHomepage>
    <RepositoryUrl>https://github.com/AiursoftWeb/AnduinOS-Packages</RepositoryUrl>
    <LicenseType>GPL-3.0</LicenseType>
    <TargetDistro>anduinos</TargetDistro>
    <TargetSuites>resolute-addon</TargetSuites>
    <TargetArchitectures>amd64 arm64</TargetArchitectures>
    <Component>main</Component>

    <!-- Derive from Ubuntu base-files -->
    <UpstreamUrl>https://mirror.aiursoft.com/ubuntu</UpstreamUrl>
    <UpstreamDistro>ubuntu</UpstreamDistro>
    <UpstreamPackage>base-files</UpstreamPackage>
    <UpstreamSuite>$(Suite)</UpstreamSuite>
    <UpstreamSuiteMapping>resolute-addon=resolute</UpstreamSuiteMapping>
    <UpstreamComponent>$(Component)</UpstreamComponent>
    <UpstreamArch>$(Arch)</UpstreamArch>
  </PropertyGroup>

  <ItemGroup>
    <!-- Branding: replace Ubuntu logos with AnduinOS logos -->
    <IncludeFile Include="assets/noble/ubuntu-logo-text.png" Target="/usr/share/pixmaps/ubuntu-logo-text.png"
                 Condition="'$(Suite)' == 'noble-addon'" />
    <IncludeFile Include="assets/noble/ubuntu-logo-text-dark.png" Target="/usr/share/pixmaps/ubuntu-logo-text-dark.png"
                 Condition="'$(Suite)' == 'noble-addon'" />


    <IncludeFile Include="assets/resolute/ubuntu-logo-text.svg" Target="/usr/share/pixmaps/ubuntu-logo-text.svg"
                 Condition="'$(Suite)' == 'resolute-addon'" />
    <IncludeFile Include="assets/resolute/ubuntu-logo-text-dark.svg" Target="/usr/share/pixmaps/ubuntu-logo-text-dark.svg"
                 Condition="'$(Suite)' == 'resolute-addon'" />
    <!-- PNG versions needed for Plymouth watermark (watermark.png symlinks to ubuntu-logo-text-dark.png) -->
    <IncludeFile Include="assets/resolute/ubuntu-logo-text.png" Target="/usr/share/pixmaps/ubuntu-logo-text.png"
                 Condition="'$(Suite)' == 'resolute-addon'" />
    <IncludeFile Include="assets/resolute/ubuntu-logo-text-dark.png" Target="/usr/share/pixmaps/ubuntu-logo-text-dark.png"
                 Condition="'$(Suite)' == 'resolute-addon'" />

    <!-- System identity files (suite-specific) -->
    <IncludeFile Include="assets/noble/os-release" Target="/etc/os-release"
                 Condition="'$(Suite)' == 'noble-addon'" />
    <IncludeFile Include="assets/resolute/os-release" Target="/etc/os-release"
                 Condition="'$(Suite)' == 'resolute-addon'" />

    <IncludeFile Include="assets/noble/lsb-release" Target="/etc/lsb-release"
                 Condition="'$(Suite)' == 'noble-addon'" />
    <IncludeFile Include="assets/resolute/lsb-release" Target="/etc/lsb-release"
                 Condition="'$(Suite)' == 'resolute-addon'" />

    <IncludeFile Include="assets/noble/issue" Target="/etc/issue"
                 Condition="'$(Suite)' == 'noble-addon'" />
    <IncludeFile Include="assets/resolute/issue" Target="/etc/issue"
                 Condition="'$(Suite)' == 'resolute-addon'" />
                 
    <IncludeFile Include="assets/noble/issue.net" Target="/etc/issue.net"
                 Condition="'$(Suite)' == 'noble-addon'" />
    <IncludeFile Include="assets/resolute/issue.net" Target="/etc/issue.net"
                 Condition="'$(Suite)' == 'resolute-addon'" />

    <!-- legal: same across all suites -->
    <IncludeFile Include="assets/legal" Target="/etc/legal" />

    <!-- MOTD: replace Ubuntu-branded / phone-home scripts with AnduinOS versions -->
    <IncludeFile Include="assets/00-header" Target="/etc/update-motd.d/00-header" />
    <IncludeFile Include="assets/10-help-text" Target="/etc/update-motd.d/10-help-text" />
    <!-- No-op stub: disables Canonical's motd.ubuntu.com telemetry -->
    <IncludeFile Include="assets/50-motd-news" Target="/etc/update-motd.d/50-motd-news" />
  </ItemGroup>
</Project>
