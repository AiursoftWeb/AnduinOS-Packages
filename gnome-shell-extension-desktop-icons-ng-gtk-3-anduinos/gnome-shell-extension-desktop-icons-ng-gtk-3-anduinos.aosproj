<Project Sdk="Aiursoft.Apkg.Sdk">
  <PropertyGroup>
    <PackageName>gnome-shell-extension-desktop-icons-ng-gtk-3-anduinos</PackageName>
    <PackageVersion>2.0.4-1+$(SuiteShortName)</PackageVersion>
    <Maintainer>AnduinOS Team &lt;anduin@aiursoft.com&gt;</Maintainer>
    <Section>gnome</Section>
    <PackageDescription>Desktop Icons NG v85 with GTK 3 for GNOME desktop icons.</PackageDescription>
    <PackageHomepage>https://extensions.gnome.org/extension/2087/desktop-icons-ng-ding/</PackageHomepage>
    <RepositoryUrl>https://github.com/AiursoftWeb/AnduinOS-Packages</RepositoryUrl>
    <LicenseType>GPL-3.0</LicenseType>
    <TargetDistro>anduinos</TargetDistro>
    <TargetSuites>noble-addon resolute-addon</TargetSuites>
    <TargetArchitectures>all</TargetArchitectures>
    <Component>main</Component>
    <SuiteShortNameMap>noble-addon=noble resolute-addon=resolute</SuiteShortNameMap>
    <Provides>gnome-shell-extension-desktop-icons-ng, gnome-shell-extension-desktop-icons-ng-anduinos</Provides>
    <Conflicts>gnome-shell-extension-desktop-icons-ng, gnome-shell-extension-desktop-icons-ng-anduinos</Conflicts>
    <Replaces>gnome-shell-extension-desktop-icons-ng, gnome-shell-extension-desktop-icons-ng-anduinos</Replaces>
  </PropertyGroup>
  <ItemGroup>
    <DependencyCheckSource Url="https://mirror.aiursoft.com/ubuntu" SuiteMap="noble-addon=noble resolute-addon=resolute" />
  </ItemGroup>
  <ItemGroup>
    <Dependency Include="anduinos-dconf-runtime" />
    <Dependency Include="gnome-shell" />
    <Dependency Include="gir1.2-gnomedesktop-3.0" />
    <Dependency Include="gir1.2-gtk-3.0" />
    <Dependency Include="gjs" />
    <Dependency Include="dconf-gsettings-backend | gsettings-backend" />
    <Recommend Include="gnome-shell-extension-prefs | gnome-shell-extension-manager" />
  </ItemGroup>
  <ItemGroup>
    <IncludeFolder Include="deploy/noble/ding@rastersoft.com"
                   Target="/usr/share/gnome-shell/extensions/ding@rastersoft.com"
                   Condition="'$(Suite)' == 'noble-addon'" />
    <IncludeFolder Include="deploy/resolute/ding@rastersoft.com"
                   Target="/usr/share/gnome-shell/extensions/ding@rastersoft.com"
                   Condition="'$(Suite)' == 'resolute-addon'" />
  </ItemGroup>
  <ItemGroup>
    <PrebuildCommand Run="bash download.sh" />
    <IncludeFile Include="dconf/08-desktop-icons-ng.conf" Target="/etc/dconf/db/anduinos.d/08-desktop-icons-ng.conf" />
  </ItemGroup>
</Project>
