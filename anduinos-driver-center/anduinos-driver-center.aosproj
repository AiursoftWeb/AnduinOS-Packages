<Project Sdk="Aiursoft.Apkg.Sdk">
  <PropertyGroup>
    <PackageName>anduinos-driver-center</PackageName>
    <PackageVersion>2.0.2-1+$(SuiteShortName)</PackageVersion>
    <Maintainer>AnduinOS Team &lt;anduin@aiursoft.com&gt;</Maintainer>
    <PackageDescription>AnduinOS Driver Center — manage hardware drivers, device firmware, printing, controllers, and Secure Boot support.</PackageDescription>
    <Section>admin</Section>
    <PackageHomepage>https://www.anduinos.com</PackageHomepage>
    <RepositoryUrl>https://github.com/AiursoftWeb/AnduinOS-Packages</RepositoryUrl>
    <LicenseType>GPL-3.0</LicenseType>
    <AppStreamDeveloperName>AnduinOS Team</AppStreamDeveloperName>
    <AppStreamMetadataLicense>CC0-1.0</AppStreamMetadataLicense>
    <TargetDistro>anduinos</TargetDistro>
    <TargetSuites>noble-addon resolute-addon</TargetSuites>
    <TargetArchitectures>amd64 arm64</TargetArchitectures>
    <Component>main</Component>
    <SuiteShortNameMap>noble-addon=noble resolute-addon=resolute</SuiteShortNameMap>
  </PropertyGroup>

  <ItemGroup>
    <DependencyCheckSource Url="https://mirror.aiursoft.com/ubuntu" SuiteMap="noble-addon=noble resolute-addon=resolute" />
  </ItemGroup>

  <ItemGroup>
    <Dependency Include="python3" />
    <Dependency Include="ubuntu-drivers-common" />
    <Dependency Include="fwupd" />
    <Dependency Include="anduinos-secureboot-toolkit" />
    <Dependency Include="pkexec" />
    <Dependency Include="pciutils" />
  </ItemGroup>

  <ItemGroup>
    <IncludeScript Include="obj/anduinos-driver-center" Target="/usr/bin/anduinos-driver-center" />
    <IncludeScript Include="scripts/driver-helper" Target="/usr/libexec/anduinos-driver-center/driver-helper" />
    <IncludeFolder Include="resources" Target="/usr/share/anduinos-driver-center/illustrations" />
    <IncludeFile Include="data/com.anduinos.DriverCenter.policy" Target="/usr/share/polkit-1/actions/com.anduinos.DriverCenter.policy" />
    <IncludeFolder Include="locale" Target="/usr/share/locale" />
    <IncludeFile Include="data/com.anduinos.DriverCenter.service" Target="/usr/share/dbus-1/services/com.anduinos.DriverCenter.service" />
  </ItemGroup>

  <ItemGroup>
    <AppStreamApplication Include="data/com.anduinos.DriverCenter.desktop" Icon="data/com.anduinos.DriverCenter.svg" />
  </ItemGroup>

  <ItemGroup>
    <PrebuildCommand Run="bash compile-locales.sh" />
    <PrebuildCommand Run="PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s tests -v" />
    <PrebuildCommand Run="bash build.sh amd64" Condition="'$(Arch)' == 'amd64'" />
    <PrebuildCommand Run="bash build.sh arm64" Condition="'$(Arch)' == 'arm64'" />
  </ItemGroup>
</Project>
