#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:75
msgid "Secure Boot Configuration"
msgstr "Secure Boot -määritys"

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:83
msgid ""
"Secure Boot is a motherboard security standard that ensures only trusted software loads at "
"startup."
msgstr ""
"\tSecure Boot on emolevun tietoturvakäytäntö, joka varmistaa, että vain luotettava ohjelmisto "
"ladataan käynnistyksen yhteydessä."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:86
msgid "It protects your system from low-level malware and rootkits."
msgstr "Se suojaa järjestelmääsi matalan tason haittaohjelmilta ja rootkit-ohjelmilta."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:95
msgid "System Trust Status"
msgstr "Järjestelmän luottamuksen tila"

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:132
#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:274
