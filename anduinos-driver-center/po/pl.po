#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:83
msgid ""
"Secure Boot is a motherboard security standard that ensures only trusted software loads at "
"startup."
msgstr ""
"\tSecure Boot to standard bezpieczeństwa płyty głównej, który zapewnia ładowanie tylko zaufanego "
"oprogramowania podczas uruchamiania."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:86
msgid "It protects your system from low-level malware and rootkits."
msgstr "\\\tOchroni Twój system przed niskopoziomowym złośliwym oprogramowaniem i rootkitami."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:95
msgid "System Trust Status"
