msgstr "لا يمكن التحقق من ثقة برنامج التشغيل"

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:303
msgid ""
"Secure Boot trust is ready. No third-party kernel modules are currently "
"installed."
msgstr ""
"ثقة Secure Boot جاهزة. لا توجد وحدات kernel تابعة لجهة خارجية مثبتة حاليًا."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:307
#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:550
#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:558
msgid "Drivers are signed and ready to load"
msgstr "تم توقيع برامج التشغيل وهي جاهزة للتحميل"

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:311
msgid "Drivers are trusted, but automatic DKMS signing needs repair"
msgstr "برامج التشغيل موثوق بها، ولكن التوقيع التلقائي DKMS يحتاج إلى إصلاح"

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:315
msgid "No signed third-party drivers detected"
msgstr "لم يتم اكتشاف برامج تشغيل طرف ثالث موقعة"

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:323
msgid "Enroll Existing Certificate"
msgstr "تسجيل الشهادة الموجودة"

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:336
msgid "Repair Automatic DKMS Signing"
msgstr "إصلاح التوقيع التلقائي DKMS"

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:356
msgid ""
"This firmware does not provide Secure Boot. No certificate is required."
msgstr "لا توفر هذه البرامج الثابتة Secure Boot. لا توجد شهادة مطلوبة."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:363
msgid ""
"Secure Boot status could not be read. Driver trust operations are blocked "
"until detection succeeds."
msgstr ""
"تعذرت قراءة حالة Secure Boot. يتم حظر عمليات الثقة في برنامج التشغيل حتى "
"ينجح الكشف."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:369
msgid "No certificate is required while Secure Boot is disabled."
msgstr "لا توجد شهادة مطلوبة أثناء تعطيل Secure Boot."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:375
msgid "System Trust Established. Third-party drivers will load securely."
msgstr "تم تأسيس ثقة النظام. سيتم تحميل برامج تشغيل طرف ثالث بأمان."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:379
msgid "The certificate is enrolled and current drivers are trusted."
msgstr "تم تسجيل الشهادة وبرامج التشغيل الحالية موثوقة."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:381
msgid "Repair automatic DKMS signing before future driver updates."
msgstr ""
"قم بإصلاح التوقيع التلقائي DKMS قبل تحديثات برنامج التشغيل المستقبلية."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:386
msgid "The certificate is enrolled, but some modules are not signed with it."
msgstr "تم تسجيل الشهادة، ولكن لم يتم توقيع بعض الوحدات بها."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:391
msgid "A certificate is waiting for enrollment."
msgstr "هناك شهادة في انتظار التسجيل."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:393
msgid "Restart and enter password 123456 in MOKManager."
msgstr "أعد التشغيل وأدخل كلمة المرور 123456 في MOKManager."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:398
msgid "The local trust certificate is not yet enrolled."
msgstr "لم يتم تسجيل شهادة الثقة المحلية بعد."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:400
#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:407
msgid "You must configure this to use third-party drivers like NVIDIA."
msgstr "يجب عليك تكوين هذا لاستخدام برامج تشغيل طرف ثالث مثل NVIDIA."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:405
msgid "The local trust certificate is missing."
msgstr "شهادة الثقة المحلية مفقودة."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:423
msgid "  Checking...  "
msgstr "  جار التحقق...  "

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:430
msgid "Please trust the certificate upon reboot using password 123456."
msgstr "يرجى الثقة بالشهادة عند إعادة التشغيل باستخدام كلمة المرور 123456."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:447
msgid "Reboot"
msgstr "إعادة التشغيل"

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:483
msgid "Success! When you reboot, a blue screen will appear."
msgstr "نجاح! عند إعادة التشغيل، ستظهر شاشة زرقاء."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:487
msgid "Select 'Enroll MOK' → 'Continue' → 'Yes', and enter password: 123456"
msgstr "حدد 'Enroll MOK' → 'Continue' → 'Yes'، وأدخل كلمة المرور: 123456"

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:491
msgid "Certificate Created"
msgstr "تم إنشاء الشهادة"

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:523
