msgid "System Trust Established. Third-party drivers will load securely."
msgstr ""
"Системну довіру встановлено. Сторонні драйвери будуть завантажені безпечно."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:379
msgid "The certificate is enrolled and current drivers are trusted."
msgstr "Сертифікат зареєстровано, а поточні драйвери є надійними."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:381
msgid "Repair automatic DKMS signing before future driver updates."
msgstr ""
"Відновлення автоматичного підпису DKMS перед майбутнім оновленням драйвера."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:386
msgid "The certificate is enrolled, but some modules are not signed with it."
msgstr "Сертифікат зареєстровано, але деякі модулі ним не підписані."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:391
msgid "A certificate is waiting for enrollment."
msgstr "Сертифікат очікує на реєстрацію."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:393
msgid "Restart and enter password 123456 in MOKManager."
msgstr "Перезапустіть і введіть пароль 123456 у MOKManager."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:398
msgid "The local trust certificate is not yet enrolled."
msgstr "Локальний сертифікат довіри ще не зареєстровано."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:400
#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:407
msgid "You must configure this to use third-party drivers like NVIDIA."
msgstr ""
"Вам необхідно налаштувати це для використання сторонніх драйверів, таких як "
"NVIDIA."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:405
msgid "The local trust certificate is missing."
msgstr "Відсутній локальний сертифікат довіри."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:423
msgid "  Checking...  "
msgstr "  Перевірка...  "

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:430
msgid "Please trust the certificate upon reboot using password 123456."
msgstr ""
"Будь ласка, довірте сертифікат при перезавантаженні, використовуючи пароль "
"123456."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:447
msgid "Reboot"
msgstr "Перезавантажити"

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:483
msgid "Success! When you reboot, a blue screen will appear."
msgstr "Успіх! Після перезавантаження з’явиться синій екран."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:487
msgid "Select 'Enroll MOK' → 'Continue' → 'Yes', and enter password: 123456"
msgstr "Виберіть 'Enroll MOK' → 'Continue' → 'Yes' та введіть пароль: 123456"

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:491
msgid "Certificate Created"
msgstr "Сертифікат створено"

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:523
msgid "Secure Boot Trust Not Required"
msgstr "Secure Boot Довіра не потрібна"

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:524
