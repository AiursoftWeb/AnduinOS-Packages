msgstr "कर्नेल संस्करण"

msgid "Restart required"
msgstr "पुनः आरंभ आवश्यक है"

msgid "Saved settings differ from this boot."
msgstr "सहेजी गई सेटिंग्स इस बूट से भिन्न हैं।"

