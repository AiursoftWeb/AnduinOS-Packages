#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "A certificate is waiting for enrollment. Restart and select Enroll MOK, Continue, Yes, then enter password 123456."
msgstr "Một chứng chỉ đang chờ đăng ký. Khởi động lại và chọn Enroll MOK, Continue, Yes, rồi nhập mật khẩu 123456."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "AnduinOS GRUB is signed, trusted and deployed."
msgstr "GRUB của AnduinOS đã được ký, tin cậy và triển khai."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "Boot Recovery Help"
msgstr "Trợ giúp khôi phục khởi động"

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "Certificate Enrollment"
msgstr "Đăng ký chứng chỉ"

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "Certificate Signing Purpose"
msgstr "Mục đích ký của chứng chỉ"

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "Check Before Enabling Secure Boot"
msgstr "Kiểm tra trước khi bật Khởi động an toàn"

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "Check the firmware and boot mode before continuing."
msgstr "Kiểm tra firmware và chế độ khởi động trước khi tiếp tục."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "Close"
msgstr "Đóng"

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "Complete This Step First"
msgstr "Hoàn tất bước này trước"

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "Create Signing Certificate"
msgstr "Tạo chứng chỉ ký"

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "Create a certificate that can sign both the bootloader and drivers first."
msgstr "Trước tiên, hãy tạo chứng chỉ có thể ký cả trình nạp khởi động và trình điều khiển."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "Create a local signing certificate before preparing trust."
msgstr "Tạo chứng chỉ ký cục bộ trước khi chuẩn bị thiết lập tin cậy."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "DKMS and the matching kernel headers are required. Check the driver build requirements."
msgstr "Cần có DKMS và các tệp tiêu đề nhân tương ứng. Hãy kiểm tra yêu cầu biên dịch trình điều khiển."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "Do not restart with an invalid bootloader. Use trusted installation media to inspect and restore the EFI boot files. Keep existing enrolled certificates."
msgstr "Không khởi động lại khi trình nạp khởi động không hợp lệ. Dùng phương tiện cài đặt đáng tin cậy để kiểm tra và khôi phục các tệp khởi động EFI. Giữ lại các chứng chỉ đã đăng ký."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "Enrollment requested. Restart and select Enroll MOK to finish trusting this certificate."
msgstr "Đã yêu cầu đăng ký. Khởi động lại và chọn Enroll MOK để hoàn tất việc tin cậy chứng chỉ này."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "Existing bootloader, driver signatures and old enrolled certificates are preserved."
msgstr "Trình nạp khởi động hiện có, chữ ký trình điều khiển và các chứng chỉ đã đăng ký trước đây được giữ nguyên."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "Firmware Configuration"
msgstr "Cấu hình firmware"

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "Firmware Help"
msgstr "Trợ giúp firmware"

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "Firmware Settings Failed"
msgstr "Không thể mở cài đặt firmware"

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "Firmware platform keys are not configured. This is separate from MOK enrollment."
msgstr "Các khóa nền tảng của firmware chưa được cấu hình. Việc này tách biệt với đăng ký MOK."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "Firmware trust for the next bootloader has not been verified."
msgstr "Chưa xác minh việc firmware tin cậy trình nạp khởi động sẽ dùng ở lần khởi động tiếp theo."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "Go to This Step"
msgstr "Đi đến bước này"

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "Inspection Failed"
msgstr "Kiểm tra thất bại"

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "Installed drivers are trusted, including signatures from previously enrolled certificates."
msgstr "Các trình điều khiển đã cài đặt được tin cậy, bao gồm chữ ký từ các chứng chỉ đã đăng ký trước đây."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "Motherboard Secure Boot is enabled."
msgstr "Khởi động an toàn trên bo mạch chủ đang bật."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "Next step:"
msgstr "Bước tiếp theo:"

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "No repairs are required by the checks shown above."
msgstr "Các kiểm tra ở trên cho thấy không cần sửa chữa."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "No third-party kernel modules need attention."
msgstr "Không có mô-đun nhân bên thứ ba nào cần xử lý."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "One or more third-party drivers need a trusted signature."
msgstr "Một hoặc nhiều trình điều khiển bên thứ ba cần chữ ký đáng tin cậy."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "Operation Failed"
msgstr "Thao tác thất bại"

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "Operation Finished"
msgstr "Thao tác đã hoàn tất"

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "Please wait. Do not restart while this operation is running."
msgstr "Vui lòng chờ. Không khởi động lại khi thao tác đang chạy."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "Prepare a valid signing certificate first."
msgstr "Trước tiên, hãy chuẩn bị chứng chỉ ký hợp lệ."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "Repair Automatic Signing"
msgstr "Sửa cấu hình ký tự động"

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "Repair Driver Signatures"
msgstr "Sửa chữ ký trình điều khiển"

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "Replace Signing Certificate…"
msgstr "Thay chứng chỉ ký…"

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "Restart"
msgstr "Khởi động lại"

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "Restart to Enroll Certificate"
msgstr "Khởi động lại để đăng ký chứng chỉ"

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "Restore a Trusted Boot Path"
msgstr "Khôi phục đường dẫn khởi động đáng tin cậy"

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "Secure Boot is configured in UEFI settings. Platform keys and the Microsoft third-party CA are separate from your MOK certificate. Verify the actual bootloader, next kernel and required drivers before enabling Secure Boot. Firmware wording varies by manufacturer."
msgstr "Khởi động an toàn được cấu hình trong cài đặt UEFI. Các khóa nền tảng và CA bên thứ ba của Microsoft tách biệt với chứng chỉ MOK của bạn. Hãy xác minh trình nạp khởi động thực tế, nhân cho lần khởi động tiếp theo và các trình điều khiển cần thiết trước khi bật Khởi động an toàn. Cách gọi trong firmware tùy thuộc nhà sản xuất."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "Secure Boot is disabled. You can still prepare certificates, drivers and the bootloader."
msgstr "Khởi động an toàn đang tắt. Bạn vẫn có thể chuẩn bị chứng chỉ, trình điều khiển và trình nạp khởi động."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "Secure Boot is not available in the current firmware or boot mode."
msgstr "Khởi động an toàn không khả dụng với firmware hoặc chế độ khởi động hiện tại."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "Secure Boot state could not be determined. Check again before changing trust."
msgstr "Không thể xác định trạng thái Khởi động an toàn. Hãy kiểm tra lại trước khi thay đổi thiết lập tin cậy."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "Select Enroll MOK, Continue, Yes, and enter password 123456 on restart."
msgstr "Khi khởi động lại, chọn Enroll MOK, Continue, Yes rồi nhập mật khẩu 123456."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "The AnduinOS bootloader is not installed. Replacing an existing working bootloader is optional."
msgstr "Chưa cài đặt trình nạp khởi động AnduinOS. Không bắt buộc thay thế trình nạp khởi động hiện có đang hoạt động."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "The AnduinOS bootloader needs signing or its signature could not be verified."
msgstr "Trình nạp khởi động AnduinOS cần được ký hoặc không thể xác minh chữ ký của nó."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "The UEFI bootloader operation is not available in the current boot mode."
msgstr "Thao tác với trình nạp khởi động UEFI không khả dụng trong chế độ khởi động hiện tại."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "The automatic signing configuration has not been verified. Check again before installing the bootloader."
msgstr "Chưa xác minh cấu hình ký tự động. Hãy kiểm tra lại trước khi cài đặt trình nạp khởi động."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "The automatic signing configuration needs attention. Another certificate enrollment is not needed."
msgstr "Cấu hình ký tự động cần được xử lý. Không cần đăng ký thêm chứng chỉ."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "The bootloader is signed, but its certificate is not enrolled."
msgstr "Trình nạp khởi động đã được ký nhưng chứng chỉ của nó chưa được đăng ký."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "The bootloader operation finished. The installed files will now be checked again."
msgstr "Thao tác với trình nạp khởi động đã hoàn tất. Các tệp đã cài đặt sẽ được kiểm tra lại ngay bây giờ."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "The bootloader update could not be completed. Review the details before restarting."
msgstr "Không thể hoàn tất cập nhật trình nạp khởi động. Hãy xem lại chi tiết trước khi khởi động lại."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "The bootloader will be signed with your enrolled certificate and deployed. Existing EFI files are backed up. Keep the computer running until the operation finishes."
msgstr "Trình nạp khởi động sẽ được ký bằng chứng chỉ đã đăng ký của bạn và được triển khai. Các tệp EFI hiện có sẽ được sao lưu. Giữ máy tính chạy cho đến khi thao tác hoàn tất."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "The certificate does not permit the required signing. Create and enroll a replacement."
msgstr "Chứng chỉ không cho phép mục đích ký cần thiết. Hãy tạo và đăng ký chứng chỉ thay thế."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "The certificate has expired. Create and enroll a replacement for future signing."
msgstr "Chứng chỉ đã hết hạn. Hãy tạo và đăng ký chứng chỉ thay thế để ký về sau."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "The drivers needed by the next kernel have not been verified."
msgstr "Chưa xác minh các trình điều khiển cần cho nhân ở lần khởi động tiếp theo."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "The installed bootloader could not be checked."
msgstr "Không thể kiểm tra trình nạp khởi động đã cài đặt."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "The installed bootloader signature is invalid. Restore a trusted boot path before restarting."
msgstr "Chữ ký của trình nạp khởi động đã cài đặt không hợp lệ. Hãy khôi phục đường dẫn khởi động đáng tin cậy trước khi khởi động lại."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "The kernel selected for the next boot has not been verified."
msgstr "Chưa xác minh nhân được chọn cho lần khởi động tiếp theo."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "The next boot entry and kernel have not been verified. Do not enable Secure Boot until the actual boot chain is checked."
msgstr "Chưa xác minh mục khởi động và nhân cho lần khởi động tiếp theo. Không bật Khởi động an toàn cho đến khi chuỗi khởi động thực tế được kiểm tra."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "The next bootloader is not verified as signed, trusted and deployed."
msgstr "Chưa xác minh trình nạp khởi động cho lần khởi động tiếp theo đã được ký, tin cậy và triển khai."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "The signed bootloader needs deployment to this system's EFI partition."
msgstr "Trình nạp khởi động đã ký cần được triển khai vào phân vùng EFI của hệ thống này."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "The signing certificate and private key are valid and match."
msgstr "Chứng chỉ ký và khóa riêng hợp lệ, khớp nhau."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "The signing certificate must be enrolled first. Complete the certificate enrollment step above."
msgstr "Chứng chỉ ký phải được đăng ký trước. Hãy hoàn tất bước đăng ký chứng chỉ ở trên."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "The signing identity could not be checked. Existing certificates have not been replaced."
msgstr "Không thể kiểm tra danh tính ký. Các chứng chỉ hiện có chưa bị thay thế."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "The signing key is missing, unreadable or does not match its certificate. Existing signatures are unchanged."
msgstr "Khóa ký bị thiếu, không đọc được hoặc không khớp với chứng chỉ. Các chữ ký hiện có không thay đổi."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "The system will now be checked again."
msgstr "Hệ thống sẽ được kiểm tra lại ngay bây giờ."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "Third-party drivers could not be checked. This does not mean no drivers are installed."
msgstr "Không thể kiểm tra các trình điều khiển bên thứ ba. Điều này không có nghĩa là chưa cài trình điều khiển nào."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "This certificate can sign both the bootloader and kernel modules."
msgstr "Chứng chỉ này có thể ký cả trình nạp khởi động và mô-đun nhân."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "This certificate can sign drivers only. A new certificate is needed for the AnduinOS bootloader."
msgstr "Chứng chỉ này chỉ có thể ký trình điều khiển. Cần chứng chỉ mới cho trình nạp khởi động AnduinOS."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "This certificate is enrolled in MOK."
msgstr "Chứng chỉ này đã được đăng ký trong MOK."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "This updates the selected signing configuration. Creating or replacing a certificate preserves existing boot and driver trust. A new certificate requires confirmation in MOKManager after restart."
msgstr "Thao tác này cập nhật cấu hình ký đã chọn. Việc tạo hoặc thay chứng chỉ vẫn giữ nguyên trạng thái tin cậy của quá trình khởi động và trình điều khiển hiện có. Chứng chỉ mới cần được xác nhận trong MOKManager sau khi khởi động lại."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "Do not restart until the installed EFI boot files are trusted. Restore a known-good EFI backup or use trusted installation media to repair them. Keep existing enrolled certificates."
msgstr "Không khởi động lại cho đến khi các tệp khởi động EFI đã cài đặt được tin cậy. Khôi phục bản sao lưu EFI hoạt động tốt hoặc dùng phương tiện cài đặt đáng tin cậy để sửa chữa các tệp này. Giữ nguyên các chứng chỉ đã đăng ký."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "The installed EFI boot chain could not be verified as trusted. Restore a trusted boot path before restarting."
msgstr "Không thể xác minh chuỗi khởi động EFI đã cài đặt là đáng tin cậy. Hãy khôi phục đường dẫn khởi động đáng tin cậy trước khi khởi động lại."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "The AnduinOS bootloader is not installed. Installing it is recommended."
msgstr "Chưa cài đặt trình nạp khởi động AnduinOS. Bạn nên cài đặt trình này."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "Open Firmware Settings"
msgstr "Mở cài đặt firmware"

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "Preparation checks passed. Secure Boot is still disabled."
msgstr "Đã vượt qua các bước kiểm tra chuẩn bị. Secure Boot vẫn đang tắt."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "Restart to UEFI settings, enable Secure Boot, then save your changes and start AnduinOS. Firmware wording varies by manufacturer. Platform keys and the Microsoft third-party CA are separate from your MOK certificate. The preparation checks shown here do not replace a successful boot with Secure Boot enabled."
msgstr "Khởi động lại vào cài đặt UEFI, bật Secure Boot, rồi lưu thay đổi và khởi động AnduinOS. Tên các tùy chọn trong firmware có thể khác nhau tùy nhà sản xuất. Các khóa nền tảng và CA bên thứ ba của Microsoft tách biệt với chứng chỉ MOK của bạn. Các bước kiểm tra chuẩn bị hiển thị ở đây không thay thế cho việc khởi động thành công khi Secure Boot được bật."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "The AnduinOS automatic signing configuration will be backed up and reset to use your enrolled certificate. Other custom DKMS settings will not be changed. No certificate enrollment is needed."
msgstr "Cấu hình ký tự động của AnduinOS sẽ được sao lưu và đặt lại để sử dụng chứng chỉ bạn đã đăng ký. Các cài đặt DKMS tùy chỉnh khác sẽ không bị thay đổi. Không cần đăng ký chứng chỉ."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "The signing certificate is valid. Complete enrollment first; automatic signing will be checked afterward."
msgstr "Chứng chỉ ký hợp lệ. Trước tiên, hãy hoàn tất việc đăng ký; sau đó sẽ kiểm tra tính năng ký tự động."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "Automatic signing now uses your enrolled certificate. The previous configuration has been backed up. No further certificate enrollment is needed."
msgstr "Tính năng ký tự động hiện sử dụng chứng chỉ đã đăng ký của bạn. Cấu hình trước đó đã được sao lưu. Không cần đăng ký thêm chứng chỉ."

#: ../anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py
msgid "Driver signature repair is complete. The system will now check whether the installed drivers are trusted."
msgstr "Đã sửa xong chữ ký trình điều khiển. Hệ thống sẽ kiểm tra xem các trình điều khiển đã cài đặt có đáng tin cậy hay không."

msgid "Recovery Environment"
msgstr "Môi trường khôi phục"

msgid "Present"
msgstr "Có"

msgid "Multiple recovery partitions found"
msgstr "Tìm thấy nhiều phân vùng khôi phục"

msgid "Recovery partition not found"
msgstr "Không tìm thấy phân vùng khôi phục"

msgid "Recovery partition"
msgstr "Phân vùng khôi phục"

msgid "Recovery package"
msgstr "Gói khôi phục"

msgid "GRUB menu entry"
msgstr "Mục menu GRUB"

msgid "Recovery menu entry not found"
msgstr "Không tìm thấy mục khôi phục trong menu"

msgid "Unable to read the GRUB menu"
msgstr "Không thể đọc menu GRUB"

msgid "Package status uses the local APT cache. Software sources are not refreshed."
msgstr "Trạng thái gói sử dụng bộ nhớ đệm APT cục bộ. Nguồn phần mềm không được làm mới."

msgid "Read recovery boot information"
msgstr "Đọc thông tin khởi động khôi phục"

msgid "A previous preparation was interrupted. Ask an administrator to inspect the saved partition table and swap header before retrying."
msgstr "Lần chuẩn bị trước đã bị gián đoạn. Hãy nhờ quản trị viên kiểm tra bảng phân vùng và phần đầu swap đã lưu trước khi thử lại."

msgid "Automatic preparation is unavailable for this disk or swap configuration. Ask an administrator to prepare a 256 MiB AOS_RECOVERY ext4 partition, then scan again."
msgstr "Không thể chuẩn bị tự động với cấu hình đĩa hoặc swap này. Hãy nhờ quản trị viên tạo phân vùng ext4 AOS_RECOVERY 256 MiB rồi quét lại."

msgid "Check the configured or duplicate recovery volumes with an administrator, then scan again."
msgstr "Hãy nhờ quản trị viên kiểm tra các ổ khôi phục đã cấu hình hoặc bị trùng rồi quét lại."

msgid "Close memory-heavy applications and scan again. There is not enough available RAM to disable this swap safely."
msgstr "Đóng các ứng dụng dùng nhiều bộ nhớ rồi quét lại. Không có đủ RAM trống để tắt swap này một cách an toàn."

msgid "Deploy the installed recovery image and regenerate the GRUB menu?"
msgstr "Triển khai ảnh khôi phục đã cài và tạo lại menu GRUB?"

msgid "Install or update only the recovery package using the current software lists?"
msgstr "Chỉ cài hoặc cập nhật gói khôi phục bằng danh sách gói hiện tại?"

msgid "Install or update recovery package"
msgstr "Cài hoặc cập nhật gói khôi phục"

msgid "No package candidate could be verified from the local APT cache. Refresh sources in your software updater, then scan again."
msgstr "Không xác minh được phiên bản ứng viên từ bộ nhớ đệm APT cục bộ. Hãy làm mới nguồn trong trình cập nhật phần mềm rồi quét lại."

msgid "Recovery repair completed."
msgstr "Đã sửa xong môi trường khôi phục."

msgid "Repair recovery boot menu"
msgstr "Sửa menu khởi động khôi phục"

msgid "Scan again and allow the read-only inspection. If checks still fail, repair the Driver Center installation and its disk utilities."
msgstr "Quét lại và cho phép kiểm tra chỉ đọc. Nếu vẫn thất bại, hãy sửa bản cài Trung tâm trình điều khiển và các tiện ích đĩa."

msgid "Shrink swap partition and create recovery partition"
msgstr "Thu nhỏ phân vùng swap và tạo phân vùng khôi phục"

msgid "Swap will be temporarily disabled. Back up your data and keep the computer powered on until this operation finishes."
msgstr "Swap sẽ bị tắt tạm thời. Hãy sao lưu dữ liệu và giữ máy tính bật cho đến khi thao tác hoàn tất."

msgid "Unable to continue: no ordinary swap partition was found on the system disk."
msgstr "Không thể tiếp tục: không tìm thấy phân vùng swap thông thường trên đĩa hệ thống."

msgid "Unable to continue: the swap partition is smaller than 512 MiB."
msgstr "Không thể tiếp tục: phân vùng swap nhỏ hơn 512 MiB."

msgid "Recovery repair requires an installed AnduinOS Btrfs @root system. Start the installed system and scan again."
msgstr "Việc sửa chữa cần hệ thống AnduinOS Btrfs @root đã cài. Hãy khởi động hệ thống đã cài rồi quét lại."

#: src/anduinos_driver_center/core.py
msgid "Graphics device"
msgstr "Thiết bị đồ họa"
