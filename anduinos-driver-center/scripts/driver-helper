#!/usr/bin/python3
"""Restricted privileged operations for AnduinOS Driver Center."""

from __future__ import annotations

import os
import re
import subprocess
import sys


XBOX_PACKAGE = "anduinos-xbox-controller-driver"
AUDIO_PACKAGES = ("firmware-sof-anduinos", "alsa-ucm-conf-anduinos")
PRINTING_PACKAGES = (
    "cups",
    "cups-client",
    "cups-core-drivers",
    "cups-filters",
    "cups-filters-core-drivers",
    "cups-ipp-utils",
    "cups-browsed",
    "avahi-daemon",
    "ipp-usb",
    "cups-pk-helper",
    "printer-driver-all",
    "sane-airscan",
)
PRINTING_UNITS = (
    "cups.service",
    "cups.socket",
    "cups.path",
    "cups-browsed.service",
    "ipp-usb.service",
)
PRINTING_AUTOSTART_UNITS = (
    "cups.service",
    "cups.socket",
    "cups.path",
    "cups-browsed.service",
)
PACKAGE_PATTERN = re.compile(r"^[a-z0-9][a-z0-9+.-]+$")


def run(command: list[str], *, stdin: str | None = None) -> None:
    print("+ " + " ".join(command), flush=True)
    result = subprocess.run(command, input=stdin, text=True, check=False)
    if result.returncode:
        raise RuntimeError(f"{command[0]} exited with status {result.returncode}")


def available_driver_packages() -> set[str]:
    result = subprocess.run(
        ["ubuntu-drivers", "devices"], capture_output=True, text=True, check=False
    )
    packages: set[str] = set()
    for line in result.stdout.splitlines():
        if line.strip().startswith("driver") and ":" in line:
            package = line.split(":", 1)[1].strip().split(" - ", 1)[0]
            if PACKAGE_PATTERN.fullmatch(package):
                packages.add(package)
    return packages


def apt_update() -> None:
    run(["apt-get", "update"])


def install_driver(package: str) -> None:
    if package not in available_driver_packages():
        raise ValueError("The selected package is not offered by ubuntu-drivers")
    apt_update()
    # Let ubuntu-drivers perform family/version switching instead of treating
    # a driver metapackage like an unrelated APT package.
    run(["ubuntu-drivers", "install", package])


def install_recommended() -> None:
    apt_update()
    run(["ubuntu-drivers", "install"])


def install_xbox(reinstall: bool = False) -> None:
    apt_update()
    command = ["apt-get", "install", "-y"]
    if reinstall:
        command.append("--reinstall")
    command.append(XBOX_PACKAGE)
    run(command)


def install_audio() -> None:
    apt_update()
    run(["apt-get", "install", "-y", *AUDIO_PACKAGES])


def install_printing_support() -> None:
    apt_update()
    run(["apt-get", "install", "-y", *PRINTING_PACKAGES])


def set_printing_enabled(enabled: bool) -> None:
    if enabled:
        run(["systemctl", "unmask", *PRINTING_UNITS])
        run(["systemctl", "enable", "--now", *PRINTING_AUTOSTART_UNITS])
    else:
        # Mask every activation path, including the static ipp-usb unit. Merely
        # stopping cups.service would allow its socket or path unit to revive it.
        run(["systemctl", "mask", "--now", *PRINTING_UNITS])


def main(arguments: list[str]) -> int:
    if os.geteuid() != 0:
        print("This helper must be run through polkit.", file=sys.stderr)
        return 77
    try:
        match arguments:
            case ["install", package]:
                install_driver(package)
            case ["install-recommended"]:
                install_recommended()
            case ["install-xbox"]:
                install_xbox()
            case ["repair-xbox"]:
                install_xbox(reinstall=True)
            case ["install-audio"]:
                install_audio()
            case ["install-printing-support"]:
                install_printing_support()
            case ["set-printing-enabled", "true"]:
                set_printing_enabled(True)
            case ["set-printing-enabled", "false"]:
                set_printing_enabled(False)
            case _:
                print("Unknown or incomplete action.", file=sys.stderr)
                return 64
    except (OSError, ValueError, RuntimeError) as error:
        print(f"Driver operation failed: {error}", file=sys.stderr)
        return 1
    print("Driver operation completed successfully.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
