<!DOCTYPE node PUBLIC
  "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
  "https://dbus.freedesktop.org/doc/introspect.dtd">
<node name="/com/anduinos/TimebackMachine1">
  <interface name="com.anduinos.TimebackMachine1">
    <property name="ContractVersion" type="u" access="read"/>
    <property name="Busy" type="b" access="read"/>

    <method name="InspectLayout">
      <arg name="report_json" type="s" direction="out"/>
    </method>
    <method name="ListDeployments">
      <arg name="deployments_json" type="s" direction="out"/>
    </method>
    <method name="InspectSystemHistory">
      <arg name="history_json" type="s" direction="out"/>
    </method>
    <method name="InspectRetention">
      <arg name="retention_json" type="s" direction="out"/>
    </method>
    <method name="InspectAutomatic">
      <arg name="status_json" type="s" direction="out"/>
    </method>
    <method name="ListHomeSnapshots">
      <arg name="snapshots_json" type="s" direction="out"/>
    </method>
    <method name="BeginSnapshotBrowse">
      <arg name="snapshot_kind" type="s" direction="in"/>
      <arg name="snapshot_id" type="s" direction="in"/>
      <arg name="session_id" type="s" direction="out"/>
    </method>
    <method name="ListSnapshotDirectorySession">
      <arg name="session_id" type="s" direction="in"/>
      <arg name="path_json" type="s" direction="in"/>
      <arg name="offset" type="u" direction="in"/>
      <arg name="limit" type="u" direction="in"/>
      <arg name="sort_mode" type="s" direction="in"/>
      <arg name="descending" type="b" direction="in"/>
      <arg name="listing_json" type="s" direction="out"/>
    </method>
    <method name="OpenSnapshotFileSession">
      <arg name="session_id" type="s" direction="in"/>
      <arg name="path_json" type="s" direction="in"/>
      <arg name="file" type="h" direction="out"/>
      <arg name="metadata_json" type="s" direction="out"/>
    </method>
    <method name="CloseSnapshotBrowse">
      <arg name="session_id" type="s" direction="in"/>
    </method>
    <method name="KeepSnapshotBrowseAlive">
      <arg name="session_id" type="s" direction="in"/>
    </method>
    <method name="ListSnapshotDirectory">
      <arg name="snapshot_kind" type="s" direction="in"/>
      <arg name="snapshot_id" type="s" direction="in"/>
      <arg name="path_json" type="s" direction="in"/>
      <arg name="listing_json" type="s" direction="out"/>
    </method>
    <method name="ListSnapshotDirectoryPage">
      <arg name="snapshot_kind" type="s" direction="in"/>
      <arg name="snapshot_id" type="s" direction="in"/>
      <arg name="path_json" type="s" direction="in"/>
      <arg name="offset" type="u" direction="in"/>
      <arg name="limit" type="u" direction="in"/>
      <arg name="listing_json" type="s" direction="out"/>
    </method>
    <method name="ListSnapshotDirectoryPageSorted">
      <arg name="snapshot_kind" type="s" direction="in"/>
      <arg name="snapshot_id" type="s" direction="in"/>
      <arg name="path_json" type="s" direction="in"/>
      <arg name="offset" type="u" direction="in"/>
      <arg name="limit" type="u" direction="in"/>
      <arg name="sort_mode" type="s" direction="in"/>
      <arg name="descending" type="b" direction="in"/>
      <arg name="listing_json" type="s" direction="out"/>
    </method>
    <method name="OpenSnapshotFile">
      <arg name="snapshot_kind" type="s" direction="in"/>
      <arg name="snapshot_id" type="s" direction="in"/>
      <arg name="path_json" type="s" direction="in"/>
      <arg name="file" type="h" direction="out"/>
      <arg name="metadata_json" type="s" direction="out"/>
    </method>
    <method name="SetAutomaticPolicy">
      <arg name="configuration_json" type="s" direction="in"/>
      <arg name="operation_id" type="s" direction="out"/>
    </method>
    <method name="VerifyRecoveryPoint">
      <arg name="deployment_id" type="s" direction="in"/>
      <arg name="operation_id" type="s" direction="out"/>
    </method>
    <method name="CreateRecoveryPoint">
      <arg name="title" type="s" direction="in"/>
      <arg name="reason" type="s" direction="in"/>
      <arg name="pinned" type="b" direction="in"/>
      <arg name="operation_id" type="s" direction="out"/>
    </method>
    <method name="SetPinned">
      <arg name="deployment_id" type="s" direction="in"/>
      <arg name="pinned" type="b" direction="in"/>
      <arg name="operation_id" type="s" direction="out"/>
    </method>
    <method name="DeleteRecoveryPoint">
      <arg name="deployment_id" type="s" direction="in"/>
      <arg name="operation_id" type="s" direction="out"/>
    </method>
    <method name="ScheduleRollback">
      <arg name="deployment_id" type="s" direction="in"/>
      <arg name="operation_id" type="s" direction="out"/>
    </method>
    <method name="CancelPendingRollback">
      <arg name="operation_id" type="s" direction="out"/>
    </method>
    <method name="RunRetention">
      <arg name="operation_id" type="s" direction="out"/>
    </method>
    <method name="SetRetentionPolicy">
      <arg name="policy_json" type="s" direction="in"/>
      <arg name="operation_id" type="s" direction="out"/>
    </method>

    <signal name="OperationProgress">
      <arg name="operation_id" type="s"/>
      <arg name="phase" type="s"/>
      <arg name="fraction" type="d"/>
      <arg name="message" type="s"/>
    </signal>
    <signal name="OperationFinished">
      <arg name="operation_id" type="s"/>
      <arg name="success" type="b"/>
      <arg name="error_code" type="s"/>
      <arg name="message" type="s"/>
    </signal>
    <signal name="DeploymentsChanged"/>
  </interface>
</node>
