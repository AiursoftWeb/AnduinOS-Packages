#!/bin/sh

PREREQ="btrfs"

prereqs()
{
    echo "$PREREQ"
}

case "${1:-}" in
prereqs)
    prereqs
    exit 0
    ;;
esac

. /scripts/functions

[ "${FSTYPE:-}" = "btrfs" ] || exit 0

root_device="$(resolve_device "${ROOT:-}")" || exit 0
[ -b "$root_device" ] || exit 0

top_level=/run/anduinos-timeback/top
mkdir -p "$top_level"
if ! mount -t btrfs -o rw,subvolid=5 "$root_device" "$top_level"; then
    log_warning_msg "AnduinOS Timeback could not inspect the Btrfs top level"
    exit 0
fi

transaction="$top_level/@snapshots/anduinos/transactions/pending-rollback.json"
if [ ! -f "$transaction" ]; then
    umount "$top_level"
    exit 0
fi

requested=""
for argument in $(cat /proc/cmdline); do
    case "$argument" in
    anduinos.timeback=*) requested="${argument#anduinos.timeback=}" ;;
    esac
done

if [ -n "$requested" ]; then
    if /usr/libexec/anduinos-timeback-initramfs "$requested"; then
        status=0
    else
        status=$?
    fi
else
    if /usr/libexec/anduinos-timeback-initramfs; then
        status=0
    else
        status=$?
    fi
fi

if [ "$status" -ne 0 ]; then
    log_failure_msg "AnduinOS Timeback could not complete the recovery transaction"
    if [ ! -d "$top_level/@root" ]; then
        panic "AnduinOS Timeback cannot find a bootable @root subvolume"
    fi
fi

if ! umount "$top_level"; then
    panic "AnduinOS Timeback could not release the Btrfs top-level mount"
fi

exit 0
