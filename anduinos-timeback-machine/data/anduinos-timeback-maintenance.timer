[Unit]
Description=Periodically maintain AnduinOS recovery points
Documentation=file:/usr/share/doc/anduinos-timeback-machine/TM5-DESIGN.md

[Timer]
OnCalendar=*:0/15
RandomizedDelaySec=2min
AccuracySec=1min
Persistent=true
Unit=anduinos-timeback-maintenance.service

[Install]
WantedBy=timers.target
