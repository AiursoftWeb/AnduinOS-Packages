[Desktop Entry]
Name=AnduinOS Timeback Machine
Name[zh_CN]=AnduinOS 时光恢复机
GenericName=System Recovery
GenericName[zh_CN]=系统恢复
Comment=Create recovery points and safely return AnduinOS to an earlier state
Comment[zh_CN]=创建恢复点并安全地将 AnduinOS 恢复到较早状态
Exec=anduinos-timeback-machine
Icon=com.anduinos.timebackmachine
Terminal=false
Type=Application
Categories=GNOME;GTK;System;
Keywords=backup;snapshot;restore;recovery;btrfs;rollback;
Keywords[zh_CN]=备份;快照;恢复;还原;btrfs;回滚;
StartupNotify=true
