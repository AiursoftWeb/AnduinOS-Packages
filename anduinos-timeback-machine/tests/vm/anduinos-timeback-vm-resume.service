[Unit]
Description=Resume AnduinOS Timeback disposable-VM qualification
After=anduinos-timeback-confirm.service
Wants=anduinos-timeback-confirm.service
ConditionPathExists=/.snapshots/anduinos/tm5-vm-test/state.json

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/anduinos-timeback-vm-resume
User=root
Group=root
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
