<Project Sdk="Aiursoft.Apkg.Sdk">
  <PropertyGroup>
    <PackageName>anduinos-timeback-machine</PackageName>
    <PackageVersion>0.4.0-1+$(SuiteShortName)</PackageVersion>
    <Maintainer>AnduinOS Team &lt;anduin@aiursoft.com&gt;</Maintainer>
    <PackageDescription>AnduinOS Timeback Machine — graphical Btrfs system recovery and deployment manager</PackageDescription>
    <Section>admin</Section>
    <PackageHomepage>https://www.anduinos.com</PackageHomepage>
    <RepositoryUrl>https://github.com/AiursoftWeb/AnduinOS-Packages</RepositoryUrl>
    <LicenseType>GPL-3.0</LicenseType>
    <AppStreamDeveloperName>AnduinOS Team</AppStreamDeveloperName>
    <AppStreamMetadataLicense>CC0-1.0</AppStreamMetadataLicense>
    <TargetDistro>anduinos</TargetDistro>
    <TargetSuites>resolute-addon</TargetSuites>
    <TargetArchitectures>amd64 arm64</TargetArchitectures>
    <Component>main</Component>
    <SuiteShortNameMap>resolute-addon=resolute</SuiteShortNameMap>
  </PropertyGroup>

  <ItemGroup>
    <DependencyCheckSource
        Url="https://mirror.aiursoft.com/ubuntu"
        SuiteMap="resolute-addon=resolute" />
  </ItemGroup>

  <ItemGroup>
    <Dependency Include="libgtk-4-1" />
    <Dependency Include="libadwaita-1-0" />
    <Dependency Include="btrfs-progs" />
    <Dependency Include="util-linux" />
    <Dependency Include="polkitd" />
    <Dependency Include="dbus-bin" />
    <Dependency Include="initramfs-tools" />
    <Dependency Include="grub-common" />
  </ItemGroup>

  <ItemGroup>
    <PrebuildCommand Run="bash compile-locales.sh" />
    <PrebuildCommand Run="bash scripts/prebuild-check.sh" />
    <PrebuildCommand Run="bash build.sh amd64" Condition="'$(Arch)' == 'amd64'" />
    <PrebuildCommand Run="bash build.sh arm64" Condition="'$(Arch)' == 'arm64'" />
  </ItemGroup>

  <ItemGroup>
    <PostInstallScript Include="scripts/postinst.sh" />
    <PreRemoveScript Include="scripts/prerm.sh" />
    <PostRemoveScript Include="scripts/postrm.sh" />
    <SystemdUnit Include="data/anduinos-timebackd.service" AutoEnable="false" />
    <SystemdUnit Include="data/anduinos-timeback-confirm.service" AutoEnable="true" />
    <SystemdUnit Include="data/anduinos-timeback-maintenance.service" AutoEnable="false" />
    <SystemdUnit Include="data/anduinos-timeback-maintenance.timer" AutoEnable="true" />
  </ItemGroup>

  <ItemGroup>
    <IncludeScript Include="obj/anduinos-timeback-machine" Target="/usr/bin/anduinos-timeback-machine" />
    <IncludeScript Include="obj/anduinos-timebackd" Target="/usr/libexec/anduinos-timebackd" />
    <IncludeScript Include="obj/timebackctl" Target="/usr/bin/timebackctl" />
    <IncludeScript Include="obj/anduinos-timeback-initramfs" Target="/usr/libexec/anduinos-timeback-initramfs" />
    <IncludeScript Include="obj/anduinos-timeback-confirm" Target="/usr/libexec/anduinos-timeback-confirm" />
    <IncludeScript Include="obj/anduinos-timeback-apt-hook" Target="/usr/libexec/anduinos-timeback-apt-hook" />
    <IncludeScript Include="obj/anduinos-timeback-maintenance" Target="/usr/libexec/anduinos-timeback-maintenance" />
    <IncludeFile Include="data/85anduinos-timeback" Target="/etc/apt/apt.conf.d/85anduinos-timeback" />
    <IncludeFile Include="data/initramfs-hook" Target="/usr/share/initramfs-tools/hooks/anduinos-timeback" Mode="755" />
    <IncludeFile Include="data/initramfs-local-premount" Target="/usr/share/initramfs-tools/scripts/local-premount/anduinos-timeback" Mode="755" />
    <IncludeFile Include="data/grub.d/09_anduinos_timeback" Target="/etc/grub.d/09_anduinos_timeback" Mode="755" />
    <DpkgTrigger Include="update-initramfs" Type="activate-await" />
    <IncludeFile Include="data/com.anduinos.timebackmachine.policy" Target="/usr/share/polkit-1/actions/com.anduinos.timebackmachine.policy" />
    <IncludeFolder Include="locale" Target="/usr/share/locale" />
    <IncludeFile Include="data/com.anduinos.timebackmachine.xml" Target="/usr/share/dbus-1/interfaces/com.anduinos.timebackmachine.xml" />
    <IncludeFile Include="data/com.anduinos.TimebackMachine1.conf" Target="/usr/share/dbus-1/system.d/com.anduinos.TimebackMachine1.conf" />
    <IncludeFile Include="data/com.anduinos.TimebackMachine1.service" Target="/usr/share/dbus-1/system-services/com.anduinos.TimebackMachine1.service" />
    <IncludeFile Include="docs/deployment-v1.schema.json" Target="/usr/share/anduinos-timeback-machine/deployment-v1.schema.json" />
    <IncludeFile Include="docs/rollback-v1.schema.json" Target="/usr/share/anduinos-timeback-machine/rollback-v1.schema.json" />
    <IncludeFile Include="docs/package-transaction-v1.schema.json" Target="/usr/share/anduinos-timeback-machine/package-transaction-v1.schema.json" />
    <IncludeFile Include="docs/home-snapshot-v1.schema.json" Target="/usr/share/anduinos-timeback-machine/home-snapshot-v1.schema.json" />
    <IncludeFile Include="docs/automatic-configuration-v1.schema.json" Target="/usr/share/anduinos-timeback-machine/automatic-configuration-v1.schema.json" />
    <IncludeFile Include="README.md" Target="/usr/share/doc/anduinos-timeback-machine/README.md" />
    <IncludeFile Include="ARCHITECTURE.md" Target="/usr/share/doc/anduinos-timeback-machine/ARCHITECTURE.md" />
    <IncludeFile Include="TM3-DESIGN.md" Target="/usr/share/doc/anduinos-timeback-machine/TM3-DESIGN.md" />
    <IncludeFile Include="TM4-DESIGN.md" Target="/usr/share/doc/anduinos-timeback-machine/TM4-DESIGN.md" />
    <IncludeFile Include="TM5-DESIGN.md" Target="/usr/share/doc/anduinos-timeback-machine/TM5-DESIGN.md" />
  </ItemGroup>

  <ItemGroup>
    <AppStreamApplication Include="data/com.anduinos.timebackmachine.desktop" Icon="data/com.anduinos.timebackmachine.svg" />
    <AppStreamScreenshot Include="screenshots/overview.png" Default="true" Caption="Protect your system with automatic recovery points" Environment="GNOME:dark" />
    <AppStreamScreenshot Include="screenshots/restore-points.png" Caption="Review and manage system recovery points" Environment="GNOME:dark" />
  </ItemGroup>
</Project>
