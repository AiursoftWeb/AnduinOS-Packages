{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.anduinos.com/timeback/package-transaction-v1.schema.json",
  "title": "AnduinOS Timeback package transaction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "phase",
    "created_at",
    "updated_at",
    "pre_deployment_id",
    "post_deployment_id",
    "failure"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "phase": {
      "enum": ["preparing-pre", "awaiting-post", "complete", "interrupted"]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "pre_deployment_id": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      ]
    },
    "post_deployment_id": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      ]
    },
    "failure": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "minLength": 1, "maxLength": 2000 }
      ]
    }
  }
}
