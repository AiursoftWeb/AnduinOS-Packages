{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.anduinos.com/schemas/timeback/home-snapshot-v1.schema.json",
  "title": "AnduinOS Timeback Home snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "created_at", "deleting"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "deleting": {
      "type": "boolean"
    }
  }
}
