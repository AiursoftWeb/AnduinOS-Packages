<Project Sdk="Aiursoft.Apkg.Sdk">
  <PropertyGroup>
    <PackageName>anduinos-dracut-migration</PackageName>
    <PackageVersion>2.0.2-4+$(SuiteShortName)</PackageVersion>
    <Maintainer>AnduinOS Team &lt;anduin@aiursoft.com&gt;</Maintainer>
    <PackageDescription>One-shot migration of existing AnduinOS installations to the pure Dracut boot stack</PackageDescription>
    <Section>admin</Section>
    <PackageHomepage>https://www.anduinos.com</PackageHomepage>
    <RepositoryUrl>https://github.com/AiursoftWeb/AnduinOS-Packages</RepositoryUrl>
    <LicenseType>GPL-3.0</LicenseType>
    <TargetDistro>anduinos</TargetDistro>
    <TargetSuites>noble-addon resolute-addon</TargetSuites>
    <TargetArchitectures>all</TargetArchitectures>
    <Component>main</Component>
    <SuiteShortNameMap>noble-addon=noble resolute-addon=resolute</SuiteShortNameMap>
  </PropertyGroup>

  <ItemGroup>
    <!-- Deliberately do not depend on Dracut here. This package must be
         installable during a conservative `apt upgrade` while the old core
         package still owns the conflicting generator stack. -->
    <Dependency Include="apt" />
    <Dependency Include="systemd" />

    <PrebuildCommand Run="PYTHONDONTWRITEBYTECODE=1 python3 tests/test_migration_contract.py" />

    <IncludeScript Include="assets/anduinos-dracut-migrate" Target="/usr/lib/anduinos-dracut-migration/anduinos-dracut-migrate" />
    <IncludeScript Include="assets/anduinos-dracut-confirm-boot" Target="/usr/lib/anduinos-dracut-migration/anduinos-dracut-confirm-boot" />
    <SystemdUnit Include="assets/anduinos-dracut-migration.service" AutoEnable="false" />
    <SystemdUnit Include="assets/anduinos-dracut-migration.timer" AutoEnable="true" />
    <SystemdUnit Include="assets/anduinos-dracut-confirm-boot.service" AutoEnable="true" />
  </ItemGroup>
</Project>
