[Unit]
Description=Migrate AnduinOS to the pure Dracut boot stack
Documentation=https://www.anduinos.com
ConditionPathExists=/usr/sbin/update-initramfs
ConditionPathExists=!/run/anduinos-live/environment
ConditionPathExists=!/var/lib/anduinos-dracut-migration/complete
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/lib/anduinos-dracut-migration/anduinos-dracut-migrate
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
