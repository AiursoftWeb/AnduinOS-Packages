[Unit]
Description=Sync GNOME color-scheme to Flatpak GTK_THEME override
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStartPre=/bin/sleep 5
ExecStart=/usr/bin/anduinos-theme-sync
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=graphical-session.target
