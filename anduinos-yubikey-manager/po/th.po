msgstr "กำลังตรวจสอบการรองรับ SSH…"

msgid "Checking connected YubiKeys"
msgstr "กำลังตรวจสอบ YubiKey ที่เชื่อมต่ออยู่"

msgid "Choose a YubiKey-backed SSH key"
msgstr "เลือกคีย์ SSH ที่รองรับด้วย YubiKey"

msgid "Choose a local key-handle file"
msgstr "เลือกไฟล์ handle คีย์ท้องถิ่น"

msgid "Choose a supported OpenSSH security-key algorithm."
msgstr "เลือกอัลกอริทึมคีย์ความปลอดภัย OpenSSH ที่รองรับ"

msgid "Choose a valid /dev/hidrawN FIDO device."
msgstr "เลือกอุปกรณ์ FIDO /dev/hidrawN ที่ถูกต้อง"

msgid "Choose a valid output folder."
msgstr "เลือกโฟลเดอร์เอาต์พุตที่ถูกต้อง"

msgid "Choose an SSH key for Git signing."
msgstr "Choose an SSH key for Git signing."

msgid "Choose local SSH key-handle path"
msgstr "เลือกเส้นทาง handle คีย์ SSH ท้องถิ่น"

msgid "Choose one SSH key. The selection takes effect immediately for this user's Git commits."
msgstr "เลือกคีย์ SSH หนึ่งคีย์ การเลือกจะมีผลทันทีสำหรับการส่งโค้ด (Git commits) ของผู้ใช้รายนี้"

msgid "Choose which YubiKeys may unlock {0}. Password sign-in remains available."
msgstr "เลือก YubiKey ใดบ้างที่สามารถปลดล็อก {0} ได้ การเข้าสู่ระบบด้วยรหัสผ่านยังคงใช้ได้"

msgid "Close"
msgstr "ปิด"

msgid "Command exited with"
msgstr "คำสั่งสิ้นสุดด้วย"

msgid "Command exited with {0}"
msgstr "คำสั่งสิ้นสุดด้วย {0}"

msgid "Commit signing"
msgstr "การลงนามในคอมมิต"

msgid "Configured YubiKeys"
msgstr "YubiKey ที่กำหนดค่าแล้ว"

msgid "Configured for {0} · Not connected"
msgstr "กำหนดค่าสำหรับ {0} · ไม่ได้เชื่อมต่อ"

msgid "Connect a FIDO security key first"
msgstr "เชื่อมต่อคีย์ความปลอดภัย FIDO ก่อน"

msgid "Connect a YubiKey"
msgstr "เชื่อมต่อ YubiKey"

msgid "Connect a YubiKey to get started"
msgstr "เชื่อมต่อ YubiKey เพื่อเริ่มต้นใช้งาน"

msgid "Connect your YubiKey"
msgstr "เชื่อมต่อ YubiKey ของคุณ"

msgid "Connected"
msgstr "เชื่อมต่อแล้ว"

msgid "Connected YubiKeys"
msgstr "YubiKey ที่เชื่อมต่ออยู่"

msgid "Continue"
msgstr "ดำเนินการต่อ"

msgid "Continue to PIN"
msgstr "ดำเนินการต่อเพื่อใช้ PIN"

msgid "Copy public key"
msgstr "คัดลอกกุญแจสาธารณะ"

msgid "Could not check SSH keys"
msgstr "ไม่สามารถตรวจสอบคีย์ SSH ได้"

msgid "Could not create a temporary public-key file: {0}"
msgstr "ไม่สามารถสร้างไฟล์กุญแจสาธารณะชั่วคราว: {0}"

msgid "Could not create temporary Git signing data: {0}"
msgstr "Could not create temporary Git signing data: {0}"

msgid "Could not create {0}: {1}"
msgstr "ไม่สามารถสร้าง {0}: {1}"

msgid "Could not export the public key: {0}"
msgstr "ไม่สามารถส่งออกกุญแจสาธารณะ: {0}"

msgid "Could not find security keys"
msgstr "ไม่พบคีย์ความปลอดภัย"

msgid "Could not flush the temporary public key: {0}"
msgstr "ไม่สามารถล้างข้อมูลกุญแจสาธารณะชั่วคราว: {0}"

msgid "Could not inspect USB devices: {0}"
msgstr "ไม่สามารถตรวจสอบอุปกรณ์ USB: {0}"

msgid "Could not inspect this YubiKey"
msgstr "ไม่สามารถตรวจสอบ YubiKey นี้ได้"

msgid "Could not list YubiKeys"
msgstr "ไม่สามารถแสดงรายการ YubiKeys ได้"

msgid "Could not locate the secure PIN helper: {0}"
msgstr "ไม่สามารถค้นหาผู้ช่วย PIN ความปลอดภัย: {0}"

msgid "Could not prepare the Git signing test: {0}"
msgstr "Could not prepare the Git signing test: {0}"

msgid "Could not protect {0}: {1}"
msgstr "ไม่สามารถป้องกัน {0}: {1}"

msgid "Could not provide the FIDO PIN: {0}"
msgstr "ไม่สามารถให้รหัส FIDO PIN: {0}"

msgid "Could not request administrator access: {0}"
msgstr "ไม่สามารถขอสิทธิ์ผู้ดูแลระบบ: {0}"

msgid "Could not run {0}: {1}"
msgstr "ไม่สามารถรัน {0}: {1}"

msgid "Could not start {0}: {1}"
msgstr "ไม่สามารถเริ่มต้น {0}: {1}"

msgid "Could not update security keys"
msgstr "ไม่สามารถอัปเดตคีย์ความปลอดภัยได้"

msgid "Could not write the temporary public key: {0}"
msgstr "ไม่สามารถเขียนกุญแจสาธารณะชั่วคราว: {0}"

msgid "Create"
msgstr "สร้าง"

msgid "Create a resident SSH credential on a selected device"
msgstr "สร้างข้อมูลประจำตัว SSH แบบ resident บนอุปกรณ์ที่เลือก"

msgid "Create a resident SSH key"
msgstr "สร้างคีย์ SSH แบบ resident"

msgid "Create…"
msgstr "สร้าง…"

msgid "Deletion result is unknown"
msgstr "ผลลัพธ์การลบไม่ทราบสถานะ"

msgid "Disabled · sudo must authenticate with a YubiKey or account password"
msgstr "ปิดใช้งาน · sudo ต้องยืนยันตัวตนด้วย YubiKey หรือรหัสผ่านบัญชี"

msgid "Discover SSH keys on your YubiKeys"
msgstr "ค้นหาคีย์ SSH บน YubiKey ของคุณ"

msgid "Display label must be at most 200 bytes and contain no control characters."
msgstr "ป้ายชื่อแสดงต้องมีความยาวไม่เกิน 200 ไบต์และไม่มีการควบคุมตัวอักษร"

msgid "Do not sign new commits by default"
msgstr "ไม่ลงนามในคอมมิตใหม่โดยค่าเริ่มต้น"

msgid "During enrollment, disconnect all other security keys. The selected key will blink; touch it to continue. Multiple keys can be enrolled one at a time."
msgstr "ระหว่างลงทะเบียน ให้ถอดอุปกรณ์ความปลอดภัยอื่นๆ ทั้งหมดออก คีย์ที่เลือกจะกระพริบ; สัมผัสเพื่อดำเนินการต่อ สามารถลงทะเบียนคีย์ได้ทีละหนึ่งตัว"

msgid "ECDSA-SK (recommended compatibility)"
msgstr "ECDSA-SK (ความเข้ากันได้แนะนำ)"

msgid "ECDSA-SK works with the widest range of YubiKeys"
msgstr "ECDSA-SK ทำงานกับ YubiKeys ที่หลากหลายที่สุด"

msgid "ECDSA-SK · resident · touch required · safe compatibility defaults"
msgstr "ECDSA-SK · resident · ต้องสัมผัส · ค่าเริ่มต้นความเข้ากันได้อย่างปลอดภัย"

msgid "Ed25519-SK (newer YubiKeys)"
msgstr "Ed25519-SK (YubiKeys รุ่นใหม่)"

msgid "Enabled"
msgstr "เปิดใช้งานแล้ว"

msgid "Enabled · programs can obtain administrator privileges without confirmation"
msgstr "เปิดใช้งาน · โปรแกรมสามารถรับสิทธิ์ผู้ดูแลระบบโดยไม่ต้องยืนยัน"

msgid "Enabling passwordless sudo…"
msgstr "กำลังเปิดใช้งาน sudo แบบไม่มีรหัสผ่าน…"

msgid "Enabling sudo authentication…"
msgstr "กำลังเปิดใช้งานการตรวจสอบสิทธิ์ sudo…"

msgid "Enrolled · inactive while sudo authentication is bypassed"
msgstr "ลงทะเบียนแล้ว · ไม่ใช้งานขณะข้ามการตรวจสอบสิทธิ์ sudo"

msgid "Enrollment safety"
msgstr "ความปลอดภัยในการลงทะเบียน"

msgid "Enter the FIDO PIN for {0}. Touch it if it flashes. The PIN is never stored."
msgstr "ใส่รหัส PIN FIDO สำหรับ {0} แตะที่อุปกรณ์หากไฟกระพริบ รหัส PIN จะไม่ถูกเก็บไว้"

msgid "Enter the FIDO PIN, then touch the selected YubiKey when it flashes. No commit will be created."
msgstr "Enter the FIDO PIN, then touch the selected YubiKey when it flashes. No commit will be created."

msgid "Enter the FIDO PIN. Touch the YubiKey if it flashes."
msgstr "ใส่ PIN ของ FIDO แตะ YubiKey หากมันกระพริบ"

msgid "Enter the YubiKey FIDO PIN to test this local key handle."
msgstr "Enter the YubiKey FIDO PIN to test this local key handle."

msgid "Enter the selected YubiKey FIDO PIN"
msgstr "ใส่ PIN ของ YubiKey FIDO ที่เลือก"

msgid "Export .pub"
msgstr "ส่งออก .pub"

msgid "Export SSH public key"
msgstr "ส่งออกคีย์สาธารณะ SSH"

msgid "FIDO PIN"
msgstr "PIN ของ FIDO"

msgid "FIDO device discovery is unavailable"
msgstr "การค้นพบอุปกรณ์ FIDO ไม่พร้อมใช้งาน"

msgid "FIDO security key"
msgstr "คีย์ความปลอดภัย FIDO"

msgid "Finish inspecting your YubiKeys"
msgstr "เสร็จสิ้นการตรวจสอบ YubiKey ของคุณ"

msgid "Firmware {0}"
msgstr "เฟิร์มแวร์ {0}"

msgid "For safe enrollment, disconnect every other security key and leave only the selected YubiKey connected."
msgstr "เพื่อความปลอดภัยในการลงทะเบียน โปรดถอดคีย์ความปลอดภัยอื่นๆ ทั้งหมดออก และเหลือเพียง YubiKey ที่เลือกไว้เชื่อมต่อกับเครื่อง"

msgid "Git signing"
msgstr "Git signing"

msgid "Git signing is enabled"
msgstr "เปิดใช้งานการลงนาม Git แล้ว"

