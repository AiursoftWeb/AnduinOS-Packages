msgid "Reading SSH keys from {0}… Touch it if it flashes."
msgstr "กำลังอ่านคีย์ SSH จาก {0}… แตะที่อุปกรณ์หากไฟกระพริบ"

msgid "Reading account security settings…"
msgstr "กำลังอ่านการตั้งค่าความปลอดภัยของบัญชี…"

msgid "Ready"
msgstr "พร้อมใช้งาน"

msgid "Ready to inspect"
msgstr "พร้อมสำหรับการตรวจสอบ"

msgid "Ready to protect {0}"
msgstr "พร้อมที่จะปกป้อง {0}"

msgid "Refresh connected YubiKeys"
msgstr "รีเฟรช YubiKeys ที่เชื่อมต่อ"

