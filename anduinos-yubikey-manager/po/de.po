msgstr "Agent"

msgid "sudo authentication"
msgstr "sudo-Authentifizierung"

msgid "sudo authentication policy"
msgstr "sudo-Authentifizierungsrichtlinie"

msgid "sudo currently allows administrator access without authentication"
msgstr "sudo erlaubt derzeit Administratorzugriff ohne Authentifizierung"

msgid "unknown"
msgstr "unbekannt"

