msgid "A key must be connected before it can be enrolled."
msgstr "Nøglen skal være tilsluttet, før den kan registreres."

msgid "About"
msgstr "Oplysninger"

msgid "Account password is required for sudo"
msgstr "Adgangskode til kontoen er påkrævet for sudo"

msgid "Advanced options"
msgstr "Avancerede indstillinger"

msgid "Algorithm"
msgstr "Algoritme"

msgid "All inspected resident credentials from this key are already in the agent"
msgstr "Alle undersøgte lokale legitimationsoplysninger fra denne nøgle er allerede i agenten"

msgid "Allow sudo without authentication"
msgstr "Tillad sudo uden godkendelse"

msgid "Allowed for sudo · not currently connected"
msgstr "Tilladt til sudo · ikke tilsluttet pt."

msgid "Allowed to authorize sudo"
msgstr "Må autorisere sudo"

msgid "Allowed to unlock this user"
msgstr "Må låse op for denne bruger"

msgid "Allowed to unlock this user · not currently connected"
msgstr "Må låse op for denne bruger · ikke tilsluttet pt."

msgid "Already loaded"
msgstr "Allerede indlæst"

msgid "An enrolled YubiKey or the account password can authorize sudo."
msgstr "En registreret YubiKey eller adgangskoden til kontoen kan autorisere sudo."

msgid "AnduinOS Team"
msgstr "AnduinOS-teamet"

msgid "AnduinOS sign-in"
msgstr "Log på AnduinOS"

msgid "Application"
msgstr "Program"

msgid "Application must begin with ssh:, contain no whitespace, and be at most 253 bytes."
msgstr "Programmet skal starte med ssh:, indeholde ingen mellemrum og være højst 253 bytes."

msgid "Cancel"
msgstr "Annullér"

msgid "Choose a local key-handle file"
msgstr "Vælg en lokal nøglehåndlingsfil"

msgid "Choose a supported OpenSSH security-key algorithm."
msgstr "Vælg en understøttet OpenSSH-sikkerhedsnøglealgoritme."

msgid "Choose a valid /dev/hidrawN FIDO device."
msgstr "Vælg en gyldig FIDO-enhed på /dev/hidrawN."

msgid "Choose a valid output folder."
msgstr "Vælg en gyldig outputmappe."

msgid "Choose local SSH key-handle path"
msgstr "Vælg lokal sti til SSH-nøglehåndtering"

msgid "Choose which YubiKeys may unlock {0}. Password sign-in remains available."
msgstr "Vælg, hvilke YubiKeys der må låse op for {0}. Adgangskodelogon forbliver tilgængelig."

msgid "Close"
msgstr "Luk"

msgid "Command exited with"
msgstr "Kommandoen afsluttede med"

msgid "Command exited with {0}"
msgstr "Kommandoen afsluttede med {0}"

msgid "Configured features"
msgstr "Konfigurerede funktioner"

msgid "Connect a FIDO security key first"
msgstr "Tilslut først en FIDO-sikkerhedsnøgle"

msgid "Connect exactly one FIDO security key to choose an unambiguous source"
msgstr "Tilslut præcis én FIDO-sikkerhedsnøgle for at vælge en entydig kilde"

msgid "Continue"
msgstr "Fortsæt"

msgid "Copy public key"
msgstr "Kopiér offentlig nøgle"

msgid "Could not create a temporary public-key file: {0}"
msgstr "Kunne ikke oprette en midlertidig fil til den offentlige nøgle: {0}"

msgid "Could not create {0}: {1}"
msgstr "Kunne ikke oprette {0}: {1}"

msgid "Could not export the public key: {0}"
msgstr "Kunne ikke eksportere den offentlige nøgle: {0}"

msgid "Could not flush the temporary public key: {0}"
msgstr "Kunne ikke tømme den midlertidige offentlige nøgle: {0}"

msgid "Could not inspect USB devices: {0}"
msgstr "Kunne ikke inspicere USB-enheder: {0}"

msgid "Could not inspect this YubiKey"
msgstr "Kunne ikke inspicere denne YubiKey"

msgid "Could not list YubiKeys"
msgstr "Kunne ikke liste YubiKeys"

msgid "Could not locate the secure PIN helper: {0}"
msgstr "Kunne ikke finde den sikre PIN-hjælper: {0}"

msgid "Could not protect {0}: {1}"
msgstr "Kunne ikke beskytte {0}: {1}"

msgid "Could not provide the FIDO PIN: {0}"
msgstr "Kunne ikke angive FIDO-PIN-koden: {0}"

msgid "Could not request administrator access: {0}"
msgstr "Kunne ikke anmode om administratoradgang: {0}"

msgid "Could not run {0}: {1}"
msgstr "Kunne ikke køre {0}: {1}"

msgid "Could not start {0}: {1}"
msgstr "Kunne ikke starte {0}: {1}"

msgid "Could not write the temporary public key: {0}"
msgstr "Kunne ikke skrive den midlertidige offentlige nøgle: {0}"

msgid "Create"
msgstr "Opret"

msgid "Create a resident SSH credential on a selected device"
msgstr "Opret en bosiddende SSH-legitimationsoplysning på en valgt enhed"

msgid "Create a resident SSH key"
msgstr "Opret en bosiddende SSH-nøgle"

msgid "Create…"
msgstr "Opret…"

msgid "Current user: {0}"
msgstr "Aktuel bruger: {0}"

msgid "Disabled · sudo must authenticate with a YubiKey or account password"
msgstr "Deaktiveret · sudo skal godkendes med en YubiKey eller kontopassword"

msgid "Display label must be at most 200 bytes and contain no control characters."
msgstr "Visningsmærkat må højst være 200 bytes og må ikke indeholde kontroltegn."

msgid "During enrollment, disconnect all other security keys. The selected key will blink; touch it to continue. Multiple keys can be enrolled one at a time."
msgstr "Frakobl alle andre sikkerhedsnøgler under registreringen. Den valgte nøgle vil blinke; tryk på den for at fortsætte. Flere nøgler kan registreres én ad gangen."

msgid "ECDSA-SK (recommended compatibility)"
msgstr "ECDSA-SK (anbefalet kompatibilitet)"

msgid "ECDSA-SK works with the widest range of YubiKeys"
msgstr "ECDSA-SK fungerer med det bredeste udvalg af YubiKeys"

msgid "ECDSA-SK · resident · touch required · safe compatibility defaults"
msgstr "ECDSA-SK · bosiddende · berøring påkrævet · sikre standardindstillinger for kompatibilitet"

msgid "Ed25519-SK (newer YubiKeys)"
msgstr "Ed25519-SK (nyere YubiKeys)"

msgid "Enabled · programs can obtain administrator privileges without confirmation"
msgstr "Aktiveret · programmer kan opnå administratorrettigheder uden bekræftelse"

msgid "Enabling passwordless sudo…"
msgstr "Aktiverer sudo uden adgangskode…"

msgid "Enabling sudo authentication…"
msgstr "Aktivering af sudo-autentificering…"

msgid "Enrolled · inactive while sudo authentication is bypassed"
msgstr "Tilmeldt · inaktiv, mens sudo-autentificering omgås"

msgid "Enrollment safety"
msgstr "Sikkerhed ved tilmelding"

msgid "Enter the YubiKey FIDO PIN"
msgstr "Indtast YubiKey FIDO-PIN-koden"

msgid "Enter the selected YubiKey FIDO PIN"
msgstr "Indtast den valgte YubiKey FIDO-PIN-kode"

msgid "Export .pub"
msgstr "Eksporter .pub"

msgid "Export SSH public key"
msgstr "Eksporter SSH-offentlig nøgle"

msgid "FIDO PIN"
msgstr "FIDO-PIN-kode"

msgid "FIDO device discovery is unavailable"
msgstr "FIDO-enhedsopdagelse er ikke tilgængelig"

msgid "FIDO security key"
msgstr "FIDO-sikkerhedsnøgle"

msgid "Firmware {0}"
msgstr "Firmware {0}"

msgid "For safe enrollment, disconnect every other security key and leave only the selected YubiKey connected."
msgstr "Dækoble alle andre sikkerhedsnøgler og efterlad kun den valgte YubiKey tilsluttet for en sikker tilmelding."

msgid "Home"
msgstr "Hjem"

msgid "Insert a YubiKey"
msgstr "Indsæt en YubiKey"

msgid "Insert a YubiKey, then press Refresh."
msgstr "Indsæt en YubiKey, og tryk derefter på Opdater."

msgid "Inspect"
msgstr "Undersøg"

msgid "Inspect, load, export, test, or remove resident SSH credentials."
msgstr "Undersøg, indlæs, eksporter, test eller fjern residente SSH-legitimationsoplysninger."

msgid "Inspecting resident SSH credentials…"
msgstr "Undersøger residente SSH-legitimationsoplysninger…"

msgid "Invalid FIDO device path."
msgstr "Ugyldig sti til FIDO-enhed."

msgid "Load"
msgstr "Indlæs"

msgid "Load into agent"
msgstr "Indlæs i agent"

msgid "Load resident SSH keys"
msgstr "Indlæs residente SSH-nøgler"

msgid "Local key handle path"
msgstr "Lokal nøglehåndteringssti"

msgid "Local key label"
msgstr "Lokalt nøglenavn"

msgid "New hardware-backed SSH key"
msgstr "Ny SSH-nøgle baseret på hardware"

msgid "No FIDO security key detected"
msgstr "Ingen FIDO-sikkerhedsnøgle registreret"

msgid "No SSH agent was detected"
msgstr "Ingen SSH-agent blev registreret"

msgid "No YubiKey detected"
msgstr "Ingen YubiKey registreret"

msgid "No hardware serial · {0}"
msgstr "Ingen hardwareserienummer · {0}"

msgid "No resident SSH credentials"
msgstr "Ingen residente SSH-legitimationsoplysninger"

msgid "No ssh:* discoverable credentials were found on this key."
msgstr "Ingen ssh:* opdagelige legitimationsoplysninger blev fundet på denne nøgle."

msgid "Not currently connected"
msgstr "Ikke forbundet i øjeblikket"

msgid "OpenSSH could not load resident keys. The SSH agent contains no newly loaded identity."
msgstr "OpenSSH kunne ikke indlæse residentnøgler. SSH-agenten indeholder ingen nyligt indlæste identiteter."

msgid ""
"OpenSSH could not load resident keys:\n"
"{0}"
msgstr "OpenSSH kunne ikke indlæse residente nøgler:\n{0}"

msgid ""
"OpenSSH did not create a resident key:\n"
"{0}"
msgstr "OpenSSH oprettede ikke en resident nøgle:\n{0}"

msgid ""
"OpenSSH finished creating the key, but the YubiKey could not be verified afterward: {0}\n"
"Do not immediately retry; inspect the key first to avoid creating a duplicate."
msgstr "OpenSSH blev færdig med at oprette nøglen, men YubiKey kunne ikke verificeres bagefter: {0}\nPrøv ikke umiddelbart igen; inspicér nøglen først for at undgå at oprette en duplikat."

msgid "OpenSSH reported success, but no new resident credential was detected. Do not retry until you inspect the YubiKey."
msgstr "OpenSSH rapporterede succes, men der blev ikke registreret nogen ny residentlegitimationsoplysning. Prøv ikke igen, før du inspicerer YubiKey."

msgid "OpenSSH/FIDO credential metadata and local file location"
msgstr "Metadata for OpenSSH/FIDO-legitimationsoplysninger og lokal filplacering"

msgid "Password sign-in only"
msgstr "Kun adgang med adgangskode"

msgid "Refresh connected YubiKeys"
msgstr "Opdater forbundne YubiKeys"

msgid "Remove from agent"
msgstr "Fjern fra agent"

msgid "Removing this key from the SSH agent…"
msgstr "Fjerner denne nøgle fra SSH-agenten…"

msgid "Require verification for every signature"
msgstr "Krav om verifikation for hver signatur"

msgid "Requires the FIDO PIN each time this key signs"
msgstr "Kræver FIDO-PIN hver gang denne nøgle signerer"

msgid "Resident SSH credentials"
msgstr "Resident SSH-legitimationsoplysninger"

msgid "Resident SSH key created"
msgstr "Resident SSH-nøgle oprettet"

msgid "Resident keys loaded"
msgstr "Residentnøgler indlæst"

msgid "Resident username"
msgstr "Resident brugernavn"

msgid "Resident username must contain 1–64 bytes and no control characters."
msgstr "Resident brugernavn skal indeholde 1–64 bytes og ingen kontroltegn."

msgid "Run ssh-add -K for this connected security key"
msgstr "Kør ssh-add -K for denne forbundne sikkerhedsnøgle"

msgid "SSH Keys"
msgstr "SSH-nøgler"

msgid "SSH agent"
msgstr "SSH-agent"

msgid "SSH agent connected"
msgstr "SSH-agent forbundet"

msgid "SSH agent unavailable"
msgstr "SSH-agent utilgængelig"

msgid "SSH key actions"
msgstr "SSH-nøglehandlinger"

msgid "SSH_AUTH_SOCK is not set"
msgstr "SSH_AUTH_SOCK er ikke indstillet"

msgid "Safe defaults use ECDSA-SK, require touch, and store a discoverable credential on the selected YubiKey."
msgstr "Sikre standardindstillinger bruger ECDSA-SK, kræver berøring og gemmer en opdagelig legitimationsoplysning på den valgte YubiKey."

msgid "Security keys"
msgstr "Sikkerhedsnøgler"

msgid "Serial {0}"
msgstr "Serial {0}"

msgid "Signing test passed"
msgstr "Signeringstest bestået"

msgid "Temporary public-key path is invalid."
msgstr "Tidslig offentlig nøglesti er ugyldig."

msgid "Test signing"
msgstr "Test-signering"

msgid "The FIDO enrollment tool is not installed. Install the libpam-u2f package, then try again."
msgstr "FIDO-registreringsværktøjet er ikke installeret. Installer libpam-u2f-pakken, og prøv igen."

msgid "The PIN is sent directly to ssh-add and is never stored."
msgstr "PIN-koden sendes direkte til ssh-add og gemmes aldrig."

msgid "The PIN is sent through a private pipe to OpenSSH. It is never stored or placed in command arguments."
msgstr "PIN-koden sendes gennem en privat kanal til OpenSSH. Den gemmes aldrig eller placeres i kommandolinjeargumenter."

msgid "The PIN is used only for this read-only inspection and is never stored."
msgstr "PIN-koden bruges kun til denne skrivebeskyttede inspektion og gemmes aldrig."

msgid "The SSH agent successfully signed and verified data with this key."
msgstr "SSH-agenten signerede og verificerede data med denne nøgle uden problemer."

msgid "The YubiKey operation stopped unexpectedly."
msgstr "YubiKey-operationen stoppede uventet."

msgid "The credential will be created only on this exact device"
msgstr "Bopælsbeviset oprettes kun på dette specifikke enhed"

msgid "The enrollment task failed."
msgstr "Registreringsopgaven mislykkedes."

msgid "The inspected resident SSH credentials are already available in this agent."
msgstr "De inspicerede boende SSH-legitimationsoplysninger er allerede tilgængelige i denne agent."

msgid "The local key path must be absolute."
msgstr "Den lokale nøglesti skal være absolut."

msgid ""
"The non-exportable private key remains protected by the selected YubiKey.\n"
"\n"
"Algorithm: {0}\n"
"Application: {1}\n"
"Resident username: {2}\n"
"Fingerprint: {3}\n"
"\n"
"Local key handle: {4}\n"
"Public key: {5}\n"
"\n"
"The key is not automatically loaded into the SSH agent."
msgstr "Den ikke-eksportable private nøgle forbliver beskyttet af den valgte YubiKey.\n\nAlgorithmus: {0}\nApplikation: {1}\nResident brugernavn: {2}\nFingeraftryk: {3}\n\nLokal nøglehåndtering: {4}\nOffentlig nøgle: {5}\n\nNøglen indlæses ikke automatisk i SSH-agenten."

msgid "The operation was cancelled or denied."
msgstr "Operationen blev annulleret eller afvist."

msgid "The output folder does not exist: {0}"
msgstr "Udmappingen findes ikke: {0}"

msgid "The resident credential did not return a public key."
msgstr "Det boende bevis returnerede ikke en offentlig nøgle."

msgid "The resident credential returned an incomplete public key."
msgstr "Det boende bevis returnerede en ufuldstændig offentlig nøgle."

msgid "The resident credential returned malformed PEM data."
msgstr "Det boende bevis returnerede forkert formaterede PEM-data."

msgid "The resident credential {0} exists on the YubiKey, but its local handle files are incomplete. Do not retry creation."
msgstr "Det boende legitimationsbevis {0} findes på YubiKey, men dets lokale håndtagsfiler er ufuldstændige. Prøv ikke at oprette igen."

msgid ""
"The resident credential {0} was created on the YubiKey, but OpenSSH did not complete successfully:\n"
"{1}\n"
"Do not retry creation. Inspect the key and preserve any local files that were written."
msgstr "Det residente legitimationsoplysning {0} blev oprettet på YubiKey, men OpenSSH fuldførte ikke succesfuldt:\n{1}\nPrøv ikke at oprette igen. Inspicér nøglen og bevar eventuelle lokale filer, der blev skrevet."

msgid "The security key returned an invalid PAM credential."
msgstr "Sikkerhedsnøglen returnerede et ugyldigt PAM-legitimationsbevis."

msgid "The selected FIDO device is no longer connected. Refresh and try again."
msgstr "Den valgte FIDO-enhed er ikke længere tilsluttet. Opdater og prøv igen."

msgid "The selected private-key or .pub file already exists. Choose another name."
msgstr "Den valgte private nøgle- eller .pub-fil findes allerede. Vælg et andet navn."

msgid "The sudo policy task failed."
msgstr "Sudo-politikopgaven mislykkedes."

msgid "This setting applies only to the current user."
msgstr "Denne indstilling gælder kun for den aktuelle bruger."

msgid "Touch the YubiKey when prompted. Loading resident keys into the SSH agent…"
msgstr "Rør ved YubiKey, når du bliver bedt om det. Indlæser boende nøgler i SSH-agenten…"

msgid "Touch the YubiKey. Testing SSH signing and verification…"
msgstr "Rør ved YubiKey. Tester SSH-signering og verifikation…"

msgid "Touch the selected YubiKey. Creating an SSH resident key on {0}… Do not remove the key."
msgstr "Rør ved den valgte YubiKey. Opretter en SSH-boende nøgle på {0}… Fjern ikke nøglen."

msgid "Touch this key when prompted to enroll it"
msgstr "Rør ved denne nøgle, når du bliver bedt om det for at registrere den"

msgid "Touch this key when prompted to enroll it for sudo"
msgstr "Rør ved denne nøgle, når du bliver bedt om det for at registrere den til sudo"

msgid "Touch your security key to continue."
msgstr "Rør ved din sikkerhedsnøgle for at fortsætte."

msgid "Unknown authentication purpose."
msgstr "Ukendt autentificeringsformål."

msgid "Unlock GDM"
msgstr "Lås GDM op"

msgid "Unlock sudo"
msgstr "Lås sudo op"

msgid "Unlock the current user"
msgstr "Lås den aktuelle bruger op"

msgid "Unnamed SSH credential"
msgstr "Unavngivet SSH-legitimationsoplysning"

msgid "Unsupported resident SSH public-key algorithm."
msgstr "Ikke-understøttet algoritme til lokal SSH-offentlig nøgle."

msgid "Updating sign-in settings…"
msgstr "Opdaterer loginindstillinger…"

msgid "Updating sudo settings…"
msgstr "Opdaterer sudo-indstillinger…"

msgid "Use YubiKey to unlock sudo"
msgstr "Brug YubiKey til at låse sudo op"

msgid "You may enroll keys now, but sudo bypasses PAM while passwordless access is enabled."
msgstr "Du kan tilmelde nøgler nu, men sudo omgår PAM, mens adgang uden adgangskode er aktiveret."

msgid "YubiKey"
msgstr "YubiKey"

msgid "YubiKey Manager"
msgstr "YubiKey Manager"

msgid "YubiKey Manager is unavailable"
msgstr "YubiKey Manager er ikke tilgængelig"

msgid "YubiKey configuration failed"
msgstr "Konfiguration af YubiKey mislykkedes"

msgid "YubiKey configured, but sudo currently bypasses authentication"
msgstr "YubiKey er konfigureret, men sudo omgår i øjeblikket autentificering"

msgid "YubiKey touch or account password can authorize sudo"
msgstr "YubiKey-berøring eller kontoadgangskode kan godkende sudo"

msgid "YubiKey touch or password can unlock this user"
msgstr "YubiKey-berøring eller adgangskode kan låse denne bruger op"

msgid "agent"
msgstr "agent"

msgid "sudo authentication"
msgstr "sudo-autentificering"

msgid "sudo authentication policy"
msgstr "sudo-autentificeringspolitik"

msgid "sudo currently allows administrator access without authentication"
msgstr "sudo tillader i øjeblikket administratoradgang uden autentificering"

msgid "unknown"
msgstr "ukendt"

msgid "unknown socket"
msgstr "ukendt socket"

msgid "user"
msgstr "bruger"

