msgstr "agent"

msgid "sudo authentication"
msgstr "authentificare sudo"

msgid "sudo authentication policy"
msgstr "politică de autentificare sudo"

msgid "sudo currently allows administrator access without authentication"
msgstr "sudo permite în prezent accesul administrator fără autentificare"

