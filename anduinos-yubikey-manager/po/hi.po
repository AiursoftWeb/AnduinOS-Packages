msgid "A key must be connected before it can be enrolled."
msgstr "एक कुंजी को एनरोल करने से पहले उसे कनेक्ट किया जाना चाहिए।"

msgid "About"
msgstr "के बारे में"

msgid "Account password is required for sudo"
msgstr "Sudo के लिए अकाउंट पासवर्ड आवश्यक है"

msgid "Advanced options"
msgstr "उन्नत विकल्प"

msgid "Algorithm"
msgstr "एल्गोरिदम"

msgid "All inspected resident credentials from this key are already in the agent"
msgstr "इस कुंजी से सभी निरीक्षण किए गए रेजिडेंट क्रेडेंशियल्स पहले ही एजेंट में हैं"

msgid "Allow sudo without authentication"
msgstr "प्रमाणीकरण के बिना sudo की अनुमति दें"

msgid "Allowed for sudo · not currently connected"
msgstr "Sudo के लिए अनुमत · वर्तमान में कनेक्ट नहीं है"

msgid "Allowed to authorize sudo"
msgstr "Sudo को अधिकृत करने की अनुमति है"

msgid "Allowed to unlock this user"
msgstr "इस उपयोगकर्ता को अनलॉक करने की अनुमति है"

msgid "Allowed to unlock this user · not currently connected"
msgstr "इस उपयोगकर्ता को अनलॉक करने की अनुमति है · वर्तमान में कनेक्ट नहीं है"

msgid "Already loaded"
msgstr "पहले ही लोड हो चुका है"

msgid "An enrolled YubiKey or the account password can authorize sudo."
msgstr "एक एनरोल किया गया YubiKey या अकाउंट पासवर्ड sudo को अधिकृत कर सकता है।"

msgid "AnduinOS Team"
msgstr "AnduinOS टीम"

msgid "AnduinOS sign-in"
msgstr "AnduinOS साइन-इन"

msgid "Application"
msgstr "अप्लिकेशन"

msgid "Application must begin with ssh:, contain no whitespace, and be at most 253 bytes."
msgstr "अप्लिकेशन ssh: से शुरू होना चाहिए, इसमें कोई व्हाइटस्पेस नहीं होना चाहिए, और अधिकतम 253 बाइट्स का होना चाहिए।"

msgid "Cancel"
msgstr "रद्द करें"

msgid "Choose a local key-handle file"
msgstr "एक स्थानीय कुंजी-हैंडल फ़ाइल चुनें"

msgid "Choose a supported OpenSSH security-key algorithm."
msgstr "एक समर्थित OpenSSH सुरक्षा-कुंजी एल्गोरिदम चुनें।"

msgid "Choose a valid /dev/hidrawN FIDO device."
msgstr "एक वैध /dev/hidrawN FIDO डिवाइस चुनें।"

msgid "Choose a valid output folder."
msgstr "एक वैध आउटपुट फ़ोल्डर चुनें।"

msgid "Choose local SSH key-handle path"
msgstr "स्थानीय SSH कुंजी-हैंडल पथ चुनें"

msgid "Choose which YubiKeys may unlock {0}. Password sign-in remains available."
msgstr "चुनें कि कौन से YubiKeys {0} को अनलॉक कर सकते हैं। पासवर्ड साइन-इन उपलब्ध रहता है।"

msgid "Close"
msgstr "बंद करें"

msgid "Command exited with"
msgstr "कमांड बाहर निकली"

msgid "Command exited with {0}"
msgstr "कमांड {0} के साथ बाहर निकली"

msgid "Configured features"
msgstr "विन्यासित सुविधाएं"

msgid "Connect a FIDO security key first"
msgstr "पहले एक FIDO सुरक्षा कुंजी कनेक्ट करें"

msgid "Connect exactly one FIDO security key to choose an unambiguous source"
msgstr "एक अस्पष्ट स्रोत चुनने के लिए बिल्कुल एक FIDO सुरक्षा कुंजी कनेक्ट करें"

msgid "Continue"
msgstr "जारी रखें"

msgid "Copy public key"
msgstr "सार्वजनिक कुंजी कॉपी करें"

msgid "Could not create a temporary public-key file: {0}"
msgstr "अस्थायी सार्वजनिक-कुंजी फ़ाइल नहीं बनाई जा सकी: {0}"

msgid "Could not create {0}: {1}"
msgstr "{0} नहीं बनाया जा सका: {1}"

msgid "Could not export the public key: {0}"
msgstr "सार्वजनिक कुंजी निर्यात नहीं की जा सकी: {0}"

msgid "Could not flush the temporary public key: {0}"
msgstr "अस्थायी सार्वजनिक कुंजी को फ्लश नहीं किया जा सका: {0}"

msgid "Could not inspect USB devices: {0}"
msgstr "USB डिवाइसों का निरीक्षण नहीं किया जा सका: {0}"

msgid "Could not inspect this YubiKey"
msgstr "इस YubiKey का निरीक्षण नहीं किया जा सका"

msgid "Could not list YubiKeys"
msgstr "YubiKeys की सूची नहीं बनाई जा सकी"

msgid "Could not locate the secure PIN helper: {0}"
msgstr "सुरक्षित PIN हेल्पर स्थानित नहीं किया जा सका: {0}"

msgid "Could not protect {0}: {1}"
msgstr "{0} की सुरक्षा नहीं की जा सकी: {1}"

msgid "Could not provide the FIDO PIN: {0}"
msgstr "FIDO PIN प्रदान नहीं किया जा सका: {0}"

msgid "Could not request administrator access: {0}"
msgstr "प्रशासक पहुँच का अनुरोध नहीं किया जा सका: {0}"

msgid "Could not run {0}: {1}"
msgstr "{0} चलाया नहीं जा सका: {1}"

msgid "Could not start {0}: {1}"
msgstr "{0} शुरू नहीं किया जा सका: {1}"

msgid "Could not write the temporary public key: {0}"
msgstr "अस्थायी सार्वजनिक कुंजी लिखी नहीं जा सकी: {0}"

msgid "Create"
msgstr "बनाएं"

msgid "Create a resident SSH credential on a selected device"
msgstr "चयनित डिवाइस पर एक निवासी SSH क्रेडेंशियल बनाएं"

msgid "Create a resident SSH key"
msgstr "एक निवासी SSH कुंजी बनाएं"

msgid "Create…"
msgstr "बनाएं…"

msgid "Current user: {0}"
msgstr "वर्तमान उपयोगकर्ता: {0}"

msgid "Disabled · sudo must authenticate with a YubiKey or account password"
msgstr "अक्षम · sudo को YubiKey या खाता पासवर्ड के साथ प्रमाणीकरण करना होगा"

msgid "Display label must be at most 200 bytes and contain no control characters."
msgstr "डिस्प्ले लेबल अधिकतम 200 बाइट का होना चाहिए और इसमें कोई नियंत्रण वर्ण नहीं होना चाहिए।"

msgid "During enrollment, disconnect all other security keys. The selected key will blink; touch it to continue. Multiple keys can be enrolled one at a time."
msgstr "प्रवेश के दौरान, सभी अन्य सुरक्षा कुंजियों को डिस्कनेक्ट करें। चयनित कुंजी ब्लिंक करेगी; जारी रखने के लिए इसे छूएं। एक समय में एक से अधिक कुंजियां एनरोल की जा सकती हैं।"

msgid "ECDSA-SK (recommended compatibility)"
msgstr "ECDSA-SK (अनुशंसित संगतता)"

msgid "ECDSA-SK works with the widest range of YubiKeys"
msgstr "ECDSA-SK सबसे व्यापक श्रृंखला के YubiKeys के साथ काम करता है"

msgid "ECDSA-SK · resident · touch required · safe compatibility defaults"
msgstr "ECDSA-SK · निवासी · छूना आवश्यक · सुरक्षित संगतता डिफ़ॉल्ट"

msgid "Ed25519-SK (newer YubiKeys)"
msgstr "Ed25519-SK (नए YubiKeys)"

msgid "Enabled · programs can obtain administrator privileges without confirmation"
msgstr "सक्रिय · प्रोग्राम पुष्टि के बिना प्रशासक विशेषाधिकार प्राप्त कर सकते हैं"

msgid "Enabling passwordless sudo…"
msgstr "पासवर्ड-रहित sudo सक्षम किया जा रहा है…"

msgid "Enabling sudo authentication…"
msgstr "सूडो प्रमाणीकरण सक्षम किया जा रहा है…"

msgid "Enrolled · inactive while sudo authentication is bypassed"
msgstr "पंजीकृत · जब तक सूडो प्रमाणीकरण बायपास किया जाता है, तब तक निष्क्रिय"

msgid "Enrollment safety"
msgstr "पंजीकरण सुरक्षा"

msgid "Enter the YubiKey FIDO PIN"
msgstr "यूबीआईकी फिडो पिन दर्ज करें"

msgid "Enter the selected YubiKey FIDO PIN"
msgstr "चयनित यूबीआईकी फिडो पिन दर्ज करें"

msgid "Export .pub"
msgstr ".pub निर्यात करें"

msgid "Export SSH public key"
msgstr "SSH सार्वजनिक कुंजी निर्यात करें"

msgid "FIDO PIN"
msgstr "फिडो पिन"

msgid "FIDO device discovery is unavailable"
msgstr "फिडो डिवाइस खोज अनुपलब्ध है"

msgid "FIDO security key"
msgstr "फिडो सुरक्षा कुंजी"

msgid "Firmware {0}"
msgstr "फर्मवेयर {0}"

msgid "For safe enrollment, disconnect every other security key and leave only the selected YubiKey connected."
msgstr "सुरक्षित पंजीकरण के लिए, प्रत्येक अन्य सुरक्षा कुंजी को डिस्कनेक्ट करें और केवल चयनित यूबीआईकी कनेक्टेड छोड़ दें।"

msgid "Home"
msgstr "होम"

msgid "Insert a YubiKey"
msgstr "एक यूबीआईकी डालें"

msgid "Insert a YubiKey, then press Refresh."
msgstr "एक यूबीआईकी डालें, फिर रिफ्रेश दबाएं।"

msgid "Inspect"
msgstr "निरीक्षण करें"

msgid "Inspect, load, export, test, or remove resident SSH credentials."
msgstr "निवासी SSH क्रेडेंशियल्स का निरीक्षण, लोड, निर्यात, परीक्षण या हटाना।"

msgid "Inspecting resident SSH credentials…"
msgstr "निवासी SSH क्रेडेंशियल्स का निरीक्षण किया जा रहा है…"

msgid "Invalid FIDO device path."
msgstr "अमान्य फिडो डिवाइस पथ।"

msgid "Load"
msgstr "लोड करें"

msgid "Load into agent"
msgstr "एजेंट में लोड करें"

msgid "Load resident SSH keys"
msgstr "निवासी SSH कुंजियाँ लोड करें"

msgid "Local key handle path"
msgstr "स्थानीय कुंजी हैंडल पथ"

msgid "Local key label"
msgstr "स्थानीय कुंजी लेबल"

msgid "New hardware-backed SSH key"
msgstr "नई हार्डवेयर-संचालित SSH कुंजी"

msgid "No FIDO security key detected"
msgstr "कोई फिडो सुरक्षा कुंजी नहीं मिली"

msgid "No SSH agent was detected"
msgstr "कोई SSH एजेंट नहीं मिला"

msgid "No YubiKey detected"
msgstr "कोई यूबीआईकी नहीं मिला"

msgid "No hardware serial · {0}"
msgstr "कोई हार्डवेयर सीरियल नहीं · {0}"

msgid "No resident SSH credentials"
msgstr "कोई निवासी SSH क्रेडेंशियल्स नहीं"

msgid "No ssh:* discoverable credentials were found on this key."
msgstr "इस कुंजी पर कोई ssh:* खोज योग्य प्रमाणपत्र नहीं मिला।"

msgid "Not currently connected"
msgstr "वर्तमान में कनेक्ट नहीं है"

msgid "OpenSSH could not load resident keys. The SSH agent contains no newly loaded identity."
msgstr "OpenSSH ने रेजिडेंट कुंजियाँ लोड नहीं कीं। SSH एजेंट में कोई नई लोड की गई पहचान नहीं है।"

msgid ""
"OpenSSH could not load resident keys:\n"
"{0}"
msgstr "OpenSSH निवासी कुंजियों को लोड नहीं कर सका:\n{0}"

msgid ""
"OpenSSH did not create a resident key:\n"
"{0}"
msgstr "OpenSSH ने रेजिडेंट की नहीं बनाया:\n{0}"

msgid ""
"OpenSSH finished creating the key, but the YubiKey could not be verified afterward: {0}\n"
"Do not immediately retry; inspect the key first to avoid creating a duplicate."
msgstr "OpenSSH ने की बनाने की प्रक्रिया पूरी कर ली, लेकिन बाद में YubiKey सत्यापित नहीं हो सका: {0}"

msgid "OpenSSH reported success, but no new resident credential was detected. Do not retry until you inspect the YubiKey."
msgstr "OpenSSH ने सफलता की रिपोर्ट दी, लेकिन कोई नया रेजिडेंट प्रमाणपत्र नहीं मिला। YubiKey का निरीक्षण करने तक पुनः प्रयास न करें।"

msgid "OpenSSH/FIDO credential metadata and local file location"
msgstr "OpenSSH/FIDO प्रमाणपत्र.metadata और स्थानीय फ़ाइल स्थान"

msgid "Password sign-in only"
msgstr "केवल पासवर्ड साइन-इन"

msgid "Refresh connected YubiKeys"
msgstr "कनेक्टेड YubiKeys को रीफ्रेश करें"

msgid "Remove from agent"
msgstr "एजेंट से हटाएं"

msgid "Removing this key from the SSH agent…"
msgstr "SSH एजेंट से इस कुंजी को हटाया जा रहा है…"

msgid "Require verification for every signature"
msgstr "हर सिग्नेचर के लिए सत्यापन आवश्यक"

msgid "Requires the FIDO PIN each time this key signs"
msgstr "इस कुंजी के हस्ताक्षर करने पर हर बार FIDO PIN की आवश्यकता होती है"

msgid "Resident SSH credentials"
msgstr "रेजिडेंट SSH प्रमाणपत्र"

msgid "Resident SSH key created"
msgstr "रेजिडेंट SSH कुंजी बनाई गई"

msgid "Resident keys loaded"
msgstr "रेजिडेंट कुंजियाँ लोड हो गईं"

msgid "Resident username"
msgstr "रेजिडेंट उपयोगकर्ता नाम"

msgid "Resident username must contain 1–64 bytes and no control characters."
msgstr "रेजिडेंट उपयोगकर्ता नाम में 1–64 बाइट्स होने चाहिए और कोई नियंत्रण वर्ण नहीं होना चाहिए।"

msgid "Run ssh-add -K for this connected security key"
msgstr "इस कनेक्टेड सुरक्षा कुंजी के लिए ssh-add -K चलाएं"

msgid "SSH Keys"
msgstr "SSH कुंजियाँ"

msgid "SSH agent"
msgstr "SSH एजेंट"

msgid "SSH agent connected"
msgstr "SSH एजेंट कनेक्ट है"

msgid "SSH agent unavailable"
msgstr "SSH एजेंट अनुपलब्ध है"

msgid "SSH key actions"
msgstr "SSH कुंजी क्रियाएँ"

msgid "SSH_AUTH_SOCK is not set"
msgstr "SSH_AUTH_SOCK सेट नहीं है"

msgid "Safe defaults use ECDSA-SK, require touch, and store a discoverable credential on the selected YubiKey."
msgstr "सुरक्षित डिफ़ॉल्ट ECDSA-SK का उपयोग करते हैं, स्पर्श की आवश्यकता होती है, और चयनित YubiKey पर एक खोज योग्य प्रमाणपत्र संग्रहीत करते हैं।"

msgid "Security keys"
msgstr "सुरक्षा कुंजियाँ"

msgid "Serial {0}"
msgstr "सीरियल {0}"

msgid "Signing test passed"
msgstr "साइनिंग परीक्षण पास हुआ"

msgid "Temporary public-key path is invalid."
msgstr "अस्थायी पब्लिक-की पाथ अमान्य है।"

msgid "Test signing"
msgstr "टेस्ट साइनिंग"

msgid "The FIDO enrollment tool is not installed. Install the libpam-u2f package, then try again."
msgstr "FIDO एनरोलमेंट टूल इंस्टॉल नहीं है। libpam-u2f पैकेज इंस्टॉल करें, फिर पुनः प्रयास करें।"

msgid "The PIN is sent directly to ssh-add and is never stored."
msgstr "PIN को सीधे ssh-add भेजा जाता है और कभी संग्रहीत नहीं किया जाता है।"

msgid "The PIN is sent through a private pipe to OpenSSH. It is never stored or placed in command arguments."
msgstr "PIN को OpenSSH के लिए एक निजी पाइप के माध्यम से भेजा जाता है। इसे कभी संग्रहीत या कमांड तर्कों में रखा नहीं जाता है।"

msgid "The PIN is used only for this read-only inspection and is never stored."
msgstr "PIN का उपयोग केवल इस रीड-ओनली निरीक्षण के लिए किया जाता है और इसे कभी संग्रहीत नहीं किया जाता है।"

msgid "The SSH agent successfully signed and verified data with this key."
msgstr "SSH एजेंट ने इस कुंजी के साथ डेटा को सफलतापूर्वक हस्ताक्षरित और सत्यापित किया।"

msgid "The YubiKey operation stopped unexpectedly."
msgstr "YubiKey ऑपरेशन अचानक रुक गया।"

msgid "The credential will be created only on this exact device"
msgstr "क्रेडेंशियल केवल इस विशिष्ट डिवाइस पर ही बनाया जाएगा"

msgid "The enrollment task failed."
msgstr "एनरोलमेंट कार्य विफल रहा।"

msgid "The inspected resident SSH credentials are already available in this agent."
msgstr "निरीक्षित रेजिडेंट SSH क्रेडेंशियल्स पहले से ही इस एजेंट में उपलब्ध हैं।"

msgid "The local key path must be absolute."
msgstr "स्थानीय कुंजी पाथ पूर्ण (absolute) होना चाहिए।"

msgid ""
"The non-exportable private key remains protected by the selected YubiKey.\n"
"\n"
"Algorithm: {0}\n"
"Application: {1}\n"
"Resident username: {2}\n"
"Fingerprint: {3}\n"
"\n"
"Local key handle: {4}\n"
"Public key: {5}\n"
"\n"
"The key is not automatically loaded into the SSH agent."
msgstr "निर्यात-योग्य न होने वाला निजी कुंजी चयनित YubiKey द्वारा सुरक्षित रहता है।\n\nअल्गोरिदम: {0}\nएप्लिकेशन: {1}\nरिज़िडेंट उपयोगकर्ता नाम: {2}\nफिंगरप्रिंट: {3}\n\nस्थानीय कुंजी हैंडल: {4}\nसार्वजनिक कुंजी: {5}\n\nकुंजी स्वचालित रूप से SSH एजेंट में लोड नहीं होती है।"

msgid "The operation was cancelled or denied."
msgstr "ऑपरेशन रद्द या अस्वीकृत कर दिया गया था।"

msgid "The output folder does not exist: {0}"
msgstr "आउटफ़ोल्डर मौजूद नहीं है: {0}"

msgid "The resident credential did not return a public key."
msgstr "रेजिडेंट क्रेडेंशियल ने पब्लिक की वापस नहीं दी।"

msgid "The resident credential returned an incomplete public key."
msgstr "रेजिडेंट क्रेडेंशियल ने अधूरी पब्लिक की वापस दी।"

msgid "The resident credential returned malformed PEM data."
msgstr "रेजिडेंट क्रेडेंशियल ने गलत PEM डेटा वापस दिया।"

msgid "The resident credential {0} exists on the YubiKey, but its local handle files are incomplete. Do not retry creation."
msgstr "रेजिडेंट क्रेडेंशियल {0} YubiKey पर मौजूद है, लेकिन इसके स्थानीय हैंडल फ़ाइलें अधूरी हैं। निर्माण की पुनः प्रयास न करें।"

msgid ""
"The resident credential {0} was created on the YubiKey, but OpenSSH did not complete successfully:\n"
"{1}\n"
"Do not retry creation. Inspect the key and preserve any local files that were written."
msgstr "{0} निवासी प्रमाणपत्र YubiKey पर बनाया गया था, लेकिन OpenSSH सफलतापूर्वक पूर्ण नहीं हो सका:\n{1} निर्माण की पुनः कोशिश न करें। कुंजी का निरीक्षण करें और किसी भी स्थानीय फ़ाइल को संरक्षित रखें जो लिखी गई थी।"

msgid "The security key returned an invalid PAM credential."
msgstr "सिक्योरिटी की ने अमान्य PAM क्रेडेंशियल वापस दिया।"

msgid "The selected FIDO device is no longer connected. Refresh and try again."
msgstr "चयनित FIDO डिवाइस अब जुड़ा हुआ नहीं है। रीफ्रेश करें और पुनः प्रयास करें।"

msgid "The selected private-key or .pub file already exists. Choose another name."
msgstr "चयनित प्राइवेट-की या .pub फ़ाइल पहले से मौजूद है। कोई अन्य नाम चुनें।"

msgid "The sudo policy task failed."
msgstr "sudo नीति कार्य विफल रहा।"

msgid "This setting applies only to the current user."
msgstr "यह सेटिंग केवल वर्तमान उपयोगकर्ता पर लागू होती है।"

msgid "Touch the YubiKey when prompted. Loading resident keys into the SSH agent…"
msgstr "जब प्रॉम्प्ट किया जाए तो YubiKey को छूएं। रेजिडेंट कुंजियों को SSH एजेंट में लोड किया जा रहा है…"

msgid "Touch the YubiKey. Testing SSH signing and verification…"
msgstr "YubiKey को छूएं। SSH साइनिंग और सत्यापन का परीक्षण किया जा रहा है…"

msgid "Touch the selected YubiKey. Creating an SSH resident key on {0}… Do not remove the key."
msgstr "चयनित YubiKey को छूएं। {0} पर SSH रेजिडेंट कुंजी बनाई जा रही है… कुंजी को न हटाएं।"

msgid "Touch this key when prompted to enroll it"
msgstr "इसे एनरोल करने के लिए जब प्रॉम्प्ट किया जाए तो इस कुंजी को छूएं"

msgid "Touch this key when prompted to enroll it for sudo"
msgstr "सुडो (sudo) के लिए इसे एनरोल करने के लिए जब प्रॉम्प्ट किया जाए तो इस कुंजी को छूएं"

msgid "Touch your security key to continue."
msgstr "जारी रखने के लिए अपने सुरक्षा कुंजी को छुएं।"

msgid "Unknown authentication purpose."
msgstr "अज्ञात प्रमाणीकरण उद्देश्य।"

msgid "Unlock GDM"
msgstr "GDM अनलॉक करें"

msgid "Unlock sudo"
msgstr "sudo अनलॉक करें"

msgid "Unlock the current user"
msgstr "वर्तमान उपयोगकर्ता को अनलॉक करें"

msgid "Unnamed SSH credential"
msgstr "अनाम SSH प्रमाणपत्र"

msgid "Unsupported resident SSH public-key algorithm."
msgstr "असमर्थित निवासी SSH सार्वजनिक-कुंजी एल्गोरिदम।"

msgid "Updating sign-in settings…"
msgstr "साइन-इन सेटिंग्स अपडेट हो रही हैं…"

msgid "Updating sudo settings…"
msgstr "sudo सेटिंग्स अपडेट हो रही हैं…"

msgid "Use YubiKey to unlock sudo"
msgstr "sudo अनलॉक करने के लिए YubiKey का उपयोग करें"

msgid "You may enroll keys now, but sudo bypasses PAM while passwordless access is enabled."
msgstr "आप अब कुंजियां रजिस्टर कर सकते हैं, लेकिन पासवर्ड रहित पहुँच सक्षम होने पर sudo PAM को बायपास करता है।"

msgid "YubiKey"
msgstr "YubiKey"

msgid "YubiKey Manager"
msgstr "YubiKey मैनेजर"

msgid "YubiKey Manager is unavailable"
msgstr "YubiKey मैनेजर अनुपलब्ध है"

msgid "YubiKey configuration failed"
msgstr "YubiKey कॉन्फ़िगरेशन विफल रहा"

msgid "YubiKey configured, but sudo currently bypasses authentication"
msgstr "YubiKey कॉन्फ़िगर किया गया है, लेकिन sudo वर्तमान में प्रमाणीकरण को बायपास करता है"

msgid "YubiKey touch or account password can authorize sudo"
msgstr "YubiKey स्पर्श या खाता पासवर्ड sudo की अनुमति दे सकता है"

msgid "YubiKey touch or password can unlock this user"
msgstr "YubiKey स्पर्श या पासवर्ड इस उपयोगकर्ता को अनलॉक कर सकता है"

msgid "agent"
msgstr "एजेंट"

msgid "sudo authentication"
msgstr "sudo प्रमाणीकरण"

msgid "sudo authentication policy"
msgstr "sudo प्रमाणीकरण नीति"

msgid "sudo currently allows administrator access without authentication"
msgstr "sudo वर्तमान में प्रमाणीकरण के बिना व्यवस्थापक पहुँच की अनुमति देता है"

msgid "unknown"
msgstr "अज्ञात"

msgid "unknown socket"
msgstr "अज्ञाट सॉकेट"

msgid "user"
msgstr "उपयोगकर्ता"

msgid "{0} exited with {1}"
msgstr "{0} ने {1} के साथ समाप्त किया"

msgid "{0} failed: {1}"
msgstr "{0} विफल: {1}"

msgid "{0} identities · {1}"
msgstr "{0} पहचानें · {1}"

msgid "{0} is configured, but another policy currently bypasses it"
msgstr "{0} कॉन्फ़िगर किया गया है, लेकिन एक अन्य नीति वर्तमान में इसे बायपास करती है"

msgid "{0} is enabled for this YubiKey"
msgstr "इस YubiKey के लिए {0} सक्षम है"

msgid "{0} is not configured for this YubiKey"
msgstr "इस YubiKey के लिए {0} कॉन्फ़िगर नहीं है"

msgid "{0} new SSH identities were added to the agent."
msgstr "एजेंट में {0} नई SSH पहचानें जोड़ी गईं।"

msgid "{0} new SSH identity was added to the agent."
msgstr "एजेंट में {0} नई SSH पहचान जोड़ी गई।"

msgid "{0} · no hardware serial"
msgstr "{0} · कोई हार्डवेयर सीरियल नहीं"

msgid "{0} · {1}"
msgstr "{0} · {1}"
