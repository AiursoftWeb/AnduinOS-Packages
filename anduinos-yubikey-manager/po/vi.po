msgstr "Đang cập nhật chức năng ký commit Git…"

msgid "Updating sign-in settings…"
msgstr "Đang cập nhật cài đặt đăng nhập…"

msgid "Updating sudo settings…"
msgstr "Đang cập nhật cài đặt sudo…"

msgid "Use YubiKey to unlock sudo"
msgstr "Sử dụng YubiKey để mở khóa sudo"

msgid "Verifying and permanently deleting the selected resident credential. Do not unplug the YubiKey…"
msgstr "Đang xác minh và xóa vĩnh viễn thông tin đăng nhập cư trú được chọn. Không rút YubiKey…"

msgid "Waiting"
msgstr "Đang chờ"

msgid "Waiting for a configured YubiKey"
msgstr "Đang chờ YubiKey đã cấu hình"

