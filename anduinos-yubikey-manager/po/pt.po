msgstr "agente"

msgid "sudo authentication"
msgstr "autenticação do sudo"

msgid "sudo authentication policy"
msgstr "política de autenticação do sudo"

msgid "sudo currently allows administrator access without authentication"
msgstr "o sudo permite atualmente acesso de administrador sem autenticação"

