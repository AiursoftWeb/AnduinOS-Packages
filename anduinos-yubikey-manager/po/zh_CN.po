msgid "The local SSH key-handle path is invalid."
msgstr "本地 SSH 密钥句柄路径无效。"

msgid "The local SSH key-handle path is not valid UTF-8."
msgstr "本地 SSH 密钥句柄路径不是有效的 UTF-8。"

msgid "The local key path must be absolute."
msgstr "本地密钥路径必须是绝对路径。"

msgid ""
"The non-exportable private key remains protected by the selected YubiKey.\n"
"\n"
"Algorithm: {0}\n"
"Application: {1}\n"
"Resident username: {2}\n"
"Fingerprint: {3}\n"
"\n"
"Local key handle: {4}\n"
"Public key: {5}\n"
"\n"
"The key is not automatically loaded into the SSH agent."
msgstr ""
"不可导出的私钥仍受所选 YubiKey 保护。\n"
"\n"
"算法：{0}\n"
"应用程序：{1}\n"
"驻留用户名：{2}\n"
"指纹：{3}\n"
"\n"
"本地密钥句柄：{4}\n"
"公钥：{5}\n"
"\n"
"该密钥不会自动加载到 SSH agent 中。"

msgid "The operation was cancelled or denied."
msgstr "操作已取消或被拒绝。"

msgid "The output folder does not exist: {0}"
msgstr "输出文件夹不存在: {0}"

msgid "The resident credential ID is invalid. Refresh before deleting."
msgstr "常驻凭据 ID 无效。请在删除前刷新。"

msgid "The resident credential did not return a public key."
msgstr "驻留凭据未返回公钥。"

msgid "The resident credential is still present. Deletion was not completed: {0}"
msgstr "常驻凭据仍然存在。删除未完成：{0}"

