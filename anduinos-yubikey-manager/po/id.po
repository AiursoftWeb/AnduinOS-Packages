msgid "A key must be connected before it can be enrolled."
msgstr "Kunci harus terhubung sebelum dapat didaftarkan."

msgid "About"
msgstr "tentang"

msgid "Account password is required for sudo"
msgstr "Kata sandi akun diperlukan untuk sudo"

msgid "Advanced options"
msgstr "Opsi lanjutan"

msgid "Algorithm"
msgstr "Algoritma"

msgid "All inspected resident credentials from this key are already in the agent"
msgstr "Semua kredensial residen yang diperiksa dari kunci ini sudah ada di agen"

msgid "Allow sudo without authentication"
msgstr "Izinkan sudo tanpa autentikasi"

msgid "Allowed for sudo · not currently connected"
msgstr "Diizinkan untuk sudo · saat ini tidak terhubung"

msgid "Allowed to authorize sudo"
msgstr "Diizinkan untuk mengotorisasi sudo"

msgid "Allowed to unlock this user"
msgstr "Diizinkan untuk membuka kunci pengguna ini"

msgid "Allowed to unlock this user · not currently connected"
msgstr "Diizinkan untuk membuka kunci pengguna ini · saat ini tidak terhubung"

msgid "Already loaded"
msgstr "Sudah dimuat"

msgid "An enrolled YubiKey or the account password can authorize sudo."
msgstr "YubiKey yang terdaftar atau kata sandi akun dapat mengotorisasi sudo."

msgid "AnduinOS Team"
msgstr "Tim AnduinOS"

msgid "AnduinOS sign-in"
msgstr "Login AnduinOS"

msgid "Application"
msgstr "Aplikasi"

msgid "Application must begin with ssh:, contain no whitespace, and be at most 253 bytes."
msgstr "Aplikasi harus diawali dengan ssh:, tidak mengandung spasi, dan maksimal 253 byte."

msgid "Cancel"
msgstr "Batal"

msgid "Choose a local key-handle file"
msgstr "Pilih file handle kunci lokal"

msgid "Choose a supported OpenSSH security-key algorithm."
msgstr "Pilih algoritma kunci keamanan OpenSSH yang didukung."

msgid "Choose a valid /dev/hidrawN FIDO device."
msgstr "Pilih perangkat FIDO /dev/hidrawN yang valid."

msgid "Choose a valid output folder."
msgstr "Pilih folder output yang valid."

msgid "Choose local SSH key-handle path"
msgstr "Pilih jalur handle kunci SSH lokal"

msgid "Choose which YubiKeys may unlock {0}. Password sign-in remains available."
msgstr "Pilih YubiKey mana yang dapat membuka kunci {0}. Login kata sandi tetap tersedia."

msgid "Close"
msgstr "Tutup"

msgid "Command exited with"
msgstr "Perintah keluar dengan"

msgid "Command exited with {0}"
msgstr "Perintah keluar dengan {0}"

msgid "Configured features"
msgstr "Fitur yang dikonfigurasi"

msgid "Connect a FIDO security key first"
msgstr "Hubungkan kunci keamanan FIDO terlebih dahulu"

msgid "Connect exactly one FIDO security key to choose an unambiguous source"
msgstr "Hubungkan tepat satu kunci keamanan FIDO untuk memilih sumber yang tidak ambigu"

msgid "Continue"
msgstr "Lanjutkan"

msgid "Copy public key"
msgstr "Salin kunci publik"

msgid "Could not create a temporary public-key file: {0}"
msgstr "Tidak dapat membuat file kunci publik sementara: {0}"

msgid "Could not create {0}: {1}"
msgstr "Tidak dapat membuat {0}: {1}"

msgid "Could not export the public key: {0}"
msgstr "Tidak dapat mengekspor kunci publik: {0}"

msgid "Could not flush the temporary public key: {0}"
msgstr "Tidak dapat menghapus kunci publik sementara: {0}"

msgid "Could not inspect USB devices: {0}"
msgstr "Tidak dapat memeriksa perangkat USB: {0}"

msgid "Could not inspect this YubiKey"
msgstr "Tidak dapat memeriksa YubiKey ini"

msgid "Could not list YubiKeys"
msgstr "Tidak dapat menampilkan daftar YubiKey"

msgid "Could not locate the secure PIN helper: {0}"
msgstr "Tidak dapat menemukan pembantu PIN aman: {0}"

msgid "Could not protect {0}: {1}"
msgstr "Tidak dapat melindungi {0}: {1}"

msgid "Could not provide the FIDO PIN: {0}"
msgstr "Tidak dapat menyediakan PIN FIDO: {0}"

msgid "Could not request administrator access: {0}"
msgstr "Tidak dapat meminta akses administrator: {0}"

msgid "Could not run {0}: {1}"
msgstr "Tidak dapat menjalankan {0}: {1}"

msgid "Could not start {0}: {1}"
msgstr "Tidak dapat memulai {0}: {1}"

msgid "Could not write the temporary public key: {0}"
msgstr "Tidak dapat menulis kunci publik sementara: {0}"

msgid "Create"
msgstr "Buat"

msgid "Create a resident SSH credential on a selected device"
msgstr "Buat kredensial SSH resident pada perangkat yang dipilih"

msgid "Create a resident SSH key"
msgstr "Buat kunci SSH resident"

msgid "Create…"
msgstr "Buat…"

msgid "Current user: {0}"
msgstr "Pengguna saat ini: {0}"

msgid "Disabled · sudo must authenticate with a YubiKey or account password"
msgstr "Nonaktif · sudo harus mengautentikasi dengan YubiKey atau kata sandi akun"

msgid "Display label must be at most 200 bytes and contain no control characters."
msgstr "Label tampilan harus maksimal 200 byte dan tidak mengandung karakter kontrol."

msgid "During enrollment, disconnect all other security keys. The selected key will blink; touch it to continue. Multiple keys can be enrolled one at a time."
msgstr "Selama pendaftaran, putuskan semua kunci keamanan lainnya. Kunci yang dipilih akan berkedip; sentuh untuk melanjutkan. Beberapa kunci dapat didaftarkan satu per satu."

msgid "ECDSA-SK (recommended compatibility)"
msgstr "ECDSA-SK (kompatibilitas yang direkomendasikan)"

msgid "ECDSA-SK works with the widest range of YubiKeys"
msgstr "ECDSA-SK bekerja dengan berbagai rentang YubiKey terluas"

msgid "ECDSA-SK · resident · touch required · safe compatibility defaults"
msgstr "ECDSA-SK · resident · sentuhan diperlukan · kompatibilitas default aman"

msgid "Ed25519-SK (newer YubiKeys)"
msgstr "Ed25519-SK (YubiKey terbaru)"

msgid "Enabled · programs can obtain administrator privileges without confirmation"
msgstr "Diaktifkan · program dapat memperoleh hak istimewa administrator tanpa konfirmasi"

msgid "Enabling passwordless sudo…"
msgstr "Mengaktifkan sudo tanpa kata sandi…"

msgid "Enabling sudo authentication…"
msgstr "Mengaktifkan autentikasi sudo…"

msgid "Enrolled · inactive while sudo authentication is bypassed"
msgstr "Terdaftar · tidak aktif saat autentikasi sudo dilewati"

msgid "Enrollment safety"
msgstr "Keamanan pendaftaran"

msgid "Enter the YubiKey FIDO PIN"
msgstr "Masukkan PIN FIDO YubiKey"

msgid "Enter the selected YubiKey FIDO PIN"
msgstr "Masukkan PIN FIDO YubiKey yang dipilih"

msgid "Export .pub"
msgstr "Ekspor .pub"

msgid "Export SSH public key"
msgstr "Ekspor kunci publik SSH"

msgid "FIDO PIN"
msgstr "PIN FIDO"

msgid "FIDO device discovery is unavailable"
msgstr "Pemindaian perangkat FIDO tidak tersedia"

msgid "FIDO security key"
msgstr "Kunci keamanan FIDO"

msgid "Firmware {0}"
msgstr "Firmware {0}"

msgid "For safe enrollment, disconnect every other security key and leave only the selected YubiKey connected."
msgstr "Untuk pendaftaran yang aman, putuskan semua kunci keamanan lainnya dan biarkan hanya YubiKey yang dipilih tetap terhubung."

msgid "Home"
msgstr "Beranda"

msgid "Insert a YubiKey"
msgstr "Sisipkan YubiKey"

msgid "Insert a YubiKey, then press Refresh."
msgstr "Sisipkan YubiKey, lalu tekan Segarkan."

msgid "Inspect"
msgstr "Periksa"

msgid "Inspect, load, export, test, or remove resident SSH credentials."
msgstr "Memeriksa, memuat, mengekspor, menguji, atau menghapus kredensial SSH residen."

msgid "Inspecting resident SSH credentials…"
msgstr "Memeriksa kredensial SSH residen…"

msgid "Invalid FIDO device path."
msgstr "Jalur perangkat FIDO tidak valid."

msgid "Load"
msgstr "Muat"

msgid "Load into agent"
msgstr "Muat ke agen"

msgid "Load resident SSH keys"
msgstr "Muat kunci SSH residen"

msgid "Local key handle path"
msgstr "Jalur gagang kunci lokal"

msgid "Local key label"
msgstr "Label kunci lokal"

msgid "New hardware-backed SSH key"
msgstr "Kunci SSH berbasis perangkat keras baru"

msgid "No FIDO security key detected"
msgstr "Tidak ada kunci keamanan FIDO yang terdeteksi"

msgid "No SSH agent was detected"
msgstr "Tidak ada agen SSH yang terdeteksi"

msgid "No YubiKey detected"
msgstr "Tidak ada YubiKey yang terdeteksi"

msgid "No hardware serial · {0}"
msgstr "Tidak ada seri perangkat keras · {0}"

msgid "No resident SSH credentials"
msgstr "Tidak ada kredensial SSH residen"

msgid "No ssh:* discoverable credentials were found on this key."
msgstr "Tidak ditemukan kredensial ssh:* yang dapat ditemukan pada kunci ini."

msgid "Not currently connected"
msgstr "Tidak sedang terhubung saat ini"

msgid "OpenSSH could not load resident keys. The SSH agent contains no newly loaded identity."
msgstr "OpenSSH tidak dapat memuat kunci resident. Agen SSH tidak berisi identitas yang baru dimuat."

msgid ""
"OpenSSH could not load resident keys:\n"
"{0}"
msgstr "OpenSSH tidak dapat memuat kunci residen:\n{0}"

msgid ""
"OpenSSH did not create a resident key:\n"
"{0}"
msgstr "OpenSSH tidak membuat kunci residen:\n{0}"

msgid ""
"OpenSSH finished creating the key, but the YubiKey could not be verified afterward: {0}\n"
"Do not immediately retry; inspect the key first to avoid creating a duplicate."
msgstr "OpenSSH selesai membuat kunci, tetapi YubiKey tidak dapat diverifikasi setelahnya: {0}\nJangan langsung mencoba lagi; periksa kuncinya terlebih dahulu untuk menghindari pembuatan duplikat."

msgid "OpenSSH reported success, but no new resident credential was detected. Do not retry until you inspect the YubiKey."
msgstr "OpenSSH melaporkan berhasil, tetapi tidak ada kredensial resident baru yang terdeteksi. Jangan mencoba lagi sampai Anda memeriksa YubiKey."

msgid "OpenSSH/FIDO credential metadata and local file location"
msgstr "Metadata kredensial OpenSSH/FIDO dan lokasi file lokal"

msgid "Password sign-in only"
msgstr "Hanya masuk dengan kata sandi"

msgid "Refresh connected YubiKeys"
msgstr "Perbarui YubiKey yang terhubung"

msgid "Remove from agent"
msgstr "Hapus dari agen"

msgid "Removing this key from the SSH agent…"
msgstr "Menghapus kunci ini dari agen SSH…"

msgid "Require verification for every signature"
msgstr "Wajib verifikasi untuk setiap tanda tangan"

msgid "Requires the FIDO PIN each time this key signs"
msgstr "Membutuhkan PIN FIDO setiap kali kunci ini menandatangani"

msgid "Resident SSH credentials"
msgstr "Kredensial SSH resident"

msgid "Resident SSH key created"
msgstr "Kunci SSH resident dibuat"

msgid "Resident keys loaded"
msgstr "Kunci resident dimuat"

msgid "Resident username"
msgstr "Nama pengguna resident"

msgid "Resident username must contain 1–64 bytes and no control characters."
msgstr "Nama pengguna resident harus berisi 1–64 byte dan tidak boleh mengandung karakter kontrol."

msgid "Run ssh-add -K for this connected security key"
msgstr "Jalankan ssh-add -K untuk kunci keamanan yang terhubung ini"

msgid "SSH Keys"
msgstr "Kunci SSH"

msgid "SSH agent"
msgstr "Agen SSH"

msgid "SSH agent connected"
msgstr "Agen SSH terhubung"

msgid "SSH agent unavailable"
msgstr "Agen SSH tidak tersedia"

msgid "SSH key actions"
msgstr "Tindakan kunci SSH"

msgid "SSH_AUTH_SOCK is not set"
msgstr "SSH_AUTH_SOCK tidak diatur"

msgid "Safe defaults use ECDSA-SK, require touch, and store a discoverable credential on the selected YubiKey."
msgstr "Setelan default yang aman menggunakan ECDSA-SK, memerlukan sentuhan, dan menyimpan kredensial yang dapat ditemukan pada YubiKey yang dipilih."

msgid "Security keys"
msgstr "Kunci keamanan"

msgid "Serial {0}"
msgstr "Serial {0}"

msgid "Signing test passed"
msgstr "Uji penandatanganan berhasil"

msgid "Temporary public-key path is invalid."
msgstr "Jalur kunci publik sementara tidak valid."

msgid "Test signing"
msgstr "Penandatanganan uji coba"

msgid "The FIDO enrollment tool is not installed. Install the libpam-u2f package, then try again."
msgstr "Alat pendaftaran FIDO belum diinstal. Instal paket libpam-u2f, lalu coba lagi."

msgid "The PIN is sent directly to ssh-add and is never stored."
msgstr "PIN dikirim langsung ke ssh-add dan tidak pernah disimpan."

msgid "The PIN is sent through a private pipe to OpenSSH. It is never stored or placed in command arguments."
msgstr "PIN dikirim melalui pipa pribadi ke OpenSSH. PIN tidak pernah disimpan atau ditempatkan dalam argumen perintah."

msgid "The PIN is used only for this read-only inspection and is never stored."
msgstr "PIN hanya digunakan untuk inspeksi baca-saja ini dan tidak pernah disimpan."

msgid "The SSH agent successfully signed and verified data with this key."
msgstr "Agen SSH berhasil menandatangani dan memverifikasi data dengan kunci ini."

msgid "The YubiKey operation stopped unexpectedly."
msgstr "Operasi YubiKey berhenti secara tak terduga."

msgid "The credential will be created only on this exact device"
msgstr "Kredensial hanya akan dibuat pada perangkat tepat ini"

msgid "The enrollment task failed."
msgstr "Tugas pendaftaran gagal."

msgid "The inspected resident SSH credentials are already available in this agent."
msgstr "Kredensial SSH residen yang diperiksa sudah tersedia di agen ini."

msgid "The local key path must be absolute."
msgstr "Jalur kunci lokal harus absolut."

msgid ""
"The non-exportable private key remains protected by the selected YubiKey.\n"
"\n"
"Algorithm: {0}\n"
"Application: {1}\n"
"Resident username: {2}\n"
"Fingerprint: {3}\n"
"\n"
"Local key handle: {4}\n"
"Public key: {5}\n"
"\n"
"The key is not automatically loaded into the SSH agent."
msgstr "Kunci privat yang tidak dapat diekspor tetap dilindungi oleh YubiKey yang dipilih.\n\nAlgoritma: {0}\nAplikasi: {1}\nNama pengguna residen: {2}\nSidik jari: {3}\n\nPenangan kunci lokal: {4}\nKunci publik: {5}\n\nKunci tidak dimuat secara otomatis ke dalam agen SSH."

msgid "The operation was cancelled or denied."
msgstr "Operasi dibatalkan atau ditolak."

msgid "The output folder does not exist: {0}"
msgstr "Folder output tidak ada: {0}"

msgid "The resident credential did not return a public key."
msgstr "Kredensial residen tidak mengembalikan kunci publik."

msgid "The resident credential returned an incomplete public key."
msgstr "Kredensial residen mengembalikan kunci publik yang tidak lengkap."

msgid "The resident credential returned malformed PEM data."
msgstr "Kredensial residen mengembalikan data PEM yang rusak."

msgid "The resident credential {0} exists on the YubiKey, but its local handle files are incomplete. Do not retry creation."
msgstr "Kredensial residen {0} ada di YubiKey, tetapi file penangan lokalnya tidak lengkap. Jangan coba buat ulang."

msgid ""
"The resident credential {0} was created on the YubiKey, but OpenSSH did not complete successfully:\n"
"{1}\n"
"Do not retry creation. Inspect the key and preserve any local files that were written."
msgstr "Kredensial residen {0} dibuat pada YubiKey, tetapi OpenSSH tidak selesai dengan sukses:\n{1}\nJangan mencoba pembuatan ulang. Periksa kunci dan simpan semua file lokal yang telah ditulis."

msgid "The security key returned an invalid PAM credential."
msgstr "Kunci keamanan mengembalikan kredensial PAM yang tidak valid."

msgid "The selected FIDO device is no longer connected. Refresh and try again."
msgstr "Perangkat FIDO yang dipilih tidak terhubung lagi. Segarkan dan coba lagi."

msgid "The selected private-key or .pub file already exists. Choose another name."
msgstr "File kunci privat atau .pub yang dipilih sudah ada. Pilih nama lain."

msgid "The sudo policy task failed."
msgstr "Tugas kebijakan sudo gagal."

msgid "This setting applies only to the current user."
msgstr "Pengaturan ini hanya berlaku untuk pengguna saat ini."

msgid "Touch the YubiKey when prompted. Loading resident keys into the SSH agent…"
msgstr "Sentuh YubiKey ketika diminta. Memuat kunci residen ke agen SSH…"

msgid "Touch the YubiKey. Testing SSH signing and verification…"
msgstr "Sentuh YubiKey. Menguji penandatanganan dan verifikasi SSH…"

msgid "Touch the selected YubiKey. Creating an SSH resident key on {0}… Do not remove the key."
msgstr "Sentuh YubiKey yang dipilih. Membuat kunci residen SSH di {0}… Jangan lepaskan kunci."

msgid "Touch this key when prompted to enroll it"
msgstr "Sentuh kunci ini ketika diminta untuk mendaftarkannya"

msgid "Touch this key when prompted to enroll it for sudo"
msgstr "Sentuh kunci ini ketika diminta untuk mendaftarkannya untuk sudo"

msgid "Touch your security key to continue."
msgstr "Sentuh kunci keamanan Anda untuk melanjutkan."

msgid "Unknown authentication purpose."
msgstr "Tujuan autentikasi tidak diketahui."

msgid "Unlock GDM"
msgstr "Buka kunci GDM"

msgid "Unlock sudo"
msgstr "Buka kunci sudo"

msgid "Unlock the current user"
msgstr "Buka kunci pengguna saat ini"

msgid "Unnamed SSH credential"
msgstr "Kredensial SSH tanpa nama"

msgid "Unsupported resident SSH public-key algorithm."
msgstr "Algoritma kunci publik SSH residen tidak didukung."

msgid "Updating sign-in settings…"
msgstr "Memperbarui pengaturan masuk…"

msgid "Updating sudo settings…"
msgstr "Memperbarui pengaturan sudo…"

msgid "Use YubiKey to unlock sudo"
msgstr "Gunakan YubiKey untuk membuka kunci sudo"

msgid "You may enroll keys now, but sudo bypasses PAM while passwordless access is enabled."
msgstr "Anda dapat mendaftarkan kunci sekarang, tetapi sudo melewati PAM saat akses tanpa kata sandi diaktifkan."

msgid "YubiKey"
msgstr "YubiKey"

msgid "YubiKey Manager"
msgstr "Pengelola YubiKey"

msgid "YubiKey Manager is unavailable"
msgstr "Pengelola YubiKey tidak tersedia"

msgid "YubiKey configuration failed"
msgstr "Konfigurasi YubiKey gagal"

msgid "YubiKey configured, but sudo currently bypasses authentication"
msgstr "YubiKey telah dikonfigurasi, tetapi sudo saat ini melewati autentikasi"

msgid "YubiKey touch or account password can authorize sudo"
msgstr "Sentuhan YubiKey atau kata sandi akun dapat mengotorisasi sudo"

msgid "YubiKey touch or password can unlock this user"
msgstr "Sentuhan YubiKey atau kata sandi dapat membuka kunci pengguna ini"

msgid "agent"
msgstr "agen"

msgid "sudo authentication"
msgstr "autentikasi sudo"

msgid "sudo authentication policy"
msgstr "kebijakan autentikasi sudo"

msgid "sudo currently allows administrator access without authentication"
msgstr "sudo saat ini memungkinkan akses administrator tanpa autentikasi"

msgid "unknown"
msgstr "tidak diketahui"

msgid "unknown socket"
msgstr "socket tidak diketahui"

msgid "user"
msgstr "pengguna"

