msgid "SSH_AUTH_SOCK is not set"
msgstr "SSH_AUTH_SOCK ayarlanmadı"

msgid "Safe defaults use ECDSA-SK, require touch, and store a discoverable credential on the selected YubiKey."
msgstr "Güvenli varsayılanlar ECDSA-SK kullanır, dokunmayı gerektirir ve seçilen YubiKey üzerinde keşfedilebilir bir kimlik bilgisi saklar."

msgid "Security keys"
msgstr "Güvenlik anahtarları"

msgid "Serial {0}"
msgstr "Seri {0}"

