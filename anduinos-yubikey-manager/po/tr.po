msgstr "Bu anahtar üzerinde ssh:* keşfedilebilir kimlik bilgisi bulunamadı."

msgid "Not currently connected"
msgstr "Şu anda bağlı değil"

msgid "OpenSSH could not load resident keys. The SSH agent contains no newly loaded identity."
msgstr "OpenSSH, yerleşik anahtarları yükleyemedi. SSH aracı yeni yüklü bir kimlik içermiyor."

msgid ""
"OpenSSH could not load resident keys:\n"
"{0}"
msgstr "OpenSSH yerel anahtarları yükleyemedi:\n{0}"

