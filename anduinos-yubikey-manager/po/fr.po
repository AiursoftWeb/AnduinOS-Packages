msgid "A key must be connected before it can be enrolled."
msgstr "Une clé doit être connectée avant de pouvoir être enregistrée."

msgid "About"
msgstr "À propos"

msgid "Account password is required for sudo"
msgstr "Le mot de passe du compte est requis pour sudo"

msgid "Advanced options"
msgstr "Options avancées"

msgid "Algorithm"
msgstr "Algorithme"

msgid "All inspected resident credentials from this key are already in the agent"
msgstr "Toutes les informations d’identification résidentes inspectées de cette clé sont déjà dans l’agent"

msgid "Allow sudo without authentication"
msgstr "Autoriser sudo sans authentification"

msgid "Allowed for sudo · not currently connected"
msgstr "Autorisé pour sudo · non connecté actuellement"

msgid "Allowed to authorize sudo"
msgstr "Autorisé à autoriser sudo"

msgid "Allowed to unlock this user"
msgstr "Autorisé à déverrouiller cet utilisateur"

msgid "Allowed to unlock this user · not currently connected"
msgstr "Autorisé à déverrouiller cet utilisateur · non connecté actuellement"

msgid "Already loaded"
msgstr "Déjà chargé"

msgid "An enrolled YubiKey or the account password can authorize sudo."
msgstr "Une YubiKey enregistrée ou le mot de passe du compte peut autoriser sudo."

msgid "AnduinOS Team"
msgstr "Équipe AnduinOS"

msgid "AnduinOS sign-in"
msgstr "Connexion AnduinOS"

msgid "Application"
msgstr "Application"

msgid "Application must begin with ssh:, contain no whitespace, and be at most 253 bytes."
msgstr "L’application doit commencer par ssh:, ne contenir aucun espace et faire au maximum 253 octets."

msgid "Cancel"
msgstr "Annuler"

msgid "Choose a local key-handle file"
msgstr "Choisir un fichier de poignée de clé local"

msgid "Choose a supported OpenSSH security-key algorithm."
msgstr "Choisir un algorithme de clé de sécurité OpenSSH pris en charge."

msgid "Choose a valid /dev/hidrawN FIDO device."
msgstr "Choisir un périphérique FIDO /dev/hidrawN valide."

msgid "Choose a valid output folder."
msgstr "Choisir un dossier de sortie valide."

msgid "Choose local SSH key-handle path"
msgstr "Choisir le chemin de la poignée de clé SSH locale"

msgid "Choose which YubiKeys may unlock {0}. Password sign-in remains available."
msgstr "Choisir quelles YubiKeys peuvent déverrouiller {0}. La connexion par mot de passe reste disponible."

msgid "Close"
msgstr "Fermer"

msgid "Command exited with"
msgstr "La commande s’est terminée avec"

msgid "Command exited with {0}"
msgstr "La commande s’est terminée avec {0}"

msgid "Configured features"
msgstr "Fonctionnalités configurées"

msgid "Connect a FIDO security key first"
msgstr "Connecter d’abord une clé de sécurité FIDO"

msgid "Connect exactly one FIDO security key to choose an unambiguous source"
msgstr "Connecter exactement une clé de sécurité FIDO pour choisir une source non ambiguë"

msgid "Continue"
msgstr "Continuer"

msgid "Copy public key"
msgstr "Copier la clé publique"

msgid "Could not create a temporary public-key file: {0}"
msgstr "Impossible de créer un fichier temporaire de clé publique : {0}"

msgid "Could not create {0}: {1}"
msgstr "Impossible de créer {0} : {1}"

msgid "Could not export the public key: {0}"
msgstr "Impossible d'exporter la clé publique : {0}"

msgid "Could not flush the temporary public key: {0}"
msgstr "Impossible de vider la clé publique temporaire : {0}"

msgid "Could not inspect USB devices: {0}"
msgstr "Impossible d'inspecter les périphériques USB : {0}"

msgid "Could not inspect this YubiKey"
msgstr "Impossible d'inspecter cette YubiKey"

msgid "Could not list YubiKeys"
msgstr "Impossible de lister les YubiKeys"

msgid "Could not locate the secure PIN helper: {0}"
msgstr "Impossible de localiser l'assistant PIN sécurisé : {0}"

msgid "Could not protect {0}: {1}"
msgstr "Impossible de protéger {0} : {1}"

msgid "Could not provide the FIDO PIN: {0}"
msgstr "Impossible de fournir le PIN FIDO : {0}"

msgid "Could not request administrator access: {0}"
msgstr "Impossible de demander l'accès administrateur : {0}"

msgid "Could not run {0}: {1}"
msgstr "Impossible d'exécuter {0} : {1}"

msgid "Could not start {0}: {1}"
msgstr "Impossible de démarrer {0} : {1}"

msgid "Could not write the temporary public key: {0}"
msgstr "Impossible d'écrire la clé publique temporaire : {0}"

msgid "Create"
msgstr "Créer"

msgid "Create a resident SSH credential on a selected device"
msgstr "Créer une identification SSH résidente sur un périphérique sélectionné"

msgid "Create a resident SSH key"
msgstr "Créer une clé SSH résidente"

msgid "Create…"
msgstr "Créer…"

msgid "Current user: {0}"
msgstr "Utilisateur actuel : {0}"

msgid "Disabled · sudo must authenticate with a YubiKey or account password"
msgstr "Désactivé · sudo doit s'authentifier avec une YubiKey ou le mot de passe du compte"

msgid "Display label must be at most 200 bytes and contain no control characters."
msgstr "L'étiquette d'affichage ne doit pas dépasser 200 octets et ne doit contenir aucun caractère de contrôle."

msgid "During enrollment, disconnect all other security keys. The selected key will blink; touch it to continue. Multiple keys can be enrolled one at a time."
msgstr "Pendant l'enregistrement, déconnectez toutes les autres clés de sécurité. La clé sélectionnée clignotera ; touchez-la pour continuer. Plusieurs clés peuvent être enregistrées une par une."

msgid "ECDSA-SK (recommended compatibility)"
msgstr "ECDSA-SK (compatibilité recommandée)"

msgid "ECDSA-SK works with the widest range of YubiKeys"
msgstr "ECDSA-SK fonctionne avec la plus large gamme de YubiKeys"

msgid "ECDSA-SK · resident · touch required · safe compatibility defaults"
msgstr "ECDSA-SK · résident · touche requise · paramètres par défaut de compatibilité sûre"

msgid "Ed25519-SK (newer YubiKeys)"
msgstr "Ed25519-SK (YubiKeys récentes)"

msgid "Enabled · programs can obtain administrator privileges without confirmation"
msgstr "Activé · les programmes peuvent obtenir des privilèges administrateur sans confirmation"

msgid "Enabling passwordless sudo…"
msgstr "Activation de sudo sans mot de passe…"

msgid "Enabling sudo authentication…"
msgstr "Activation de l'authentification sudo…"

msgid "Enrolled · inactive while sudo authentication is bypassed"
msgstr "Inscrit · inactif pendant que l'authentification sudo est contournée"

msgid "Enrollment safety"
msgstr "Sécurité de l'inscription"

msgid "Enter the YubiKey FIDO PIN"
msgstr "Saisissez le PIN FIDO de la YubiKey"

msgid "Enter the selected YubiKey FIDO PIN"
msgstr "Saisissez le PIN FIDO de la YubiKey sélectionnée"

msgid "Export .pub"
msgstr "Exporter .pub"

msgid "Export SSH public key"
msgstr "Exporter la clé publique SSH"

msgid "FIDO PIN"
msgstr "PIN FIDO"

msgid "FIDO device discovery is unavailable"
msgstr "La découverte des appareils FIDO n'est pas disponible"

msgid "FIDO security key"
msgstr "Clef de sécurité FIDO"

msgid "Firmware {0}"
msgstr "Firmware {0}"

msgid "For safe enrollment, disconnect every other security key and leave only the selected YubiKey connected."
msgstr "Pour une inscription sûre, débranchez toutes les autres clefs de sécurité et laissez uniquement la YubiKey sélectionnée branchée."

msgid "Home"
msgstr "Accueil"

msgid "Insert a YubiKey"
msgstr "Insérez une YubiKey"

msgid "Insert a YubiKey, then press Refresh."
msgstr "Insérez une YubiKey, puis appuyez sur Actualiser."

msgid "Inspect"
msgstr "Inspecter"

msgid "Inspect, load, export, test, or remove resident SSH credentials."
msgstr "Inspecter, charger, exporter, tester ou supprimer les identifiants SSH résidents."

msgid "Inspecting resident SSH credentials…"
msgstr "Inspection des identifiants SSH résidents…"

msgid "Invalid FIDO device path."
msgstr "Chemin d'accès de l'appareil FIDO invalide."

msgid "Load"
msgstr "Charger"

msgid "Load into agent"
msgstr "Charger dans l'agent"

msgid "Load resident SSH keys"
msgstr "Charger les clés SSH résidentes"

msgid "Local key handle path"
msgstr "Chemin du gestionnaire de clé local"

msgid "Local key label"
msgstr "Etiquette de la clé locale"

msgid "New hardware-backed SSH key"
msgstr "Nouvelle clé SSH protégée par le matériel"

msgid "No FIDO security key detected"
msgstr "Aucune clef de sécurité FIDO détectée"

msgid "No SSH agent was detected"
msgstr "Aucun agent SSH n'a été détecté"

msgid "No YubiKey detected"
msgstr "Aucune YubiKey détectée"

msgid "No hardware serial · {0}"
msgstr "Pas de numéro de série matériel · {0}"

msgid "No resident SSH credentials"
msgstr "Aucun identifiant SSH résident"

msgid "No ssh:* discoverable credentials were found on this key."
msgstr "Aucune information d'identification ssh:* découvrable n'a été trouvée sur cette clé."

msgid "Not currently connected"
msgstr "Pas actuellement connecté"

msgid "OpenSSH could not load resident keys. The SSH agent contains no newly loaded identity."
msgstr "OpenSSH n'a pas pu charger les clés résidentes. L'agent SSH ne contient aucune nouvelle identité chargée."

msgid ""
"OpenSSH could not load resident keys:\n"
"{0}"
msgstr "OpenSSH n’a pas pu charger les clés résidentes : {0}"

msgid ""
"OpenSSH did not create a resident key:\n"
"{0}"
msgstr "OpenSSH n’a pas créé de clé résidente : {0}"

msgid ""
"OpenSSH finished creating the key, but the YubiKey could not be verified afterward: {0}\n"
"Do not immediately retry; inspect the key first to avoid creating a duplicate."
msgstr "OpenSSH a terminé la création de la clé, mais le YubiKey n’a pas pu être vérifié par la suite : {0}\nNe réessayez pas immédiatement ; inspectez d’abord la clé pour éviter d’en créer une en double."

msgid "OpenSSH reported success, but no new resident credential was detected. Do not retry until you inspect the YubiKey."
msgstr "OpenSSH a signalé une réussite, mais aucune nouvelle information d'identification résidente n'a été détectée. Ne réessayez pas tant que vous n'avez pas inspecté la YubiKey."

msgid "OpenSSH/FIDO credential metadata and local file location"
msgstr "Métadonnées des informations d'identification OpenSSH/FIDO et emplacement du fichier local"

msgid "Password sign-in only"
msgstr "Connexion par mot de passe uniquement"

msgid "Refresh connected YubiKeys"
msgstr "Actualiser les YubiKeys connectées"

msgid "Remove from agent"
msgstr "Supprimer de l'agent"

msgid "Removing this key from the SSH agent…"
msgstr "Suppression de cette clé de l'agent SSH…"

msgid "Require verification for every signature"
msgstr "Exiger une vérification pour chaque signature"

msgid "Requires the FIDO PIN each time this key signs"
msgstr "Nécessite le code PIN FIDO à chaque fois que cette clé signe"

msgid "Resident SSH credentials"
msgstr "Credentials SSH résidentes"

msgid "Resident SSH key created"
msgstr "Clé SSH résidente créée"

msgid "Resident keys loaded"
msgstr "Clés résidentes chargées"

msgid "Resident username"
msgstr "Nom d'utilisateur résident"

msgid "Resident username must contain 1–64 bytes and no control characters."
msgstr "Le nom d'utilisateur résident doit contenir 1 à 64 octets et aucun caractère de contrôle."

msgid "Run ssh-add -K for this connected security key"
msgstr "Exécuter ssh-add -K pour cette clé de sécurité connectée"

msgid "SSH Keys"
msgstr "Clés SSH"

msgid "SSH agent"
msgstr "Agent SSH"

msgid "SSH agent connected"
msgstr "Agent SSH connecté"

msgid "SSH agent unavailable"
msgstr "Agent SSH indisponible"

msgid "SSH key actions"
msgstr "Actions sur les clés SSH"

msgid "SSH_AUTH_SOCK is not set"
msgstr "SSH_AUTH_SOCK n'est pas défini"

msgid "Safe defaults use ECDSA-SK, require touch, and store a discoverable credential on the selected YubiKey."
msgstr "Les valeurs par défaut sûres utilisent ECDSA-SK, exigent une touche tactile et stockent une information d'identification découvrable sur la YubiKey sélectionnée."

msgid "Security keys"
msgstr "Clés de sécurité"

msgid "Serial {0}"
msgstr "Série {0}"

msgid "Signing test passed"
msgstr "Test de signature réussi"

msgid "Temporary public-key path is invalid."
msgstr "Le chemin de clé publique temporaire est invalide."

msgid "Test signing"
msgstr "Signature de test"

msgid "The FIDO enrollment tool is not installed. Install the libpam-u2f package, then try again."
msgstr "L’outil d’enrôlement FIDO n’est pas installé. Installez le paquet libpam-u2f, puis réessayez."

msgid "The PIN is sent directly to ssh-add and is never stored."
msgstr "Le code PIN est envoyé directement à ssh-add et n’est jamais stocké."

msgid "The PIN is sent through a private pipe to OpenSSH. It is never stored or placed in command arguments."
msgstr "Le code PIN est envoyé via un canal privé à OpenSSH. Il n’est jamais stocké ni placé dans les arguments de commande."

msgid "The PIN is used only for this read-only inspection and is never stored."
msgstr "Le code PIN est utilisé uniquement pour cette inspection en lecture seule et n’est jamais stocké."

msgid "The SSH agent successfully signed and verified data with this key."
msgstr "L’agent SSH a signé et vérifié avec succès les données avec cette clé."

msgid "The YubiKey operation stopped unexpectedly."
msgstr "L’opération YubiKey s’est arrêtée de manière inattendue."

msgid "The credential will be created only on this exact device"
msgstr "L’identifiant sera créé uniquement sur cet appareil exact"

msgid "The enrollment task failed."
msgstr "La tâche d’enrôlement a échoué."

msgid "The inspected resident SSH credentials are already available in this agent."
msgstr "Les identifiants SSH résidents inspectés sont déjà disponibles dans cet agent."

msgid "The local key path must be absolute."
msgstr "Le chemin de clé local doit être absolu."

msgid ""
"The non-exportable private key remains protected by the selected YubiKey.\n"
"\n"
"Algorithm: {0}\n"
"Application: {1}\n"
"Resident username: {2}\n"
"Fingerprint: {3}\n"
"\n"
"Local key handle: {4}\n"
"Public key: {5}\n"
"\n"
"The key is not automatically loaded into the SSH agent."
msgstr "La clé privée non exportable reste protégée par le YubiKey sélectionné.\n\nAlgorithme : {0}\nApplication : {1}\nNom d’utilisateur résident : {2}\nEmpreinte : {3}\n\nPoignée de clé locale : {4}\nClé publique : {5}\n\nLa clé n’est pas chargée automatiquement dans l’agent SSH."

msgid "The operation was cancelled or denied."
msgstr "L’opération a été annulée ou refusée."

msgid "The output folder does not exist: {0}"
msgstr "Le dossier de sortie n’existe pas : {0}"

msgid "The resident credential did not return a public key."
msgstr "L’identifiant résident n’a pas renvoyé de clé publique."

msgid "The resident credential returned an incomplete public key."
msgstr "L’identifiant résident a renvoyé une clé publique incomplète."

msgid "The resident credential returned malformed PEM data."
msgstr "L’identifiant résident a renvoyé des données PEM mal formées."

msgid "The resident credential {0} exists on the YubiKey, but its local handle files are incomplete. Do not retry creation."
msgstr "L’identifiant résident {0} existe sur la YubiKey, mais ses fichiers de poignée locaux sont incomplets. Ne réessayez pas de créer."

msgid ""
"The resident credential {0} was created on the YubiKey, but OpenSSH did not complete successfully:\n"
"{1}\n"
"Do not retry creation. Inspect the key and preserve any local files that were written."
msgstr "L’information d’identification résidente {0} a été créée sur le YubiKey, mais OpenSSH n’a pas abouti avec succès :\n{1}\nNe réessayez pas la création. Inspectez la clé et conservez les fichiers locaux qui ont été écrits."

msgid "The security key returned an invalid PAM credential."
msgstr "La clé de sécurité a renvoyé un identifiant PAM invalide."

msgid "The selected FIDO device is no longer connected. Refresh and try again."
msgstr "L’appareil FIDO sélectionné n’est plus connecté. Rafraîchissez et réessayez."

msgid "The selected private-key or .pub file already exists. Choose another name."
msgstr "Le fichier de clé privée ou .pub sélectionné existe déjà. Choisissez un autre nom."

msgid "The sudo policy task failed."
msgstr "La tâche de stratégie sudo a échoué."

msgid "This setting applies only to the current user."
msgstr "Ce paramètre s’applique uniquement à l’utilisateur actuel."

msgid "Touch the YubiKey when prompted. Loading resident keys into the SSH agent…"
msgstr "Touchez la YubiKey lorsque vous y êtes invité. Chargement des clés résidentes dans l’agent SSH…"

msgid "Touch the YubiKey. Testing SSH signing and verification…"
msgstr "Touchez la YubiKey. Test de signature et de vérification SSH…"

msgid "Touch the selected YubiKey. Creating an SSH resident key on {0}… Do not remove the key."
msgstr "Touchez la YubiKey sélectionnée. Création d’une clé SSH résidente sur {0}… Ne retirez pas la clé."

msgid "Touch this key when prompted to enroll it"
msgstr "Touchez cette clé lorsque vous y êtes invité pour l’enrôler"

msgid "Touch this key when prompted to enroll it for sudo"
msgstr "Touchez cette clé lorsque vous y êtes invité pour l’enrôler pour sudo"

msgid "Touch your security key to continue."
msgstr "Touchez votre clé de sécurité pour continuer."

msgid "Unknown authentication purpose."
msgstr "Objet d'authentification inconnu."

msgid "Unlock GDM"
msgstr "Déverrouiller GDM"

msgid "Unlock sudo"
msgstr "Déverrouiller sudo"

msgid "Unlock the current user"
msgstr "Déverrouiller l'utilisateur actuel"

msgid "Unnamed SSH credential"
msgstr "Jeu d'identifiants SSH sans nom"

msgid "Unsupported resident SSH public-key algorithm."
msgstr "Algorithme de clé publique SSH résidente non pris en charge."

msgid "Updating sign-in settings…"
msgstr "Mise à jour des paramètres de connexion…"

msgid "Updating sudo settings…"
msgstr "Mise à jour des paramètres sudo…"

msgid "Use YubiKey to unlock sudo"
msgstr "Utiser YubiKey pour déverrouiller sudo"

msgid "You may enroll keys now, but sudo bypasses PAM while passwordless access is enabled."
msgstr "Vous pouvez enregistrer des clés maintenant, mais sudo contourne PAM tant que l'accès sans mot de passe est activé."

