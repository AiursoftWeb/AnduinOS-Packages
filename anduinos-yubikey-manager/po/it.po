msgstr "agente"

msgid "sudo authentication"
msgstr "autenticazione sudo"

msgid "sudo authentication policy"
msgstr "политика di autenticazione sudo"

msgid "sudo currently allows administrator access without authentication"
msgstr "sudo attualmente consente l'accesso amministrativo senza autenticazione"

