<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>AnduinOS</vendor>
  <vendor_url>https://www.anduinos.com</vendor_url>
  <action id="com.anduinos.yubikeymanager.manage-login">
    <description>Manage YubiKey security settings</description>
    <description xml:lang="ar_SA">إدارة إعدادات أمان YubiKey</description>
    <description xml:lang="da_DK">Administrer YubiKey-sikkerhedsindstillinger</description>
    <description xml:lang="de_DE">YubiKey-Sicherheitseinstellungen verwalten</description>
    <description xml:lang="el_GR">Διαχείριση ρυθμίσεων ασφαλείας YubiKey</description>
    <description xml:lang="en_GB">Manage YubiKey security settings</description>
    <description xml:lang="es_ES">Gestionar la configuración de seguridad de YubiKey</description>
    <description xml:lang="fi_FI">Hallitse YubiKey-turva-asetuksia</description>
    <description xml:lang="fr_FR">Gérer les paramètres de sécurité de la YubiKey</description>
    <description xml:lang="hi_IN">YubiKey सुरक्षा सेटिंग्स प्रबंधित करें</description>
    <description xml:lang="id_ID">Kelola pengaturan keamanan YubiKey</description>
    <description xml:lang="it_IT">Gestisci le impostazioni di sicurezza di YubiKey</description>
    <description xml:lang="ja_JP">YubiKey のセキュリティ設定を管理</description>
    <description xml:lang="ko_KR">YubiKey 보안 설정 관리</description>
    <description xml:lang="nl_NL">YubiKey-beveiligingsinstellingen beheren</description>
    <description xml:lang="pl_PL">Zarządzaj ustawieniami bezpieczeństwa YubiKey</description>
    <description xml:lang="pt_BR">Gerenciar configurações de segurança da YubiKey</description>
    <description xml:lang="pt_PT">Gerir as definições de segurança da YubiKey</description>
    <description xml:lang="ro_RO">Gestionați setările de securitate YubiKey</description>
    <description xml:lang="ru_RU">Управление настройками безопасности YubiKey</description>
    <description xml:lang="sv_SE">Hantera säkerhetsinställningar för YubiKey</description>
    <description xml:lang="th_TH">จัดการการตั้งค่าความปลอดภัยของ YubiKey</description>
    <description xml:lang="tr_TR">YubiKey güvenlik ayarlarını yönet</description>
    <description xml:lang="uk_UA">Керування параметрами безпеки YubiKey</description>
    <description xml:lang="vi_VN">Quản lý cài đặt bảo mật YubiKey</description>
    <description xml:lang="zh_HK">管理 YubiKey 安全設定</description>
    <description xml:lang="zh_TW">管理 YubiKey 安全設定</description>
    <description xml:lang="zh_CN">管理 YubiKey 安全设置</description>
    <message>Authentication is required to change security settings or install Git</message>
    <message xml:lang="ar_SA">يتطلب تغيير إعدادات الأمان أو تثبيت Git المصادقة</message>
    <message xml:lang="da_DK">Autentificering er påkrævet for at ændre sikkerhedsindstillinger eller installere Git</message>
    <message xml:lang="de_DE">Zur Änderung der Sicherheitseinstellungen oder zur Installation von Git ist eine Authentifizierung erforderlich</message>
    <message xml:lang="el_GR">Απαιτείται έλεγχος ταυτότητας για την αλλαγή ρυθμίσεων ασφαλείας ή την εγκατάσταση του Git</message>
    <message xml:lang="en_GB">Authentication is required to change security settings or install Git</message>
    <message xml:lang="es_ES">Se requiere autenticación para cambiar la configuración de seguridad o instalar Git</message>
    <message xml:lang="fi_FI">Turvallisuusasetusten muuttaminen tai Gitin asennus vaatii todennuksen</message>
    <message xml:lang="fr_FR">L’authentification est requise pour modifier les paramètres de sécurité ou installer Git</message>
    <message xml:lang="hi_IN">सुरक्षा सेटिंग्स बदलने या Git इंस्टॉल करने के लिए प्रमाणीकरण आवश्यक है</message>
    <message xml:lang="id_ID">Autentikasi diperlukan untuk mengubah pengaturan keamanan atau menginstal Git</message>
    <message xml:lang="it_IT">L'autenticazione è richiesta per modificare le impostazioni di sicurezza o installare Git</message>
    <message xml:lang="ja_JP">セキュリティ設定の変更または Git のインストールには、認証が必要です</message>
    <message xml:lang="ko_KR">보안 설정을 변경하거나 Git을 설치하려면 인증이 필요합니다</message>
    <message xml:lang="nl_NL">Authenticatie is vereist om beveiligingsinstellingen te wijzigen of Git te installeren</message>
    <message xml:lang="pl_PL">Wymagane jest uwierzytelnienie, aby zmienić ustawienia bezpieczeństwa lub zainstalować Gita</message>
    <message xml:lang="pt_BR">A autenticação é necessária para alterar as configurações de segurança ou instalar o Git</message>
    <message xml:lang="pt_PT">É necessária autenticação para alterar as definições de segurança ou instalar o Git</message>
    <message xml:lang="ro_RO">Autentificarea este necesară pentru a modifica setările de securitate sau pentru a instala Git</message>
    <message xml:lang="ru_RU">Для изменения настроек безопасности или установки Git требуется аутентификация</message>
    <message xml:lang="sv_SE">Autentisering krävs för att ändra säkerhetsinställningar eller installera Git</message>
    <message xml:lang="th_TH">จำเป็นต้องมีการยืนยันตัวตนเพื่อเปลี่ยนแปลงการตั้งค่าความปลอดภัยหรือติดตั้ง Git</message>
    <message xml:lang="tr_TR">Güvenlik ayarlarını değiştirmek veya Git'i yüklemek için kimlik doğrulaması gerekir</message>
    <message xml:lang="uk_UA">Для зміни параметрів безпеки або встановлення Git потрібна автентифікація</message>
    <message xml:lang="vi_VN">Cần xác thực để thay đổi cài đặt bảo mật hoặc cài đặt Git</message>
    <message xml:lang="zh_HK">變更安全設定或安裝 Git 需要身份驗證</message>
    <message xml:lang="zh_TW">變更安全設定或安裝 Git 需要身分驗證</message>
    <message xml:lang="zh_CN">更改安全设置或安装 Git 需要身份验证</message>
    <icon_name>com.anduinos.yubikeymanager</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/anduinos-yubikey-manager/helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
