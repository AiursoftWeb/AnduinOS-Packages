<Project Sdk="Aiursoft.Apkg.Sdk">
  <PropertyGroup>
    <PackageName>anduinos-zram-config</PackageName>
    <PackageVersion>2.0.0-1+$(SuiteShortName)</PackageVersion>
    <Maintainer>AnduinOS Team &lt;anduin@aiursoft.com&gt;</Maintainer>
    <PackageDescription>AnduinOS Zram default configuration — enables compressed RAM swap (50% of RAM, lz4) on boot. The service file is installed to /usr/lib/systemd/system/ so user customizations made by anduinos-swapcontrol-gtk (written to /etc/systemd/system/) take priority without dpkg conflicts.</PackageDescription>
    <Section>admin</Section>
    <PackageHomepage>https://www.anduinos.com</PackageHomepage>
    <RepositoryUrl>https://github.com/AiursoftWeb/AnduinOS-Packages</RepositoryUrl>
    <LicenseType>GPL-3.0</LicenseType>
    <TargetDistro>anduinos</TargetDistro>
    <TargetSuites>noble-addon questing-addon resolute-addon</TargetSuites>
    <TargetArchitectures>amd64 arm64</TargetArchitectures>
    <Component>main</Component>
    <SuiteShortNameMap>noble-addon=noble questing-addon=questing resolute-addon=resolute</SuiteShortNameMap>
  </PropertyGroup>

  <ItemGroup>
    <DependencyCheckSource Url="https://mirror.aiursoft.com/ubuntu" SuiteMap="noble-addon=noble questing-addon=questing resolute-addon=resolute" />
  </ItemGroup>

  <ItemGroup>
    <!-- Minimal dependencies: just util-linux for zramctl, mkswap, swapon -->
    <Dependency Include="util-linux" />
  </ItemGroup>

  <ItemGroup>
    <!-- Service file goes to /usr/lib (vendor default), not /etc (user/admin space).
         anduinos-swapcontrol-gtk writes its customizations to /etc/systemd/system/
         which overrides this file — no dpkg conffile conflicts. -->
    <IncludeFile Include="data/anduinos-zram.service" Target="/usr/lib/systemd/system/anduinos-zram.service" />
    <!-- Preset enables the service on first boot / package install -->
    <IncludeFile Include="data/90-anduinos-zram.preset" Target="/usr/lib/systemd/system-preset/90-anduinos-zram.preset" />
  </ItemGroup>
</Project>
