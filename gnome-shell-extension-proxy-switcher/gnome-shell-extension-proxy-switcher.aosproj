<Project Sdk="Aiursoft.Apkg.Sdk">
  <PropertyGroup>
    <PackageName>gnome-shell-extension-proxy-switcher</PackageName>
    <PackageVersion>2.0.2-5+$(SuiteShortName)</PackageVersion>
    <Maintainer>AnduinOS Team &lt;anduin@aiursoft.com&gt;</Maintainer>
    <PackageDescription>AnduinOS-maintained GNOME Shell system proxy controls with an active status indicator</PackageDescription>
    <Section>gnome</Section>
    <PackageHomepage>https://github.com/AiursoftWeb/AnduinOS-Packages</PackageHomepage>
    <RepositoryUrl>https://github.com/AiursoftWeb/AnduinOS-Packages</RepositoryUrl>
    <LicenseType>GPL-2.0-only</LicenseType>
    <TargetDistro>anduinos</TargetDistro>
    <TargetSuites>noble-addon resolute-addon</TargetSuites>
    <TargetArchitectures>all</TargetArchitectures>
    <Component>main</Component>
    <SuiteShortNameMap>noble-addon=noble resolute-addon=resolute</SuiteShortNameMap>
  </PropertyGroup>
  <ItemGroup>
    <DependencyCheckSource Url="https://mirror.aiursoft.com/ubuntu" SuiteMap="noble-addon=noble resolute-addon=resolute" />
  </ItemGroup>

  <ItemGroup>
    <Dependency Include="gnome-shell" />
    <Dependency Include="dconf-gsettings-backend | gsettings-backend" />
    <Recommend Include="gnome-shell-extension-prefs | gnome-shell-extension-manager" />
    <IncludeFolder Include="assets/proxy-switcher@anduinos.com"
                   Target="/usr/share/gnome-shell/extensions/proxy-switcher@anduinos.com" />
    <IncludeFile Include="COPYING"
                 Target="/usr/share/doc/gnome-shell-extension-proxy-switcher/COPYING" />
    <IncludeFile Include="UPSTREAM.md"
                 Target="/usr/share/doc/gnome-shell-extension-proxy-switcher/UPSTREAM.md" />
    <IncludeFolder Include="po"
                   Target="/usr/share/doc/gnome-shell-extension-proxy-switcher/po" />
  </ItemGroup>
  <ItemGroup>
    <PrebuildCommand Run="bash build.sh" />
  </ItemGroup>
</Project>
