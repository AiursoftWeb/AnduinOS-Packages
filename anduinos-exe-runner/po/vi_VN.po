msgid "==> Executing command: {}"
msgstr "Đang thực thi lệnh: {}"

msgid "About to start downloading Bottles..."
msgstr "Sắp bắt đầu tải xuống Bottles..."

msgid "Advanced Status and Logs"
msgstr "Trạng thái nâng cao và nhật ký"

msgid ""
"An error occurred while initializing the bottle. Please expand advanced "
"status to view logs."
msgstr ""

msgid ""
"An error occurred while installing Bottles. Please expand advanced status to "
"view logs."
msgstr ""

msgid "Attempt Run"
msgstr "Cố gắng chạy"

msgid "Automatically hiding launcher window, enjoy!"
msgstr "Tự động ẩn cửa sổ trình khởi chạy, chúc bạn vui vẻ!"

msgid "Bottle is ready, about to launch application..."
msgstr "Chai (bottle) đã sẵn sàng, sắp khởi chạy ứng dụng..."

msgid "Bottles installation not found."
msgstr "Không tìm thấy cài đặt Bottles."

msgid "Cancel"
msgstr "Hủy"

msgid "Checking Bottles installation status via filesystem..."
msgstr "Đang kiểm tra trạng thái cài đặt Bottles qua hệ thống tệp..."

msgid "Checking if Default bottle exists via filesystem..."
msgstr "Đang kiểm tra xem chai mặc định có tồn tại không qua hệ thống tệp..."

msgid "Checking system compatibility layer..."
msgstr "Đang kiểm tra lớp tương thích của hệ thống..."

msgid "Compatibility layer is ready, preparing to start program..."
msgstr "Lớp tương thích đã sẵn sàng, đang chuẩn bị khởi chạy chương trình..."

msgid "Configuration Failed"
msgstr "Cấu hình thất bại"

msgid "Configuring Bottle"
msgstr "Đang cấu hình chai (bottle)"

msgid "Configuring runtime environment, please wait..."
msgstr "Đang cấu hình môi trường thời gian chạy, vui lòng đợi..."

msgid "Default bottle not found."
msgstr "Không tìm thấy chai mặc định."

msgid "Downloading Components"
msgstr "Đang tải xuống các thành phần"

msgid "Downloading and installing Bottles via Flatpak..."
msgstr "Đang tải xuống và cài đặt Bottles qua Flatpak..."

msgid "Get {}"
msgstr "Lấy {}"

msgid "Initializing Windows virtual bottle (Default)..."
msgstr "Đang khởi tạo chai ảo Windows (Mặc định)..."

msgid "Initializing core gaming components (DXVK, VKD3D, Runner, etc.)..."
msgstr "Đang khởi tạo các thành phần cốt lõi của trò chơi (DXVK, VKD3D, Runner, v.v.)..."

msgid "Install and Configure"
msgstr "Cài đặt và cấu hình"

msgid "Installation Failed"
msgstr "Cài đặt thất bại"

msgid "Installation and configuration complete!"
msgstr "Cài đặt và cấu hình hoàn tất!"

msgid "Installing Environment"
msgstr "Đang cài đặt môi trường"

msgid "Launch Exception"
msgstr "Lỗi khởi chạy"

msgid "Launch Failed"
msgstr "Khởi chạy thất bại"

msgid "Launch failed: {}"
msgstr "Khởi chạy thất bại: {}"

msgid "Launch or configuration failed, please check advanced logs."
msgstr "Khởi chạy hoặc cấu hình thất bại, vui lòng kiểm tra nhật ký nâng cao."

msgid "Launcher mission complete, program is running in the background."
msgstr "Nhiệm vụ trình khởi chạy hoàn tất, chương trình đang chạy trong nền."

msgid "Looking for a bootable USB tool?"
msgstr "Đang tìm kiếm công cụ tạo USB khả dụng?"

msgid "Preparing environment..."
msgstr "Đang chuẩn bị môi trường..."

msgid "Preparing to launch EXE: {}"
msgstr "Đang chuẩn bị để khởi chạy EXE: {}"

msgid "Preparing..."
msgstr "Đang chuẩn bị..."

msgid "Process finished normally."
msgstr "Quá trình kết thúc bình thường."

msgid "Process successfully started in the background, listening to logs..."
msgstr "Quá trình đã bắt đầu thành công trong nền, đang lắng nghe nhật ký..."

msgid "Process terminated abnormally (exit code {})."
msgstr "Quá trình kết thúc bất thường (mã thoát {})."

msgid ""
"Rufus attempts direct hardware access, which is impossible in a Windows "
"compatibility layer and will crash.\\n\\nIn AnduinOS, we recommend the "
"native, beautiful, and highly stable Impression for creating bootable drives."
msgstr ""

msgid "Starting program"
msgstr "Bắt đầu chương trình"

msgid "Starting program..."
msgstr "Đang khởi chạy chương trình..."

msgid ""
"The system is not configured with the Bottles compatibility layer.\\nWould "
"you like to automatically download and install it? This may take a few "
"minutes."
msgstr ""

msgid "Unable to start program, please check advanced logs."
msgstr "Không thể khởi chạy chương trình, vui lòng kiểm tra nhật ký nâng cao."

msgid "Windows Application Runner"
msgstr "Trình chạy ứng dụng Windows"

msgid "Windows Compatibility Environment Required"
msgstr "Yêu cầu môi trường tương thích Windows"
