msgid "==> Executing command: {}"
msgstr "Εκτελείται εντολή: {}"

msgid "About to start downloading Bottles..."
msgstr "Προετοιμασία για λήψη των Bottles..."

msgid "Advanced Status and Logs"
msgstr "Αναλυτική κατάσταση και αρχεία καταγραφής"

msgid ""
"An error occurred while initializing the bottle. Please expand advanced "
"status to view logs."
msgstr ""

msgid ""
"An error occurred while installing Bottles. Please expand advanced status to "
"view logs."
msgstr ""

msgid "Attempt Run"
msgstr "Δοκιμαστική Εκτέλεση"

msgid "Automatically hiding launcher window, enjoy!"
msgstr "Αυτόματη απόκρυψη παραθύρου εκκίνησης, απολαύστε!"

msgid "Bottle is ready, about to launch application..."
msgstr "Η φιάλη είναι έτοιμη, προετοιμασία για εκκίνηση εφαρμογής..."

msgid "Bottles installation not found."
msgstr "Δεν βρέθηκε εγκατάσταση των Bottles."

msgid "Cancel"
msgstr "Ακύρωση"

msgid "Checking Bottles installation status via filesystem..."
msgstr ""
"Έλεγχος κατάστασης εγκατάστασης των Bottles μέσω του συστήματος αρχείων..."

msgid "Checking if Default bottle exists via filesystem..."
msgstr "Έλεγχος αν υπάρχει προεπιλεγμένη φιάλη μέσω του συστήματος αρχείων..."

msgid "Checking system compatibility layer..."
msgstr "Έλεγχος στρώματος συμβατότητας συστήματος..."

msgid "Compatibility layer is ready, preparing to start program..."
msgstr ""
"Το στρώμα συμβατότητας είναι έτοιμο, προετοιμασία για εκκίνηση "
"προγράμματος..."

msgid "Configuration Failed"
msgstr "Αποτυχία διαμόρφωσης"

msgid "Configuring Bottle"
msgstr "Διαμόρφωση φιάλης"

msgid "Configuring runtime environment, please wait..."
msgstr "Διαμόρφωση περιβάλλοντος χρόνου εκτέλεσης, παρακαλώ περιμένετε..."

msgid "Default bottle not found."
msgstr "Η προεπιλεγμένη φιάλη δεν βρέθηκε."

msgid "Downloading Components"
msgstr "Λήψη συνιστωσών"

msgid "Downloading and installing Bottles via Flatpak..."
msgstr "Λήψη και εγκατάσταση των Bottles μέσω Flatpak..."

msgid "Get {}"
msgstr "Λήψη {}"

msgid "Initializing Windows virtual bottle (Default)..."
msgstr "Αρχικοποίηση εικονικής φιάλης Windows (Προεπιλεγμένη)..."

msgid "Initializing core gaming components (DXVK, VKD3D, Runner, etc.)..."
msgstr "Αρχικοποίηση βασικών συνιστωσών gaming (DXVK, VKD3D, Runner, κ.λπ.)..."

msgid "Install and Configure"
msgstr "Εγκατάσταση και διαμόρφωση"

msgid "Installation Failed"
msgstr "Αποτυχία εγκατάστασης"

msgid "Installation and configuration complete!"
msgstr "Η εγκατάσταση και η διαμόρφωση ολοκληρώθηκαν!"

msgid "Installing Environment"
msgstr "Εγκατάσταση περιβάλλοντος"

msgid "Launch Exception"
msgstr "Εξαίρεση εκκίνησης"

msgid "Launch Failed"
msgstr "Αποτυχία εκκίνησης"

msgid "Launch failed: {}"
msgstr "Αποτυχία εκκίνησης: {}"

msgid "Launch or configuration failed, please check advanced logs."
msgstr ""
"Η εκκίνηση ή η διαμόρφωση απέτυχε, παρακαλώ ελέγξτε τα αναλυτικά αρχεία "
"καταγραφής."

msgid "Launcher mission complete, program is running in the background."
msgstr ""
"Η αποστολή της εφαρμογής εκκίνησης ολοκληρώθηκε, το πρόγραμμα τρέχει στο "
"παρασκήνιο."

msgid "Looking for a bootable USB tool?"
msgstr "Αναζητάτε ένα εργαλείο για εκκινητό USB;"

msgid "Preparing environment..."
msgstr "Προετοιμασία περιβάλλοντος..."

msgid "Preparing to launch EXE: {}"
msgstr "Προετοιμασία για εκκίνηση EXE: {}"

msgid "Preparing..."
msgstr "Προετοιμασία..."

msgid "Process finished normally."
msgstr "Η διεργασία ολοκληρώθηκε κανονικά."

msgid "Process successfully started in the background, listening to logs..."
msgstr ""
"Η διεργασία ξεκίνησε επιτυχώς στο παρασκήνιο, ακρόαση αρχείων καταγραφής..."

msgid "Process terminated abnormally (exit code {})."
msgstr "Η διεργασία τερματίστηκε ανώμαλα (κωδικός εξόδου {})."

msgid ""
"Rufus attempts direct hardware access, which is impossible in a Windows "
"compatibility layer and will crash.\\n\\nIn AnduinOS, we recommend the "
"native, beautiful, and highly stable Impression for creating bootable drives."
msgstr ""

msgid "Starting program"
msgstr "Εκκίνηση προγράμματος"

msgid "Starting program..."
msgstr "Εκκίνηση προγράμματος..."

msgid "The system is not configured with the Bottles compatibility layer."
msgstr "Το σύστημα δεν έχει διαμορφωθεί με το στρώμα συμβατότητας Bottles."

msgid "Unable to start program, please check advanced logs."
msgstr ""
"Αδυναμία εκκίνησης προγράμματος, παρακαλώ ελέγξτε τα αναλυτικά αρχεία "
"καταγραφής."

msgid "Windows Application Runner"
msgstr "Τροχιαστής Εφαρμογών Windows"

msgid "Windows Compatibility Environment Required"
msgstr "Απαιτούμενο Περιβάλλον Συμβατότητας Windows"

msgid ""
"Would you like to automatically download and install it? This may take a few "
"minutes."
msgstr ""
