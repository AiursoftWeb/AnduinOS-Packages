msgid "==> Executing command: {}"
msgstr "\\tआदेश निष्पादित किया जा रहा है: {}"

msgid "About to start downloading Bottles..."
msgstr "\\tBottles डाउनलोड करना शुरू करने वाला है..."

msgid "Advanced Status and Logs"
msgstr "\\tउन्नत स्थिति और लॉग"

msgid ""
"An error occurred while initializing the bottle. Please expand advanced "
"status to view logs."
msgstr ""

msgid ""
"An error occurred while installing Bottles. Please expand advanced status to "
"view logs."
msgstr ""

msgid "Attempt Run"
msgstr "\\tप्रयास चलाएँ"

msgid "Automatically hiding launcher window, enjoy!"
msgstr "\\tलॉन्चर विंडो स्वचालित रूप से छिपी जा रही है, आनंद लें!"

msgid "Bottle is ready, about to launch application..."
msgstr "\\tबोतल तैयार है, एप्लिकेशन लॉन्च करने वाला है..."

msgid "Bottles installation not found."
msgstr "\\tBottles की स्थापना नहीं मिली।"

msgid "Cancel"
msgstr "\\रद्द करें"

msgid "Checking Bottles installation status via filesystem..."
msgstr "\\tफ़ाइल प्रणाली के माध्यम से Bottles स्थापना स्थिति की जाँच की जा रही है..."

msgid "Checking if Default bottle exists via filesystem..."
msgstr "\\tफ़ाइल प्रणाली के माध्यम से डिफ़ॉल्ट बोतल मौजूद है की जाँच की जा रही है..."

msgid "Checking system compatibility layer..."
msgstr "\\tसंगतता परत की जाँच की जा रही है..."

msgid "Compatibility layer is ready, preparing to start program..."
msgstr "\\tसंगतता परत तैयार है, प्रोग्राम शुरू करने की तैयारी कर रहा है..."

msgid "Configuration Failed"
msgstr "\\tविन्यास विफल"

msgid "Configuring Bottle"
msgstr "\\tबोतल को कॉन्फ़िगर किया जा रहा है"

msgid "Configuring runtime environment, please wait..."
msgstr "\\tरनटाइम वातावरण को कॉन्फ़िगर किया जा रहा है, कृपया प्रतीक्षा करें..."

msgid "Default bottle not found."
msgstr "\\tडिफ़ॉल्ट बोतल नहीं मिली।"

msgid "Downloading Components"
msgstr "\\tघटक डाउनलोड किए जा रहे हैं"

msgid "Downloading and installing Bottles via Flatpak..."
msgstr "\\tFlatpak के माध्यम से Bottles डाउनलोड और स्थापित किया जा रहा है..."

msgid "Get {}"
msgstr "\\t{} प्राप्त करें"

msgid "Initializing Windows virtual bottle (Default)..."
msgstr "\\tविंडोज़ वर्चुअल बोतल (डिफ़ॉल्ट) को प्रारंभ किया जा रहा है..."

msgid "Initializing core gaming components (DXVK, VKD3D, Runner, etc.)..."
msgstr "\\tकोर गेमिंग घटकों को प्रारंभ किया जा रहा है (DXVK, VKD3D, रनर आदि)..."

msgid "Install and Configure"
msgstr "\\tस्थापित करें और कॉन्फ़िगर करें"

msgid "Installation Failed"
msgstr "\\tस्थापना विफल"

msgid "Installation and configuration complete!"
msgstr "\\tस्थापना और विन्यास पूर्ण!"

msgid "Installing Environment"
msgstr "\\tवातावरण स्थापित किया जा रहा है"

msgid "Launch Exception"
msgstr "\\tलॉन्च अपवाद"

msgid "Launch Failed"
msgstr "\\tलॉन्च विफल"

msgid "Launch failed: {}"
msgstr "\\tलॉन्च विफल: {}"

msgid "Launch or configuration failed, please check advanced logs."
msgstr "\\tलॉन्च या विन्यास विफल रहा, कृपया उन्नत लॉग जाँचें।"

msgid "Launcher mission complete, program is running in the background."
msgstr "\\tलॉन्चर मिशन पूर्ण, प्रोग्राम पृष्ठभूमि में चल रहा है।"

msgid "Looking for a bootable USB tool?"
msgstr "\\tक्या आप एक बूटेबल USB टूल खोज रहे हैं?"

msgid "Preparing environment..."
msgstr "\\tवातावरण तैयार किया जा रहा है..."

msgid "Preparing to launch EXE: {}"
msgstr "\\tEXE लॉन्च करने की तैयारी: {}"

msgid "Preparing..."
msgstr "\\tतैयारी हो रही है..."

msgid "Process finished normally."
msgstr "\\tप्रक्रिया सामान्य रूप से समाप्त हुई।"

msgid "Process successfully started in the background, listening to logs..."
msgstr "\\tप्रक्रिया सफलतापूर्वक पृष्ठभूमि में शुरू हो गई, लॉग सुन रहे हैं..."

msgid "Process terminated abnormally (exit code {})."
msgstr "\\tप्रक्रिया असामान्य रूप से समाप्त हुई (आउट कोड {})।"

msgid ""
"Rufus attempts direct hardware access, which is impossible in a Windows "
"compatibility layer and will crash.\\n\\nIn AnduinOS, we recommend the "
"native, beautiful, and highly stable Impression for creating bootable drives."
msgstr ""

msgid "Starting program"
msgstr "\\tप्रोग्राम शुरू किया जा रहा है"

msgid "Starting program..."
msgstr "\\tप्रोग्राम शुरू किया जा रहा है..."

msgid "The system is not configured with the Bottles compatibility layer."
msgstr "\\tसिस्टम में बॉटल्स संगतता परत कॉन्फ़िगर नहीं की गई है।"

msgid "Unable to start program, please check advanced logs."
msgstr "\\tप्रोग्राम शुरू नहीं किया जा सका, कृपया उन्नत लॉग जाँचें।"

msgid "Windows Application Runner"
msgstr "\\tविंडोज़ एप्लिकेशन रनर"

msgid "Windows Compatibility Environment Required"
msgstr "\\tविंडोज़ संगतता वातावरण आवश्यक है"

msgid ""
"Would you like to automatically download and install it? This may take a few "
"minutes."
msgstr ""
