msgstr "Không tìm thấy kho lưu trữ phản chiếu nào."

#: assets/anduinos-oobe:1156
msgid "✗ No mirrors reachable. Check your connection."
msgstr ""
"✗ Không có máy chủ phản chiếu nào khả dụng. Hãy kiểm tra kết nối mạng của "
"bạn."

#: assets/anduinos-oobe:1164
msgid "=== Testing bandwidth of top 5 mirrors "
msgstr "=== Đang kiểm tra băng thông của 5 kho lưu trữ hàng đầu ==="

