msgid "✓ Mirror switched and system updated."
msgstr "✓ Đã chuyển đổi kho lưu trữ phản chiếu và cập nhật hệ thống."

#: assets/anduinos-oobe:1373
msgid "✓ Switched to "
msgstr "✓ Đã chuyển sang"

