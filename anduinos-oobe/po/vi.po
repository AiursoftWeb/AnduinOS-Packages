#: anduinos-oobe/assets/anduinos-oobe:394
msgid "Choose a crisp light theme, or an immersive dark experience."
msgstr "Chọn giao diện sáng sắc nét, hoặc trải nghiệm tối đắm chìm."

#: anduinos-oobe/assets/anduinos-oobe:414
msgid "Light"
msgstr "Sáng"

#: anduinos-oobe/assets/anduinos-oobe:427
msgid "Dark"
msgstr "Tối"

#: anduinos-oobe/assets/anduinos-oobe:455
msgid "Workflow Layout"
msgstr "Bố cục Công việc"

#: anduinos-oobe/assets/anduinos-oobe:456
msgid "Prefer modern centered alignment, or classic left-docked?"
msgstr "Bạn thích căn giữa hiện đại, hay neo trái cổ điển?"

#: anduinos-oobe/assets/anduinos-oobe:504
msgid "Taskbar Layout"
msgstr "Bố cục Thanh tác vụ"

#: anduinos-oobe/assets/anduinos-oobe:505
msgid "Choose your workflow."
msgstr "Chọn cách làm việc của bạn."

#: anduinos-oobe/assets/anduinos-oobe:514
msgid " Modern "
msgstr "Hiện đại"

#: anduinos-oobe/assets/anduinos-oobe:515
msgid " Classic "
msgstr "Cổ điển"

#: anduinos-oobe/assets/anduinos-oobe:543
msgid "Show Virtual Desktop Switch Button"
msgstr "Hiển thị nút chuyển đổi Màn hình ảo"

