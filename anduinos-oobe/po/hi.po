msgid "Could not open network settings: {}"
msgstr "नेटवर्क सेटिंग नहीं खोल सका: {}"

#: assets/anduinos-oobe:779
msgid "Continue Offline"
msgstr "ऑफ़लाइन जारी रखें"

#: assets/anduinos-oobe:783
msgid "Skip updates, online drivers, apps, and account setup."
msgstr "अपडेट, ऑनलाइन ड्राइवर, ऐप्स और खाता सेटअप छोड़ें।"

#: assets/anduinos-oobe:799
msgid "Internet connection is ready. Choose Next to continue."
msgstr "इंटरनेट कनेक्शन तैयार है. जारी रखने के लिए अगला चुनें."

#: assets/anduinos-oobe:806
msgid "Connect to Wi-Fi or a wired network to continue."
msgstr "जारी रखने के लिए वाई-फाई या वायर्ड नेटवर्क से कनेक्ट करें।"

#: assets/anduinos-oobe:829
msgid "No network adapters detected."
msgstr "कोई नेटवर्क एडाप्टर नहीं मिला."

#: assets/anduinos-oobe:831
msgid "Connect a network adapter or continue offline."
msgstr "नेटवर्क एडाप्टर कनेक्ट करें या ऑफ़लाइन जारी रखें."

#: assets/anduinos-oobe:836
msgid "Wired Network"
msgstr "वायर्ड नेटवर्क"

#: assets/anduinos-oobe:838
msgid "Cable connected."
msgstr "केबल कनेक्ट किया गया."

#: assets/anduinos-oobe:839
msgid "Plug in a network cable to connect."
msgstr "कनेक्ट करने के लिए नेटवर्क केबल प्लग इन करें।"

#: assets/anduinos-oobe:844
msgid "Wireless Network"
msgstr "वायरलेस नेटवर्क"

#: assets/anduinos-oobe:845
msgid "Wi-Fi adapter detected."
msgstr "वाई-फ़ाई एडाप्टर का पता चला."

#: assets/anduinos-oobe:846
msgid "Open Wi-Fi Settings"
msgstr "वाई-फ़ाई सेटिंग खोलें"

#: assets/anduinos-oobe:850
msgid "Wired and Wireless Networks"
msgstr "वायर्ड और वायरलेस नेटवर्क"

#: assets/anduinos-oobe:852
msgid "Cable connected and Wi-Fi available."
msgstr "केबल जुड़ा हुआ है और वाई-फ़ाई उपलब्ध है।"

#: assets/anduinos-oobe:854
msgid "Wi-Fi is available; the network cable is disconnected."
msgstr "वाई-फ़ाई उपलब्ध है; नेटवर्क केबल काट दिया गया है."

#: assets/anduinos-oobe:866
msgid "Wi-Fi is turned off."
msgstr "वाई-फ़ाई बंद है."

#: assets/anduinos-oobe:870
msgid "No Wi-Fi networks found."
msgstr "कोई वाई-फ़ाई नेटवर्क नहीं मिला."

#: assets/anduinos-oobe:899
msgid "Wi-Fi unavailable: {}"
msgstr "वाई-फ़ाई अनुपलब्ध: {}"

#: assets/anduinos-oobe:981
msgid "Define Your Visual Order"
msgstr "अपने दृश्य क्रम को परिभाषित करें"

#: assets/anduinos-oobe:991
msgid "Light and Shadow"
msgstr "प्रकाश और छाया"

#: assets/anduinos-oobe:992
msgid "Choose a crisp light theme, or an immersive dark experience."
msgstr "एक स्पष्ट लाइट थीम चुनें, या एक immersive डार्क अनुभव।"

#: assets/anduinos-oobe:1011
msgid "Light"
msgstr "लाइट"

#: assets/anduinos-oobe:1023
msgid "Dark"
msgstr "डार्क"

#: assets/anduinos-oobe:1054
msgid "Workflow Layout"
msgstr "कार्यप्रवाह लेआउट"

#: assets/anduinos-oobe:1055
msgid "Prefer modern centered alignment, or classic left-docked?"
msgstr "आधुनिक केंद्रित एलाइनमेंट पसंद है, या क्लासिक बाएं-डॉक्ड?"

#: assets/anduinos-oobe:1089
msgid "Taskbar Layout"
msgstr "टास्कबार लेआउट"

#: assets/anduinos-oobe:1090
msgid "Choose your workflow."
msgstr "अपना कार्यप्रवाह चुनें।"

#: assets/anduinos-oobe:1099
msgid " Modern "
msgstr " आधुनिक "

#: assets/anduinos-oobe:1100
msgid " Classic "
msgstr " क्लासिक "

#: assets/anduinos-oobe:1129
msgid "Show Virtual Desktop Switch Button"
msgstr "वर्चुअल डेस्कटॉप स्विच बटन दिखाएं"

