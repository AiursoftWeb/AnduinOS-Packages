#: anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:83
msgid ""
"Secure Boot is a motherboard security standard that ensures only trusted "
"software loads at startup."
msgstr ""
"\tSecure Boot to standard bezpieczeństwa płyty głównej, który zapewnia "
"ładowanie tylko zaufanego oprogramowania podczas uruchamiania."

#: anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:86
msgid "It protects your system from low-level malware and rootkits."
msgstr ""
"\\\tOchroni Twój system przed niskopoziomowym złośliwym oprogramowaniem i "
"rootkitami."

#: anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:95
msgid "System Trust Status"
msgstr "\\\tStatus zaufania systemu"

#: anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:146
msgid "Note: Use password <b>123456</b> after rebooting."
msgstr "\\\tUwaga: Użyj hasła <b>123456</b> po ponownym uruchomieniu."

#: anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:185
msgid "Motherboard hardware protection is active"
msgstr "\\\tOchrona sprzętowa płyty głównej jest aktywna"

#: anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:188
msgid "Firmware does not support Secure Boot"
msgstr "Oprogramowanie sprzętowe nie obsługuje Secure Boot"

#: anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:194
msgid "Secure Boot is disabled"
msgstr "Secure Boot jest wyłączony"

#: anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:200
#: anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:202
msgid "Not required without firmware enforcement"
msgstr "Niewymagane bez wymuszania oprogramowania sprzętowego"

#: anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:206
#: anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:210
msgid "Not checked because Secure Boot state is unknown"
msgstr "Nie zaznaczono, ponieważ stan Secure Boot jest nieznany"

#: anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:215
msgid "Certificate generated locally"
msgstr "\\\tCertyfikat wygenerowany lokalnie"

#: anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:217
msgid "Missing local certificate"
msgstr "\\\tBrak lokalnego certyfikatu"

#: anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:230
msgid "Certificate is trusted by motherboard"
msgstr "\\\tCertyfikat jest zaufany przez płytę główną"

#: anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:234
msgid "Pending enrollment in blue screen (MOKManager)"
msgstr "\\\tOczekiwanie na rejestrację w niebieskim ekranie (MOKManager)"

#: anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:239
msgid "Certificate is not trusted by motherboard"
msgstr "Certyfikat nie jest zaufany przez płytę główną"

#: anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:245
msgid "Kernel signature enforcement is inactive"
msgstr "Wymuszanie podpisu jądra jest nieaktywne"

#: anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:252
msgid ""
"Secure Boot trust is ready. No third-party kernel modules are currently "
"installed."
msgstr ""
"Zaufanie Secure Boot jest gotowe. Obecnie nie są zainstalowane żadne moduły "
"jądra innych firm."

#: anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:256
#: anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:447
#: anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:455
msgid "Drivers are signed and ready to load"
msgstr "\\\tSterowniki są podpisane i gotowe do załadowania."

#: anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:260
msgid "Drivers are trusted, but automatic DKMS signing needs repair"
msgstr "Sterowniki są zaufane, ale automatyczne podpisywanie DKMS wymaga naprawy"

#: anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:264
msgid "No signed third-party drivers detected"
msgstr "\\\tNie wykryto podpisanych sterowników firm trzecich."

#: anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:267
msgid "Some DKMS modules need to be re-signed"
msgstr "Niektóre moduły DKMS wymagają ponownego podpisania"

#: anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:272
msgid "Enroll Existing Certificate"
msgstr "Zarejestruj istniejący certyfikat"

#: anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:282
msgid "Repair Automatic DKMS Signing"
msgstr "Napraw automatyczne podpisywanie DKMS"

#: anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:299
msgid "This firmware does not provide Secure Boot. No certificate is required."
msgstr ""
"To oprogramowanie sprzętowe nie udostępnia Secure Boot. Żaden certyfikat nie"
" jest wymagany."

#: anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:306
msgid ""
"Secure Boot status could not be read. Driver trust operations are blocked "
"until detection succeeds."
msgstr ""
"Nie można odczytać statusu Secure Boot. Operacje zaufania sterowników są "
"blokowane do momentu pomyślnego wykrycia."

#: anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:311
msgid "No certificate is required while Secure Boot is disabled."
msgstr "Żaden certyfikat nie jest wymagany, gdy Secure Boot jest wyłączony."

#: anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:314
msgid "System Trust Established. Third-party drivers will load securely."
msgstr ""
"\\\tZaufanie systemowe ustanowione. Sterowniki firm trzecich będą ładowane "
"bezpiecznie."

#: anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:318
msgid "The certificate is enrolled and current drivers are trusted."
msgstr "Certyfikat został zarejestrowany, a aktualne sterowniki są zaufane."

#: anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:320
msgid "Repair automatic DKMS signing before future driver updates."
msgstr ""
"Napraw automatyczne podpisywanie DKMS przed przyszłymi aktualizacjami "
"sterowników."

#: anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:325
msgid "The certificate is enrolled, but some modules are not signed with it."
msgstr "Certyfikat jest zarejestrowany, ale niektóre moduły nie są nim podpisane."

#: anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:339
#: anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:346
msgid "You must configure this to use third-party drivers like NVIDIA."
msgstr ""
"\\\tMusisz to skonfigurować, aby korzystać ze sterowników firm trzecich, "
"takich jak NVIDIA."

#: anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:344
msgid "The local trust certificate is missing."
msgstr "Brak lokalnego certyfikatu zaufania."

#: anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:369
msgid "Please trust the certificate upon reboot using password 123456."
msgstr "\\\tZaufaj certyfikatowi po ponownym uruchomieniu, używając hasła 123456."

#: anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:380
msgid "Success! When you reboot, a blue screen will appear."
msgstr "\\\tSukces! Po restarcie pojawi się niebieski ekran."

#: anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:384
msgid "Select 'Enroll MOK' → 'Continue' → 'Yes', and enter password: 123456"
msgstr "\\\tWybierz 'Enroll MOK' → 'Continue' → 'Yes' i wpisz hasło: 123456"

#: anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:388
msgid "Certificate Created"
msgstr "\\\tCertyfikat utworzony"

#: anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:391
msgid "Later"
msgstr "Później"

#: anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:420
msgid "Secure Boot Trust Not Required"
msgstr "Secure Boot Zaufanie nie jest wymagane"

#: anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:421
msgid "Firmware signature enforcement is not active."
msgstr "Wymuszanie podpisu oprogramowania sprzętowego nie jest aktywne."

#: anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:423
#: anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:441
#: anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:449
#: anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:457
#: anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:473
msgid "OK"
msgstr "\\\tOK"

#: anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:431
msgid ""
"The certificate is ready, but one or more DKMS modules could not be rebuilt."
" You can repair them after enrollment."
msgstr ""
"Certyfikat jest gotowy, ale nie udało się odbudować jednego lub więcej "
"modułów DKMS. Możesz je naprawić po rejestracji."

#: anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:439
msgid "Configuration needs attention"
msgstr "Konfiguracja wymaga uwagi"

#: anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:446
msgid "System Trust Established"
msgstr "Utworzono zaufanie systemu"

#: anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:470
msgid "Configuration failed. Please try again."
msgstr "\\\tKonfiguracja nie powiodła się. Spróbuj ponownie."

#: anduinos-secureboot-toolkit/src/anduinos_secureboot/ui.py:482
msgid "Generating & Signing..."
msgstr "\\\tGenerowanie i podpisywanie..."

