msgid "  Install Updates  "
msgstr "Εγκατάσταση Ενημερώσεων"

#: anduinos-oobe/assets/anduinos-oobe:890
msgid "✓ System is up to date."
msgstr "✓ Το σύστημα είναι ενημερωμένο."

#: anduinos-oobe/assets/anduinos-oobe:892
#: anduinos-oobe/assets/anduinos-oobe:922
#: anduinos-oobe/assets/anduinos-oobe:1510
