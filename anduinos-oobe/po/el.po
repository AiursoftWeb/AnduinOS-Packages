#: assets/anduinos-oobe:546
msgid " Modern "
msgstr "Σύγχρονο"

#: assets/anduinos-oobe:547
msgid " Classic "
msgstr "Κλασικό"

#: assets/anduinos-oobe:575
msgid "Show Virtual Desktop Switch Button"
msgstr "Εμφάνιση κουμπιού εναλλαγής εικονικών επιφανειών εργασίας"

