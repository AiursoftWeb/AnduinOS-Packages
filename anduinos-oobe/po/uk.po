msgid "Xbox Controller Driver Installed"
msgstr "Драйвер контролера Xbox встановлено"

#: assets/anduinos-oobe:2083 assets/anduinos-oobe:2271
#: assets/anduinos-oobe:2356
msgid "The xpadneo driver is currently installed"
msgstr "Драйвер xpadneo зараз встановлено"

