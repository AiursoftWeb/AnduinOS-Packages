msgid "✓ Zero telemetry — your activity is yours alone"
msgstr "✓ 22 ✓ Zero telemetrie — la tua attività è solo tua"

#: assets/anduinos-oobe:2160
msgid "✓ No data collection — your files stay on your device"
msgstr "✓ 23 ✓ Nessuna raccolta dati — i tuoi file restano sul tuo dispositivo"

