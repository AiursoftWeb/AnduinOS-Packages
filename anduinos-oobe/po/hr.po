msgid "Internet connection is ready. Choose Next to continue."
msgstr "Internetska veza je spremna. Odaberite Dalje za nastavak."

#: assets/anduinos-oobe:604
msgid "Connect to Wi-Fi or a wired network to continue."
msgstr "Povežite se s Wi-Fi ili žičnom mrežom za nastavak."

#: assets/anduinos-oobe:627
msgid "No network adapters detected."
msgstr "Nisu otkriveni mrežni prilagodnici."

#: assets/anduinos-oobe:629
msgid "Connect a network adapter or continue offline."
msgstr "Povežite mrežni prilagodnik ili nastavite bez interneta."

#: assets/anduinos-oobe:634
msgid "Wired Network"
msgstr "Žična mreža"

#: assets/anduinos-oobe:636
msgid "Cable connected."
msgstr "Kabel je povezan."

#: assets/anduinos-oobe:637
msgid "Plug in a network cable to connect."
msgstr "Priključite mrežni kabel za povezivanje."

#: assets/anduinos-oobe:642
msgid "Wireless Network"
msgstr "Bežična mreža"

#: assets/anduinos-oobe:643
msgid "Wi-Fi adapter detected."
msgstr "Otkriven je Wi-Fi prilagodnik."

#: assets/anduinos-oobe:644
msgid "Open Wi-Fi Settings"
msgstr "Otvori Wi-Fi postavke"

#: assets/anduinos-oobe:648
msgid "Wired and Wireless Networks"
msgstr "Žične i bežične mreže"

#: assets/anduinos-oobe:650
msgid "Cable connected and Wi-Fi available."
msgstr "Kabel je povezan i Wi-Fi je dostupan."

#: assets/anduinos-oobe:652
msgid "Wi-Fi is available; the network cable is disconnected."
msgstr "Wi-Fi je dostupan; mrežni kabel nije povezan."

