msgstr "Mrežni hardver"

#: assets/anduinos-oobe:544
msgid "Available Wi-Fi Networks"
msgstr "Dostupne Wi-Fi mreže"

#: assets/anduinos-oobe:546
msgid "Wi-Fi"
msgstr "Wi-Fi"

#: assets/anduinos-oobe:549
msgid "Scan Again"
msgstr "Ponovno pretraži"

#: assets/anduinos-oobe:558 assets/anduinos-oobe:630 assets/anduinos-oobe:638
#: assets/anduinos-oobe:653
msgid "Open Network Settings"
msgstr "Otvori mrežne postavke"

#: assets/anduinos-oobe:567
msgid "Could not open network settings: {}"
msgstr "Nije moguće otvoriti mrežne postavke: {}"

#: assets/anduinos-oobe:577
msgid "Continue Offline"
msgstr "Nastavi bez interneta"

#: assets/anduinos-oobe:581
msgid "Skip updates, online drivers, apps, and account setup."
msgstr ""
"Preskočite ažuriranja, preuzimanje upravljačkih programa i aplikacija te "
"postavljanje računa."

