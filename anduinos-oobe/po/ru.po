msgid "✗ Installation failed: "
msgstr "✗ Установка не удалась:"

#: assets/anduinos-oobe:1012
msgid "Testing mirrors…"
msgstr "Проверка зеркал…"

#: assets/anduinos-oobe:1013
msgid "=== Testing mirror speeds ==="
msgstr "=== Тестирование скорости зеркал ==="

#: assets/anduinos-oobe:1138 assets/anduinos-oobe:1146
#, python-brace-format
msgid "Testing mirrors… ({c}/{t})"
msgstr "Проверка зеркал… ({c}/{t})"

