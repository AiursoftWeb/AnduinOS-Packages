msgid "=== Testing mirror speeds ==="
msgstr "=== Ayna hızları test ediliyor ==="

#: assets/anduinos-oobe:1138 assets/anduinos-oobe:1146
#, python-brace-format
msgid "Testing mirrors… ({c}/{t})"
msgstr "Ayna Test Ediliyor… ({c}/{t})"

#: assets/anduinos-oobe:1154
msgid "No mirrors reachable."
msgstr "Erişilebilir ayna yok."

#: assets/anduinos-oobe:1156
msgid "✗ No mirrors reachable. Check your connection."
msgstr "21\t✗ Ulaşılabilecek yansı yok. Bağlantınızı kontrol edin."

#: assets/anduinos-oobe:1164
msgid "=== Testing bandwidth of top 5 mirrors "
msgstr "=== En iyi 5 aynanın bant genişliği test ediliyor ==="

#: assets/anduinos-oobe:1165
msgid "(3 s each) ==="
msgstr "(her biri 3 sn) ==="

#: assets/anduinos-oobe:1219
msgid "Best mirror by bandwidth"
msgstr "23\tBant genişine göre en iyi yansı"

#: assets/anduinos-oobe:1221 assets/anduinos-oobe:1242
#: assets/anduinos-oobe:1249
msgid "Latency"
msgstr "24\tGecikme süresi"

#: assets/anduinos-oobe:1222 assets/anduinos-oobe:1243
#: assets/anduinos-oobe:1250
