msgid "Display Scaling"
msgstr "디스플레이 배율"

#: assets/anduinos-oobe:768 assets/anduinos-oobe:799 assets/anduinos-oobe:816
msgid "Recommendation unavailable for this display."
msgstr "이 디스플레이에 대한 권장 값이 없습니다."

#: assets/anduinos-oobe:790
#, python-format
msgid "%(scale)s (Recommended)"
msgstr "%(scale)s (권장)"

#: assets/anduinos-oobe:797
#, python-format
msgid "Primary display: %(display)s · Recommended: %(scale)s"
msgstr "주 디스플레이: %(display)s · 권장: %(scale)s"

#: assets/anduinos-oobe:800 assets/anduinos-oobe:815
msgid "Could not change display scaling."
msgstr "디스플레이 배율을 변경할 수 없습니다."

