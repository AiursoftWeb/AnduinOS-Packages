def get_mdns_control_state():
    """Return (available, enabled) for the Avahi system service."""
    if not os.path.isfile(MDNS_HELPER):
        return False, False
    try:
        load_state = subprocess.run(
            ['systemctl', 'show', 'avahi-daemon.service', '--property=LoadState',
             '--value'], capture_output=True, text=True, timeout=5
        ).stdout.strip()
        if load_state in ('', 'not-found'):
            return False, False
        enabled_states = ('enabled', 'enabled-runtime', 'static', 'indirect')
        service_state = subprocess.run(
            ['systemctl', 'is-enabled', 'avahi-daemon.service'],
            capture_output=True, text=True, timeout=5
        ).stdout.strip()
        socket_state = subprocess.run(
            ['systemctl', 'is-enabled', 'avahi-daemon.socket'],
            capture_output=True, text=True, timeout=5
        ).stdout.strip()
        return True, (service_state in enabled_states
                      and socket_state in enabled_states)
    except Exception:
        return False, False


def set_mdns_enabled(enabled):
    """Change Avahi state through OOBE's fixed, polkit-authorized helper."""
    return subprocess.run(
        ['pkexec', MDNS_HELPER, 'set-mdns-enabled',
         'true' if enabled else 'false'],
        capture_output=True, text=True, timeout=30
    )

def _read_os_pretty_name():
    """Read PRETTY_NAME from /etc/os-release, fallback to NAME=."""
    try:
        with open('/etc/os-release', 'r') as f:
            pretty = None
            name = None
            for line in f:
                line = line.strip()
                if line.startswith('PRETTY_NAME='):
                    pretty = line.split('=', 1)[1].strip().strip('"').strip("'")
                elif line.startswith('NAME='):
                    name = line.split('=', 1)[1].strip().strip('"').strip("'")
            return pretty or name or 'AnduinOS'
    except Exception:
        return 'AnduinOS'


