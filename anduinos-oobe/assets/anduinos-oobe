def get_mdns_control_state():
    """Return (available, enabled) for the Avahi system service."""
    if not os.path.isfile(MDNS_HELPER):
        return False, False
    try:
        load_state = subprocess.run(
            ['systemctl', 'show', 'avahi-daemon.service', '--property=LoadState',
             '--value'], capture_output=True, text=True, timeout=5
        ).stdout.strip()
        if load_state in ('', 'not-found'):
            return False, False
        enabled_states = ('enabled', 'enabled-runtime', 'static', 'indirect')
        service_state = subprocess.run(
            ['systemctl', 'is-enabled', 'avahi-daemon.service'],
            capture_output=True, text=True, timeout=5
        ).stdout.strip()
        socket_state = subprocess.run(
            ['systemctl', 'is-enabled', 'avahi-daemon.socket'],
            capture_output=True, text=True, timeout=5
        ).stdout.strip()
        return True, (service_state in enabled_states
                      and socket_state in enabled_states)
    except Exception:
        return False, False


