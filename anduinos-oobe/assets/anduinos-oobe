def create_flathub_mirror_page():
    page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
    page._requires_internet = True
    page.set_valign(Gtk.Align.FILL)
    page.set_halign(Gtk.Align.FILL)
