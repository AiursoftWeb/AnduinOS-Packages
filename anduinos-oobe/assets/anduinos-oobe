def _read_bashrc(bashrc_path=None):
    """Return (resolved path, text, mode) without following special files."""
    path = os.path.expanduser(bashrc_path or '~/.bashrc')
    target = os.path.realpath(path)
    try:
        metadata = os.stat(target)
    except FileNotFoundError:
        return target, '', 0o644
    if not stat.S_ISREG(metadata.st_mode):
        raise OSError('Bash configuration is not a regular file')
    if metadata.st_size > 4 * 1024 * 1024:
        raise OSError('Bash configuration is unexpectedly large')
    with open(target, 'r', encoding='utf-8', errors='surrogateescape') as stream:
        return target, stream.read(), stat.S_IMODE(metadata.st_mode)


def bash_command_predictions_enabled(bashrc_path=None):
    """Return the effective value of simple Bash prediction assignments."""
    try:
        _target, contents, _mode = _read_bashrc(bashrc_path)
    except OSError:
        return True
    assignments = list(BASH_GUESS_ASSIGNMENT_RE.finditer(contents))
    return not assignments or assignments[-1].group(2) != '0'


def _append_bash_guess_block(contents, enabled):
    if contents and not contents.endswith('\n'):
        contents += '\n'
    if contents and not contents.endswith('\n\n'):
        contents += '\n'
    return (
        contents
        + BASH_GUESS_BEGIN + '\n'
        + BASH_GUESS_ASSIGNMENT.format('1' if enabled else '0') + '\n'
        + BASH_GUESS_END + '\n'
    )


def set_bash_command_predictions_enabled(enabled, bashrc_path=None):
    """Atomically update only OOBE's marked Bash prediction configuration."""
    target, contents, mode = _read_bashrc(bashrc_path)
    updated = BASH_GUESS_BLOCK_RE.sub('', contents)

    # Enabled is the package default, so no managed setting is necessary unless
    # it must explicitly override a simple manual `...=0` earlier in .bashrc.
    effective = list(BASH_GUESS_ASSIGNMENT_RE.finditer(updated))
    manual_disabled = effective and effective[-1].group(2) == '0'
    if not enabled or manual_disabled:
        updated = _append_bash_guess_block(updated, enabled)
    if updated == contents:
        return False

    parent = os.path.dirname(target)
    if not os.path.isdir(parent):
        raise OSError('Bash configuration directory does not exist')
    descriptor, temporary = tempfile.mkstemp(
        prefix='.bashrc.anduinos-', dir=parent
    )
    try:
        os.fchmod(descriptor, mode)
        with os.fdopen(
            descriptor, 'w', encoding='utf-8', errors='surrogateescape'
        ) as stream:
            descriptor = -1
            stream.write(updated)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, target)
        try:
            directory = os.open(parent, os.O_RDONLY | os.O_DIRECTORY)
        except OSError:
            directory = -1
        if directory >= 0:
            try:
                # Some network filesystems do not support directory fsync.
                try:
                    os.fsync(directory)
                except OSError:
                    pass
            finally:
                os.close(directory)
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass
    return True

def _read_os_pretty_name():
    """Read PRETTY_NAME from /etc/os-release, fallback to NAME=."""
    try:
        with open('/etc/os-release', 'r') as f:
            pretty = None
            name = None
            for line in f:
                line = line.strip()
                if line.startswith('PRETTY_NAME='):
                    pretty = line.split('=', 1)[1].strip().strip('"').strip("'")
                elif line.startswith('NAME='):
                    name = line.split('=', 1)[1].strip().strip('"').strip("'")
            return pretty or name or 'AnduinOS'
    except Exception:
        return 'AnduinOS'


def is_arm64():
    """True on aarch64 platforms (Snapdragon, Apple Silicon, etc.)."""
    return os.uname().machine == 'aarch64'


def has_second_disk():
    try:
        r = subprocess.run(['lsblk', '-ndo', 'NAME,TYPE'], capture_output=True, text=True, timeout=10)
        count = 0
        for line in r.stdout.strip().split('\n'):
            parts = line.split()
            if len(parts) >= 2 and parts[1] == 'disk' and not parts[0].startswith('loop'):
                count += 1
        return count > 1
    except Exception:
        return False


