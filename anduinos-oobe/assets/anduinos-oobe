    # ── Network Security Card ──
    fw_card = Adw.PreferencesGroup()
    fw_card.set_title(_('Network Security'))
    fw_card.set_description(
        _('Control inbound protection and whether this computer participates in local network discovery.')
    )
    fw_card.set_margin_bottom(24)

    fw_row = Adw.SwitchRow()
    fw_row.set_title(_('Network Firewall (UFW)'))

    # Shield icon that glows green
    shield_icon = _create_image('preferences-security-firewall.svg')
    shield_icon.set_pixel_size(32)
    fw_row.add_prefix(shield_icon)

    # Read UFW status from world-readable config file — no root needed
    try:
        with open('/etc/ufw/ufw.conf', 'r') as f:
            for line in f:
                line = line.strip()
                if line.startswith('ENABLED='):
                    fw_active = line.split('=', 1)[1].strip().lower() == 'yes'
                    break
            else:
                fw_active = False
    except Exception:
        fw_active = False
    fw_row.set_active(fw_active)

    def _on_fw_toggle(switch, pspec):
        enable = switch.get_active()
        arg = 'enable' if enable else 'disable'

        def _done(returncode, stdout, stderr, sw, expected):
            if returncode != 0:
                GLib.idle_add(lambda: sw.set_active(not expected))
            else:
                icon_name = 'preferences-security-firewall.svg' if enable else 'preferences-security.svg'
                path = _icon(icon_name)
                def _update_icon():
                    if os.path.isfile(path):
                        shield_icon.set_from_file(path)
                    else:
                        shield_icon.set_from_icon_name(path)
                GLib.idle_add(_update_icon)

        def _run_fw():
            try:
                proc = subprocess.run(['pkexec', 'ufw', '--force', arg],
                                      capture_output=True, text=True, timeout=30)
                GLib.idle_add(lambda: _done(proc.returncode, proc.stdout, proc.stderr,
                                            switch, enable))
            except Exception as e:
                GLib.idle_add(lambda e=e: _done(-1, '', str(e), switch, enable))

        threading.Thread(target=_run_fw, daemon=True).start()

    fw_row.connect('notify::active', _on_fw_toggle)
    fw_card.add(fw_row)

    mdns_row = Adw.SwitchRow()
    mdns_row.set_title(_('Local Network Discovery (mDNS)'))
    mdns_row.set_subtitle(
        _('Find printers and nearby devices, and make .local names available on trusted networks.')
    )

    mdns_icon = _create_image('preferences-system-network-connection.svg')
    mdns_icon.set_pixel_size(32)
    mdns_row.add_prefix(mdns_icon)

    mdns_available, mdns_enabled = get_mdns_control_state()
    if mdns_available:
        mdns_row.set_active(mdns_enabled)
    else:
        mdns_row.set_sensitive(False)
        mdns_row.set_subtitle(_('Local network discovery controls are not installed.'))

    mdns_row._update_in_progress = False

    def _on_mdns_toggle(switch, pspec):
        if switch._update_in_progress:
            return

        enable = switch.get_active()
        switch._update_in_progress = True
        switch.set_sensitive(False)

        def _finish(returncode):
            if returncode != 0:
                switch.set_active(not enable)
            switch.set_sensitive(True)
            switch._update_in_progress = False
            return False

        def _run_mdns():
            try:
                proc = set_mdns_enabled(enable)
                GLib.idle_add(_finish, proc.returncode)
            except Exception:
                GLib.idle_add(_finish, -1)

        threading.Thread(target=_run_mdns, daemon=True).start()

    if mdns_available:
        mdns_row.connect('notify::active', _on_mdns_toggle)
    fw_card.add(mdns_row)
    center.append(fw_card)

    # ── Location Card ──
    loc_card = Adw.PreferencesGroup()
