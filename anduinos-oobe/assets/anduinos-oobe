    offline_btn.set_halign(Gtk.Align.CENTER)
    offline_btn.add_css_class('flat')
    offline_btn.set_tooltip_text(
        _('Skip updates, online drivers, apps, and account setup.'))
    offline_btn.connect('clicked', lambda _button: continue_offline())
    center.append(offline_btn)

    monitor = Gio.NetworkMonitor.get_default()

    def _render_connectivity():
        online = internet_connection_ready(monitor)
        page._hide_next = not online
        page._suggest_next = online
        page._block_carousel = not online
        if online:
            status_icon.set_from_icon_name('network-transmit-receive-symbolic')
            status_icon.remove_css_class('warning')
            status_icon.add_css_class('success')
            status_row.set_subtitle(
                _('Internet connection is ready. Choose Next to continue.'))
            offline_btn.set_visible(False)
        else:
            status_icon.set_from_icon_name('network-offline-symbolic')
            status_icon.remove_css_class('success')
            status_icon.add_css_class('warning')
            status_row.set_subtitle(
                _('Connect to Wi-Fi or a wired network to continue.'))
            offline_btn.set_visible(True)
        if update_nav:
            update_nav()

    def _clear_wifi_rows():
        for row in wifi_rows:
            networks_group.remove(row)
        wifi_rows.clear()

    def _replace_wifi_rows(devices, enabled, found):
        wifi_devices = devices['wifi']
        ethernet_devices = devices['ethernet']
        has_wifi = bool(wifi_devices)
        has_ethernet = bool(ethernet_devices)
        ethernet_connected = any(
            device['state'] in ('connected', 'connecting')
            for device in ethernet_devices
        )

        networks_group.set_visible(has_wifi)
        if not has_wifi and not has_ethernet:
            hardware_icon.set_from_icon_name('network-offline-symbolic')
            hardware_row.set_title(_('No network adapters detected.'))
            hardware_row.set_subtitle(
                _('Connect a network adapter or continue offline.'))
            settings_btn.set_label(_('Open Network Settings'))
            settings_state['panel'] = 'network'
        elif has_ethernet and not has_wifi:
            hardware_icon.set_from_icon_name('network-wired-symbolic')
            hardware_row.set_title(_('Wired Network'))
            hardware_row.set_subtitle(
                _('Cable connected.') if ethernet_connected
                else _('Plug in a network cable to connect.'))
            settings_btn.set_label(_('Open Network Settings'))
            settings_state['panel'] = 'network'
        elif has_wifi and not has_ethernet:
            hardware_icon.set_from_icon_name('network-wireless-symbolic')
            hardware_row.set_title(_('Wireless Network'))
            hardware_row.set_subtitle(_('Wi-Fi adapter detected.'))
            settings_btn.set_label(_('Open Wi-Fi Settings'))
            settings_state['panel'] = 'wifi'
        else:
            hardware_icon.set_from_icon_name('network-wired-symbolic')
            hardware_row.set_title(_('Wired and Wireless Networks'))
            hardware_row.set_subtitle(
                _('Cable connected and Wi-Fi available.')
                if ethernet_connected else
                _('Wi-Fi is available; the network cable is disconnected.'))
            settings_btn.set_label(_('Open Network Settings'))
            settings_state['panel'] = 'network'

        wifi_switch.handler_block(radio_handler)
        wifi_switch.set_active(enabled)
        wifi_switch.set_state(enabled)
        wifi_switch.handler_unblock(radio_handler)
        wifi_switch.set_sensitive(True)
        _clear_wifi_rows()

        if not enabled:
            row = Adw.ActionRow(title=_('Wi-Fi is turned off.'))
            networks_group.add(row)
            wifi_rows.append(row)
        elif not found:
            row = Adw.ActionRow(title=_('No Wi-Fi networks found.'))
            networks_group.add(row)
            wifi_rows.append(row)
        else:
            for network in found:
                detail = '{}%'.format(network['signal'])
                if network['security'] != '--':
                    detail += ' · ' + network['security']
                row = Adw.ActionRow(
                    title=network['ssid'], subtitle=detail, activatable=True)
                signal = network['signal']
                signal_icon = Gtk.Image.new_from_icon_name(
                    'network-wireless-signal-excellent-symbolic'
                    if signal >= 70 else
                    'network-wireless-signal-good-symbolic'
                    if signal >= 40 else
                    'network-wireless-signal-weak-symbolic')
                row.add_prefix(signal_icon)
                if network['active']:
                    row.add_suffix(
                        Gtk.Image.new_from_icon_name('emblem-ok-symbolic'))
                row.connect('activated', _open_wifi_settings)
                networks_group.add(row)
                wifi_rows.append(row)
        refresh_btn.set_sensitive(True)

    def _show_scan_error(error):
        _clear_wifi_rows()
        row = Adw.ActionRow(
            title=_('Wi-Fi unavailable: {}').format(error))
        networks_group.add(row)
        wifi_rows.append(row)
        wifi_switch.set_sensitive(True)
        refresh_btn.set_sensitive(True)

    def _scan_wifi(*_args):
        refresh_btn.set_sensitive(False)

        def _worker():
            try:
                devices = _get_network_devices()
                has_wifi = bool(devices['wifi'])
                enabled = _wifi_radio_enabled() if has_wifi else False
                found = (
                    _scan_wifi_networks() if has_wifi and enabled else []
                )
            except Exception as error:
                GLib.idle_add(_show_scan_error, error)
            else:
                GLib.idle_add(
                    _replace_wifi_rows, devices, enabled, found)

        threading.Thread(target=_worker, daemon=True).start()

    def _finish_radio_change(enabled, error):
        if error is not None:
            _show_scan_error(error)
        else:
            wifi_switch.handler_block(radio_handler)
            wifi_switch.set_active(enabled)
            wifi_switch.set_state(enabled)
            wifi_switch.handler_unblock(radio_handler)
        _scan_wifi()

    def _on_radio_state_set(_switch, enabled):
        wifi_switch.set_sensitive(False)
        refresh_btn.set_sensitive(False)

        def _worker():
            error = None
            try:
                _set_wifi_radio(enabled)
            except Exception as exception:
                error = exception
            GLib.idle_add(_finish_radio_change, enabled, error)

        threading.Thread(target=_worker, daemon=True).start()
        return True

    radio_handler = wifi_switch.connect('state-set', _on_radio_state_set)
    refresh_btn.connect('clicked', _scan_wifi)
    monitor.connect(
        'network-changed',
        lambda _monitor, _available: (_render_connectivity(), _scan_wifi()))

    _render_connectivity()
    _scan_wifi()
    return page


