def _get_flathub_url():
    """Return the current Flathub remote URL, or empty string on failure."""
    try:
        r = subprocess.run(['flatpak', 'remotes', '--system',
                            '--columns=name,url'],
                           capture_output=True, text=True, timeout=10)
        for line in r.stdout.splitlines():
            cols = line.split('\t')
            if len(cols) >= 2 and cols[0] == FLATHUB_REMOTE:
                return cols[1]
    except Exception:
        pass
    return ''


def _is_flathub_china_mirror():
    """True if Flathub is already pointing at a Chinese mirror."""
    url = _get_flathub_url()
    return 'ustc.edu.cn' in url or 'tuna.tsinghua.edu.cn' in url


def _is_package_installed(pkg):
    """Return True if the given dpkg package is installed."""
    try:
        r = subprocess.run(['dpkg', '-s', pkg], capture_output=True, timeout=5)
        return r.returncode == 0
    except Exception:
        return False


def should_recommend_snapshots_manager():
    """Return True when Disk Snapshots Manager can protect this system."""
    if not _is_package_installed(SNAPSHOTS_MANAGER_PACKAGE):
        return False
    try:
        result = subprocess.run(
            ['findmnt', '--noheadings', '--output', 'FSTYPE', '--target', '/'],
            capture_output=True,
            text=True,
            timeout=5,
        )
        return result.returncode == 0 and result.stdout.strip().lower() == 'btrfs'
    except Exception:
        return False


