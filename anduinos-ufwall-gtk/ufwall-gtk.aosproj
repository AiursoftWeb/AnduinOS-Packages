<Project Sdk="Aiursoft.Apkg.Sdk">
  <PropertyGroup>
    <PackageName>anduinos-ufwall-gtk</PackageName>
    <PackageVersion>2.0.1-7+$(SuiteShortName)</PackageVersion>
    <Maintainer>AnduinOS Team &lt;anduin@aiursoft.com&gt;</Maintainer>
    <PackageDescription>AnduinOS Firewall Configuration — a modern GTK4 and Libadwaita frontend for monitoring firewall activity and managing UFW status, rules, and application profiles.</PackageDescription>
    <Section>admin</Section>
    <PackageHomepage>https://www.anduinos.com</PackageHomepage>
    <RepositoryUrl>https://github.com/AiursoftWeb/AnduinOS-Packages</RepositoryUrl>
    <LicenseType>GPL-3.0</LicenseType>
    <AppStreamDeveloperName>AnduinOS Team</AppStreamDeveloperName>
    <AppStreamMetadataLicense>CC0-1.0</AppStreamMetadataLicense>
    <TargetDistro>anduinos</TargetDistro>
    <TargetSuites>noble-addon resolute-addon</TargetSuites>
    <TargetArchitectures>amd64 arm64</TargetArchitectures>
    <Component>main</Component>
    <SuiteShortNameMap>noble-addon=noble resolute-addon=resolute</SuiteShortNameMap>
  </PropertyGroup>

  <ItemGroup>
    <DependencyCheckSource Url="https://mirror.aiursoft.com/ubuntu" SuiteMap="noble-addon=noble resolute-addon=resolute" />
  </ItemGroup>

  <ItemGroup>
    <Dependency Include="ufw" />
    <Dependency Include="polkitd" />
    <Dependency Include="libpcap0.8t64" />
  </ItemGroup>

  <ItemGroup>
    <PrebuildCommand Run="bash build.sh amd64" Condition="'$(Arch)' == 'amd64'" />
    <PrebuildCommand Run="bash build.sh arm64" Condition="'$(Arch)' == 'arm64'" />
    <PrebuildCommand Run="PYTHONDONTWRITEBYTECODE=1 python3 scripts/test-network-service-helper.py" />
  </ItemGroup>

  <ItemGroup>
    <IncludeScript Include="obj/ufwall-gtk" Target="/usr/bin/ufwall-gtk" />
    <IncludeScript Include="obj/ufwall-auditor" Target="/usr/libexec/ufwall-gtk/ufwall-auditor" />
    <IncludeScript Include="scripts/network-service-helper" Target="/usr/libexec/ufwall-gtk/network-service-helper" />
    <IncludeFile Include="data/com.anduinos.ufwall.policy" Target="/usr/share/polkit-1/actions/com.anduinos.ufwall.policy" />
    <IncludeFolder Include="data/app_profiles" Target="/usr/share/ufwall-gtk/app_profiles" />
    <IncludeFolder Include="locale" Target="/usr/share/locale" />
  </ItemGroup>

  <ItemGroup>
    <AppStreamApplication Include="data/com.anduinos.ufwall.desktop" Icon="data/com.anduinos.ufwall.svg" />
    <AppStreamScreenshot Include="screenshots/overview.png" Default="true" Caption="Monitor firewall activity and manage UFW from a modern dashboard" Environment="GNOME:dark" />
    <AppStreamScreenshot Include="screenshots/rules.png" Caption="Create and manage firewall rules" Environment="GNOME:dark" />
    <AppStreamScreenshot Include="screenshots/status.png" Caption="Review firewall status and default policies" Environment="GNOME:dark" />
  </ItemGroup>

  <ItemGroup>
    <PostInstallScript Include="scripts/postinst.sh" />
  </ItemGroup>

</Project>
