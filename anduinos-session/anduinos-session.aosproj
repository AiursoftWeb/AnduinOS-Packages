<Project Sdk="Aiursoft.Apkg.Sdk">
  <PropertyGroup>
    <PackageName>anduinos-session</PackageName>
    <PackageVersion>2.0.0-2+$(SuiteShortName)</PackageVersion>
    <Maintainer>AnduinOS Team &lt;anduin@aiursoft.com&gt;</Maintainer>
    <PackageDescription>AnduinOS session configuration and login entry</PackageDescription>
    <Section>gnome</Section>
    <PackageHomepage>https://www.anduinos.com</PackageHomepage>
    <RepositoryUrl>https://github.com/AiursoftWeb/AnduinOS-Packages</RepositoryUrl>
    <LicenseType>GPL-3.0</LicenseType>
    
    <Provides>ubuntu-session</Provides>
    <Conflicts>ubuntu-session</Conflicts>
    <Replaces>ubuntu-session</Replaces>
    
    <TargetDistro>anduinos</TargetDistro>
    <TargetSuites>noble-addon resolute-addon</TargetSuites>
    <TargetArchitectures>all</TargetArchitectures>
    <Component>main</Component>
    <SuiteShortNameMap>noble-addon=noble resolute-addon=resolute</SuiteShortNameMap>
  </PropertyGroup>

  <ItemGroup>
    <Dependency Include="gnome-session" />
    <Dependency Include="gnome-shell" />
    <Dependency Include="anduinos-mimeapps" />
  </ItemGroup>

  <ItemGroup>
    <PostInstallScript Include="scripts/postinst.sh" />

    <!-- Run the regular GNOME session with an AnduinOS session mode.  This
         gives the lock screen a distro-owned fallback stylesheet without
         relying on extensions, which GNOME disables while locked. -->
    <IncludeFile Include="assets/anduinos.json"
                 Target="/usr/share/gnome-shell/modes/anduinos.json" />
    <IncludeFile Include="assets/50-anduinos-session-mode.conf"
                 Target="/usr/lib/systemd/user/org.gnome.Shell@user.service.d/50-anduinos-session-mode.conf" />

    <!-- Thin wrappers around GNOME's own Shell stylesheets. -->
    <IncludeFile Include="assets/anduinos-shell.css"
                 Target="/usr/share/gnome-shell/theme/anduinos-shell.css" />
    <IncludeFile Include="assets/anduinos-shell-light.css"
                 Target="/usr/share/gnome-shell/theme/anduinos-shell-light.css" />
    <IncludeFile Include="assets/anduinos-shell-dark.css"
                 Target="/usr/share/gnome-shell/theme/anduinos-shell-dark.css" />
    <IncludeFile Include="assets/anduinos-shell-high-contrast.css"
                 Target="/usr/share/gnome-shell/theme/anduinos-shell-high-contrast.css" />
    <IncludeFile Include="assets/anduinos-lock-screen.css"
                 Target="/usr/share/gnome-shell/theme/anduinos-lock-screen.css" />
  </ItemGroup>
</Project>
