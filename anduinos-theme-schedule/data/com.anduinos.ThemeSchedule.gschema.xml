<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="com.anduinos.ThemeSchedule" path="/com/anduinos/theme-schedule/">
    <key name="mode" type="s">
      <choices>
        <choice value="manual"/>
        <choice value="sunset-sunrise"/>
      </choices>
      <default>'manual'</default>
      <summary>Dark Style schedule</summary>
      <description>manual keeps the current GNOME color scheme. sunset-sunrise switches prefer-light at sunrise and prefer-dark at sunset.</description>
    </key>
    <key name="latitude" type="d">
      <default>0.0</default>
      <summary>Cached latitude</summary>
    </key>
    <key name="longitude" type="d">
      <default>0.0</default>
      <summary>Cached longitude</summary>
    </key>
    <key name="has-location" type="b">
      <default>false</default>
      <summary>Whether a location has been stored</summary>
    </key>
  </schema>
</schemalist>
