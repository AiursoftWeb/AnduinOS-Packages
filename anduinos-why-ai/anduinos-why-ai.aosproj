<Project Sdk="Aiursoft.Apkg.Sdk">
  <PropertyGroup>
    <PackageName>anduinos-why-ai</PackageName>
    <PackageVersion>0.1.5+$(SuiteShortName)</PackageVersion>
    <Maintainer>AnduinOS Team &lt;anduin@aiursoft.com&gt;</Maintainer>
    <PackageDescription>why — a fully offline, zero-daemon LLM CLI backed by a bundled Qwen3.5 0.8B model. Ask questions in plain text, pipe in context from stdin, or run --serve for an OpenAI-compatible HTTP API.</PackageDescription>
    <Section>utils</Section>
    <PackageHomepage>https://www.anduinos.com</PackageHomepage>
    <RepositoryUrl>https://github.com/AiursoftWeb/AnduinOS-Packages</RepositoryUrl>
    <LicenseType>GPL-3.0</LicenseType>
    <TargetDistro>anduinos</TargetDistro>
    <TargetSuites>noble-addon questing-addon resolute-addon</TargetSuites>
    <TargetArchitectures>amd64 arm64</TargetArchitectures>
    <Component>main</Component>
    <SuiteShortNameMap>noble-addon=noble questing-addon=questing resolute-addon=resolute</SuiteShortNameMap>
    <Conflicts>anduinos-why-placeholder</Conflicts>
    <Replaces>anduinos-why-placeholder</Replaces>
    <Provides>anduinos-why-placeholder</Provides>
  </PropertyGroup>

  <ItemGroup>
    <DependencyCheckSource Url="https://mirror.aiursoft.com/ubuntu" SuiteMap="noble-addon=noble questing-addon=questing resolute-addon=resolute" />
  </ItemGroup>

  <ItemGroup>
    <Dependency Include="libvulkan1" />
    <Dependency Include="llama.cpp" />
    <Dependency Include="libggml0-backend-vulkan" />
  </ItemGroup>

  <ItemGroup>
    <PrebuildCommand Run="bash download.sh" />
    <PrebuildCommand Run="bash build.sh amd64" Condition="'$(Arch)' == 'amd64'" />
    <PrebuildCommand Run="bash build.sh arm64" Condition="'$(Arch)' == 'arm64'" />
  </ItemGroup>

  <ItemGroup>
    <IncludeScript Include="obj/why" Target="/usr/bin/why" />
    <IncludeFolder Include="obj/usr/share/anduinos-why-ai" Target="/usr/share/anduinos-why-ai" />
  </ItemGroup>
</Project>
