<Project Sdk="Aiursoft.Apkg.Sdk">
  <PropertyGroup>
    <PackageName>anduinos-shim-signed</PackageName>
    <PackageVersion>2.0.5+repack1-1+$(SuiteShortName)</PackageVersion>
    <Maintainer>AnduinOS Team &lt;anduin@aiursoft.com&gt;</Maintainer>
    <PackageDescription>Official Microsoft-signed Ubuntu shim for the locally signed AnduinOS GRUB</PackageDescription>
    <Section>admin</Section>
    <PackageHomepage>https://www.anduinos.com</PackageHomepage>
    <RepositoryUrl>https://github.com/AiursoftWeb/AnduinOS-Packages</RepositoryUrl>
    <LicenseType>BSD-2-Clause</LicenseType>
    <TargetDistro>anduinos</TargetDistro>
    <TargetSuites>resolute-addon stonking-addon</TargetSuites>
    <TargetArchitectures>amd64 arm64</TargetArchitectures>
    <SuiteShortNameMap>resolute-addon=resolute stonking-addon=stonking</SuiteShortNameMap>
    <Component>main</Component>
    <Provides>shim-signed</Provides>
    <Conflicts>shim-signed, shim</Conflicts>
    <Replaces>shim-signed, shim</Replaces>
  </PropertyGroup>
  <ItemGroup>
    <BuildSource Name="ubuntu" Url="https://archive.ubuntu.com/ubuntu" Suites="$(SuiteShortName) $(SuiteShortName)-updates $(SuiteShortName)-security" Components="main" SignedBy="/usr/share/keyrings/ubuntu-archive-keyring.gpg" Condition="'$(Arch)' == 'amd64'" />
    <BuildSource Name="ubuntu" Url="https://ports.ubuntu.com/ubuntu-ports" Suites="$(SuiteShortName) $(SuiteShortName)-updates $(SuiteShortName)-security" Components="main" SignedBy="/usr/share/keyrings/ubuntu-archive-keyring.gpg" Condition="'$(Arch)' == 'arm64'" />
    <BuildInput Include="shim-signed" Sources="ubuntu" Arch="$(Arch)" />
    <DependencyCheckSource Url="https://mirror.aiursoft.com/ubuntu" SuiteMap="resolute-addon=resolute stonking-addon=stonking" />
    <Dependency Include="anduinos-grub" />
    <Dependency Include="mokutil" />
    <Dependency Include="sbsigntool" />
    <Dependency Include="bash" />
    <Recommend Include="secureboot-db" />
    <PrebuildCommand Run="bash build.sh" />
    <PostInstallScript Include="scripts/postinst.sh" />
    <PostRemoveScript Include="scripts/postrm.sh" />
    <DpkgTrigger Include="shim-kernel-check" Type="interest-noawait" />
    <IncludeFile Include="README.md" Target="/usr/share/doc/anduinos-shim-signed/README.md" />
  </ItemGroup>
</Project>
