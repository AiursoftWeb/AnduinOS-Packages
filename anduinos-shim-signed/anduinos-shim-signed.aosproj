<Project Sdk="Aiursoft.Apkg.Sdk">
  <PropertyGroup>
    <PackageName>anduinos-shim-signed</PackageName>
    <PackageVersion>2.0.6+$(UpstreamVersion)-1+$(SuiteShortName)</PackageVersion>
    <Maintainer>AnduinOS Team &lt;anduin@aiursoft.com&gt;</Maintainer>
    <PackageDescription>Official Microsoft-signed Ubuntu shim for the locally signed AnduinOS GRUB</PackageDescription>
    <Section>admin</Section>
    <PackageHomepage>https://www.anduinos.com</PackageHomepage>
    <RepositoryUrl>https://github.com/AiursoftWeb/AnduinOS-Packages</RepositoryUrl>
    <LicenseType>BSD-2-Clause</LicenseType>
    <TargetDistro>anduinos</TargetDistro>
    <TargetSuites>resolute-addon</TargetSuites>
    <TargetArchitectures>amd64 arm64</TargetArchitectures>
    <SuiteShortNameMap>resolute-addon=resolute</SuiteShortNameMap>
    <Component>main</Component>

    <UpstreamUrl Condition="'$(Arch)' == 'amd64'">https://archive.ubuntu.com/ubuntu</UpstreamUrl>
    <UpstreamUrl Condition="'$(Arch)' == 'arm64'">https://ports.ubuntu.com/ubuntu-ports</UpstreamUrl>
    <UpstreamDistro>ubuntu</UpstreamDistro>
    <UpstreamPackage>shim-signed</UpstreamPackage>
    <UpstreamSuite>$(Suite)</UpstreamSuite>
    <UpstreamSuiteMapping>resolute-addon=resolute</UpstreamSuiteMapping>
    <UpstreamComponent>main</UpstreamComponent>
    <UpstreamArch>$(Arch)</UpstreamArch>
    <UpstreamSignedBy>/usr/share/keyrings/ubuntu-archive-keyring.gpg</UpstreamSignedBy>
    <SuppressUpstreamScripts>true</SuppressUpstreamScripts>
    <!-- Replace Ubuntu's boot-stack dependencies with our own stack. -->
    <SuppressUpstreamDependencies>grub-efi-amd64-signed grub-efi-arm64-signed grub2-common</SuppressUpstreamDependencies>
    <Provides>shim-signed</Provides>
    <Conflicts>shim-signed, shim</Conflicts>
    <Replaces>shim-signed, shim</Replaces>
  </PropertyGroup>
  <ItemGroup>
    <Dependency Include="anduinos-grub (&gt;= 2.0.6)" />
    <Dependency Include="mokutil" />
    <Dependency Include="sbsigntool" />
    <Dependency Include="bash" />
    <Recommend Include="secureboot-db" />
    <PrebuildCommand Run="bash prepare.sh" />
    <PostInstallScript Include="scripts/postinst.sh" />
    <PostRemoveScript Include="scripts/postrm.sh" />
    <DpkgTrigger Include="shim-kernel-check" Type="interest-noawait" />
    <IncludeFile Include="README.md" Target="/usr/share/doc/anduinos-shim-signed/README.md" />
  </ItemGroup>
  <ItemGroup>
    <TestCommand Name="source" Profile="anduinos-package-release-test" Run="PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s tests -v" TimeoutSeconds="60" />
  </ItemGroup>
</Project>
