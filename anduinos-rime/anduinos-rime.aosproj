<Project Sdk="Aiursoft.Apkg.Sdk">
  <PropertyGroup>
    <PackageName>anduinos-rime</PackageName>
    <PackageVersion>2.0.6-1+$(SuiteShortName)</PackageVersion>
    <Maintainer>AnduinOS Team &lt;anduin@aiursoft.com&gt;</Maintainer>
    <PackageDescription>AnduinOS default Chinese input method (rime-ice configuration for ibus-rime)</PackageDescription>
    <Section>utils</Section>
    <PackageHomepage>https://www.anduinos.com</PackageHomepage>
    <RepositoryUrl>https://github.com/AiursoftWeb/AnduinOS-Packages</RepositoryUrl>
    <LicenseType>Various</LicenseType>
    <TargetDistro>anduinos</TargetDistro>
    <TargetSuites>noble-addon resolute-addon stonking-addon</TargetSuites>
    <TargetArchitectures>all</TargetArchitectures>
    <Component>main</Component>
    <SuiteShortNameMap>noble-addon=noble resolute-addon=resolute stonking-addon=stonking</SuiteShortNameMap>
    <PrebuildCommand Run="sh -n scripts/postinst.sh" />
  </PropertyGroup>

  <ItemGroup>
    <Dependency Include="ibus-rime" />
    <!-- The schema uses Lua processors, translators and filters. In
         particular, corrector.lua removes the spelling_hints comments from
         ordinary candidates. Without this plugin every candidate leaks its
         internal pinyin annotation into the IBus candidate list. -->
    <Dependency Include="librime-plugin-lua" />
  </ItemGroup>

  <ItemGroup>
    <IncludeFile Include="README.md" Target="/usr/share/doc/anduinos-rime/README.md" />
    <IncludeFolder Include="assets/" Target="/usr/share/rime-data/" />
    <IncludeFolder Include="defaults/" Target="/usr/share/rime-data/" />
  </ItemGroup>

  <ItemGroup>
    <!-- One-release migration: remove diversions created by <= 2.0.1-1. -->
    <PostInstallScript Include="scripts/postinst.sh" />
  </ItemGroup>
</Project>
